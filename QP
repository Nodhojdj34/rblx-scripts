local function createSlider(parent, title, minValue, maxValue, initialValue, formatter, onChanged, step)
	local container = newGui("Frame", parent, {
		Size = UDim2.new(1, -4, 0, 56),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
	}, "card")
	addCorner(container, 9)

	local titleLabel = createLabel(
		container,
		title,
		UDim2.new(0.68, -8, 0, 19),
		UDim2.new(0, 10, 0, 3),
		"text",
		12
	)

	local valueLabel = createLabel(
		container,
		"",
		UDim2.new(0.32, -12, 0, 19),
		UDim2.new(0.68, 0, 0, 3),
		"muted",
		11
	)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local bar = newGui("Frame", container, {
		Size = UDim2.new(1, -26, 0, 7),
		Position = UDim2.new(0, 13, 0, 37),
		BorderSizePixel = 0,
		BackgroundTransparency = 0,
	}, "button")
	addCorner(bar, 5)

	local fill = newGui("Frame", bar, {
		Size = UDim2.new(0, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BorderSizePixel = 0,
	}, "accentBar")
	addCorner(fill, 5)

	local knob = newGui("Frame", bar, {
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(0, -7, 0.5, -7),
		BorderSizePixel = 0,
	}, "accent")
	addCorner(knob, 10)

	local hit = newGui("TextButton", container, {
		Size = UDim2.new(1, -8, 0, 32),
		Position = UDim2.new(0, 4, 0, 22),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 5,
	}, nil)

	local value = initialValue
	local dragging = false
	local dragInput

	local slider = {}

	local function displayValue()
		if formatter then
			valueLabel.Text = formatter(value)
		else
			valueLabel.Text = tostring(value)
		end
	end

	local function drawValue()
		local range = maxValue - minValue
		local ratio = 0
		if range ~= 0 then
			ratio = math.clamp((value - minValue) / range, 0, 1)
		end
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, -7, 0.5, -7)
		displayValue()
	end

	local function setValue(newValue, shouldFire)
		newValue = math.clamp(newValue, minValue, maxValue)

		if step and step > 0 then
			newValue = minValue + math.floor(((newValue - minValue) / step) + 0.5) * step
			newValue = math.clamp(newValue, minValue, maxValue)
		end

		value = newValue
		drawValue()

		if shouldFire ~= false and onChanged then
			onChanged(value)
		end
	end

	function slider:SetValue(newValue, shouldFire)
		setValue(newValue, shouldFire)
	end

	function slider:IsDragging()
		return dragging
	end

	local function updateFromX(x)
		local width = bar.AbsoluteSize.X
		if width <= 0 then
			return
		end

		local ratio = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
		setValue(minValue + ratio * (maxValue - minValue), true)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInput = input
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input == dragInput
			or input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			dragInput = nil
		end
	end)

	drawValue()
	return slider
end

