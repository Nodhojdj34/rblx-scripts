	gradient.Rotation = 35
	gradient.Parent = cover

	local glyph = makeLabel(
		cover,
		"MusicGlyph",
		"♫",
		UDim2.fromScale(0, 0),
		UDim2.fromScale(1, 1),
		25,
		COLORS.text,
		Enum.Font.GothamBold,
		zIndex + 1
	)
	glyph.TextXAlignment = Enum.TextXAlignment.Center

	local image = Instance.new("ImageLabel")
	image.Name = "CoverImage"
	image.Size = UDim2.fromScale(1, 1)
	image.BackgroundTransparency = 1
	image.ScaleType = Enum.ScaleType.Crop
	image.Visible = false
	image.ZIndex = zIndex + 2
	image.Parent = cover

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = image

	return glyph, image
end

local function setCover(glyph, image, coverId)
	local uri = getAssetUri(coverId)

	if uri then
		image.Image = uri
		image.Visible = true
		glyph.Visible = false
	else
		image.Image = ""
		image.Visible = false
		glyph.Visible = true
	end
end

