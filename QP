local function parseHexColor(text)
	local hex = tostring(text or ""):gsub("%s", ""):gsub("^#", "")

	if #hex ~= 6 then
		return nil
	end

	local value = tonumber(hex, 16)
	if not value then
		return nil
	end

	return Color3.fromRGB(
		math.floor(value / 65536),
		math.floor((value % 65536) / 256),
		value % 256
	)
end

