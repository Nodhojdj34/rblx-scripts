local function assetUri(value)
	if value == nil then
		return nil
	end

	if type(value) == "number" then
		if value > 0 and value % 1 == 0 then
			return "rbxassetid://" .. string.format("%.0f", value)
		end
		return nil
	end

	local text = tostring(value):match("^%s*(.-)%s*$")
	local id = text:match("^rbxassetid://(%d+)$") or text:match("^(%d+)$")

	if not id or tonumber(id) == 0 then
		return nil
	end

	return "rbxassetid://" .. id
end

local function makeFrame(parent, name, size, position, color, radius, zIndex)
	local object = Instance.new("Frame")
	object.Name = name
	object.Size = size
	object.Position = position
	object.BackgroundColor3 = color or COLORS.panel
	object.BorderSizePixel = 0
	object.ZIndex = zIndex or 10
	object.Parent = parent

	if radius then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, radius)
		corner.Parent = object
	end

	return object
end

local function makeLabel(parent, name, text, position, size, textSize, color, font, zIndex)
	local object = Instance.new("TextLabel")
	object.Name = name
	object.Position = position
	object.Size = size
	object.BackgroundTransparency = 1
	object.Text = text or ""
	object.TextSize = textSize or 12
	object.TextColor3 = color or COLORS.text
	object.Font = font or Enum.Font.Gotham
	object.TextXAlignment = Enum.TextXAlignment.Left
	object.TextYAlignment = Enum.TextYAlignment.Center
	object.TextWrapped = false
	object.TextTruncate = Enum.TextTruncate.AtEnd
	object.ZIndex = zIndex or 12
	object.Parent = parent
	return object
end

local function makeButton(parent, name, text, position, size, textSize, zIndex, bgColor, radius)
	local object = Instance.new("TextButton")
	object.Name = name
	object.Position = position
	object.Size = size
	object.BackgroundColor3 = bgColor or COLORS.panel
	object.BackgroundTransparency = bgColor and 0 or 1
	object.BorderSizePixel = 0
	object.Text = text or ""
	object.TextSize = textSize or 14
	object.TextColor3 = COLORS.text
	object.Font = Enum.Font.GothamBold
	object.TextWrapped = false
	object.TextTruncate = Enum.TextTruncate.AtEnd
	object.AutoButtonColor = false
	object.Active = true
	object.Selectable = false
	object.ZIndex = zIndex or 14
	object.Parent = parent

	if radius then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, radius)
		corner.Parent = object
	end

	return object
end

local function addGradient(frame)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(
		Color3.fromRGB(139, 79, 255),
		Color3.fromRGB(39, 185, 180)
	)
	gradient.Rotation = 35
	gradient.Parent = frame
end

local function makeCover(parent, name, size, position, radius, zIndex)
	local cover = makeFrame(
		parent,
		name,
		size,
		position,
		Color3.fromRGB(87, 69, 126),
		radius,
		zIndex
	)
	cover.ClipsDescendants = true
	addGradient(cover)

	local glyph = makeLabel(
		cover,
		"MusicGlyph",
		"♪",
		UDim2.fromScale(0, 0),
		UDim2.fromScale(1, 1),
		24,
		COLORS.text,
		Enum.Font.GothamBold,
		zIndex + 1
	)
	glyph.TextXAlignment = Enum.TextXAlignment.Center

	local image = Instance.new("ImageLabel")
	image.Name = "CoverImage"
	image.Size = UDim2.fromScale(1, 1)
	image.BackgroundTransparency = 1
	image.ScaleType = Enum.ScaleType.Crop
	image.Visible = false
	image.ZIndex = zIndex + 2
	image.Parent = cover

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = image

	return glyph, image
end

local function applyCover(glyph, image, coverId)
	local uri = assetUri(coverId)

	if uri then
		image.Image = uri
		image.Visible = true
		glyph.Visible = false
	else
		image.Image = ""
		image.Visible = false
		glyph.Visible = true
	end
end

