muteButton.Activated:Connect(function()
	if volume > 0 then
		lastNonZeroVolume = volume
		volume = 0
	else
		volume = lastNonZeroVolume > 0 and lastNonZeroVolume or 0.65
	end

	updateVolumeUI()
end)

-- 自然播放结束后的队列逻辑
musicSound.Ended:Connect(function()
	if not isPlaying then
		return
	end

	isPlaying = false
	hasStarted = false

	if repeatMode == 2 then
		playTrack(currentIndex, true)
	elseif shuffleEnabled then
		playTrack(getRandomNextIndex(), true)
	elseif currentIndex < #TRACKS then
		playTrack(currentIndex + 1, true)
	elseif repeatMode == 1 then
		playTrack(1, true)
	else
		pcall(function()
			musicSound.TimePosition = 0
		end)
		updatePlayerButtons()
		refreshProgress()
		setStatus("播放结束", COLORS.muted)
	end
end)

-- 进度条和音量条：支持鼠标点击、触摸以及拖动
local dragTarget = nil

local function applySliderPointer(slider, pointerX)
	if not slider or not pointerX then
		return
	end

	local width = slider.AbsoluteSize.X
	if width <= 0 then
		return
	end

	local ratio = math.clamp(
		(pointerX - slider.AbsolutePosition.X) / width,
		0,
		1
	)

	if slider == seekHit then
		if musicSound.TimeLength > 0 then
			pcall(function()
				musicSound.TimePosition = ratio * musicSound.TimeLength
			end)
			refreshProgress()
		end
	elseif slider == volumeHit then
		volume = ratio
		if volume > 0 then
			lastNonZeroVolume = volume
		end
		updateVolumeUI()
	end
end

local function bindSlider(slider)
	slider.InputBegan:Connect(function(input)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1
			or inputType == Enum.UserInputType.Touch then
			dragTarget = slider
			applySliderPointer(slider, input.Position.X)
		end
	end)
end

bindSlider(seekHit)
bindSlider(volumeHit)

UserInputService.InputChanged:Connect(function(input)
	if dragTarget
		and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
		applySliderPointer(dragTarget, input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragTarget = nil
	end
end)

