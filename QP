local function refreshPlaylist()
	for _, child in ipairs(playlistContainer:GetChildren()) do
		if child:IsA("Frame") and child.Name == "TrackRow" then
			child:Destroy()
		end
	end

	local query = string.lower(searchBox.Text or "")
	local visibleCount = 0

	for index, track in ipairs(tracks) do
		local textToSearch = string.lower(
			tostring(track.title or "") .. " "
				.. tostring(track.artist or "") .. " "
				.. tostring(track.id or "")
		)

		local matchesSearch = query == "" or string.find(textToSearch, query, 1, true) ~= nil
		local matchesFavorite = not favoriteOnly or track.favorite == true

		if matchesSearch and matchesFavorite then
			visibleCount += 1
			local capturedIndex = index

			local row = newGui("Frame", playlistContainer, {
				Name = "TrackRow",
				Size = UDim2.new(1, 0, 0, 46),
				BorderSizePixel = 0,
			}, "card")
			addCorner(row, 9)

			local playButton = createButton(
				row,
				"▶",
				UDim2.new(0, 34, 0, 32),
				UDim2.new(0, 6, 0.5, -16),
				"accentButton",
				11
			)

			local nameLabel = createLabel(
				row,
				tostring(track.title) .. "  ·  ID " .. tostring(track.id),
				UDim2.new(1, -124, 1, 0),
				UDim2.new(0, 46, 0, 0),
				"text",
				11
			)
			nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

			local favoriteButton = createButton(
				row,
				track.favorite and "★" or "☆",
				UDim2.new(0, 30, 0, 32),
				UDim2.new(1, -70, 0.5, -16),
				"button",
				15
			)

			local removeButton = createButton(
				row,
				"×",
				UDim2.new(0, 30, 0, 32),
				UDim2.new(1, -36, 0.5, -16),
				"button",
				16
			)

			playButton.Activated:Connect(function()
				playTrack(capturedIndex)
			end)

			nameLabel.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					playTrack(capturedIndex)
				end
			end)

			favoriteButton.Activated:Connect(function()
				local item = tracks[capturedIndex]
				if item then
					item.favorite = not item.favorite
					refreshPlaylist()
				end
			end)

			removeButton.Activated:Connect(function()
				if not tracks[capturedIndex] then
					return
				end

				if capturedIndex == currentIndex then
					sound:Stop()
					currentIndex = 0
					playToken += 1
					sound.SoundId = ""
				elseif capturedIndex < currentIndex then
					currentIndex -= 1
				end

				table.remove(tracks, capturedIndex)
				updateCurrentTrackUI()
				refreshPlaylist()
			end)
		end
	end

	playlistEmptyLabel.Visible = visibleCount == 0
	if visibleCount == 0 and #tracks > 0 then
		playlistEmptyLabel.Text = "沒有符合搜尋或收藏篩選的曲目。"
	else
		playlistEmptyLabel.Text = "列表为空；在上方输入 Roblox 音频 ID 后添加。"
	end
end

local function playTrack(index)
	local track = tracks[index]
	if not track then
		setMusicStatus("播放列表中没有这首曲目。")
		return
	end

	currentIndex = index
	playToken += 1
	local thisToken = playToken

	sound:Stop()
	sound.SoundId = "rbxassetid://" .. tostring(track.id)
	sound.Volume = volume
	sound.PlaybackSpeed = playbackSpeed
	sound.Looped = repeatMode == 2

	pcall(function()
		sound.TimePosition = 0
	end)

	setMusicStatus("正在载入音频…请确认该音频获准用于当前体验。")
	updateCurrentTrackUI()

	-- 先请求播放，再异步预载；权限问题无法通过脚本绕过。
	pcall(function()
		sound:Play()
	end)

	task.spawn(function()
		local fetchFailure
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync({ sound }, function(_, status)
				local statusText = tostring(status)
				if not string.find(statusText, "Success", 1, true) then
					fetchFailure = statusText
				end
			end)
		end)

		if playToken ~= thisToken then
			return
		end

		if not ok or fetchFailure then
			setMusicStatus("加载失败：音频可能不存在、无权限或暂时不可用。")
			return
		end

		if sound.IsLoaded then
			setMusicStatus(sound.IsPlaying and "正在播放" or "音频已载入。")
		else
			setMusicStatus("音频仍在载入；若无法播放，请检查音频 ID 和体验权限。")
		end
	end)

	task.delay(15, function()
		if playToken == thisToken and not sound.IsLoaded then
			setMusicStatus("载入超时：请检查音频 ID、网络或体验音频权限。")
		end
	end)
end

local function nextTrack(manual)
	if #tracks == 0 then
		setMusicStatus("播放列表为空。")
		return
	end

	local nextIndex

	if currentIndex == 0 then
		nextIndex = 1
	elseif shuffleEnabled and #tracks > 1 then
		nextIndex = currentIndex
		for _ = 1, 8 do
			local candidate = math.random(1, #tracks)
			if candidate ~= currentIndex then
				nextIndex = candidate
				break
			end
		end
	elseif currentIndex < #tracks then
		nextIndex = currentIndex + 1
	elseif manual or repeatMode == 1 then
		nextIndex = 1
	else
		sound:Stop()
		setMusicStatus("播放完成。")
		updateCurrentTrackUI()
		return
	end

	playTrack(nextIndex)
end

local function previousTrack()
	if #tracks == 0 then
		return
	end

	if currentIndex > 0 and sound.TimePosition > 3 then
		pcall(function()
			sound.TimePosition = 0
		end)
		return
	end

	if currentIndex <= 1 then
		if repeatMode == 1 or currentIndex == 0 then
			playTrack(#tracks)
		else
			playTrack(1)
		end
	else
		playTrack(currentIndex - 1)
	end
end

local function addTrackFromInput()
	local rawText = idBox.Text or ""
	local id = rawText:match("[?&]id=(%d+)")
		or rawText:match("rbxassetid://(%d+)")
		or rawText:match("(%d+)")

	if not id or not tonumber(id) or tonumber(id) <= 0 then
		setMusicStatus("请在上方音频 ID 输入框填写有效的 Roblox 音频 ID。")
		return
	end

	local title = titleBox.Text
	if not title or title:gsub("%s", "") == "" then
		title = "音频 " .. id
	end

	table.insert(tracks, {
		id = id,
		title = title,
		artist = "Roblox 音频",
		favorite = false,
	})

	local newIndex = #tracks
	idBox.Text = ""
	refreshPlaylist()
	playTrack(newIndex)
end

