local function getRandomNextIndex()
	if #TRACKS <= 1 then
		return currentIndex
	end

	local nextIndex = currentIndex
	while nextIndex == currentIndex do
		nextIndex = randomGenerator:NextInteger(1, #TRACKS)
	end

	return nextIndex
end

local function nextTrack()
	if #TRACKS == 0 then
		setStatus("请先输入音频 ID", COLORS.amber)
		return
	end

	if shuffleEnabled and #TRACKS > 1 then
		playTrack(getRandomNextIndex(), true)
	else
		playTrack((currentIndex % #TRACKS) + 1, true)
	end
end

local function previousTrack()
	if #TRACKS == 0 then
		return
	end

	if musicSound.IsLoaded
		and currentTrack()
		and loadedUri == getAssetUri(currentTrack().id)
		and musicSound.TimePosition > 3 then
		pcall(function()
			musicSound.TimePosition = 0
		end)
		updateProgress()
		return
	end

	local previousIndex = currentIndex - 1
	if previousIndex < 1 then
		previousIndex = #TRACKS
	end

	playTrack(previousIndex, true)
end

