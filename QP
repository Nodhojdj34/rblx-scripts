	updateServerInfo()
end)

local deviceTimer = 0
local serverTimer = 0

RunService.Heartbeat:Connect(function(dt)
	-- 只检查本地玩家，不遍历或修改其他玩家角色。
	if antiFlingEnabled
		and localCharacter
		and localHumanoid
		and localRootPart
		and localHumanoid.Health > 0
		and localRootPart.Parent
		and not localRootPart.Anchored
		and os.clock() - localCharacterBoundAt > 1 then

		local seated =
			localHumanoid.SeatPart ~= nil or localHumanoid.Sit

		if not seated then
			local linearSpeed =
				localRootPart.AssemblyLinearVelocity.Magnitude
			local angularSpeed =
				localRootPart.AssemblyAngularVelocity.Magnitude
			local angularThreshold =
				math.max(220, antiFlingThreshold * 1.5)

			if linearSpeed > antiFlingThreshold
				or angularSpeed > angularThreshold then

				pcall(function()
					localRootPart.AssemblyLinearVelocity = Vector3.zero
					localRootPart.AssemblyAngularVelocity = Vector3.zero
				end)

				if os.clock() - antiFlingNoticeAt > 1.5 then
					antiFlingNoticeAt = os.clock()
					antiFlingLastSpeed = linearSpeed
					antiFlingStatusKey = "handled"
					refreshAntiFlingUI()
				end
			end
		end
	end

	if currentIndex > 0
		and sound.TimeLength > 0
		and not progressSlider:IsDragging() then
		progressSlider:SetValue(
			math.clamp(sound.TimePosition / sound.TimeLength, 0, 1),
			false
		)
		updateMiniIsland()
	end

	deviceTimer += dt
	serverTimer += dt

	if deviceTimer >= 1 then
		deviceTimer = 0
		updateDeviceInfo()
	end

	if serverTimer >= 3 then
		serverTimer = 0
		updateServerInfo()
	end
end)

