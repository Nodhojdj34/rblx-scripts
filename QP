local function updateProgress()
	local track = currentTrack()
	local uri = track and getAudioUri(track.id)

	local validLoadedSound =
		uri ~= nil
		and loadedUri == uri
		and musicSound.IsLoaded

	local length = validLoadedSound and musicSound.TimeLength or 0
	local position = validLoadedSound and musicSound.TimePosition or 0

	if length ~= length or length < 0 then
		length = 0
	end
	if position ~= position or position < 0 then
		position = 0
	end

	local ratio = 0
	if length > 0 then
		ratio = math.clamp(position / length, 0, 1)
	end

	seekFill.Size = UDim2.new(ratio, 0, 1, 0)
	seekKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
	currentTimeLabel.Text = formatTime(position)
	durationLabel.Text = formatTime(length)
end

local function updateVolume()
	volume = math.clamp(volume, 0, 1)
	musicSound.Volume = volume

	volumeFill.Size = UDim2.new(volume, 0, 1, 0)
	volumeKnob.Position = UDim2.new(volume, 0, 0.5, 0)
	volumePercent.Text = tostring(math.floor(volume * 100 + 0.5)) .. "%"
	muteButton.Text = volume == 0 and "×" or "♪"
end

local function failLoading(message)
	loadGeneration += 1
	loadBusy = false
	wantPlay = false
	loadedUri = nil
	playState = "error"

	pcall(function()
		musicSound:Stop()
	end)

	setStatus(message, COLORS.red)
	updatePlayerButtons()
	updateProgress()
end

local function beginLoading(uri)
	loadGeneration += 1
	local thisGeneration = loadGeneration

	loadBusy = true
	wantPlay = true
	playState = "loading"
	loadedUri = nil

	pcall(function()
		musicSound:Stop()
		musicSound.SoundId = uri
		musicSound.TimePosition = 0
		musicSound.Looped = repeatMode == 2
	end)

	setStatus("正在加载音频…", COLORS.amber)
	updatePlayerButtons()
	updateProgress()

	-- 超时后结束等待，避免界面一直停在“加载中”
	task.delay(20, function()
		if thisGeneration == loadGeneration and loadBusy then
			failLoading("加载超时：检查音频 ID 和使用权限")
		end
	end)

	task.spawn(function()
		local fetchStatus = nil

		local ok, err = pcall(function()
			ContentProvider:PreloadAsync({ musicSound }, function(_, status)
				fetchStatus = tostring(status)
			end)
		end)

		if thisGeneration ~= loadGeneration then
			return
		end

		local loadedDeadline = os.clock() + 4
		while ok
			and not musicSound.IsLoaded
			and os.clock() < loadedDeadline
			and thisGeneration == loadGeneration do
			task.wait(0.1)
		end

		if thisGeneration ~= loadGeneration then
			return
		end

		if not ok or not musicSound.IsLoaded then
			local detail = fetchStatus or tostring(err or "未知错误")
			failLoading("加载失败：" .. detail .. "；检查音频 ID / 权限")
			return
		end

		loadBusy = false
		loadedUri = uri
		musicSound.Looped = repeatMode == 2
		musicSound.PlaybackSpeed = speeds[speedIndex]

		if wantPlay then
			local played = pcall(function()
				musicSound:Play()
			end)

			if not played then
				failLoading("播放失败：请检查音频资产")
				return
			end

			playState = "playing"
			setStatus("正在播放", COLORS.green)
		else
			playState = "ready"
			setStatus("已加载，点击播放", COLORS.muted)
		end

		updatePlayerButtons()
		updateProgress()
	end)
end

startPlayback = function()
	local track = currentTrack()
	local uri = track and getAudioUri(track.id)

	if not uri then
		wantPlay = false
		playState = "error"
		setStatus("请先输入有效的 Roblox 音频 ID", COLORS.amber)
		updatePlayerButtons()
		return
	end

	wantPlay = true
	musicSound.Looped = repeatMode == 2
	musicSound.PlaybackSpeed = speeds[speedIndex]

	if loadBusy then
		playState = "loading"
		setStatus("正在加载音频…", COLORS.amber)
		updatePlayerButtons()
		return
	end

	if musicSound.IsLoaded and loadedUri == uri then
		if musicSound.TimeLength > 0
			and musicSound.TimePosition >= musicSound.TimeLength then
			pcall(function()
				musicSound.TimePosition = 0
			end)
		end

		local ok = pcall(function()
			musicSound:Play()
		end)

		if ok then
			playState = "playing"
			setStatus("正在播放", COLORS.green)
			updatePlayerButtons()
		else
			failLoading("播放失败：请检查音频资产")
		end
	else
		beginLoading(uri)
	end
end

playTrack = function(index, autoPlay)
	if #TRACKS == 0 then
		currentIndex = 0
		playState = "ready"
		wantPlay = false
		updateTrackUI()
		setStatus("请先输入音频 ID", COLORS.amber)
		return
	end

	index = math.clamp(math.floor(tonumber(index) or 1), 1, #TRACKS)
	currentIndex = index

	loadGeneration += 1
	loadBusy = false
	wantPlay = false
	loadedUri = nil

	pcall(function()
		musicSound:Stop()
	end)

	local track = TRACKS[currentIndex]
	local uri = track and getAudioUri(track.id)

	pcall(function()
		musicSound.SoundId = uri or ""
		musicSound.Looped = repeatMode == 2
		musicSound.TimePosition = 0
	end)

	updateTrackUI()
	updateProgress()

	if not uri then
		playState = "error"
		setStatus("该曲目没有有效音频 ID", COLORS.amber)
		updatePlayerButtons()
		return
	end

	playState = "ready"
	setStatus("已就绪，点击播放", COLORS.muted)
	updatePlayerButtons()

	if autoPlay then
		startPlayback()
	end
end

local function submitAudioId()
	local uri = getAudioUri(audioIdBox.Text)

	if not uri then
		setStatus("输入数字 ID 或 rbxassetid://数字", COLORS.amber)
		audioIdBox:CaptureFocus()
		return
	end

	local id = uri:match("(%d+)$")
	local foundIndex = nil

	for index, track in ipairs(TRACKS) do
		if getAudioUri(track.id) == uri then
			foundIndex = index
			break
		end
	end

	if foundIndex then
		TRACKS[foundIndex].title = "自定义音频 " .. id
		TRACKS[foundIndex].artist = "Roblox 音频"
	else
		table.insert(TRACKS, {
			title = "自定义音频 " .. id,
			artist = "Roblox 音频",
			id = id,
			cover = "",
		})
		foundIndex = #TRACKS
	end

	showFavoritesOnly = false
	rebuildPlaylist()
	audioIdBox:ReleaseFocus()
	playTrack(foundIndex, true)
end

