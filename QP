			button.BackgroundColor3 = COLORS.panel
			button.BackgroundTransparency = 1
			button.TextColor3 = COLORS.muted
		end
	end
end

local function updateButtons()
	playButton.Text = isPlaying and "Ⅱ" or "▶"
	miniSubtitle.Text = isPlaying and "正在播放" or "点按展开"
	miniSubtitle.TextColor3 = isPlaying and COLORS.green or COLORS.muted

	favoriteButton.Text = favorites[currentIndex] and "♥" or "♡"
	favoriteButton.TextColor3 = favorites[currentIndex] and COLORS.pink or COLORS.muted

	shuffleButton.TextColor3 = shuffleEnabled and COLORS.green or COLORS.muted
	repeatButton.TextColor3 = repeatMode == 0 and COLORS.muted or COLORS.green

	repeatBadge.Visible = repeatMode == 2
end

local function updateTrackUI()
	local track = TRACKS[currentIndex]
	if not track then
		return
	end

	trackTitle.Text = track.title or "未知曲目"
	artistLabel.Text = track.artist or "未知歌手"
	miniTitle.Text = track.title or "音乐播放器"

	applyCover(largeGlyph, largeImage, track.cover)
	applyCover(miniGlyph, miniImage, track.cover)

	updateButtons()
	updatePlaylistRows()
end

local function updateProgress()
	local length = musicSound.TimeLength
	local position = musicSound.TimePosition

	if length ~= length or length < 0 then
		length = 0
	end

	if position ~= position or position < 0 then
		position = 0
	end

	local ratio = 0
	if length > 0 then
		ratio = math.clamp(position / length, 0, 1)
	end

	seekFill.Size = UDim2.new(ratio, 0, 1, 0)
	seekKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
	currentTimeLabel.Text = formatTime(position)
	durationLabel.Text = formatTime(length)
end

local function updateVolumeUI()
	volume = math.clamp(volume, 0, 1)
	musicSound.Volume = volume

	volumeFill.Size = UDim2.new(volume, 0, 1, 0)
	volumeKnob.Position = UDim2.new(volume, 0, 0.5, 0)
	volumePercent.Text = tostring(math.floor(volume * 100 + 0.5)) .. "%"
	muteButton.Text = volume == 0 and "×" or "♪"
end

local function startPlayback()
	local track = TRACKS[currentIndex]
	local uri = track and assetUri(track.id)

	if not uri then
		isPlaying = false
		updateButtons()
		setStatus("请填写有效音频 ID", COLORS.amber)
		return
	end

	if musicSound.SoundId ~= uri then
		pcall(function()
			musicSound:Stop()
			musicSound.SoundId = uri
			musicSound.TimePosition = 0
		end)
		hasStarted = false
	end

	if musicSound.IsLoaded
		and musicSound.TimeLength > 0
		and musicSound.TimePosition >= musicSound.TimeLength then
		pcall(function()
			musicSound.TimePosition = 0
		end)
		hasStarted = false
	end

	musicSound.Looped = repeatMode == 2

	local ok = false

	if hasStarted then
		ok = pcall(function()
			musicSound:Resume()
		end)
	end

	if not ok then
		ok = pcall(function()
			musicSound:Play()
		end)
		if ok then
			hasStarted = true
		end
	end

	if not ok then
		isPlaying = false
		updateButtons()
		setStatus("无法播放：检查音频 ID / 权限", COLORS.red)
		return
	end

	isPlaying = true
	updateButtons()

	if musicSound.IsLoaded then
		setStatus("正在播放", COLORS.green)
	else
		setStatus("正在加载音频…", COLORS.amber)
	end

	local thisLoadToken = loadToken

	task.spawn(function()
		local deadline = os.clock() + 20

		while gui.Parent
			and thisLoadToken == loadToken
			and not musicSound.IsLoaded
			and os.clock() < deadline do
			task.wait(0.2)
		end

		if not gui.Parent or thisLoadToken ~= loadToken then
			return
		end

		if musicSound.IsLoaded then
			if isPlaying then
				setStatus("正在播放", COLORS.green)
			end
		elseif isPlaying then
			isPlaying = false
			hasStarted = false

			pcall(function()
				musicSound:Stop()
			end)

			updateButtons()
			setStatus("加载失败：检查 ID / 音频权限", COLORS.red)
		end
	end)
end

local function pausePlayback()
	if not isPlaying then
		return
	end

	pcall(function()
		musicSound:Pause()
	end)

	isPlaying = false
	updateButtons()
	setStatus("已暂停", COLORS.muted)
end

local function playTrack(index, autoPlay)
	if #TRACKS == 0 then
		return
	end

	currentIndex = ((index - 1) % #TRACKS) + 1
	loadToken = loadToken + 1
	isPlaying = false
	hasStarted = false

	local track = TRACKS[currentIndex]
	local uri = track and assetUri(track.id)

	pcall(function()
		musicSound:Stop()
		musicSound.SoundId = uri or ""
		musicSound.TimePosition = 0
		musicSound.Looped = repeatMode == 2
	end)

	updateTrackUI()
	updateProgress()

	if not uri then
		setStatus("请在曲目表填写有效音频 ID", COLORS.amber)
		return
	end

	setStatus("已就绪 · 点击播放", COLORS.muted)

	if autoPlay then
		startPlayback()
	end
end

local function getRandomNextIndex()
	if #TRACKS <= 1 then
		return currentIndex
	end

	local nextIndex = currentIndex
	while nextIndex == currentIndex do
		nextIndex = randomGenerator:NextInteger(1, #TRACKS)
	end

	return nextIndex
end

local function nextTrack()
	if shuffleEnabled then
		playTrack(getRandomNextIndex(), true)
	else
		playTrack((currentIndex % #TRACKS) + 1, true)
	end
end

local function previousTrack()
	if musicSound.IsLoaded and musicSound.TimePosition > 3 then
		pcall(function()
			musicSound.TimePosition = 0
		end)
		updateProgress()
		return
	end

	local previousIndex = currentIndex - 1
	if previousIndex < 1 then
		previousIndex = #TRACKS
	end

	playTrack(previousIndex, true)
end

-- 进度 / 音量拖动
local dragTarget = nil

local function applySlider(slider, pointerX)
	if not slider or not pointerX then
		return
	end

	local width = slider.AbsoluteSize.X
	if width <= 0 then
		return
	end

	local ratio = math.clamp(
		(pointerX - slider.AbsolutePosition.X) / width,
		0,
		1
	)

	if slider == seekHit then
		if musicSound.IsLoaded and musicSound.TimeLength > 0 then
			pcall(function()
				musicSound.TimePosition = ratio * musicSound.TimeLength
			end)
			updateProgress()
		end
	elseif slider == volumeHit then
		volume = ratio
		if volume > 0 then
			lastNonZeroVolume = volume
		end
		updateVolumeUI()
	end
end

local function bindSlider(slider)
	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragTarget = slider
			applySlider(slider, input.Position.X)
		end
	end)
end

bindSlider(seekHit)
bindSlider(volumeHit)

UserInputService.InputChanged:Connect(function(input)
	if dragTarget
		and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
		applySlider(dragTarget, input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragTarget = nil
	end
end)

