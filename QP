	if radius then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, radius)
		corner.Parent = object
	end

	return object
end

local function makeTextBox(parent, name, placeholder, position, size, zIndex)
	local box = Instance.new("TextBox")
	box.Name = name
	box.Position = position
	box.Size = size
	box.BackgroundColor3 = COLORS.panelLight
	box.BackgroundTransparency = 0
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = COLORS.muted
	box.Text = ""
	box.TextColor3 = COLORS.text
	box.TextSize = 10
	box.Font = Enum.Font.Gotham
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Center
	box.Active = true
	box.Selectable = true
	box.ZIndex = zIndex or 25
	box.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = box

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(70, 77, 73)
	stroke.Thickness = 1
	stroke.Parent = box

	return box, stroke
end

local function makeCover(parent, name, size, position, radius, zIndex)
	local cover = makeFrame(
		parent,
		name,
		size,
		position,
		Color3.fromRGB(69, 97, 78),
		radius,
		zIndex
	)
	cover.ClipsDescendants = true

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(
		Color3.fromRGB(35, 95, 67),
		Color3.fromRGB(27, 50, 45)
	)
	gradient.Rotation = 35
	gradient.Parent = cover

	local glyph = makeLabel(
		cover,
		"MusicGlyph",
		"♫",
		UDim2.fromScale(0, 0),
		UDim2.fromScale(1, 1),
		25,
		COLORS.text,
		Enum.Font.GothamBold,
		zIndex + 1
	)
	glyph.TextXAlignment = Enum.TextXAlignment.Center

	local image = Instance.new("ImageLabel")
	image.Name = "CoverImage"
	image.Size = UDim2.fromScale(1, 1)
	image.BackgroundTransparency = 1
	image.ScaleType = Enum.ScaleType.Crop
	image.Visible = false
	image.ZIndex = zIndex + 2
	image.Parent = cover

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = image

	return glyph, image
end

local function setCover(glyph, image, coverId)
	local uri = getAssetUri(coverId)

	if uri then
		image.Image = uri
		image.Visible = true
		glyph.Visible = false
	else
		image.Image = ""
		image.Visible = false
		glyph.Visible = true
	end
end

