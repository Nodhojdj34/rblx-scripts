		miniTitle.Text = tostring(track.title or "Roblox 音频")

		setCover(largeGlyph, largeImage, track.cover)
		setCover(miniGlyph, miniImage, track.cover)
	else
		trackTitle.Text = "等待添加音频"
		artistLabel.Text = "在下方输入 Roblox 音频 ID"
		miniTitle.Text = "音乐播放器"

		setCover(largeGlyph, largeImage, "")
		setCover(miniGlyph, miniImage, "")
	end

	updatePlayerButtons()
	updatePlaylistSelection()
end

local function updateProgress()
	local track = currentTrack()
	local uri = track and getAssetUri(track.id)

	local validSound =
		uri ~= nil
		and loadedUri == uri
		and musicSound.IsLoaded

	local length = validSound and musicSound.TimeLength or 0
	local position = validSound and musicSound.TimePosition or 0

	if length ~= length or length < 0 then
		length = 0
	end
	if position ~= position or position < 0 then
		position = 0
	end

	local ratio = 0
	if length > 0 then
		ratio = math.clamp(position / length, 0, 1)
	end

	seekFill.Size = UDim2.new(ratio, 0, 1, 0)
	seekKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
	currentTimeLabel.Text = formatTime(position)
	durationLabel.Text = formatTime(length)
end

local function updateVolume()
	volume = math.clamp(volume, 0, 1)
	musicSound.Volume = volume

	volumeFill.Size = UDim2.new(volume, 0, 1, 0)
	volumeKnob.Position = UDim2.new(volume, 0, 0.5, 0)
	volumePercent.Text = tostring(math.floor(volume * 100 + 0.5)) .. "%"
	muteButton.Text = volume == 0 and "×" or "♪"
end

local function updateAccentSwatches()
	for _, entry in ipairs(accentSwatches) do
		if entry.color == accentColor then
			entry.stroke.Color = COLORS.text
			entry.stroke.Thickness = 2
			entry.stroke.Transparency = 0
		else
			entry.stroke.Color = COLORS.text
			entry.stroke.Thickness = 1
			entry.stroke.Transparency = 0.65
		end
	end
end

local function updateBackgroundSwatches()
	for _, entry in ipairs(backgroundSwatches) do
		if entry.index == currentPaletteIndex then
			entry.stroke.Color = accentColor
			entry.stroke.Thickness = 2
			entry.stroke.Transparency = 0
		else
			entry.stroke.Color = COLORS.text
			entry.stroke.Thickness = 1
			entry.stroke.Transparency = 0.65
		end
	end
end

