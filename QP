local function parseHexColor(text)
	local hex = tostring(text or ""):gsub("%s", ""):gsub("^#", "")
	if #hex ~= 6 then
		return nil
	end

	local value = tonumber(hex, 16)
	if not value then
		return nil
	end

	local red = math.floor(value / 65536)
	local green = math.floor((value % 65536) / 256)
	local blue = value % 256
	return Color3.fromRGB(red, green, blue)
end

