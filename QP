local languageOrder = { "zh", "en", "ja" }
local language = "zh"
local localizedBindings = {}
local allSliders = {}
local languageButton = nil
local refreshDynamicUI = nil

local function T(key)
	local current = translations[language]
	if current and current[key] then
		return current[key]
	end

	return translations.zh[key] or key
end

local function TF(key, ...)
	local formatString = T(key)
	local arguments = { ... }

	if #arguments == 0 then
		return formatString
	end

	local success, result = pcall(
		string.format,
		formatString,
		table.unpack(arguments)
	)

	if success then
		return result
	end

	return formatString
end

local function bindLocalizedText(object, key, property)
	table.insert(localizedBindings, {
		object = object,
		key = key,
		property = property,
	})

	object[property] = T(key)
	return object
end

local function applyLanguage(nextLanguage)
	language = nextLanguage

	for index = #localizedBindings, 1, -1 do
		local binding = localizedBindings[index]

		if binding.object and binding.object.Parent then
			binding.object[binding.property] = T(binding.key)
		else
			table.remove(localizedBindings, index)
		end
	end

	if languageButton then
		languageButton.Text =
			TF("language_switch", T("lang_" .. language))
	end

	if refreshDynamicUI then
		refreshDynamicUI()
	end

	for _, slider in ipairs(allSliders) do
		slider:Refresh()
	end
end

