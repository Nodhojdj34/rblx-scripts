-- 单个 LocalScript
-- 放置位置：StarterPlayer > StarterPlayerScripts > LocalScript
-- 顶部灵动岛药丸 + 屏幕中央悬浮控制窗
-- 不包含异常玩家检测。
-- 防甩飞只处理本地玩家角色。
-- 音乐只播放当前体验获准使用的 Roblox 音频，不连接 Spotify。

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local GuiService = game:GetService("GuiService")
local VRService = game:GetService("VRService")
local LocalizationService = game:GetService("LocalizationService")
local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local startedAt = os.clock()

-- 可选预设曲目；不需要预设曲目就保持空表。
-- 示例：{ title = "我的曲目", artist = "歌手", id = 1234567890 }
local TRACKS = {}

----------------------------------------------------------------
-- 清理旧版本本地对象
----------------------------------------------------------------

local oldGui = playerGui:FindFirstChild("IslandLocalUI")
if oldGui then
	oldGui:Destroy()
end

for _, object in ipairs(Lighting:GetChildren()) do
	if object.Name == "IslandLocalColorCorrection"
		or object.Name == "IslandLocalBlur" then
		object:Destroy()
	end
end

local oldSound = SoundService:FindFirstChild("IslandLocalMusic")
if oldSound then
	oldSound:Destroy()
end

