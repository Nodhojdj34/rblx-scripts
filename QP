local expanded = false
local userScale = 1
local rootOffsetX = 0
local rootOffsetY = 8

local function getViewportSize()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end
	return Vector2.new(800, 600)
end

local function updateLayout()
	local viewport = getViewportSize()

	-- 面板留出左右边距；手机上不会强行按桌面 420px 宽显示。
	local panelWidth = math.max(190, math.min(420, viewport.X - 32))
	local pillWidth = math.max(180, math.min(258, viewport.X - 72))

	-- 面板高度限制为屏幕的大约 55%，内容过多时在面板内滚动。
	local panelHeight = math.floor(math.min(500, math.max(190, viewport.Y * 0.55)))
	local rootHeight = expanded and (panelHeight + 50) or 44

	root.Size = UDim2.new(0, panelWidth, 0, rootHeight)
	island.Size = UDim2.new(0, pillWidth, 0, 44)
	panel.Position = UDim2.new(0, 0, 0, 50)
	panel.Size = UDim2.new(1, 0, 0, panelHeight)
	panel.Visible = expanded
	expandButton.Text = expanded and "⌃" or "⌄"

	for _, page in pairs(pages) do
		page.Position = UDim2.new(0, 8, 0, 70)
		page.Size = UDim2.new(1, -16, 1, -78)
	end

	local baseHeight = rootHeight
	local fitScale = math.min(
		1.15,
		(viewport.X - 16) / panelWidth,
		(viewport.Y - 16) / math.max(baseHeight, 1)
	)

	uiScale.Scale = math.min(userScale, fitScale)

	local scaledWidth = panelWidth * uiScale.Scale
	local scaledHeight = baseHeight * uiScale.Scale
	local maxX = math.max(0, viewport.X / 2 - scaledWidth / 2 - 4)
	local maxY = math.max(4, viewport.Y - scaledHeight - 8)

	rootOffsetX = math.clamp(rootOffsetX, -maxX, maxX)
	rootOffsetY = math.clamp(rootOffsetY, 4, maxY)
	root.Position = UDim2.new(0.5, rootOffsetX, 0, rootOffsetY)
end

local function setExpanded(value)
	expanded = value
	updateLayout()
end

