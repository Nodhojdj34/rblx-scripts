-- 进度条和音量条支持鼠标及触摸拖动
local sliderDragTarget = nil

local function applySlider(slider, pointerX)
	local width = slider.AbsoluteSize.X
	if width <= 0 then
		return
	end

	local ratio = math.clamp(
		(pointerX - slider.AbsolutePosition.X) / width,
		0,
		1
	)

	if slider == seekHit then
		if musicSound.IsLoaded
			and currentTrack()
			and loadedUri == getAudioUri(currentTrack().id)
			and musicSound.TimeLength > 0 then
			pcall(function()
				musicSound.TimePosition = ratio * musicSound.TimeLength
			end)
			updateProgress()
		end
	elseif slider == volumeHit then
		volume = ratio
		if volume > 0 then
			lastNonZeroVolume = volume
		end
		updateVolume()
	end
end

local function bindSlider(slider)
	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragTarget = slider
			applySlider(slider, input.Position.X)
		end
	end)
end

bindSlider(seekHit)
bindSlider(volumeHit)

UserInputService.InputChanged:Connect(function(input)
	if sliderDragTarget
		and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
		applySlider(sliderDragTarget, input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragTarget = nil
	end
end)

-- 展开与收起
local isExpanded = false
local activeTween
local expansionGeneration = 0

local function setExpanded(value)
	if isExpanded == value then
		return
	end

	isExpanded = value
	expansionGeneration += 1
	local thisGeneration = expansionGeneration

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if value then
		compact.Visible = false
		expanded.Visible = true
		compactHit.Visible = false
	end

	local tween = TweenService:Create(
		island,
		TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = value and OPEN_SIZE or CLOSED_SIZE }
	)
	activeTween = tween

	tween.Completed:Connect(function(playbackState)
		if thisGeneration ~= expansionGeneration
			or playbackState ~= Enum.PlaybackState.Completed then
			return
		end

		activeTween = nil

		if not value then
			expanded.Visible = false
			compact.Visible = true
			compactHit.Visible = true
		end
	end)

	tween:Play()
end

compactHit.Activated:Connect(function()
	setExpanded(true)
end)

closeButton.Activated:Connect(function()
	setExpanded(false)
end)

-- 拖动位置，PC 用鼠标，移动端用手指
local isDraggingIsland = false
local dragStartPointer
local dragStartLeft
local dragStartTop

dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingIsland = true
		dragStartPointer = Vector2.new(input.Position.X, input.Position.Y)
		dragStartLeft = island.AbsolutePosition.X
		dragStartTop = island.AbsolutePosition.Y
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not isDraggingIsland
		or not dragStartPointer
		or not dragStartLeft
		or not dragStartTop then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local pointer = Vector2.new(input.Position.X, input.Position.Y)
	local delta = pointer - dragStartPointer
	local viewport = camera.ViewportSize
	local width = island.AbsoluteSize.X
	local height = island.AbsoluteSize.Y

	local left = math.clamp(
		dragStartLeft + delta.X,
		6,
		math.max(6, viewport.X - width - 6)
	)

	local top = math.clamp(
		dragStartTop + delta.Y,
		6,
		math.max(6, viewport.Y - height - 6)
	)

	island.Position = UDim2.fromOffset(left + width / 2, top)
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingIsland = false
	end
end)

-- 当前服务器信息；不需要第二个服务端脚本
local function safeRead(callback, fallback)
	local ok, result = pcall(callback)
	if ok and result ~= nil then
		return result
	end
	return fallback
end

local function refreshServerInfo()
	local currentPlayers = Players:GetPlayers()

	table.sort(currentPlayers, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	local present = {}

	for order, player in ipairs(currentPlayers) do
		local key = tostring(player.UserId)
		present[key] = true

		local entry = rosterRows[key]

		if not entry then
			local row = makeFrame(
				roster,
				"PlayerRow_" .. key,
				UDim2.new(1, -6, 0, 26),
				UDim2.new(),
				Color3.fromRGB(40, 43, 50),
				6,
				20
			)
			row.BackgroundTransparency = 0.25

			local label = makeLabel(
				row,
				"PlayerInfo",
				"",
				UDim2.new(0, 8, 0, 0),
				UDim2.new(1, -16, 1, 0),
				9,
				COLORS.text,
				Enum.Font.Gotham,
				21
			)

			entry = { frame = row, label = label }
			rosterRows[key] = entry
		end

		entry.frame.LayoutOrder = order

		local name = player.DisplayName
		if player.DisplayName ~= player.Name then
			name = name .. " (@" .. player.Name .. ")"
		else
			name = "@" .. player.Name
		end

		if player == Players.LocalPlayer then
			name = "你 · " .. name
		end

		local teamName = player.Team and player.Team.Name or "无队伍"
		entry.label.Text = name .. " · " .. teamName
	end

	for key, entry in pairs(rosterRows) do
		if not present[key] then
			entry.frame:Destroy()
			rosterRows[key] = nil
		end
	end

	local maxPlayers = safeRead(function()
		return Players.MaxPlayers
	end, "未知")

	local jobId = safeRead(function()
		return game.JobId
	end, "")

	local placeId = safeRead(function()
		return game.PlaceId
	end, "未知")

	local gameId = safeRead(function()
		return game.GameId
	end, "未知")

	local version = safeRead(function()
		return game.PlaceVersion
	end, "未知")

	local privateOwnerId = safeRead(function()
		return game.PrivateServerOwnerId
	end, 0)

	local privateServerId = safeRead(function()
		return game.PrivateServerId
	end, "")

	local isStudio = safeRead(function()
		return RunService:IsStudio()
	end, false)

	local serverType
	if isStudio then
		serverType = "Studio"
	elseif tonumber(privateOwnerId) and tonumber(privateOwnerId) > 0 then
		serverType = "私人服务器"
	elseif privateServerId ~= "" then
		serverType = "预留服务器"
	else
		serverType = "公开服务器"
	end

	if jobId == "" then
		jobId = isStudio and "Studio / 未分配" or "客户端不可读取"
	end

	serverSummary.Text =
		"类型：" .. tostring(serverType)
		.. "\n人数：" .. tostring(#currentPlayers) .. " / " .. tostring(maxPlayers)
		.. "\nPlaceId：" .. tostring(placeId)
		.. "\nGameId：" .. tostring(gameId)
		.. "\nJobId：" .. tostring(jobId)
		.. "\n版本：" .. tostring(version)
		.. "\n本地面板运行：" .. formatDuration(os.clock() - clientStartTime)

	playerListTitle.Text = "玩家列表（" .. tostring(#currentPlayers) .. "）"
end

local function showPage(pageName)
	local showMusic = pageName == "music"

	musicPage.Visible = showMusic
	serverPage.Visible = not showMusic

	musicTab.BackgroundColor3 = showMusic and COLORS.green or COLORS.panel
	musicTab.TextColor3 = showMusic and COLORS.black or COLORS.muted

	serverTab.BackgroundColor3 = showMusic and COLORS.panel or COLORS.green
	serverTab.TextColor3 = showMusic and COLORS.muted or COLORS.black

	if not showMusic then
		refreshServerInfo()
	end
end

musicTab.Activated:Connect(function()
	showPage("music")
end)

serverTab.Activated:Connect(function()
	showPage("server")
end)

refreshButton.Activated:Connect(refreshServerInfo)
Players.PlayerAdded:Connect(refreshServerInfo)
Players.PlayerRemoving:Connect(refreshServerInfo)

