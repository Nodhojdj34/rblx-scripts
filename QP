local windowOpen = false
local userScale = 1
local pillOffsetX = 0
local pillOffsetY = 8

local function getViewportSize()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.ViewportSize
	end

	return Vector2.new(800, 600)
end

local function updateLayout()
	local viewport = getViewportSize()

	local windowWidth
	if viewport.X < 600 then
		windowWidth = math.max(220, math.min(400, viewport.X - 28))
	else
		windowWidth = math.max(320, math.min(440, viewport.X - 80))
	end

	local windowHeight = math.floor(math.clamp(viewport.Y * 0.58, 220, 500))
	local pillWidth = math.max(190, math.min(260, viewport.X - 72))

	window.Size = UDim2.new(0, windowWidth, 0, windowHeight)
	window.Position = UDim2.new(0.5, 0, 0.5, 0)
	window.Visible = windowOpen

	for _, page in pairs(pages) do
		page.Position = UDim2.new(0, 8, 0, 72)
		page.Size = UDim2.new(1, -16, 1, -82)
	end

	local windowFitX = math.max(0.4, (viewport.X - 12) / windowWidth)
	local windowFitY = math.max(0.4, (viewport.Y - 12) / windowHeight)
	windowScale.Scale = math.min(userScale, windowFitX, windowFitY)

	pill.Size = UDim2.new(0, pillWidth, 0, 48)

	local pillFitX = math.max(0.4, (viewport.X - 16) / pillWidth)
	local pillFitY = math.max(0.4, (viewport.Y - 16) / 48)
	pillScale.Scale = math.min(userScale, pillFitX, pillFitY)

	local actualPillWidth = pill.AbsoluteSize.X
	local actualPillHeight = pill.AbsoluteSize.Y
	local maxPillX = math.max(0, viewport.X / 2 - actualPillWidth / 2 - 4)
	local maxPillY = math.max(4, viewport.Y - actualPillHeight - 8)

	pillOffsetX = math.clamp(pillOffsetX, -maxPillX, maxPillX)
	pillOffsetY = math.clamp(pillOffsetY, 4, maxPillY)
	pill.Position = UDim2.new(0.5, pillOffsetX, 0, pillOffsetY)
end

local function setWindowOpen(value)
	windowOpen = value
	updateLayout()
end

