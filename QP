local function setStatus(text, color)
	playStatus.Text = text
	playStatus.TextColor3 = color or COLORS.muted
	statusDot.BackgroundColor3 = color or COLORS.muted
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function formatDuration(seconds)
	local total = math.max(0, math.floor(tonumber(seconds) or 0))
	local days = math.floor(total / 86400)
	local hours = math.floor((total % 86400) / 3600)
	local minutes = math.floor((total % 3600) / 60)
	local remainingSeconds = total % 60

	if days > 0 then
		return string.format("%dd %02d:%02d:%02d", days, hours, minutes, remainingSeconds)
	end

	return string.format("%02d:%02d:%02d", hours, minutes, remainingSeconds)
end

local function formatSpeed(value)
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text .. "×"
end

local function updatePlayerButtons()
	local isActuallyPlaying = playState == "playing" or (playState == "loading" and wantPlay)
	playButton.Text = isActuallyPlaying and "Ⅱ" or "▶"

	if playState == "playing" then
		miniSubtitle.Text = "正在播放"
		miniSubtitle.TextColor3 = COLORS.green
	elseif playState == "loading" then
		miniSubtitle.Text = "正在加载"
		miniSubtitle.TextColor3 = COLORS.amber
	elseif playState == "error" then
		miniSubtitle.Text = "检查音频设置"
		miniSubtitle.TextColor3 = COLORS.red
	else
		miniSubtitle.Text = "点按展开"
		miniSubtitle.TextColor3 = COLORS.muted
	end

	favoriteButton.Text = favorites[currentIndex] and "♥" or "♡"
	favoriteButton.TextColor3 =
		favorites[currentIndex] and COLORS.pink or COLORS.muted

	shuffleButton.TextColor3 =
		shuffleEnabled and COLORS.green or COLORS.muted

	repeatButton.TextColor3 =
		repeatMode == 0 and COLORS.muted or COLORS.green

	repeatBadge.Visible = repeatMode == 2
	speedButton.Text = formatSpeed(speeds[speedIndex])
end

local function updatePlaylistSelection()
	for index, button in pairs(trackButtons) do
		local track = TRACKS[index]

		if track and button.Parent then
			local prefix = index == currentIndex and "▶  " or "♪  "

			button.Text = prefix
				.. tostring(track.title or ("曲目 " .. index))
				.. " — "
				.. tostring(track.artist or "未知歌手")

			if index == currentIndex then
				button.BackgroundColor3 = Color3.fromRGB(49, 56, 62)
				button.BackgroundTransparency = 0.12
				button.TextColor3 = COLORS.green
			else
				button.BackgroundColor3 = COLORS.panel
				button.BackgroundTransparency = 0.35
				button.TextColor3 = COLORS.text
			end
		end
	end
end

local function rebuildPlaylist()
	for _, object in ipairs(playlistElements) do
		if object.Parent then
			object:Destroy()
		end
	end

	playlistElements = {}
	trackButtons = {}
	playlistList.CanvasPosition = Vector2.new(0, 0)

	local shownCount = 0

	for index, track in ipairs(TRACKS) do
		if not showFavoritesOnly or favorites[index] then
			shownCount += 1

			local row = makeButton(
				playlistList,
				"TrackRow" .. index,
				"",
				UDim2.new(),
				UDim2.new(1, -6, 0, 28),
				9,
				16,
				COLORS.panel,
				6
			)

			row.LayoutOrder = shownCount
			row.TextXAlignment = Enum.TextXAlignment.Left
			trackButtons[index] = row
			table.insert(playlistElements, row)

			row.Activated:Connect(function()
				playTrack(index, true)
			end)
		end
	end

	if shownCount == 0 then
		local emptyLabel = makeLabel(
			playlistList,
			"EmptyPlaylist",
			showFavoritesOnly and "还没有收藏曲目" or "播放列表为空",
			UDim2.new(),
			UDim2.new(1, -8, 0, 28),
			9,
			COLORS.muted,
			Enum.Font.Gotham,
			16
		)

		emptyLabel.LayoutOrder = 1
		table.insert(playlistElements, emptyLabel)
	end

	filterButton.Text = showFavoritesOnly and "全部" or "收藏"
	updatePlaylistSelection()
end

local function updateTrackUI()
	local track = TRACKS[currentIndex]
	if not track then
		return
	end

	trackTitle.Text = tostring(track.title or "未知曲目")
	artistLabel.Text = tostring(track.artist or "未知歌手")
	miniTitle.Text = tostring(track.title or "音乐播放器")

	applyCover(largeGlyph, largeImage, track.cover)
	applyCover(miniGlyph, miniImage, track.cover)

	updatePlaylistSelection()
	updatePlayerButtons()
end

local function updateProgress()
	local track = TRACKS[currentIndex]
	local uri = track and assetUri(track.id)

	local loadedCorrectTrack =
		uri ~= nil
		and loadedSoundId == uri
		and musicSound.IsLoaded

	local length = loadedCorrectTrack and musicSound.TimeLength or 0
	local position = loadedCorrectTrack and musicSound.TimePosition or 0

	if length ~= length or length < 0 then
		length = 0
	end

	if position ~= position or position < 0 then
		position = 0
	end

	local ratio = 0
	if length > 0 then
		ratio = math.clamp(position / length, 0, 1)
	end

	seekFill.Size = UDim2.new(ratio, 0, 1, 0)
	seekKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
	currentTimeLabel.Text = formatTime(position)
	durationLabel.Text = formatTime(length)
end

local function updateVolumeUI()
	volume = math.clamp(volume, 0, 1)
	musicSound.Volume = volume

	volumeFill.Size = UDim2.new(volume, 0, 1, 0)
	volumeKnob.Position = UDim2.new(volume, 0, 0.5, 0)
	volumePercent.Text = tostring(math.floor(volume * 100 + 0.5)) .. "%"
	muteButton.Text = volume == 0 and "×" or "♪"
end

local function failLoading(message)
	loadToken += 1
	loadBusy = false
	wantPlay = false
	loadedSoundId = nil
	playState = "error"

	pcall(function()
		musicSound:Stop()
	end)

	setStatus(message, COLORS.red)
	updatePlayerButtons()
	updateProgress()
end

local function beginLoading(uri)
	if loadBusy then
		return
	end

	loadToken += 1
	local thisToken = loadToken
	loadBusy = true
	playState = "loading"
	musicSound.Looped = repeatMode == 2

	setStatus("正在加载音频…", COLORS.amber)
	updatePlayerButtons()

	-- 超时后停止等待，避免 UI 一直卡在加载状态
	task.delay(25, function()
		if thisToken == loadToken and loadBusy then
			failLoading("加载超时：检查音频 ID / 权限")
		end
	end)

	task.spawn(function()
		local fetchStatus
		local ok, result = pcall(function()
			ContentProvider:PreloadAsync({ musicSound }, function(_, status)
				fetchStatus = status
			end)
		end)

		if thisToken ~= loadToken then
			return
		end

		if musicSound.SoundId ~= uri then
			return
		end

		local loadedDeadline = os.clock() + 4

		while ok
			and not musicSound.IsLoaded
			and os.clock() < loadedDeadline
			and thisToken == loadToken do
			task.wait(0.1)
		end

		if thisToken ~= loadToken then
			return
		end

		if not ok or not musicSound.IsLoaded then
			local reason = tostring(fetchStatus or result or "未知错误")
			failLoading("加载失败：" .. reason .. " · 检查 ID / 权限")
			return
		end

		loadBusy = false
		loadedSoundId = uri
		musicSound.Looped = repeatMode == 2
		updateProgress()

		if wantPlay then
			local played = pcall(function()
				musicSound:Play()
			end)

			if not played then
				failLoading("播放失败：请检查音频资产")
				return
			end

			playState = "playing"
			setStatus("正在播放", COLORS.green)
		else
			playState = "ready"
			setStatus("已加载 · 点击播放", COLORS.muted)
		end

		updatePlayerButtons()
	end)
end

local function startPlayback()
	local track = TRACKS[currentIndex]
	local uri = track and assetUri(track.id)

	if not uri then
		wantPlay = false
		playState = "error"
		setStatus("请填写有效音频 ID", COLORS.amber)
		updatePlayerButtons()
		return
	end

	if musicSound.SoundId ~= uri then
		loadToken += 1
		loadBusy = false
		loadedSoundId = nil

		pcall(function()
			musicSound:Stop()
		end)

		musicSound.SoundId = uri
		pcall(function()
			musicSound.TimePosition = 0
		end)
	end

	wantPlay = true
	musicSound.Looped = repeatMode == 2

	if loadBusy then
		playState = "loading"
		setStatus("正在加载音频…", COLORS.amber)
		updatePlayerButtons()
		return
	end

	if musicSound.IsLoaded and loadedSoundId == uri then
		if musicSound.TimeLength > 0
			and musicSound.TimePosition >= musicSound.TimeLength then
			pcall(function()
				musicSound.TimePosition = 0
			end)
		end

		local ok = pcall(function()
			musicSound:Play()
		end)

		if ok then
			playState = "playing"
			setStatus("正在播放", COLORS.green)
			updatePlayerButtons()
		else
			failLoading("播放失败：请检查音频资产")
		end
	else
		beginLoading(uri)
	end
end

playTrack = function(index, autoPlay)
	if #TRACKS == 0 then
		playState = "error"
		setStatus("播放列表为空", COLORS.amber)
		updatePlayerButtons()
		return
	end

	index = math.floor(tonumber(index) or 1)
	currentIndex = ((index - 1) % #TRACKS) + 1

	loadToken += 1
	loadBusy = false
	wantPlay = false
	loadedSoundId = nil

	pcall(function()
		musicSound:Stop()
	end)

	local track = TRACKS[currentIndex]
	local uri = track and assetUri(track.id)
	musicSound.SoundId = uri or ""
	musicSound.Looped = repeatMode == 2

	pcall(function()
		musicSound.TimePosition = 0
	end)

	updateTrackUI()
	updateProgress()

	if not uri then
		playState = "error"
		setStatus("此曲目没有有效音频 ID", COLORS.amber)
		updatePlayerButtons()
		return
	end

	playState = "ready"
	setStatus("已就绪 · 点击播放", COLORS.muted)
	updatePlayerButtons()

	if autoPlay then
		startPlayback()
	end
end

local function getRandomNextIndex()
	if #TRACKS <= 1 then
		return currentIndex
	end

	local nextIndex = currentIndex
	while nextIndex == currentIndex do
		nextIndex = randomGenerator:NextInteger(1, #TRACKS)
	end

	return nextIndex
end

local function nextTrack()
	if #TRACKS == 0 then
		return
	end

	if shuffleEnabled and #TRACKS > 1 then
		playTrack(getRandomNextIndex(), true)
	else
		playTrack((currentIndex % #TRACKS) + 1, true)
	end
end

local function previousTrack()
	if #TRACKS == 0 then
		return
	end

	if musicSound.IsLoaded
		and loadedSoundId == assetUri(TRACKS[currentIndex].id)
		and musicSound.TimePosition > 3 then
		pcall(function()
			musicSound.TimePosition = 0
		end)
		updateProgress()
		return
	end

	local previousIndex = currentIndex - 1
	if previousIndex < 1 then
		previousIndex = #TRACKS
	end

	playTrack(previousIndex, true)
end

local function pausePlayback()
	wantPlay = false

	if musicSound.IsPlaying then
		pcall(function()
			musicSound:Pause()
		end)
	end

	if loadBusy then
		playState = "loading"
		setStatus("正在加载（播放已暂停）", COLORS.amber)
	elseif musicSound.IsLoaded
		and loadedSoundId == assetUri(TRACKS[currentIndex].id) then
		playState = "paused"
		setStatus("已暂停", COLORS.muted)
	else
		playState = "ready"
		setStatus("已暂停", COLORS.muted)
	end

	updatePlayerButtons()
end

