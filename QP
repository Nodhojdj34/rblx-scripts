local draggingIsland = false
local dragInput
local dragStartPointer
local dragStartPosition

dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingIsland = true
		dragInput = input
		dragStartPointer = input.Position
		dragStartPosition = root.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not draggingIsland or not dragStartPointer or not dragStartPosition then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStartPointer
		local viewport = getViewportSize()
		local halfWidth = root.AbsoluteSize.X / 2
		local maxHorizontalOffset = math.max(0, (viewport.X / 2) - halfWidth - 6)

		local xOffset = dragStartPosition.X.Offset + delta.X
		local yOffset = dragStartPosition.Y.Offset + delta.Y
		xOffset = math.clamp(xOffset, -maxHorizontalOffset, maxHorizontalOffset)

		local maxVerticalOffset = math.max(6, viewport.Y - root.AbsoluteSize.Y - 8)
		yOffset = math.clamp(yOffset, 6, maxVerticalOffset)

		root.Position = UDim2.new(
			dragStartPosition.X.Scale,
			xOffset,
			dragStartPosition.Y.Scale,
			yOffset
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == dragInput
		or input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingIsland = false
		dragInput = nil
		dragStartPointer = nil
		dragStartPosition = nil
	end
end)

local deviceUpdateTimer = 0
local serverUpdateTimer = 0

RunService.Heartbeat:Connect(function(dt)
	-- 只监测本地玩家角色，不遍历或修改其他玩家角色。
	if antiFlingEnabled
		and currentCharacter
		and currentHumanoid
		and currentRoot
		and currentHumanoid.Health > 0
		and currentRoot.Parent
		and not currentRoot.Anchored
		and os.clock() - characterBoundAt > 1
	then
		local seated = currentHumanoid.SeatPart ~= nil or currentHumanoid.Sit
		if not seated then
			local linearSpeed = currentRoot.AssemblyLinearVelocity.Magnitude
			local angularSpeed = currentRoot.AssemblyAngularVelocity.Magnitude
			local angularThreshold = math.max(220, antiFlingThreshold * 1.5)

			if linearSpeed > antiFlingThreshold or angularSpeed > angularThreshold then
				pcall(function()
					currentRoot.AssemblyLinearVelocity = Vector3.zero
					currentRoot.AssemblyAngularVelocity = Vector3.zero
				end)

				if os.clock() - lastFlingNoticeAt > 1.5 then
					lastFlingNoticeAt = os.clock()
					antiFlingStatus.Text = string.format(
						"已处理本地角色异常速度（%.0f studs/s）。",
						linearSpeed
					)
				end
			end
		end
	end

	-- 刷新播放进度。
	if progressSlider and currentIndex > 0 and sound.TimeLength > 0 and not progressSlider:IsDragging() then
		local ratio = math.clamp(sound.TimePosition / sound.TimeLength, 0, 1)
		progressSlider:SetValue(ratio, false)
	end

	-- 设备信息每秒刷新；服务器玩家信息每数秒刷新。
	deviceUpdateTimer += dt
	serverUpdateTimer += dt

	if deviceUpdateTimer >= 1 then
		deviceUpdateTimer = 0
		updateDeviceInfo()
	end

	if serverUpdateTimer >= 3 then
		serverUpdateTimer = 0
		updateServerInfo()
	end
end)

