local function contrastText(color)
	local luminance =
		color.R * 0.2126
		+ color.G * 0.7152
		+ color.B * 0.0722

	if luminance > 0.58 then
		return Color3.fromRGB(20, 21, 23)
	end

	return Color3.fromRGB(245, 246, 248)
end

local function cardColor()
	local luminance =
		theme.background.R * 0.2126
		+ theme.background.G * 0.7152
		+ theme.background.B * 0.0722

	if luminance > 0.58 then
		return theme.background:Lerp(Color3.new(0, 0, 0), 0.07)
	end

	return theme.background:Lerp(Color3.new(1, 1, 1), 0.07)
end

local function colorForRole(role)
	if role == "panel" or role == "pill" then
		return theme.background
	elseif role == "card" or role == "button" or role == "input" then
		return cardColor()
	elseif role == "accent"
		or role == "accentBar"
		or role == "accentButton" then
		return theme.accent
	elseif role == "stroke" then
		return theme.background:Lerp(contrastText(theme.background), 0.26)
	end

	return theme.background
end

local function applyStyle(object, role)
	if not object then
		return
	end

	if object:IsA("UIStroke") then
		if role == "stroke" then
			object.Color = colorForRole("stroke")
		end
		return
	end

	if object:IsA("GuiObject") then
		if role == "panel"
			or role == "pill"
			or role == "card"
			or role == "button"
			or role == "input"
			or role == "accent"
			or role == "accentBar"
			or role == "accentButton" then
			object.BackgroundColor3 = colorForRole(role)
		end
	end

	if object:IsA("TextLabel")
		or object:IsA("TextButton")
		or object:IsA("TextBox") then

		if role == "muted" then
			object.TextColor3 =
				contrastText(theme.background):Lerp(theme.background, 0.36)
		elseif role == "accentText" then
			object.TextColor3 = theme.accent
		elseif role == "accentButton" then
			object.TextColor3 = contrastText(theme.accent)
		else
			object.TextColor3 = contrastText(theme.background)
		end

		if object:IsA("TextBox") then
			object.PlaceholderColor3 =
				contrastText(theme.background):Lerp(theme.background, 0.42)
		end
	end
end

local function setStyle(object, role)
	styleRegistry[object] = role
	applyStyle(object, role)
end

local function applyTheme()
	for object, role in pairs(styleRegistry) do
		if object.Parent then
			applyStyle(object, role)
		else
			styleRegistry[object] = nil
		end
	end

	for _, scroll in ipairs(scrollFrames) do
		if scroll.Parent then
			scroll.ScrollBarImageColor3 = theme.accent
		end
	end
end

local function newGui(className, parent, properties, role)
	local object = Instance.new(className)

	for key, value in pairs(properties or {}) do
