local function applyEQ(index)
	eqIndex = index
	local preset = eqPresets[eqIndex]
	equalizer.LowGain = preset.low
	equalizer.MidGain = preset.mid
	equalizer.HighGain = preset.high
	updatePlaybackButtons()
end

