local function luminance(color)
	return color.R * 0.2126 + color.G * 0.7152 + color.B * 0.0722
end

local function contrastText(color)
	if luminance(color) > 0.58 then
		return Color3.fromRGB(20, 21, 23)
	end
	return Color3.fromRGB(245, 246, 248)
end

local function cardColor()
	if luminance(theme.background) > 0.58 then
		return theme.background:Lerp(Color3.new(0, 0, 0), 0.07)
	end
	return theme.background:Lerp(Color3.new(1, 1, 1), 0.075)
end

local function colorForRole(role)
	if role == "panel" then
		return theme.background
	elseif role == "card" or role == "button" or role == "input" then
		return cardColor()
	elseif role == "island" then
		return theme.background:Lerp(theme.accent, 0.20)
	elseif role == "accent" or role == "accentBar" or role == "accentButton" then
		return theme.accent
	elseif role == "stroke" then
		return theme.background:Lerp(contrastText(theme.background), 0.28)
	end
	return theme.background
end

local function applyStyleToOne(inst, role)
	if not inst or not inst.Parent then
		return
	end

	if role == "stroke" and inst:IsA("UIStroke") then
		inst.Color = colorForRole("stroke")
		return
	end

	if inst:IsA("GuiObject") then
		if role == "panel" or role == "card" or role == "button"
			or role == "input" or role == "island" or role == "accent"
			or role == "accentBar" or role == "accentButton" then
			inst.BackgroundColor3 = colorForRole(role)
		end
	end

	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		if role == "muted" then
			inst.TextColor3 = contrastText(theme.background):Lerp(theme.background, 0.34)
		elseif role == "accentText" then
			inst.TextColor3 = theme.accent
		elseif role == "accentButton" then
			inst.TextColor3 = contrastText(theme.accent)
		else
			inst.TextColor3 = contrastText(theme.background)
		end

		if inst:IsA("TextBox") then
			inst.PlaceholderColor3 = contrastText(theme.background):Lerp(theme.background, 0.42)
		end
	end
end

local function setStyle(inst, role)
	styleRegistry[inst] = role
	applyStyleToOne(inst, role)
end

local function applyTheme()
	for inst, role in pairs(styleRegistry) do
		if inst.Parent then
			applyStyleToOne(inst, role)
		else
			styleRegistry[inst] = nil
		end
	end

	for _, scroll in ipairs(scrollFrames) do
		if scroll.Parent then
			scroll.ScrollBarImageColor3 = theme.accent
		end
	end
end

local function newGui(className, parent, properties, role)
	local inst = Instance.new(className)

	for key, value in pairs(properties or {}) do
		inst[key] = value
	end

	if role then
		setStyle(inst, role)
	end

	inst.Parent = parent
	return inst
end

local function addCorner(inst, radius)
	local corner = Instance.new("UICorner")
