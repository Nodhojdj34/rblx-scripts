local function readProperty(object, property, fallback)
	local success, value = pcall(function()
		return object[property]
	end)

	if success and value ~= nil then
		return value
	end

	return fallback
end

local function enumName(value)
	if value == nil then
		return T("info_unavailable")
	end

	local text = tostring(value)
	return text:match("%.([^%.]+)$") or text
end

local function getPingText()
	local success, result = pcall(function()
		local network = Stats:FindFirstChild("Network")
		local serverStats = network and network:FindFirstChild("ServerStatsItem")
		local pingItem = serverStats and serverStats:FindFirstChild("Data Ping")

		if pingItem then
			return pingItem:GetValueString()
		end

		return nil
	end)

	if success and result then
		return result
	end

	return T("info_unavailable")
end

local function getMemoryText()
	local success, value = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)

	if success and tonumber(value) then
		return string.format("%.1f MB", value)
	end

	return T("info_unavailable")
end

local function getGraphicsText()
	local success, settings = pcall(function()
		return UserSettings():GetService("UserGameSettings")
	end)

	if not success or not settings then
		return T("info_unavailable")
	end

	local quality = readProperty(settings, "SavedQualityLevel", nil)
	if quality ~= nil then
		return enumName(quality)
	end

	return T("info_unavailable")
end

local fpsFrameCount = 0
local fpsElapsed = 0
local fpsEstimate = 0

RunService.RenderStepped:Connect(function(dt)
	fpsFrameCount += 1
	fpsElapsed += dt

	if fpsElapsed >= 0.5 then
		if fpsElapsed > 0 then
			fpsEstimate = math.floor(fpsFrameCount / fpsElapsed + 0.5)
		end

		fpsFrameCount = 0
		fpsElapsed = 0
	end
end)

local function updateDeviceInfo()
	local platformText = T("info_unavailable")
	local platformSuccess, platform = pcall(function()
		return UserInputService:GetPlatform()
	end)

	if platformSuccess then
		platformText = enumName(platform)
	end

	deviceRows.platform.Text = platformText
	deviceRows.player.Text =
		player.DisplayName .. "  (@" .. player.Name .. ")"
	deviceRows.account.Text =
		TF("account_format", tostring(player.UserId), tostring(player.AccountAge))

	local inputs = {}

	if readProperty(UserInputService, "TouchEnabled", false) then
		table.insert(inputs, T("input_touch"))
	end
	if readProperty(UserInputService, "KeyboardEnabled", false) then
		table.insert(inputs, T("input_keyboard"))
	end
	if readProperty(UserInputService, "MouseEnabled", false) then
		table.insert(inputs, T("input_mouse"))
	end
	if readProperty(UserInputService, "GamepadEnabled", false) then
		table.insert(inputs, T("input_gamepad"))
	end

	if #inputs == 0 then
		table.insert(inputs, T("info_not_reported"))
	end

	deviceRows.input.Text = table.concat(inputs, " / ")

	local inputSuccess, lastInput = pcall(function()
		return UserInputService:GetLastInputType()
	end)

	deviceRows.lastInput.Text =
		inputSuccess and enumName(lastInput) or T("info_unavailable")

	local sensors = {}

	if readProperty(UserInputService, "AccelerometerEnabled", false) then
		table.insert(sensors, T("sensor_accel"))
	end
	if readProperty(UserInputService, "GyroscopeEnabled", false) then
		table.insert(sensors, T("sensor_gyro"))
	end

	deviceRows.sensors.Text =
		#sensors > 0 and table.concat(sensors, " / ") or T("info_not_reported")

	deviceRows.vr.Text =
		readProperty(VRService, "VREnabled", false)
		and T("vr_enabled")
		or T("vr_disabled")

	local camera = workspace.CurrentCamera

	if camera then
		local viewport = camera.ViewportSize
		local orientation =
			viewport.X >= viewport.Y
			and T("orientation_landscape")
			or T("orientation_portrait")

		deviceRows.viewport.Text = TF(
			"viewport_format",
			math.floor(viewport.X),
			math.floor(viewport.Y),
			orientation
		)

		deviceRows.camera.Text = TF(
			"camera_format",
			enumName(camera.CameraType),
			math.floor(camera.FieldOfView + 0.5)
		)
	else
		deviceRows.viewport.Text = T("info_unavailable")
		deviceRows.camera.Text = T("info_unavailable")
	end

	deviceRows.fps.Text = TF("fps_format", fpsEstimate)
	deviceRows.ping.Text = getPingText()
	deviceRows.memory.Text = getMemoryText()
	deviceRows.graphics.Text = getGraphicsText()
	deviceRows.locale.Text =
		tostring(readProperty(LocalizationService, "RobloxLocaleId", T("info_unavailable")))

	local insetSuccess, topLeft, bottomRight = pcall(function()
		return GuiService:GetGuiInset()
	end)

	if insetSuccess and topLeft and bottomRight then
		deviceRows.inset.Text = TF(
			"inset_format",
			math.floor(topLeft.X),
			math.floor(topLeft.Y),
			math.floor(bottomRight.X),
			math.floor(bottomRight.Y)
		)
	else
		deviceRows.inset.Text = T("info_unavailable")
	end

	deviceRows.runtime.Text = formatTime(os.clock() - startedAt)
	deviceRows.model.Text = T("api_unavailable")
	deviceRows.battery.Text = T("api_unavailable")
end

local function updatePlayerList()
	for _, child in ipairs(playerListScroll:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local playerList = Players:GetPlayers()
	table.sort(playerList, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	if #playerList == 0 then
		local emptyLabel = createLabel(
			playerListScroll,
			T("player_none"),
			UDim2.new(1, -4, 0, 22),
			"muted",
			{ TextSize = 10 }
		)
		emptyLabel.LayoutOrder = 1
		return
	end

	for index, listedPlayer in ipairs(playerList) do
		local teamText =
			listedPlayer.Team and (" · " .. listedPlayer.Team.Name) or ""
		local selfText =
			listedPlayer == player and T("you_suffix") or ""

		local label = createLabel(
			playerListScroll,
			TF(
				"player_line",
				listedPlayer.DisplayName,
				listedPlayer.Name,
				teamText,
				selfText
			),
			UDim2.new(1, -4, 0, 22),
			"muted",
			{
				TextSize = 10,
				TextWrapped = false,
			}
		)

		label.LayoutOrder = index
	end
end

local function updateServerInfo()
	local privateServerId =
		tostring(readProperty(game, "PrivateServerId", "") or "")
	local privateOwner =
		tonumber(readProperty(game, "PrivateServerOwnerId", 0)) or 0

	local isStudio = false
	pcall(function()
		isStudio = RunService:IsStudio()
	end)

	local serverType

	if isStudio then
		serverType = T("server_studio")
	elseif privateServerId ~= "" and privateOwner > 0 then
		serverType = T("server_vip")
	elseif privateServerId ~= "" then
		serverType = T("server_reserved")
	else
		serverType = T("server_public")
	end

	local maxPlayers = readProperty(Players, "MaxPlayers", nil)
	local maxText = maxPlayers and tostring(maxPlayers) or T("info_unavailable")
	local jobId = tostring(readProperty(game, "JobId", "") or "")

	serverRows.type.Text = serverType
	serverRows.players.Text =
		TF("server_count_format", #Players:GetPlayers(), maxText)
	serverRows.placeId.Text =
		tostring(readProperty(game, "PlaceId", T("info_unavailable")))
	serverRows.gameId.Text =
		tostring(readProperty(game, "GameId", T("info_unavailable")))
	serverRows.jobId.Text =
		jobId ~= "" and jobId or T("server_job_missing")
	serverRows.placeVersion.Text =
		tostring(readProperty(game, "PlaceVersion", T("info_unavailable")))
	serverRows.privateServerId.Text =
		privateServerId ~= "" and privateServerId or T("server_private_none")
	serverRows.privateOwner.Text = tostring(privateOwner)
	serverRows.creator.Text =
		tostring(readProperty(game, "CreatorId", T("info_unavailable")))
	serverRows.serverIp.Text = T("server_ip_unavailable")

	updatePlayerList()
end

