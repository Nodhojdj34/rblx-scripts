local function refreshAnomalyList()
	for _, child in ipairs(anomalyList:GetChildren()) do
		if child:IsA("Frame") and child.Name == "SuspiciousPlayerRow" then
			child:Destroy()
		end
	end

	if not scannerEnabled then
		scannerSummary.Text = "异常检查已关闭。"
		anomalyEmptyLabel.Text = "检查已关闭。"
		anomalyEmptyLabel.Visible = true
		return
	end

	local otherPlayerCount = math.max(#Players:GetPlayers() - 1, 0)
	local results = {}
	local now = os.clock()

	for target, state in pairs(anomalyStates) do
		if target.Parent == Players
			and state.expires
			and state.expires > now
			and #state.reasons > 0 then
			table.insert(results, {
				player = target,
				state = state,
			})
		end
	end

	table.sort(results, function(a, b)
		return a.state.lastDetected > b.state.lastDetected
	end)

	scannerSummary.Text = string.format(
		"检查其他玩家：%d 人 · 有异常迹象：%d 人",
		otherPlayerCount,
		#results
	)

	anomalyEmptyLabel.Visible = #results == 0
	if #results == 0 then
		anomalyEmptyLabel.Text = "当前没有检测到明显异常。"
	end

	local displayCount = math.min(#results, 20)

	for index = 1, displayCount do
		local result = results[index]
		local target = result.player
		local state = result.state

		local row = newGui("Frame", anomalyList, {
