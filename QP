end

local function updatePlayerButtons()
	playButton.Text = isPlaying and "Ⅱ" or "▶"

	miniSubtitle.Text = isPlaying and "NOW PLAYING" or "TAP TO OPEN"
	miniSubtitle.TextColor3 = isPlaying and COLORS.green or COLORS.muted

	local isFavorite = favorites[currentIndex] == true
	favoriteButton.Text = isFavorite and "♥" or "♡"
	favoriteButton.TextColor3 = isFavorite and COLORS.pink or COLORS.muted

	shuffleButton.TextColor3 = shuffleEnabled and COLORS.green or COLORS.muted
	repeatButton.TextColor3 = repeatMode == 0 and COLORS.muted or COLORS.green
	repeatBadge.Visible = repeatMode == 2
end

local function updateTrackUI()
	local track = TRACKS[currentIndex]
	if not track then
		return
	end

	titleLabel.Text = track.title or "未知曲目"
	artistLabel.Text = track.artist or "未知歌手"
	miniTitle.Text = track.title or "音乐播放器"

	local coverUri = toAssetUri(track.cover)
	if coverUri then
		largeCoverImage.Image = coverUri
		largeCoverImage.Visible = true
		largeGlyph.Visible = false

		miniCoverImage.Image = coverUri
		miniCoverImage.Visible = true
		miniGlyph.Visible = false
	else
		largeCoverImage.Image = ""
		largeCoverImage.Visible = false
		largeGlyph.Visible = true

		miniCoverImage.Image = ""
		miniCoverImage.Visible = false
		miniGlyph.Visible = true
	end

	updatePlayerButtons()
end

local function formatTime(seconds)
	if not seconds or seconds ~= seconds or seconds < 0 then
		seconds = 0
	end

	seconds = math.floor(seconds)
	local minutes = math.floor(seconds / 60)
	local remainingSeconds = seconds % 60

	return string.format("%d:%02d", minutes, remainingSeconds)
end

local function refreshProgress()
	local length = musicSound.TimeLength
	local position = musicSound.TimePosition

	if not length or length ~= length or length <= 0 then
		length = 0
	end

	if not position or position ~= position or position < 0 then
		position = 0
	end

	local ratio = 0
	if length > 0 then
		ratio = math.clamp(position / length, 0, 1)
	end

	seekFill.Size = UDim2.new(ratio, 0, 1, 0)
	seekDot.Position = UDim2.new(ratio, 0, 0.5, 0)
	currentTimeLabel.Text = formatTime(position)
	durationLabel.Text = formatTime(length)
end

local function updateVolumeUI()
	volume = math.clamp(volume, 0, 1)
	musicSound.Volume = volume

	volumeFill.Size = UDim2.new(volume, 0, 1, 0)
	volumeKnob.Position = UDim2.new(volume, 0, 0.5, 0)
	volumePercent.Text = tostring(math.floor(volume * 100 + 0.5)) .. "%"
	muteButton.Text = volume <= 0 and "×" or "♪"
end

local function watchLoading(token)
	task.spawn(function()
		local deadline = os.clock() + 12

		while gui.Parent
			and token == loadToken
			and not musicSound.IsLoaded
			and os.clock() < deadline do
			task.wait(0.15)
		end

		if not gui.Parent or token ~= loadToken then
			return
		end

		if musicSound.IsLoaded then
			if isPlaying then
				setStatus("正在播放", COLORS.green)
			else
				setStatus("已暂停", COLORS.muted)
			end
		else
			isPlaying = false
			hasStarted = false
			pcall(function()
				musicSound:Stop()
			end)
			updatePlayerButtons()
			setStatus("加载失败：检查音频 ID / 权限", COLORS.red)
		end
	end)
end

local function startPlayback()
	local track = TRACKS[currentIndex]
	local audioUri = track and toAssetUri(track.id)

	if not audioUri then
		isPlaying = false
		updatePlayerButtons()
		setStatus("请先配置可用的 Roblox 音频 ID", COLORS.amber)
		return
	end

	if musicSound.SoundId ~= audioUri then
		musicSound.SoundId = audioUri
		hasStarted = false
	end

	if musicSound.IsLoaded
		and musicSound.TimeLength > 0
		and musicSound.TimePosition >= musicSound.TimeLength then
		pcall(function()
			musicSound.TimePosition = 0
		end)
		hasStarted = false
	end

	local ok = true

	if hasStarted then
		ok = pcall(function()
			musicSound:Resume()
		end)

		if not ok then
			ok = pcall(function()
				musicSound:Play()
			end)
		end
	else
		ok = pcall(function()
			musicSound:Play()
		end)
		hasStarted = ok
	end

	if not ok then
		isPlaying = false
		updatePlayerButtons()
		setStatus("无法播放：检查音频资产权限", COLORS.red)
		return
	end

	isPlaying = true
	updatePlayerButtons()

	if musicSound.IsLoaded then
		setStatus("正在播放", COLORS.green)
	else
		setStatus("正在加载音频…", COLORS.amber)
	end

	watchLoading(loadToken)
end

local function pausePlayback()
	if not isPlaying then
		return
	end

	pcall(function()
		musicSound:Pause()
	end)

	isPlaying = false
	updatePlayerButtons()
	setStatus("已暂停", COLORS.muted)
end

local function playTrack(index, autoPlay)
	if #TRACKS == 0 then
		return
	end

	currentIndex = ((index - 1) % #TRACKS) + 1
	loadToken += 1

	isPlaying = false
	hasStarted = false

	pcall(function()
		musicSound:Stop()
	end)

	local track = TRACKS[currentIndex]
	local audioUri = track and toAssetUri(track.id)

	musicSound.SoundId = audioUri or ""
	pcall(function()
		musicSound.TimePosition = 0
	end)

	updateTrackUI()
	refreshProgress()

	if not audioUri then
		setStatus("请先配置可用的 Roblox 音频 ID", COLORS.amber)
		return
	end

	setStatus("已就绪 · 点击播放", COLORS.muted)

	if autoPlay then
		startPlayback()
	end
end

local function getRandomNextIndex()
	if #TRACKS <= 1 then
		return currentIndex
	end

	local nextIndex = currentIndex
	while nextIndex == currentIndex do
		nextIndex = randomGenerator:NextInteger(1, #TRACKS)
	end

	return nextIndex
end

local function nextTrack()
	if shuffleEnabled then
		playTrack(getRandomNextIndex(), true)
	else
		playTrack((currentIndex % #TRACKS) + 1, true)
	end
end

local function previousTrack()
	if musicSound.TimeLength > 0 and musicSound.TimePosition > 3 then
		pcall(function()
			musicSound.TimePosition = 0
		end)
		refreshProgress()
		setStatus(isPlaying and "正在播放" or "已暂停", isPlaying and COLORS.green or COLORS.muted)
		return
	end

	local previousIndex = currentIndex - 1
	if previousIndex < 1 then
		previousIndex = #TRACKS
	end

	playTrack(previousIndex, true)
end

-- 点击 / 触摸展开与收起
local activeTween
local expansionToken = 0

local function setExpanded(value)
	if isExpanded == value then
		return
	end

	isExpanded = value
	expansionToken += 1
	local token = expansionToken

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if value then
		compact.Visible = false
		expanded.Visible = true
	end

	local targetSize = value and OPEN_SIZE or CLOSED_SIZE
	local tween = TweenService:Create(
		island,
		TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = targetSize }
	)

	activeTween = tween

	tween.Completed:Connect(function(playbackState)
		if token ~= expansionToken or playbackState ~= Enum.PlaybackState.Completed then
			return
		end

		activeTween = nil

		if not value then
			expanded.Visible = false
			compact.Visible = true
		end
	end)

	tween:Play()
end

compactHit.Activated:Connect(function()
	setExpanded(true)
end)

closeButton.Activated:Connect(function()
	setExpanded(false)
end)

-- 播放控制
playButton.Activated:Connect(function()
	if isPlaying then
		pausePlayback()
	else
		startPlayback()
	end
end)

previousButton.Activated:Connect(previousTrack)
nextButton.Activated:Connect(nextTrack)

shuffleButton.Activated:Connect(function()
	shuffleEnabled = not shuffleEnabled
	updatePlayerButtons()
	setStatus(
		shuffleEnabled and "随机播放已开启" or "随机播放已关闭",
		shuffleEnabled and COLORS.green or COLORS.muted
	)
end)

repeatButton.Activated:Connect(function()
	repeatMode = (repeatMode + 1) % 3
	updatePlayerButtons()

	if repeatMode == 0 then
		setStatus("循环已关闭", COLORS.muted)
	elseif repeatMode == 1 then
		setStatus("列表循环已开启", COLORS.green)
	else
		setStatus("单曲循环已开启", COLORS.green)
	end
end)

favoriteButton.Activated:Connect(function()
