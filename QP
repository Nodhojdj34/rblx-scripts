dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingPill = true
		pillDragInput = input
		pillDragStartPointer = Vector2.new(
			input.Position.X,
			input.Position.Y
		)
		pillDragStartX = pillOffsetX
		pillDragStartY = pillOffsetY
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not draggingPill or not pillDragStartPointer then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local pointer = Vector2.new(input.Position.X, input.Position.Y)
		local delta = pointer - pillDragStartPointer
		local viewport = getViewportSize()
		local pillWidth = pill.AbsoluteSize.X
		local pillHeight = pill.AbsoluteSize.Y
		local maxX = math.max(0, viewport.X / 2 - pillWidth / 2 - 4)
		local maxY = math.max(4, viewport.Y - pillHeight - 8)

		pillOffsetX = math.clamp(pillDragStartX + delta.X, -maxX, maxX)
		pillOffsetY = math.clamp(pillDragStartY + delta.Y, 4, maxY)
		pill.Position = UDim2.new(0.5, pillOffsetX, 0, pillOffsetY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == pillDragInput
		or input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingPill = false
		pillDragInput = nil
		pillDragStartPointer = nil
	end
end)

