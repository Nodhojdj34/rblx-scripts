-- 展开与收起
local isExpanded = false
local activeTween
local expansionGeneration = 0

local function setExpanded(value)
	if isExpanded == value then
		return
	end

	isExpanded = value
	expansionGeneration += 1
	local thisGeneration = expansionGeneration

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if value then
		compact.Visible = false
		expanded.Visible = true
		compactHit.Visible = false
	end

	local tween = TweenService:Create(
		island,
		TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = value and OPEN_SIZE or CLOSED_SIZE }
	)

	activeTween = tween

	tween.Completed:Connect(function(state)
		if thisGeneration ~= expansionGeneration
			or state ~= Enum.PlaybackState.Completed then
			return
		end

		activeTween = nil

		if not value then
			expanded.Visible = false
			compact.Visible = true
			compactHit.Visible = true
		end
	end)

	tween:Play()
end

compactHit.Activated:Connect(function()
	setExpanded(true)
end)

closeButton.Activated:Connect(function()
	setExpanded(false)
end)

-- 拖动顶部横条移动灵动岛
local draggingIsland = false
local dragStartPointer
local dragStartLeft
local dragStartTop

dragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingIsland = true
		dragStartPointer = Vector2.new(input.Position.X, input.Position.Y)
		dragStartLeft = island.AbsolutePosition.X
		dragStartTop = island.AbsolutePosition.Y
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not draggingIsland
		or not dragStartPointer
		or dragStartLeft == nil
		or dragStartTop == nil then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local pointer = Vector2.new(input.Position.X, input.Position.Y)
	local delta = pointer - dragStartPointer
	local viewport = camera.ViewportSize
	local width = island.AbsoluteSize.X
	local height = island.AbsoluteSize.Y

	local left = math.clamp(
		dragStartLeft + delta.X,
		5,
		math.max(5, viewport.X - width - 5)
	)

	local top = math.clamp(
		dragStartTop + delta.Y,
		5,
		math.max(5, viewport.Y - height - 5)
	)

	island.Position = UDim2.fromOffset(left + width / 2, top)
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingIsland = false
	end
end)

-- 当前客户端设备性能信息
local fpsFrames = 0
local fpsValue = 0
local fpsWindowStart = os.clock()

RunService.RenderStepped:Connect(function()
	fpsFrames += 1
	local now = os.clock()

	if now - fpsWindowStart >= 1 then
		fpsValue = math.floor(fpsFrames / (now - fpsWindowStart) + 0.5)
		fpsFrames = 0
		fpsWindowStart = now
	end
end)

local function readPingText()
	local ok, value = pcall(function()
		local network = Stats:FindFirstChild("Network")
		if not network then
			return nil
		end

		local serverStats = network:FindFirstChild("ServerStatsItem")
		if not serverStats then
			return nil
		end

		local pingItem = serverStats:FindFirstChild("Data Ping")
		if not pingItem then
			return nil
		end

		return pingItem:GetValue()
	end)

	if ok and tonumber(value) then
		return string.format("%.0f ms", tonumber(value))
	end

	return "不可读取"
end

local function readMemoryText()
	local ok, value = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)

	if ok and tonumber(value) then
		return string.format("%.0f MB", tonumber(value))
	end

	return "不可读取"
end

local function safeRead(callback, fallback)
	local ok, value = pcall(callback)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function refreshDeviceInfo()
	local camera = Workspace.CurrentCamera
	local viewportText = "不可读取"

	if camera then
		local size = camera.ViewportSize
		viewportText = string.format(
			"%d × %d 游戏视口",
			math.floor(size.X),
			math.floor(size.Y)
		)
	end

	local platform = safeRead(function()
		return tostring(UserInputService:GetPlatform())
	end, "未知")

	platform = platform:gsub("^Enum%.Platform%.", "")

	local touch = safeRead(function()
		return UserInputService.TouchEnabled
	end, false)

	local keyboard = safeRead(function()
		return UserInputService.KeyboardEnabled
	end, false)

	local mouse = safeRead(function()
		return UserInputService.MouseEnabled
	end, false)

	local gamepad = safeRead(function()
		return UserInputService.GamepadEnabled
	end, false)

	local lowerPlatform = string.lower(platform)
	local deviceType

	if string.find(lowerPlatform, "android", 1, true)
		or string.find(lowerPlatform, "ios", 1, true) then
		deviceType = "手机 / 平板"
	elseif keyboard and (mouse or gamepad) then
		deviceType = "电脑 / 主机"
	elseif touch then
		deviceType = "触摸设备"
	else
		deviceType = "未知设备类型"
	end

	local inputMethods = {}

	if touch then
		table.insert(inputMethods, "触摸")
	end
	if keyboard then
		table.insert(inputMethods, "键盘")
	end
	if mouse then
		table.insert(inputMethods, "鼠标")
	end
	if gamepad then
		table.insert(inputMethods, "手柄")
	end

	if #inputMethods == 0 then
		table.insert(inputMethods, "不可读取")
	end

	local fpsText = fpsValue > 0
		and (tostring(fpsValue) .. " FPS")
		or "测量中"

	deviceInfo.Text =
		"设备类别：" .. deviceType
		.. "\n平台：" .. platform
		.. "\n帧率估算：" .. fpsText
		.. "\n网络 Ping：" .. readPingText()
		.. "\nRoblox 客户端内存：" .. readMemoryText()
		.. "\n屏幕：" .. viewportText
		.. "\n输入方式：" .. table.concat(inputMethods, " / ")
		.. "\n本地面板运行：" .. formatDuration(os.clock() - clientStartedAt)
end

-- 当前服务器和玩家列表
local function refreshServerInfo()
	local currentPlayers = Players:GetPlayers()

	table.sort(currentPlayers, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	local present = {}

	for order, player in ipairs(currentPlayers) do
		local key = tostring(player.UserId)
		present[key] = true

		local entry = rosterRows[key]

		if not entry then
			local row = makeFrame(
				roster,
				"PlayerRow_" .. key,
				UDim2.new(1, -6, 0, 27),
				UDim2.new(),
				COLORS.panelLight,
				6,
				20
			)
			row.BackgroundTransparency = 0.25

			local label = makeLabel(
				row,
				"PlayerInfo",
				"",
				UDim2.new(0, 8, 0, 0),
				UDim2.new(1, -16, 1, 0),
				9,
				COLORS.text,
				Enum.Font.Gotham,
				21
			)

			entry = {
				frame = row,
				label = label,
			}
			rosterRows[key] = entry
		end

		entry.frame.LayoutOrder = order

		local name = player.DisplayName
		if player.DisplayName ~= player.Name then
			name = name .. " (@" .. player.Name .. ")"
		else
			name = "@" .. player.Name
		end

		if player == Players.LocalPlayer then
			name = "你 · " .. name
		end

		local teamName = player.Team and player.Team.Name or "无队伍"
		entry.label.Text = name .. " · " .. teamName
	end

	for key, entry in pairs(rosterRows) do
		if not present[key] then
			entry.frame:Destroy()
			rosterRows[key] = nil
		end
	end

	local maxPlayers = safeRead(function()
		return Players.MaxPlayers
	end, "未知")

	local placeId = safeRead(function()
		return game.PlaceId
	end, "未知")

	local gameId = safeRead(function()
		return game.GameId
	end, "未知")

	local placeVersion = safeRead(function()
		return game.PlaceVersion
	end, "未知")

	local jobId = safeRead(function()
		return game.JobId
	end, "")

	local privateServerId = safeRead(function()
		return game.PrivateServerId
	end, "")

	local ownerId = safeRead(function()
		return game.PrivateServerOwnerId
	end, 0)

	local isStudio = safeRead(function()
		return RunService:IsStudio()
	end, false)

	local serverType

	if isStudio then
		serverType = "Studio"
	elseif tonumber(ownerId) and tonumber(ownerId) > 0 then
		serverType = "私人服务器"
	elseif privateServerId ~= "" then
		serverType = "预留服务器"
	else
		serverType = "公开服务器"
	end

	if jobId == "" then
		jobId = "客户端不可读取"
	end

	serverSummary.Text =
		"类型：" .. tostring(serverType)
		.. "\n人数：" .. tostring(#currentPlayers) .. " / " .. tostring(maxPlayers)
		.. "\nPlaceId：" .. tostring(placeId)
		.. "\nGameId：" .. tostring(gameId)
		.. "\nJobId：" .. tostring(jobId)
		.. "\n版本：" .. tostring(placeVersion)

	playerListTitle.Text = "当前玩家（" .. tostring(#currentPlayers) .. "）"
end

