local function setDeviceRow(key, value)
	if deviceRows[key] then
		deviceRows[key].Text = tostring(value)
	end
end

local function readProperty(object, property, fallback)
	local ok, value = pcall(function()
		return object[property]
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function enumName(value)
	if value == nil then
		return "不可用"
	end
	local text = tostring(value)
	return text:match("%.([^%.]+)$") or text
end

local fpsFrameCount = 0
local fpsElapsed = 0
local fpsEstimate = 0

RunService.RenderStepped:Connect(function(dt)
	fpsFrameCount += 1
	fpsElapsed += dt

	if fpsElapsed >= 0.5 then
		if fpsElapsed > 0 then
			fpsEstimate = math.floor((fpsFrameCount / fpsElapsed) + 0.5)
		end
		fpsFrameCount = 0
		fpsElapsed = 0
	end
end)

local function getPingText()
	local ok, result = pcall(function()
		local network = Stats:FindFirstChild("Network")
		if not network then
			return nil
		end

		local serverStats = network:FindFirstChild("ServerStatsItem")
		if not serverStats then
			return nil
		end

		local pingItem = serverStats:FindFirstChild("Data Ping")
		if not pingItem then
			return nil
		end

		return pingItem:GetValueString()
	end)

	if ok and result then
		return result
	end
	return "客户端未提供"
end

local function getMemoryText()
	local ok, value = pcall(function()
		return Stats:GetTotalMemoryUsageMb()
	end)

	if ok and tonumber(value) then
		return string.format("%.1f MB", value)
	end
	return "客户端未提供"
end

local function getGraphicsText()
	local ok, settings = pcall(function()
		return UserSettings():GetService("UserGameSettings")
	end)

	if not ok or not settings then
		return "客户端未提供"
	end

	local quality = readProperty(settings, "SavedQualityLevel", nil)
	if quality ~= nil then
		return enumName(quality)
	end

	return "客户端未提供"
end

local function updateDeviceInfo()
	local platformValue = "不可用"
	local platformOk, platformResult = pcall(function()
		return UserInputService:GetPlatform()
	end)
	if platformOk then
		platformValue = enumName(platformResult)
	end

	setDeviceRow("platform", platformValue)
	setDeviceRow("player", player.DisplayName .. "  (@" .. player.Name .. ")")
	setDeviceRow("account", tostring(player.UserId) .. " / " .. tostring(player.AccountAge) .. " 天")

	local inputModes = {}
	if readProperty(UserInputService, "TouchEnabled", false) then
		table.insert(inputModes, "触屏")
	end
	if readProperty(UserInputService, "KeyboardEnabled", false) then
		table.insert(inputModes, "键盘")
	end
	if readProperty(UserInputService, "MouseEnabled", false) then
		table.insert(inputModes, "鼠标")
	end
	if readProperty(UserInputService, "GamepadEnabled", false) then
		table.insert(inputModes, "手柄")
	end
	if #inputModes == 0 then
		table.insert(inputModes, "未报告")
	end
	setDeviceRow("input", table.concat(inputModes, " / "))

	local lastInputOk, lastInput = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	setDeviceRow("lastInput", lastInputOk and enumName(lastInput) or "不可用")

	local sensors = {}
	if readProperty(UserInputService, "AccelerometerEnabled", false) then
		table.insert(sensors, "加速度计")
	end
	if readProperty(UserInputService, "GyroscopeEnabled", false) then
		table.insert(sensors, "陀螺仪")
	end
	setDeviceRow("sensors", #sensors > 0 and table.concat(sensors, " / ") or "未报告 / 不可用")

	local vrEnabled = readProperty(VRService, "VREnabled", false)
	setDeviceRow("vr", vrEnabled and "已启用" or "未启用")

	local camera = workspace.CurrentCamera
	if camera then
		local viewport = camera.ViewportSize
		local orientation = viewport.X >= viewport.Y and "横向" or "纵向"
		setDeviceRow(
			"viewport",
			string.format("%d × %d px · %s", math.floor(viewport.X), math.floor(viewport.Y), orientation)
		)
		setDeviceRow(
			"camera",
			enumName(camera.CameraType) .. " · FOV " .. tostring(math.floor(camera.FieldOfView + 0.5)) .. "°"
		)
	else
		setDeviceRow("viewport", "不可用")
		setDeviceRow("camera", "不可用")
	end

	setDeviceRow("fps", tostring(fpsEstimate) .. " FPS（估算）")
	setDeviceRow("ping", getPingText())
	setDeviceRow("memory", getMemoryText())
	setDeviceRow("graphics", getGraphicsText())

	local locale = readProperty(LocalizationService, "RobloxLocaleId", "不可用")
	setDeviceRow("locale", locale)

	local insetOk, topLeft, bottomRight = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if insetOk and topLeft and bottomRight then
		setDeviceRow(
			"inset",
			string.format(
				"左上 (%d,%d) · 右下 (%d,%d)",
				math.floor(topLeft.X),
				math.floor(topLeft.Y),
				math.floor(bottomRight.X),
				math.floor(bottomRight.Y)
			)
		)
	else
		setDeviceRow("inset", "客户端未提供")
	end

	local elapsed = math.floor(os.clock() - scriptStartedAt)
	setDeviceRow("runtime", formatTime(elapsed))
end

