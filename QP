local function safeRead(callback, fallback)
	local ok, value = pcall(callback)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function readPing()
	local ok, result = pcall(function()
		local network = Stats:FindFirstChild("Network")
		local item = network and network:FindFirstChild("Data Ping", true)

		if not item then
			return nil
		end

		local value = item:GetValue()
		if type(value) == "number" then
			return string.format("%.0f ms", value)
		end

		return item:GetValueString()
	end)

	if ok and result then
		return tostring(result)
	end

	return "不可读取"
end

local function readMemoryTag(tagName)
	local ok, value = pcall(function()
		local tag = Enum.DeveloperMemoryTag[tagName]
		return Stats:GetMemoryUsageMbForTag(tag)
	end)

	if ok and tonumber(value) then
		return string.format("%.0f MB", tonumber(value))
	end

	return "不可读取"
end

local function readQualitySetting()
	local quality = safeRead(function()
		local settings = UserSettings():GetService("UserGameSettings")
		return tostring(settings.SavedQualityLevel)
	end, "不可读取")

	return tostring(quality):gsub("Enum%.SavedQualitySetting%.", "")
end

