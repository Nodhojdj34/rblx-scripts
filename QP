task.spawn(function()
	while gui.Parent do
		refreshProgress()

		local now = os.clock()
		for i, bar in ipairs(miniWaveBars) do
			local height = 3

			if isPlaying then
				height = 4 + math.floor((math.sin(now * 8 + i * 1.3) + 1) * 5)
			end

			bar.Size = UDim2.fromOffset(3, height)
		end

		task.wait(0.08)
	end
end)
