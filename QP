muteButton.Activated:Connect(function()
	if volume > 0 then
		lastNonZeroVolume = volume
		volume = 0
	else
		volume = lastNonZeroVolume > 0 and lastNonZeroVolume or 0.65
	end

	updateVolumeUI()
end)

musicSound.Ended:Connect(function()
	if not wantPlay or playState ~= "playing" then
		return
	end

	if repeatMode == 2 then
		pcall(function()
			musicSound.TimePosition = 0
			musicSound:Play()
		end)
		return
	end

	wantPlay = false
	playState = "ready"

	if shuffleEnabled and #TRACKS > 1 then
		playTrack(getRandomNextIndex(), true)
	elseif currentIndex < #TRACKS then
		playTrack(currentIndex + 1, true)
	elseif repeatMode == 1 then
		playTrack(1, true)
	else
		pcall(function()
			musicSound.TimePosition = 0
		end)
		setStatus("播放结束", COLORS.muted)
		updatePlayerButtons()
		updateProgress()
	end
end)

-- 进度条与音量条：鼠标点击、触摸和拖动
local dragTarget = nil

local function applySlider(slider, pointerX)
	if not slider or not pointerX then
		return
	end

	local width = slider.AbsoluteSize.X
	if width <= 0 then
		return
	end

	local ratio = math.clamp(
		(pointerX - slider.AbsolutePosition.X) / width,
		0,
		1
	)

	if slider == seekHit then
		local track = TRACKS[currentIndex]
		local uri = track and assetUri(track.id)

		if musicSound.IsLoaded
			and uri
			and loadedSoundId == uri
			and musicSound.TimeLength > 0 then
			pcall(function()
				musicSound.TimePosition = ratio * musicSound.TimeLength
			end)
			updateProgress()
		end
	elseif slider == volumeHit then
		volume = ratio
		if volume > 0 then
			lastNonZeroVolume = volume
		end
		updateVolumeUI()
	end
end

local function bindSlider(slider)
	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragTarget = slider
			applySlider(slider, input.Position.X)
		end
	end)
end

bindSlider(seekHit)
bindSlider(volumeHit)

UserInputService.InputChanged:Connect(function(input)
	if dragTarget
		and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
		applySlider(dragTarget, input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragTarget = nil
	end
end)

-- 展开 / 收起动画
local isExpanded = false
local activeTween
local expansionToken = 0

local function setExpanded(value)
	if isExpanded == value then
		return
	end

	isExpanded = value
	expansionToken += 1
	local thisToken = expansionToken

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if value then
		compact.Visible = false
		expanded.Visible = true
		compactHit.Visible = false
	end

	local tween = TweenService:Create(
		island,
		TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = value and OPEN_SIZE or CLOSED_SIZE }
	)

	activeTween = tween

	tween.Completed:Connect(function(state)
		if thisToken ~= expansionToken
			or state ~= Enum.PlaybackState.Completed then
			return
		end

		activeTween = nil

		if not value then
			expanded.Visible = false
			compact.Visible = true
			compactHit.Visible = true
		end
	end)

	tween:Play()
end

compactHit.Activated:Connect(function()
	setExpanded(true)
end)

closeButton.Activated:Connect(function()
	setExpanded(false)
end)

-- 服务器信息：只读取当前客户端能看到的信息
local function safeRead(callback, fallback)
	local ok, value = pcall(callback)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function updateRoster()
	local playerList = Players:GetPlayers()

	table.sort(playerList, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	local present = {}

	for order, player in ipairs(playerList) do
		local key = tostring(player.UserId)
		present[key] = true

		local entry = rosterRows[key]

		if not entry then
			local row = makeFrame(
				roster,
				"PlayerRow_" .. key,
				UDim2.new(1, -6, 0, 27),
				UDim2.new(),
				Color3.fromRGB(40, 43, 50),
				6,
				16
			)
			row.BackgroundTransparency = 0.25

			local label = makeLabel(
				row,
				"PlayerInfo",
				"",
				UDim2.new(0, 8, 0, 0),
				UDim2.new(1, -16, 1, 0),
				9,
				COLORS.text,
				Enum.Font.Gotham,
				17
			)

			entry = {
				frame = row,
				label = label,
			}
			rosterRows[key] = entry
		end

		entry.frame.LayoutOrder = order

		local nameText = player.DisplayName
		if player.DisplayName ~= player.Name then
			nameText = nameText .. " (@" .. player.Name .. ")"
		else
			nameText = "@" .. player.Name
		end

		if player == Players.LocalPlayer then
			nameText = "你 · " .. nameText
		end

		local teamName = player.Team and player.Team.Name or "无队伍"
		entry.label.Text = nameText .. " · " .. teamName
	end

	for key, entry in pairs(rosterRows) do
		if not present[key] then
			entry.frame:Destroy()
			rosterRows[key] = nil
		end
	end

	return #playerList
end

local function refreshServerInfo()
	local playerCount = updateRoster()

	local maxPlayers = safeRead(function()
		return Players.MaxPlayers
	end, "未知")

	local placeId = safeRead(function()
		return game.PlaceId
	end, "未知")

	local gameId = safeRead(function()
		return game.GameId
	end, "未知")

	local placeVersion = safeRead(function()
		return game.PlaceVersion
	end, "未知")

	local jobId = safeRead(function()
		return game.JobId
	end, "")

	local privateServerId = safeRead(function()
		return game.PrivateServerId
	end, "")

	local ownerId = safeRead(function()
		return game.PrivateServerOwnerId
	end, 0)

	local isStudio = safeRead(function()
		return RunService:IsStudio()
	end, false)

	local serverType

	if isStudio then
		serverType = "Studio"
	elseif tonumber(ownerId) and tonumber(ownerId) > 0 then
		serverType = "私人服务器"
	elseif privateServerId ~= "" then
		serverType = "预留服务器"
	else
		serverType = "公开服务器"
	end

	if jobId == "" then
		jobId = isStudio and "Studio / 未分配" or "客户端不可读取"
	end

	serverSummary.Text =
		"类型：" .. tostring(serverType)
		.. "\n人数：" .. tostring(playerCount) .. " / " .. tostring(maxPlayers)
		.. "\nPlaceId：" .. tostring(placeId)
		.. "\nGameId：" .. tostring(gameId)
		.. "\n实例 JobId：" .. tostring(jobId)
		.. "\n版本：" .. tostring(placeVersion)
		.. "\n面板运行时间：" .. formatDuration(os.clock() - clientStartedAt)
		.. "\n服务器启动时间：单 LocalScript 无法读取"

	playerListTitle.Text = "玩家列表（" .. tostring(playerCount) .. "）"
end

local function showPage(pageName)
	local showMusic = pageName == "music"

	musicPage.Visible = showMusic
	serverPage.Visible = not showMusic

	musicTab.BackgroundColor3 = showMusic and COLORS.green or COLORS.panel
	musicTab.TextColor3 = showMusic and COLORS.black or COLORS.muted

	serverTab.BackgroundColor3 = showMusic and COLORS.panel or COLORS.green
	serverTab.TextColor3 = showMusic and COLORS.muted or COLORS.black

	if not showMusic then
		refreshServerInfo()
	end
end

musicTab.Activated:Connect(function()
	showPage("music")
end)

serverTab.Activated:Connect(function()
	showPage("server")
end)

refreshButton.Activated:Connect(refreshServerInfo)

Players.PlayerAdded:Connect(function()
	task.defer(refreshServerInfo)
end)

Players.PlayerRemoving:Connect(function()
	task.defer(refreshServerInfo)
end)

