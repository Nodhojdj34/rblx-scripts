-- 定时刷新玩家列表和进度条
task.spawn(function()
	local lastServerRefresh = 0

	while gui.Parent do
		updateProgress()

		local now = os.clock()

		for index, bar in ipairs(miniWaveBars) do
			local height = 3

			if playState == "playing" then
				height = 4 + math.floor(
					(math.sin(now * 8 + index * 1.3) + 1) * 5
				)
			end

			bar.Size = UDim2.fromOffset(3, height)
		end

		if now - lastServerRefresh >= 5 then
			lastServerRefresh = now
			refreshServerInfo()
		end

		task.wait(0.1)
	end
end)
