local function formatTime(seconds)
	seconds = tonumber(seconds) or 0
	if seconds < 0 or seconds ~= seconds then
		seconds = 0
	end

	seconds = math.floor(seconds)
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

