local function applyScreenPreset(presetKey)
	local brightness = 0
	local contrast = 0
	local saturation = 0
	local tint = Color3.new(1, 1, 1)
	local enabled = true

	if presetKey == "screen_default" then
		enabled = false
	elseif presetKey == "screen_warm" then
		brightness = 0.02
		contrast = 0.04
		saturation = 0.10
		tint = Color3.fromRGB(255, 235, 218)
	elseif presetKey == "screen_cool" then
		brightness = 0.01
		contrast = 0.04
		saturation = 0.06
		tint = Color3.fromRGB(218, 235, 255)
	elseif presetKey == "screen_mono" then
		saturation = -1
	elseif presetKey == "screen_contrast" then
		contrast = 0.22
		saturation = 0.12
	end

	colorEffect.Brightness = brightness
	colorEffect.Contrast = contrast
	colorEffect.Saturation = saturation
	colorEffect.TintColor = tint
	colorEffect.Enabled = enabled

	blurEffect.Size = 0
	blurEffect.Enabled = false

	brightnessSlider:SetValue(brightness, false)
	contrastSlider:SetValue(contrast, false)
	saturationSlider:SetValue(saturation, false)
	blurSlider:SetValue(0, false)

	if presetKey == "screen_default" then
		screenStatusType = "off"
		activeScreenPresetKey = nil
	else
		screenStatusType = "preset"
		activeScreenPresetKey = presetKey
	end

	refreshScreenStatus()
end

