local function failLoading(message)
	loadGeneration += 1
	loadBusy = false
	wantPlay = false
	loadedUri = nil
	playState = "error"

	pcall(function()
		musicSound:Stop()
	end)

	setStatus(message, COLORS.red)
	updatePlayerButtons()
	updateProgress()
end

local function beginLoading(uri)
	loadGeneration += 1
	local thisGeneration = loadGeneration

	loadBusy = true
	wantPlay = true
	loadedUri = nil
	playState = "loading"

	pcall(function()
		musicSound:Stop()
		musicSound.SoundId = uri
		musicSound.TimePosition = 0
		musicSound.Looped = repeatMode == 2
		musicSound.PlaybackSpeed = speeds[speedIndex]
	end)

	setStatus("正在加载音频…", COLORS.amber)
	updatePlayerButtons()
	updateProgress()

	-- 避免失效 ID 永远卡在“加载中”
	task.delay(20, function()
		if thisGeneration == loadGeneration and loadBusy then
			failLoading("加载超时：检查音频 ID / 使用权限")
		end
	end)

	task.spawn(function()
		local fetchStatus = nil

		local ok, err = pcall(function()
			ContentProvider:PreloadAsync({ musicSound }, function(_, status)
				fetchStatus = tostring(status)
			end)
		end)

		if thisGeneration ~= loadGeneration then
			return
		end

		local deadline = os.clock() + 4

		while ok
			and not musicSound.IsLoaded
			and os.clock() < deadline
			and thisGeneration == loadGeneration do
			task.wait(0.1)
		end

		if thisGeneration ~= loadGeneration then
			return
		end

		if not ok or not musicSound.IsLoaded then
			local detail = fetchStatus or tostring(err or "未知错误")
			failLoading("加载失败：" .. detail .. "；检查 ID / 权限")
			return
		end

		loadBusy = false
		loadedUri = uri
		musicSound.Looped = repeatMode == 2
		musicSound.PlaybackSpeed = speeds[speedIndex]

		if wantPlay then
			local played = pcall(function()
				musicSound:Play()
			end)

			if not played then
				failLoading("播放失败：请检查音频资产")
				return
			end

			playState = "playing"
			setStatus("正在播放", COLORS.green)
		else
			playState = "ready"
			setStatus("已加载，点击播放", COLORS.muted)
		end

		updatePlayerButtons()
		updateProgress()
	end)
end

local function startPlayback()
	local track = currentTrack()
	local uri = track and getAssetUri(track.id)

	if not uri then
		wantPlay = false
		playState = "error"
		setStatus("请先输入有效的 Roblox 音频 ID", COLORS.amber)
		updatePlayerButtons()
		return
	end

	wantPlay = true
	musicSound.Looped = repeatMode == 2
	musicSound.PlaybackSpeed = speeds[speedIndex]

	if loadBusy then
		playState = "loading"
		setStatus("正在加载音频…", COLORS.amber)
		updatePlayerButtons()
		return
	end

	if musicSound.IsLoaded and loadedUri == uri then
		if musicSound.TimeLength > 0
			and musicSound.TimePosition >= musicSound.TimeLength then
			pcall(function()
				musicSound.TimePosition = 0
			end)
		end

		local ok = false

		if playState == "paused" then
			ok = pcall(function()
				musicSound:Resume()
			end)
		end

		if not ok then
			ok = pcall(function()
				musicSound:Play()
			end)
		end

		if ok then
			playState = "playing"
			setStatus("正在播放", COLORS.green)
			updatePlayerButtons()
		else
			failLoading("播放失败：请检查音频资产")
		end
	else
		beginLoading(uri)
	end
end

playTrack = function(index, autoPlay)
	if #TRACKS == 0 then
		currentIndex = 0
		playState = "ready"
		wantPlay = false
		updateTrackUI()
		updateProgress()
		setStatus("请先输入 Roblox 音频 ID", COLORS.amber)
		return
	end

	index = math.clamp(math.floor(tonumber(index) or 1), 1, #TRACKS)
	currentIndex = index

	loadGeneration += 1
	loadBusy = false
	wantPlay = false
	loadedUri = nil

	pcall(function()
		musicSound:Stop()
	end)

	local track = TRACKS[currentIndex]
	local uri = track and getAssetUri(track.id)

	pcall(function()
		musicSound.SoundId = uri or ""
		musicSound.Looped = repeatMode == 2
		musicSound.TimePosition = 0
	end)

	updateTrackUI()
	updateProgress()

	if not uri then
		playState = "error"
		setStatus("该曲目没有有效音频 ID", COLORS.amber)
		updatePlayerButtons()
		return
	end

	playState = "ready"
	setStatus("已就绪，点击播放", COLORS.muted)
	updatePlayerButtons()

	if autoPlay then
		startPlayback()
	end
end

