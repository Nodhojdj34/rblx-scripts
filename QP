local function scanOtherPlayers()
	if not scannerEnabled then
		return
	end

	local now = os.clock()
	local seen = {}

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			seen[target] = true

			local state = anomalyStates[target]
			if not state then
				state = {
					reasons = {},
					expires = 0,
					lastDetected = 0,
				}
				anomalyStates[target] = state
			end

			local character = target.Character
			local humanoid =
				character and character:FindFirstChildOfClass("Humanoid")
			local rootPart =
				character
				and (
					character:FindFirstChild("HumanoidRootPart")
					or character.PrimaryPart
				)

			if character and humanoid and rootPart and humanoid.Health > 0 then
				local sample = movementSamples[target]

				if not sample or sample.character ~= character then
					sample = {
						character = character,
						position = rootPart.Position,
						time = now,
						spawnedAt = now,
					}
					movementSamples[target] = sample
				end

				local reasons = {}
				local settled = now - sample.spawnedAt >= 2
				local seated =
					humanoid.SeatPart ~= nil or humanoid.Sit

				if settled then
					local walkSpeed = humanoid.WalkSpeed
					if walkSpeed > maxWalkSpeed then
						table.insert(
							reasons,
							string.format(
								"WalkSpeed %.0f > %.0f",
								walkSpeed,
								maxWalkSpeed
							)
						)
					end

					if humanoid.UseJumpPower then
						if humanoid.JumpPower > jumpPowerThreshold then
							table.insert(
								reasons,
								string.format(
									"JumpPower %.0f > %d",
									humanoid.JumpPower,
									jumpPowerThreshold
								)
							)
						end
					elseif humanoid.JumpHeight > jumpHeightThreshold then
						table.insert(
							reasons,
							string.format(
								"JumpHeight %.1f > %d",
								humanoid.JumpHeight,
								jumpHeightThreshold
							)
						)
					end

					if not seated then
						local velocity = rootPart.AssemblyLinearVelocity
						local horizontalSpeed =
							Vector2.new(velocity.X, velocity.Z).Magnitude

						if horizontalSpeed > maxHorizontalSpeed then
							table.insert(
								reasons,
								string.format(
									"水平速度 %.0f > %.0f",
									horizontalSpeed,
									maxHorizontalSpeed
								)
							)
						end

						local dt = now - sample.time
						if dt >= 0.15 and dt <= 1.5 then
							local distance =
								(rootPart.Position - sample.position).Magnitude
							local displacementSpeed = distance / dt

							if distance >= 60
								and displacementSpeed > teleportSpeedThreshold then
								table.insert(
									reasons,
									string.format(
										"短时位移约 %.0f studs/s",
										displacementSpeed
									)
								)
							end
						end
					end
				end

				if #reasons > 0 then
					state.reasons = reasons
					state.expires = now + 8
					state.lastDetected = now
				end

				sample.position = rootPart.Position
				sample.time = now

				if state.expires <= now then
					state.reasons = {}
				end
			else
				movementSamples[target] = nil

				if state.expires <= now then
					state.reasons = {}
				end
			end
		end
	end

	for target in pairs(anomalyStates) do
		if not seen[target] then
			anomalyStates[target] = nil
			movementSamples[target] = nil
		end
	end
end

