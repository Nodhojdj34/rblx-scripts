			tostring(track.title or "")
				.. " "
				.. tostring(track.artist or "")
				.. " "
				.. tostring(track.id or "")
		)

		local matchesSearch =
			query == "" or string.find(searchable, query, 1, true) ~= nil
		local matchesFavorite = not favoriteOnly or track.favorite == true

		if matchesSearch and matchesFavorite then
			visibleCount += 1
			local capturedIndex = index

			local row = newGui("Frame", playlistContainer, {
				Name = "TrackRow",
				Size = UDim2.new(1, 0, 0, 44),
				BorderSizePixel = 0,
				LayoutOrder = visibleCount,
			}, "card")
			addCorner(row, 9)

			local playButton = createButton(
				row,
				"▶",
				UDim2.new(0, 32, 0, 30),
				UDim2.new(0, 6, 0.5, -15),
				"accentButton",
				10
			)

			local nameLabel = createLabel(
				row,
				tostring(track.title) .. " · ID " .. tostring(track.id),
				UDim2.new(1, -116, 1, 0),
				"text",
				{
					Position = UDim2.new(0, 43, 0, 0),
					TextSize = 10,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextWrapped = false,
				}
			)

			local favoriteButton = createButton(
				row,
				track.favorite and "★" or "☆",
				UDim2.new(0, 28, 0, 30),
				UDim2.new(1, -66, 0.5, -15),
				track.favorite and "accentButton" or "button",
				14
			)

			local removeButton = createButton(
				row,
				"×",
				UDim2.new(0, 28, 0, 30),
				UDim2.new(1, -34, 0.5, -15),
				"button",
				15
			)

			playButton.Activated:Connect(function()
				if playTrack then
					playTrack(capturedIndex)
				end
			end)

			nameLabel.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					if playTrack then
						playTrack(capturedIndex)
					end
				end
			end)

			favoriteButton.Activated:Connect(function()
				local item = tracks[capturedIndex]
				if item then
					item.favorite = not item.favorite
					refreshPlaylist()
				end
			end)

			removeButton.Activated:Connect(function()
				if not tracks[capturedIndex] then
					return
				end

				if capturedIndex == currentIndex then
					sound:Stop()
					sound.SoundId = ""
					currentIndex = 0
					playToken += 1
				elseif capturedIndex < currentIndex then
					currentIndex -= 1
				end

				table.remove(tracks, capturedIndex)
				updateMiniIsland()
				updateMusicButtons()
				refreshPlaylist()
			end)
		end
	end

	playlistEmptyLabel.Visible = visibleCount == 0
	playlistEmptyLabel.Size =
		UDim2.new(1, 0, 0, visibleCount == 0 and 34 or 0)

	if visibleCount == 0 and #tracks > 0 then
		playlistEmptyLabel.Text = T("playlist_no_match")
	else
		playlistEmptyLabel.Text = T("playlist_empty")
	end
end

