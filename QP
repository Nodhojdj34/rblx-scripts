local function updatePlayerList()
	for _, child in ipairs(playerListScroll:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local playerList = Players:GetPlayers()
	table.sort(playerList, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	if #playerList == 0 then
		local empty = createLabel(
			playerListScroll,
			"当前没有其他玩家。",
			UDim2.new(1, -4, 0, 22),
			UDim2.new(),
			"muted",
			11
		)
		empty.TextWrapped = false
		return
	end

	for _, listedPlayer in ipairs(playerList) do
		local suffix = listedPlayer == player and " · 你" or ""
		local teamName = listedPlayer.Team and (" · " .. listedPlayer.Team.Name) or ""
		local label = createLabel(
			playerListScroll,
			listedPlayer.DisplayName .. "  (@" .. listedPlayer.Name .. ")" .. teamName .. suffix,
