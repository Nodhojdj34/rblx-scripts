-- 展开 / 收起动画
local isExpanded = false
local activeTween
local expansionToken = 0

local function setExpanded(value)
	if isExpanded == value then
		return
	end

	isExpanded = value
	expansionToken = expansionToken + 1
	local thisToken = expansionToken

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	if value then
		compact.Visible = false
		expanded.Visible = true
		compactHit.Visible = false
	end

	local targetSize = value and OPEN_SIZE or CLOSED_SIZE

	local tween = TweenService:Create(
		island,
		TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = targetSize }
	)

	activeTween = tween

	tween.Completed:Connect(function(playbackState)
		if thisToken ~= expansionToken
			or playbackState ~= Enum.PlaybackState.Completed then
			return
		end

		activeTween = nil

		if not value then
			expanded.Visible = false
			compact.Visible = true
			compactHit.Visible = true
		end
	end)

	tween:Play()
end

compactHit.Activated:Connect(function()
	setExpanded(true)
end)

closeButton.Activated:Connect(function()
	setExpanded(false)
end)

-- 服务器信息显示
local rosterRows = {}

local function formatServerTime(timestamp)
	local unixTime = tonumber(timestamp)
	if not unixTime then
		return "—"
	end

	local ok, result = pcall(function()
		return DateTime
			.fromUnixTimestamp(unixTime)
			:FormatUniversalTime("HH:mm:ss", "en-us")
	end)

	if ok then
		return result .. " UTC"
	end

	return tostring(unixTime)
end

local function updateServerInfo(info)
	if type(info) ~= "table" then
		serverSummary.Text = "没有收到服务器信息。请确认 ServerScriptService 中已安装服务端脚本。"
		return
	end

	local players = type(info.players) == "table" and info.players or {}
	local playerCount = tonumber(info.playerCount) or #players
	local maxPlayers = tonumber(info.maxPlayers) or 0

	serverSummary.Text = table.concat({
		"类型：" .. tostring(info.serverType or "未知"),
		"人数：" .. tostring(playerCount) .. " / " .. tostring(maxPlayers),
		"PlaceId：" .. tostring(info.placeId or "—"),
		"GameId：" .. tostring(info.gameId or "—"),
		"JobId：" .. tostring(info.jobId or "—"),
		"版本：" .. tostring(info.placeVersion or "—"),
		"运行时间：" .. formatDuration(info.uptime),
		"服务器时间：" .. formatServerTime(info.serverTime),
	}, "\n")

	playerListTitle.Text = "玩家列表（" .. tostring(playerCount) .. "）"

	for _, row in ipairs(rosterRows) do
		row:Destroy()
	end
	rosterRows = {}

	for index, playerInfo in ipairs(players) do
		local row = makeFrame(
			roster,
			"PlayerRow" .. index,
			UDim2.new(1, -5, 0, 25),
			UDim2.new(),
			Color3.fromRGB(40, 43, 50),
			6,
			16
		)
		row.LayoutOrder = index
		row.BackgroundTransparency = 0.25

		local displayName = tostring(playerInfo.displayName or playerInfo.name or "玩家")
		local userName = tostring(playerInfo.name or "未知")
		local nameText = displayName

		if displayName ~= userName then
			nameText = displayName .. " (@" .. userName .. ")"
		else
			nameText = "@" .. userName
		end

		local rowLabel = makeLabel(
			row,
			"PlayerInfo",
			nameText
				.. "  ·  "
				.. tostring(playerInfo.team or "无队伍")
				.. "  ·  "
				.. formatDuration(playerInfo.joinedSeconds),
			UDim2.new(0, 8, 0, 0),
			UDim2.new(1, -16, 1, 0),
			9,
			COLORS.text,
			Enum.Font.Gotham,
			17
		)

		rowLabel.TextTruncate = Enum.TextTruncate.AtEnd
		table.insert(rosterRows, row)
	end
end

local infoFunction
local updateEvent
local requestBusy = false

requestServerInfo = function()
	if not infoFunction or requestBusy then
		return
	end

	requestBusy = true
	refreshButton.Text = "…"

	task.spawn(function()
		local ok, result = pcall(function()
			return infoFunction:InvokeServer()
		end)

		if ok then
			updateServerInfo(result)
		else
			serverSummary.Text = "读取失败。请确认服务端脚本已运行。"
		end

		refreshButton.Text = "刷新"
		requestBusy = false
	end)
end

refreshButton.Activated:Connect(function()
	if requestServerInfo then
		requestServerInfo()
	end
end)

task.spawn(function()
	local folder = ReplicatedStorage:WaitForChild("IslandServerInfo", 12)

	if not folder then
		serverSummary.Text = "找不到 IslandServerInfo。请把服务端脚本放入 ServerScriptService。"
		return
	end

	local remoteFunction = folder:WaitForChild("GetInfo", 8)
	local remoteEvent = folder:WaitForChild("Update", 8)

	if not remoteFunction
		or not remoteFunction:IsA("RemoteFunction")
		or not remoteEvent
		or not remoteEvent:IsA("RemoteEvent") then
		serverSummary.Text = "服务器信息接口未正确创建，请检查服务端脚本。"
		return
	end

	infoFunction = remoteFunction
	updateEvent = remoteEvent

	updateEvent.OnClientEvent:Connect(updateServerInfo)
	requestServerInfo()
end)

