-- 外观滑块
local function applySizeFromPointer(pointerX)
	local width = sizeHit.AbsoluteSize.X
	if width <= 0 then
		return
	end

	local ratio = math.clamp(
		(pointerX - sizeHit.AbsolutePosition.X) / width,
		0,
		1
	)
	setUserScale(0.75 + ratio * (1.15 - 0.75))
end

local function applySlider(slider, pointerX)
	local width = slider.AbsoluteSize.X
	if width <= 0 then
		return
	end

	local ratio = math.clamp(
		(pointerX - slider.AbsolutePosition.X) / width,
		0,
		1
	)

	if slider == seekHit then
		local track = currentTrack()
		local uri = track and getAssetUri(track.id)

		if musicSound.IsLoaded
			and uri
			and loadedUri == uri
			and musicSound.TimeLength > 0 then
			pcall(function()
				musicSound.TimePosition = ratio * musicSound.TimeLength
			end)
			updateProgress()
		end
	elseif slider == volumeHit then
		volume = ratio
		if volume > 0 then
			lastNonZeroVolume = volume
		end
		updateVolume()
	elseif slider == sizeHit then
		applySizeFromPointer(pointerX)
	end
end

local activeSlider = nil

local function bindSlider(slider)
	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = slider
			applySlider(slider, input.Position.X)
		end
	end)
end

bindSlider(seekHit)
bindSlider(volumeHit)
bindSlider(sizeHit)

UserInputService.InputChanged:Connect(function(input)
	if activeSlider
		and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
		applySlider(activeSlider, input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
