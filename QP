local function currentTrack()
	if currentIndex < 1 then
		return nil
	end
	return TRACKS[currentIndex]
end

local function setStatus(text, color)
	playStatus.Text = text
	playStatus.TextColor3 = color or COLORS.muted
	statusDot.BackgroundColor3 = color or COLORS.muted
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function formatDuration(seconds)
	local total = math.max(0, math.floor(tonumber(seconds) or 0))
	local hours = math.floor(total / 3600)
	local minutes = math.floor((total % 3600) / 60)
	local remaining = total % 60

	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, remaining)
	end

	return string.format("%d:%02d", minutes, remaining)
end

local function formatSpeed(value)
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text .. "×"
end

local function updatePlayerButtons()
	local showPause =
		playState == "playing"
		or (playState == "loading" and wantPlay)

	playButton.Text = showPause and "Ⅱ" or "▶"

	if playState == "playing" then
		miniSubtitle.Text = "正在播放"
		miniSubtitle.TextColor3 = accentColor
	elseif playState == "loading" then
		miniSubtitle.Text = "正在加载"
		miniSubtitle.TextColor3 = COLORS.amber
	elseif playState == "error" then
		miniSubtitle.Text = "检查音频设置"
		miniSubtitle.TextColor3 = COLORS.red
	else
		miniSubtitle.Text = "点按展开"
		miniSubtitle.TextColor3 = COLORS.muted
	end

	local track = currentTrack()
	local isFavorite = track and favorites[track.uid] == true

	favoriteButton.Text = isFavorite and "♥" or "♡"
	favoriteButton.TextColor3 = isFavorite and COLORS.pink or COLORS.muted

	shuffleButton.TextColor3 =
		shuffleEnabled and accentColor or COLORS.muted

	repeatButton.TextColor3 =
		repeatMode == 0 and COLORS.muted or accentColor

	repeatBadge.Visible = repeatMode == 2
	repeatBadge.TextColor3 = accentColor
	speedButton.Text = formatSpeed(speeds[speedIndex])
	eqButton.Text = eqPresets[eqIndex].name
end

local function updatePlaylistSelection()
	for index, button in pairs(trackButtons) do
		local track = TRACKS[index]

		if track and button.Parent then
			local prefix = index == currentIndex and "▶  " or "♫  "
			button.Text = prefix
				.. tostring(track.title or ("曲目 " .. index))
				.. " — "
				.. tostring(track.artist or "Roblox 音频")

			if index == currentIndex then
				button.BackgroundColor3 = accentColor:Lerp(COLORS.panel, 0.72)
				button.BackgroundTransparency = 0
				button.TextColor3 = COLORS.text
			else
				button.BackgroundColor3 = COLORS.panel
				button.BackgroundTransparency = 0.25
				button.TextColor3 = COLORS.text
			end
		end
	end
end

rebuildPlaylist = function()
	for _, row in ipairs(playlistRows) do
		if row.Parent then
			row:Destroy()
		end
	end

	playlistRows = {}
	trackButtons = {}
	playlist.CanvasPosition = Vector2.new(0, 0)

	local query = string.lower(searchBox.Text or "")
	local shownCount = 0

	for index, track in ipairs(TRACKS) do
		local matches = not showFavoritesOnly or favorites[track.uid] == true

		if matches and query ~= "" then
			local haystack = string.lower(
				tostring(track.title or "")
					.. " "
					.. tostring(track.artist or "")
					.. " "
					.. tostring(track.id or "")
			)
			matches = string.find(haystack, query, 1, true) ~= nil
		end

		if matches then
			shownCount += 1

			local row = makeButton(
				playlist,
				"TrackRow" .. index,
				"",
				UDim2.new(),
				UDim2.new(1, -6, 0, 28),
				9,
				20,
				COLORS.panel,
				6
			)
			row.LayoutOrder = shownCount
			row.TextXAlignment = Enum.TextXAlignment.Left
			trackButtons[index] = row
			table.insert(playlistRows, row)

			row.Activated:Connect(function()
				if playTrack then
					playTrack(index, true)
				end
			end)
		end
	end

	if shownCount == 0 then
		local message

		if #TRACKS == 0 then
			message = "在上方输入音频 ID，再点“添加并播放”"
		elseif showFavoritesOnly then
			message = "还没有收藏的曲目"
		else
			message = "没有找到匹配曲目"
		end

		local emptyLabel = makeLabel(
			playlist,
			"PlaylistEmpty",
			message,
			UDim2.new(),
			UDim2.new(1, -8, 0, 28),
			9,
			COLORS.muted,
			Enum.Font.Gotham,
			20
		)
		emptyLabel.LayoutOrder = 1
		table.insert(playlistRows, emptyLabel)
	end

	favoriteFilterButton.Text = showFavoritesOnly and "全部" or "收藏"
	updatePlaylistSelection()
end

