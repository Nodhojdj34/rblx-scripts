-- 拖动灵动岛位置
----------------------------------------------------------------

local draggingIsland = false
local dragInput = nil
local dragStartPointer = nil
local dragStartX = 0
local dragStartY = 0

dragArea.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingIsland = true
		dragInput = input
		dragStartPointer = Vector2.new(input.Position.X, input.Position.Y)
		dragStartX = root.Position.X.Offset
		dragStartY = root.Position.Y.Offset
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not draggingIsland or not dragStartPointer then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local pointer = Vector2.new(input.Position.X, input.Position.Y)
		local delta = pointer - dragStartPointer
		local viewport = getViewportSize()
		local halfWidth = root.AbsoluteSize.X / 2

		local maxX = math.max(0, viewport.X / 2 - halfWidth - 4)
		local maxY = math.max(4, viewport.Y - root.AbsoluteSize.Y - 8)

		rootOffsetX = math.clamp(dragStartX + delta.X, -maxX, maxX)
		rootOffsetY = math.clamp(dragStartY + delta.Y, 4, maxY)
		root.Position = UDim2.new(0.5, rootOffsetX, 0, rootOffsetY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == dragInput
		or input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingIsland = false
		dragInput = nil
		dragStartPointer = nil
	end
end)

