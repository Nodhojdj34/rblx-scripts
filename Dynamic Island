	isPlaying = not isPlaying
	playBtn.label.Text = isPlaying and ICON.Pause or ICON.Play
	if Island.OnPlayPause then task.spawn(Island.OnPlayPause, isPlaying) end
end)

local isDragging = false

local function applySeekFromX(x)
	local abs = trackHitbox.AbsolutePosition.X
	local w   = trackHitbox.AbsoluteSize.X
	if w <= 0 then return end
	local p = math.clamp((x - abs) / w, 0, 1)
	musicFill.Size = UDim2.fromScale(p, 1)
	if Island.OnSeek then task.spawn(Island.OnSeek, p) end
end

trackHitbox.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		applySeekFromX(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		applySeekFromX(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
	end
end)

hitbox.Activated:Connect(function()
	if currentState == STATE.Idle then
		setState(STATE.Music)
		scheduleCollapse(CONFIG.MusicAutoCollapse)
	else
		setState(STATE.Idle)
	end
end)

--==============================================================
--  对外 API
--==============================================================
Island = {}

function Island:ShowMusic(title, artist, progress, playing)
	musicTitle.Text    = title  or "正在播放"
	musicSubtitle.Text = artist or "未知艺术家"
	musicFill.Size     = UDim2.fromScale(math.clamp(progress or 0.35, 0, 1), 1)
	if playing ~= nil then
		isPlaying = playing and true or false
		playBtn.label.Text = isPlaying and ICON.Pause or ICON.Play
	end
	setState(STATE.Music)
	scheduleCollapse(CONFIG.MusicAutoCollapse)
end

function Island:ShowNotification(title, body, glyph)
	notifTitle.Text = title or "新通知"
	notifBody.Text  = body  or ""
	notifGlyph.Text = glyph or "!"
	setState(STATE.Notification)
	scheduleCollapse(CONFIG.NotificationAutoCollapse)
end

function Island:Hide() setState(STATE.Idle) end

function Island:SetProgress(p)
	musicFill.Size = UDim2.fromScale(math.clamp(p, 0, 1), 1)
end

function Island:SetPlaying(v)
	isPlaying = v and true or false
	playBtn.label.Text = isPlaying and ICON.Pause or ICON.Play
end

function Island:GetPlaying() return isPlaying end
function Island:IsExpanded() return currentState ~= STATE.Idle end

_G.DynamicIsland = Island
