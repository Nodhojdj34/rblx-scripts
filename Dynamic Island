local function computeExpandedSize()
	local vp = viewport()
	local w = math.clamp(math.floor(vp.X * 0.8), 288, 360)
	w = math.min(w, math.max(240, vp.X - 32))
	local h = math.clamp(math.floor(vp.Y - 70), 280, 420)
	h = math.min(h, math.max(240, vp.Y - 40))
	return w, h
