local volumeSteps = {0.25, 0.5, 0.75, 1.0, 0}

local function applyVolumeLabel()
	volumeBtn.Text = "音量 " .. math.floor(musicSound.Volume * 100 + 0.5) .. "%"
end

local function cycleVolume()
	local cur = musicSound.Volume
	local idx = 2
	for i, v in ipairs(volumeSteps) do
		if math.abs(v - cur) < 0.01 then idx = i; break end
	end
	idx = idx + 1
	if idx > #volumeSteps then idx = 1 end
	musicSound.Volume = volumeSteps[idx]
	applyVolumeLabel()
end

