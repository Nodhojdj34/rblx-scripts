local function isInsideRoot(p)
	local a = root.AbsolutePosition
	local s = root.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local function isInsideHeader(p)
	local a = headerDrag.AbsolutePosition
	local s = headerDrag.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local dragCandidate = nil
local dragStartPos = nil
local dragStartX, dragStartY = 0, 0
local isDragging = false

local function startDrag(input, p)
	dragCandidate = input
	dragStartPos = p
	dragStartX = islandCenterX
	dragStartY = islandTopY
	isDragging = false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end

	local p = input.Position
	local inside = isInsideRoot(p)

	if isExpanded then
		if isInsideHeader(p) then
			startDrag(input, p)
		elseif not inside then
			collapseIsland()
		end
		return
	end

	if inside then
		startDrag(input, p)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragCandidate then return end
	local isMouseMove = (input.UserInputType == Enum.UserInputType.MouseMovement)
	local isSameTouch = (dragCandidate.UserInputType == Enum.UserInputType.Touch
		and input.UserInputType == Enum.UserInputType.Touch)
	if not (isMouseMove or isSameTouch) then return end

	local p = input.Position
	local dx = p.X - dragStartPos.X
	local dy = p.Y - dragStartPos.Y

	if not isDragging then
		if math.abs(dx) + math.abs(dy) < 6 then return end
		isDragging = true
	end

	local vp = camera.ViewportSize
	local w = isExpanded and expandedWidth() or collapsedWidth()
	local h = isExpanded and expandedHeight() or 38
	islandCenterX = math.clamp(dragStartX + dx, w / 2, vp.X - w / 2)
	islandTopY = math.clamp(dragStartY + dy, guiInset.Y, vp.Y - h - 4)
	root.Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY))
end)

UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	if not dragCandidate then return end

	local wasDragging = isDragging
	local inside = isInsideRoot(input.Position)
	dragCandidate = nil
	isDragging = false

	if wasDragging then return end
	if inside and not isExpanded then
		expandIsland()
	end
end)

