--==== Tab 切换 ====
function switchTab(key)
	currentTab = key
	for k, b in pairs(tabBtns) do
		if k == key then
			b.TextColor3 = COL.text
			b.BackgroundTransparency = 0
			b.BackgroundColor3 = COL.cardSoft
		else
			b.TextColor3 = COL.dim
			b.BackgroundTransparency = 1
		end
	end
	for k, p in pairs(pagesMap) do
		p.Visible = (k == key)
	end
	if key == "server" and refreshServer then refreshServer() end
	if key == "notify" and refreshNotifications then refreshNotifications() end
	if key == "notify" and tabMarks.notify then tabMarks.notify.Visible = false end
end

--==== 主题 ====
function applyTheme(t)
	accent = t.c
	for _, it in ipairs(accentList) do
		local o = it.o
		if o and o.Parent then
			if it.k == "bg" then o.BackgroundColor3 = accent
			elseif it.k == "text" then o.TextColor3 = accent
			elseif it.k == "stroke" then o.Color = accent end
		end
	end
	for k, v in pairs(themeBtns) do
		v.stroke.Transparency = (k == t.key) and 0 or 1
	end
	for _, fn in ipairs(toggleRenders) do fn() end
	switchTab(currentTab)
	updateCollapsedText()
end

--==== 通知 ====
local function pushNotif(title, body, kind)
	unread = unread + 1
	table.insert(notifications, 1, {
		title = title, body = body, kind = kind or "info",
		time = os.date("%H:%M:%S"),
	})
	while #notifications > 20 do table.remove(notifications) end
	if tabMarks.notify and not pagesMap.notify.Visible then
		tabMarks.notify.Visible = true
	end
	if not isExpanded then
		toastToken = toastToken + 1
		local tk = toastToken
		dot.BackgroundColor3 = (kind == "good" and COL.good)
			or (kind == "danger" and COL.danger)
			or (kind == "warn" and COL.warn)
			or accent
		mainLabel.Text = title
		task.delay(2.2, function()
			if tk ~= toastToken then return end
			dot.BackgroundColor3 = accent
			updateCollapsedText()
		end)
	end
end
