function expandIsland()
	if isExpanded then return end
	isExpanded = true; expandToken = expandToken + 1
	local token = expandToken
	local w, h = computeExpandedSize(); EW, EH = w, h
	expanded.Size = UDim2.fromOffset(w, h)
	expanded.Position = UDim2.fromScale(0.5, 0.5)
	expanded.Visible = true; expanded.GroupTransparency = 1
	collapsedContent.Visible = false; miniProgress.Visible = false
	topSheen.Visible = false; topLine.Visible = false
	if animationsEnabled then
		rootScale.Scale = 0.94
		tw(rootScale, 0.38, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tw(root, 0.34, { Size = UDim2.fromOffset(w,h) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tw(rootCorner, 0.30, { CornerRadius = UDim.new(0,26) })
	else
		rootScale.Scale = 1
		root.Size = UDim2.fromOffset(w,h)
		rootCorner.CornerRadius = UDim.new(0,26)
		expanded.GroupTransparency = 0
	end
	task.delay(0.10, function()
		if expandToken ~= token then return end
		if animationsEnabled then tw(expanded, 0.24, { GroupTransparency = 0 })
		else expanded.GroupTransparency = 0 end
	end)
	switchTab(activeTab, true)
end
function collapseIsland()
	if not isExpanded then return end
	isExpanded = false; expandToken = expandToken + 1
	local token = expandToken
	if animationsEnabled then
		tw(expanded, 0.12, { GroupTransparency = 1 })
		tw(root, 0.28, { Size = UDim2.fromOffset(collapsedWidth(), ISLAND_H) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		tw(rootCorner, 0.28, { CornerRadius = UDim.new(0,19) })
	else
		expanded.GroupTransparency = 1
		root.Size = UDim2.fromOffset(collapsedWidth(), ISLAND_H)
		rootCorner.CornerRadius = UDim.new(0,19)
	end
	task.delay(0.14, function()
		if expandToken ~= token then return end
		expanded.Visible = false; collapsedContent.Visible = true
		topSheen.Visible = true; topLine.Visible = true
		updateCollapsedText(); updateMiniProgress()
	end)
end
local function isInsideRoot(p)
	local ap, as = root.AbsolutePosition, root.AbsoluteSize
	return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
end
local function isInsideHeader(p)
	if not isExpanded or not expanded.Visible then return false end
	local ap, as = header.AbsolutePosition, header.AbsoluteSize
	return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if gameProcessed then return end
		if UserInputService:GetFocusedTextBox() then return end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		local k = input.KeyCode
		if ctrl and k == Enum.KeyCode.I then
			if isExpanded then collapseIsland() else expandIsland() end
			return
		elseif ctrl and k == Enum.KeyCode.M then toggleMusic(); return
		elseif ctrl and k == Enum.KeyCode.R then swRunning = false; swAccum = 0; swValue = 0; updateStopwatchDisplay(); return
		end
		return
	end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	local p = Vector2.new(input.Position.X, input.Position.Y)
	local inside = isInsideRoot(p)
	if isExpanded then
		if inside and isInsideHeader(p) then
			pressMode = "header"; pressStart = p; pressMoved = false; dragBasePos = root.Position
		elseif not inside and not gameProcessed then collapseIsland() end
	else
		if inside then pressMode = "tap"; pressStart = p; pressMoved = false; dragBasePos = root.Position end
	end
end)
UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if activeSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		sliderDrag(activeSlider, input.Position.X); return
	end
	if not pressMode then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local p = Vector2.new(input.Position.X, input.Position.Y)
	local delta = p - pressStart
	if not pressMoved and delta.Magnitude > 6 then pressMoved = true end
	if pressMoved then root.Position = UDim2.fromOffset(dragBasePos.X.Offset + delta.X, dragBasePos.Y.Offset + delta.Y) end
