-- [18] Expand / collapse ------------------------------------------
local function expandedHeight()
	local vp = camera.ViewportSize
	local h = math.clamp(math.floor(vp.Y - 70), 280, 420)
	return math.min(h, vp.Y - 40)
end

local function expandedWidth()
	local vp = camera.ViewportSize
	local w = math.clamp(math.floor(vp.X * 0.8), 288, 360)
	return math.min(w, vp.X - 32)
end

local function clampPosition(w, h)
	local vp = camera.ViewportSize
	islandCenterX = math.clamp(islandCenterX, w / 2 + 4, math.max(w / 2 + 4, vp.X - w / 2 - 4))
	islandTopY = math.clamp(islandTopY, guiInset.Y + 2, math.max(guiInset.Y + 2, vp.Y - h - 6))
end

expandIsland = function()
	if isExpanded then return end
	isExpanded = true
	expandToken = expandToken + 1
	local token = expandToken

	local w = expandedWidth()
	local h = expandedHeight()
	clampPosition(w, h)

	collapsedGroup.Visible = true
	expandedGroup.Visible = true
	expandedGroup.GroupTransparency = 1
	if switchTab then switchTab(activeTab) end

	-- 微回弹
	rootScale.Scale = 0.92
	tw(rootScale, 0.42, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	tw(root, 0.36, {
		Size = UDim2.fromOffset(w, h),
		Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY)),
	})
	tw(rootCorner, 0.36, { CornerRadius = UDim.new(0, 26) })
	tw(expandedGroup, 0.26, { GroupTransparency = 0 })
	tw(collapsedGroup, 0.12, { GroupTransparency = 1 })

	task.delay(0.44, function()
		if token ~= expandToken or not isExpanded then return end
		collapsedGroup.Visible = false
	end)
end

collapseIsland = function()
	if not isExpanded then return end
	isExpanded = false
	expandToken = expandToken + 1
	local token = expandToken

	local w = collapsedWidth()
	clampPosition(w, 38)

	collapsedGroup.Visible = true
	tw(expandedGroup, 0.16, { GroupTransparency = 1 })
	tw(collapsedGroup, 0.22, { GroupTransparency = 0 })
	tw(root, 0.3, {
		Size = UDim2.fromOffset(w, 38),
		Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY)),
	}, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	tw(rootCorner, 0.3, { CornerRadius = UDim.new(0, 19) })

	task.delay(0.34, function()
		if token ~= expandToken or isExpanded then return end
		expandedGroup.Visible = false
	end)
end

-- [19] Input: keyboard + drag --------------------------------------
local function isInsideRoot(p)
	local a = root.AbsolutePosition
	local s = root.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local function isInsideHeader(p)
	local a = headerDrag.AbsolutePosition
	local s = headerDrag.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local dragCandidate = nil
local dragStartPos = nil
local dragStartX, dragStartY = 0, 0
local isDragging = false

local function startDrag(input, p)
	dragCandidate = input
	dragStartPos = p
	dragStartX = islandCenterX
	dragStartY = islandTopY
	isDragging = false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- 键盘快捷键
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if gameProcessed then return end
		if UserInputService:GetFocusedTextBox() then return end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		local k = input.KeyCode
		if ctrl and k == Enum.KeyCode.I then
			if isExpanded then
				if collapseIsland then collapseIsland() end
			else
				if expandIsland then expandIsland() end
			end
			return
		elseif ctrl and k == Enum.KeyCode.M then
			if togglePlay then togglePlay() end
			return
		elseif ctrl and k == Enum.KeyCode.R then
			-- 重置秒表
			swRunning = false
			swAccum = 0
			swValue = 0
			swLabel.Text = "00:00.00"
			return
		end
		return
	end

	if gameProcessed then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end

	local p = input.Position
	local inside = isInsideRoot(p)

	if isExpanded then
		if isInsideHeader(p) then
			startDrag(input, p)
		elseif not inside then
			if collapseIsland then collapseIsland() end
		end
		return
	end

	if inside then
		startDrag(input, p)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragCandidate then return end
	local isMouseMove = (input.UserInputType == Enum.UserInputType.MouseMovement)
	local isSameTouch = (dragCandidate.UserInputType == Enum.UserInputType.Touch
		and input.UserInputType == Enum.UserInputType.Touch)
	if not (isMouseMove or isSameTouch) then return end

	local p = input.Position
	local dx = p.X - dragStartPos.X
	local dy = p.Y - dragStartPos.Y

	if not isDragging then
		if math.abs(dx) + math.abs(dy) < 6 then return end
		isDragging = true
	end

	local vp = camera.ViewportSize
	local w = isExpanded and expandedWidth() or collapsedWidth()
	local h = isExpanded and expandedHeight() or 38
	islandCenterX = math.clamp(dragStartX + dx, w / 2, vp.X - w / 2)
	islandTopY = math.clamp(dragStartY + dy, guiInset.Y, vp.Y - h - 4)
	root.Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY))
end)

UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	if not dragCandidate then return end

	local wasDragging = isDragging
	local inside = isInsideRoot(input.Position)
	dragCandidate = nil
	isDragging = false

	if wasDragging then return end
	if inside and not isExpanded then
		if expandIsland then expandIsland() end
	end
end)

