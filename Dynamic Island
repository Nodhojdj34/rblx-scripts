			local len = musicSound.TimeLength
			local pos = musicSound.TimePosition
			if len and len > 0 then
				musicProgressFill.Size = UDim2.fromScale(math.clamp(pos / len, 0, 1), 1)
				musicProgressText.Text = formatTime(pos) .. " / " .. formatTime(len)
			end
			if not isExpanded and isPlaying then
				compactText.Text = "♪ " .. formatTime(pos)
