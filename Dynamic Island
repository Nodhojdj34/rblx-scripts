local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local function computeScale()
	local cam = workspace.CurrentCamera
	local vp
	if cam then vp = cam.ViewportSize end
	if not vp or vp.X <= 0 or vp.Y <= 0 then
		vp = Vector2.new(1280, 720)
	end
	local s = math.clamp(math.min(vp.X / 1100, vp.Y / 760), 0.6, 1.2) * CONFIG.Scale
	if isMobile then
		s = s * CONFIG.MobileScale
	end
	local w = CONFIG.Size.Music.X * s
	local limit = vp.X * CONFIG.MaxWidthPct
	if w > limit and w > 0 then
		s = s * (limit / w)
	end
	return s
end

local S = computeScale()

local function dim(x, y) return UDim2.fromOffset(math.round(x * S), math.round(y * S)) end
local function num(x)    return math.round(x * S) end

local function create(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

