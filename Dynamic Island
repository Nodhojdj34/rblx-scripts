-- 【前向声明已存在：local loadAndPlay】
function loadAndPlay(rawInput)
	if isMusicLoading then return end

	local id = parseId(rawInput)
	if not id then
		showMusicError("请输入有效音频 ID")
		return
	end

	if musicInput:IsFocused() then
		musicInput:ReleaseFocus()
	end

	if currentMusicId == id and musicSound.IsLoaded then
		if musicSound.IsPaused then
			musicSound:Resume()
			setPlayingUI(true)
			return
		elseif musicSound.IsPlaying then
			return
		end
	end

	isMusicLoading = true
	currentMusicId = id
	setPlayingUI(false)
	playPauseBtn.Text = "加载中"

	musicSound:Stop()
	musicSound.TimePosition = 0
	musicSound.SoundId = "rbxassetid://" .. id
	musicInfo.Text = "ID " .. id .. " · 加载中…"
	musicProgressFill.Size = UDim2.fromScale(0, 1)
	musicProgressText.Text = "0:00 / 0:00"

	task.spawn(function()
		local t = 0
		while not musicSound.IsLoaded and t < 10 do
			task.wait(0.1)
			t = t + 0.1
			if currentMusicId ~= id then
				isMusicLoading = false
				return
			end
		end

		if currentMusicId ~= id then
			isMusicLoading = false
			return
		end

		if musicSound.IsLoaded then
			musicSound:Play()
			isMusicLoading = false
			setPlayingUI(true)
			musicInfo.Text = "ID " .. id .. " · 时长 " .. formatTime(musicSound.TimeLength)
			addRecent(id)
			showNotification("正在播放", "ID " .. id, 2.5)
		else
			isMusicLoading = false
			currentMusicId = nil
			setPlayingUI(false)
			playPauseBtn.Text = "播放"
			showMusicError("加载失败：音频未公开或 ID 无效")
		end
	end)
end

