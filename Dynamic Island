local function renderStopwatch()
	local t = stopwatchAccum
	if stopwatchRunning then
		t = t + (os.clock() - stopwatchStart)
	end
	swVal.Text = string.format("%02d:%02d.%02d",
		math.floor(t / 60), math.floor(t % 60), math.floor((t % 1) * 100))
end

