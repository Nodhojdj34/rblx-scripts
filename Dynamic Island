local function makeControl(name, icon, centerX, visualSize, isRound)
	local hit = create("TextButton", {
		Name = name .. "_Hit",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, num(centerX), 0.5, 0),
		Size = dim(44, 44),
		BackgroundTransparency = 1,
		Text = "",
		TextTransparency = 1,
		AutoButtonColor = false,
		Active = false,
		ZIndex = 10,
	}, buttonsContainer)

	local visual = create("Frame", {
		Name = name .. "_Visual",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = dim(visualSize, visualSize),
		BackgroundColor3 = isRound and THEME.TextColor or THEME.BtnBG,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 11,
	}, hit)

	create("UICorner", { CornerRadius = UDim.new(1, 0) }, visual)

	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = icon,
		TextColor3 = isRound and THEME.Background or THEME.TextColor,
		TextTransparency = 1,
		TextSize = num(isRound and 16 or 13),
		Font = Enum.Font.GothamBold,
		ZIndex = 12,
	}, visual)

	return { hit = hit, visual = visual, label = label }
end

