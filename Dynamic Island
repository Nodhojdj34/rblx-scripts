RunService.RenderStepped:Connect(function(dt)
	local ap, as = root.AbsolutePosition, root.AbsoluteSize
	shadowFar.Position = UDim2.fromOffset(ap.X-14, ap.Y-6); shadowFar.Size = UDim2.fromOffset(as.X+28, as.Y+26)
