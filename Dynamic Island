--================================================================
-- 0. 工具
--================================================================
local function new(class, props, parent)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then inst[k] = v end
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(parent, radius)
	return new("UICorner", { CornerRadius = radius or UDim.new(0, 10) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1,
		Transparency = transparency or 0.6,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local animationsEnabled = true

local function tw(obj, duration, props, style, dir)
	TweenService:Create(obj, TweenInfo.new(
		animationsEnabled and duration or 0,
		style or Enum.EasingStyle.Quart,
		dir or Enum.EasingDirection.Out
	), props):Play()
end

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec or 0))
	if sec >= 3600 then
		return string.format("%d:%02d:%02d", math.floor(sec / 3600), math.floor(sec % 3600 / 60), sec % 60)
	end
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function addPressEffect(button)
	local scale = new("UIScale", { Scale = 1 }, button)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 0.94 }):Play()
	end)
	local function reset()
		TweenService:Create(scale, TweenInfo.new(0.13), { Scale = 1 }):Play()
	end
	button.MouseButton1Up:Connect(reset)
	button.MouseLeave:Connect(reset)
end

local function parseId(text)
	if type(text) ~= "string" then return nil end
	local id = string.match(text, "(%d+)")
	if id then return tonumber(id) end
	return nil
end

