	shadowNear.Position = UDim2.fromOffset(ap.X-4, ap.Y-1); shadowNear.Size = UDim2.fromOffset(as.X+8, as.Y+6)
	if not perfMode then glowPhase = glowPhase + dt*1.8; iconGlow.Transparency = 0.55 + math.sin(glowPhase)*0.22 end
	if pageMusic.Visible and musicSound.IsPlaying and not perfMode then
		visPhase = visPhase + dt
		for i, bar in ipairs(visBars) do
			local wave = math.abs(math.sin(visPhase*5 + i*0.7))
			bar.Size = UDim2.new(0,4,0.15 + wave*0.75,0)
		end
	elseif pageMusic.Visible then
		for i, bar in ipairs(visBars) do bar.Size = UDim2.new(0,4,0.12,0) end
	end
	fpsAccum = fpsAccum + dt; fpsFrames = fpsFrames + 1
	local sampleInterval = perfMode and 1.0 or 0.3
	if fpsAccum >= sampleInterval then
		currentFps = math.floor(fpsFrames/fpsAccum + 0.5)
		fpsAccum = 0; fpsFrames = 0
		ovFpsValue.Text = tostring(currentFps)
		if currentFps < 30 then
			lowFpsTime = lowFpsTime + sampleInterval
			if lowFpsTime >= 2 and (os.time() - lastLowFpsNotify) > 60 then
				lastLowFpsNotify = os.time(); lowFpsTime = 0
				showNotification("性能提醒","帧率低于 30 FPS",3)
			end
		else lowFpsTime = 0 end
		chartAccum = chartAccum + sampleInterval
		if chartAccum >= 0.5 then
			chartAccum = 0
			table.remove(chartHistory, 1)
			table.insert(chartHistory, math.clamp(currentFps/60,0.05,1))
			if pageOverview.Visible then redrawChart() end
		end
	end
end)

