function refreshServer()
	local now = os.time()
	local okSrv, srv = pcall(function() return workspace:GetServerTimeNow() end)
	svTime.Text = okSrv and os.date("%H:%M:%S", math.floor(srv)) or os.date("%H:%M:%S")
	svLocal.Text = os.date("%H:%M:%S")
	svUptime.Text = fmtTime(now - SESSION_START)
	local okMem, mem = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
	svMem.Text = okMem and string.format("%.0f MB", mem) or "--"
	local okPing, ping = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	svPing.Text = okPing and (math.floor(ping) .. " ms") or "--"
	svPlace.Text = tostring(game.PlaceId)
	local jid = game.JobId
	svJob.Text = (jid and jid ~= "") and jid or "客户端不可读"

	local ch = LP.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp then
		svCoord.Text = string.format("%.0f, %.0f, %.0f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
	else
		svCoord.Text = "--"
	end

	for _, c in ipairs(playersBox:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	local list = Players:GetPlayers()
	for i, pl in ipairs(list) do
		local f = new("Frame", {
			Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = COL.bgSoft,
			BorderSizePixel = 0, LayoutOrder = i, Parent = playersBox,
		})
