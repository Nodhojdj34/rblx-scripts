	b.BackgroundTransparency = prim and 0 or 0.86
	b.BorderSizePixel = 0; b.ZIndex = 12; b.AutoButtonColor = false
	b.Parent = controlsRow
	corner(b, sz / 2)
	stroke(b, Color3.new(1,1,1), prim and 0.72 or 0.82, 1.5)
	b.MouseEnter:Connect(function() b.BackgroundTransparency = prim and 0.1 or 0.74 end)
	b.MouseLeave:Connect(function() b.BackgroundTransparency = prim and 0 or 0.86 end)
	return b
end

