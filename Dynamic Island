-- [22] Main loop ---------------------------------------------------
local lastVP = Vector2.new(-1, -1)
local fpsFrames = 0
local fpsElapsed = 0
local fpsHistory = []
local fpsSampleInterval = 0.3

local function updateFpsChart()
	local n = #fpsHistory
	for i = 1, CHART_N do
		local idx = i - (CHART_N - n)
		local val = 0
		if n >= CHART_N then
			val = fpsHistory[i] or 0
		elseif idx >= 1 then
			val = fpsHistory[idx] or 0
		end
		local ratio = math.clamp(val / 60, 0, 1)
		local bar = fpsBars[i]
		bar.Size = UDim2.new(1 / CHART_N, -2, 0, math.max(2, math.floor(ratio * 30)))
		if val >= 50 then
			bar.BackgroundColor3 = currentTheme.accent
		elseif val >= 30 then
			bar.BackgroundColor3 = COL.warn
		else
			bar.BackgroundColor3 = COL.danger
		end
		bar.BackgroundTransparency = 0.3
	end
end

RunService.RenderStepped:Connect(function(dt)
	local vp = camera.ViewportSize
	if vp ~= lastVP then
		lastVP = vp
		local w = isExpanded and expandedWidth() or collapsedWidth()
		local h = isExpanded and expandedHeight() or 38
		clampPosition(w, h)
		if not isDragging then
			root.Size = UDim2.fromOffset(w, h)
			root.Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY))
		end
	end

	-- 性能模式下降频 FPS 采样
	fpsSampleInterval = perfMode and 1.0 or 0.3

	fpsFrames = fpsFrames + 1
	fpsElapsed = fpsElapsed + dt
	if fpsElapsed >= fpsSampleInterval then
		local fps = math.floor(fpsFrames / fpsElapsed + 0.5)
		fpsFrames = 0
		fpsElapsed = 0
		table.insert(fpsHistory, fps)
		while #fpsHistory > CHART_N do
			table.remove(fpsHistory, 1)
		end
		fpsValue.Text = tostring(fps)
		updateFpsChart()

		if fps < 30 then
			lowFpsTime = lowFpsTime + fpsSampleInterval
			if lowFpsTime >= 2 and (os.clock() - lastLowFpsNotify) > 60 then
				lastLowFpsNotify = os.clock()
				if showNotification then
					showNotification("性能警告", "帧率持续低于 30，建议降低画质", 3)
				end
			end
		else
			lowFpsTime = 0
		end
	end

	-- 呼吸光效（性能模式下禁用）
	if not perfMode then
		if musicSound.Playing then
			local s = math.abs(math.sin(os.clock() * 3))
			iconGlow.Thickness = 2 + s * 3
			iconGlow.Transparency = 0.5 - s * 0.35
		else
			iconGlow.Thickness = 2
			iconGlow.Transparency = 0.5
		end
	end

	-- 三段阴影跟随
	local rp = root.AbsolutePosition
	local rs = root.AbsoluteSize
	shadowFar.Position = UDim2.fromOffset(rp.X - 10, rp.Y + 6)
	shadowFar.Size = UDim2.fromOffset(rs.X + 20, rs.Y + 20)
	shadowMid.Position = UDim2.fromOffset(rp.X - 6, rp.Y + 3)
	shadowMid.Size = UDim2.fromOffset(rs.X + 12, rs.Size and 0 or 0, 0, 0)
	shadowMid.Size = UDim2.fromOffset(rs.X + 12, rs.Y + 12)
	shadowNear.Position = UDim2.fromOffset(rp.X - 3, rp.Y + 1)
	shadowNear.Size = UDim2.fromOffset(rs.X + 6, rs.Y + 6)
end)

