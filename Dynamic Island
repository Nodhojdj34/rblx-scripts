		BackgroundTransparency = initialOn and 0.15 or 0.55,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = initialOn and Color3.new(1, 1, 1) or COL.textDim,
		Text = initialOn and "开启" or "关闭",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(58, 26),
	}, card)
	corner(btn, UDim.new(0, 13))
	addPressEffect(btn)
	local state = initialOn
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = state and "开启" or "关闭"
		btn.BackgroundColor3 = state and currentTheme.accent or COL.cardSoft
		btn.BackgroundTransparency = state and 0.15 or 0.55
		btn.TextColor3 = state and Color3.new(1, 1, 1) or COL.textDim
		callback(state)
	end)
