function loadAndPlay(id)
	local numId = parseId(id)
	if not numId then showNotification("无效 ID","请输入数字音频 ID",2.5); return end
	if isMusicLoading then return end
	isMusicLoading = true; currentMusicId = numId
	musicSound:Stop(); musicSound.TimePosition = 0
	musicSound.SoundId = "rbxassetid://" .. tostring(numId)
	updateMusicUI(); updateCollapsedText()
	task.spawn(function()
		local waited = 0
		while not musicSound.IsLoaded and waited < 10 do
			task.wait(0.1); waited = waited + 0.1
			if currentMusicId ~= numId then isMusicLoading = false; return end
		end
		if currentMusicId ~= numId then isMusicLoading = false; return end
		isMusicLoading = false
		if musicSound.IsLoaded then
			local targetVol = isMuted and 0 or lastVolume
			musicSound.Volume = fadeEnabled and 0 or targetVol
			musicSound:Play()
			if fadeEnabled then tw(musicSound, 0.6, { Volume = targetVol }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out) end
			addRecent(numId); showNotification("正在播放","ID " .. tostring(numId),2)
			if not isExpanded then tw(root, 0.25, { Size = UDim2.fromOffset(collapsedWidth(), ISLAND_H) }) end
		else
			currentMusicId = nil
			showNotification("播放失败","音频未公开 / 已下架",2.5)
			if not isExpanded then tw(root, 0.25, { Size = UDim2.fromOffset(ISLAND_W, ISLAND_H) }) end
		end
		updateMusicUI(); updateCollapsedText()
	end)
end
function toggleMusic()
