-- Sliders
local sliders, activeSlider = {}, nil
local function registerSlider(holder, fill, isActive, onChange)
	local s = { holder=holder, fill=fill, isActive=isActive, onChange=onChange }
	table.insert(sliders, s)
	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isActive and not isActive() then return end
			activeSlider = s
			local ap, as = holder.AbsolutePosition, holder.AbsoluteSize
			if as.X > 1 then
				local rel = math.clamp((input.Position.X - ap.X) / as.X, 0, 1)
				fill.Size = UDim2.new(rel,0,1,0)
				if onChange then onChange(rel) end
			end
		end
	end)
	return s
end
local function sliderDrag(s, screenX)
	local ap, as = s.holder.AbsolutePosition, s.holder.AbsoluteSize
	if as.X <= 1 then return end
	local rel = math.clamp((screenX - ap.X) / as.X, 0, 1)
	s.fill.Size = UDim2.new(rel,0,1,0)
	if s.onChange then s.onChange(rel) end
end
registerSlider(musicSeek, musicSeekFill, function() return pageMusic.Visible and currentMusicId ~= nil end, function(rel)
	if not currentMusicId or not musicSound.IsLoaded then return end
	local dur = musicSound.TimeLength
	if dur > 0 then musicSound.TimePosition = math.clamp(rel*dur,0,dur); updateMusicUI() end
end)
registerSlider(musicVolume, musicVolumeFill, function() return pageMusic.Visible end, function(rel)
	lastVolume = math.clamp(rel, 0, 1)
	if isMuted then isMuted = false; volPct.TextColor3 = COL.textDim end
	musicSound.Volume = lastVolume
	volPct.Text = tostring(math.floor(lastVolume*100+0.5)) .. "%"
end)
