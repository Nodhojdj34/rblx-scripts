--==============================================================
--  状态机
--==============================================================
local STATE = { Idle = "Idle", Music = "Music", Notification = "Notification" }

local currentState  = STATE.Idle
local collapseToken = 0
local isPlaying     = true

local setState
local scheduleCollapse

scheduleCollapse = function(delay)
	if not delay or delay <= 0 then return end
	collapseToken += 1
	local token = collapseToken
	task.delay(delay, function()
		if token == collapseToken and currentState ~= STATE.Idle then
			setState(STATE.Idle)
		end
	end)
end

local function radiusFor(h) return num(math.min(h / 2, 40)) end

setState = function(state)
	if state == currentState then return end
	currentState = state
	collapseToken += 1

	local targetSize, targetRadius
	if state == STATE.Music then
		targetSize   = dim(CONFIG.Size.Music.X, CONFIG.Size.Music.Y)
		targetRadius = radiusFor(CONFIG.Size.Music.Y)
	elseif state == STATE.Notification then
		targetSize   = dim(CONFIG.Size.Notif.X, CONFIG.Size.Notif.Y)
		targetRadius = radiusFor(CONFIG.Size.Notif.Y)
	else
		targetSize   = dim(CONFIG.Size.Idle.X, CONFIG.Size.Idle.Y)
		targetRadius = num(CONFIG.Size.Idle.Y / 2)
	end

	animateSize(targetSize, targetRadius, CONFIG.AnimTime)

	-- 只启用当前层交互，避免收起态幽灵点击
	setInteractive(state == STATE.Music)

	setAlpha(compactParts, 1, 0.10)
	setAlpha(musicParts,   1, 0.10)
	setAlpha(notifParts,   1, 0.10)

	local myState = state
	task.delay(0.10, function()
		if currentState ~= myState then return end
		setAlpha(compactParts, myState == STATE.Idle and 0 or 1, 0.22)
		setAlpha(musicParts,   myState == STATE.Music and 0 or 1, 0.22)
		setAlpha(notifParts,   myState == STATE.Notification and 0 or 1, 0.22)
	end)
end

