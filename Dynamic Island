local COLLAPSED_SIZE = UDim2.fromOffset(136, 36)
local COLLAPSED_RADIUS = 18
local EXPANDED_RADIUS = 28
local EXPANDED_HEIGHT = 400

local function getExpandedSize()
	local camera = workspace.CurrentCamera
	local viewport = (camera and camera.ViewportSize) or Vector2.new(1280, 720)
	local width = math.clamp(viewport.X * 0.75, 280, 340)
	width = math.min(width, math.max(220, viewport.X - 32))
	return UDim2.fromOffset(width, EXPANDED_HEIGHT)
end

local animToken = 0
local autoCollapseToken = 0

local function setIconPosition(expanded, duration)
	local target = expanded
		and UDim2.new(0, 14, 0, 25)
		or UDim2.new(0, 10, 0.5, 0)
	TweenService:Create(icon,
		TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Position = target }):Play()
end

local function expandIsland(animate)
	local duration = animate and 0.32 or 0
	animToken = animToken + 1
	isExpanded = true

	local targetSize = getExpandedSize()
	expandedFrame.Size = targetSize
	expandedFrame.Position = UDim2.new(0.5, 0, 0, 0)
	expandedFrame.Visible = true
	expandedFrame.GroupTransparency = 1
	compactText.Visible = false
	clickButton.Visible = false

	setIconPosition(true, duration)

	TweenService:Create(root,
		TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = targetSize }):Play()
	TweenService:Create(rootCorner,
		TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ CornerRadius = UDim.new(0, EXPANDED_RADIUS) }):Play()
	TweenService:Create(expandedFrame,
		TweenInfo.new(math.max(0.01, duration * 1.15), Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ GroupTransparency = 0 }):Play()

	if duration == 0 then
		root.Size = targetSize
		expandedFrame.GroupTransparency = 0
	end
end

local function collapseIsland(animate)
	local duration = animate and 0.28 or 0
	animToken = animToken + 1
	local myToken = animToken
	isExpanded = false

	setIconPosition(false, duration)

	TweenService:Create(root,
		TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = COLLAPSED_SIZE }):Play()
	TweenService:Create(rootCorner,
		TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ CornerRadius = UDim.new(0, COLLAPSED_RADIUS) }):Play()
	TweenService:Create(expandedFrame,
		TweenInfo.new(math.max(0.01, duration * 0.55), Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ GroupTransparency = 1 }):Play()

	if duration == 0 then
		root.Size = COLLAPSED_SIZE
		expandedFrame.GroupTransparency = 1
	end

	task.delay(duration, function()
		if myToken ~= animToken then return end
		if isExpanded then return end
		expandedFrame.Visible = false
		compactText.Visible = true
		clickButton.Visible = true
		updateClock()
	end)
end

