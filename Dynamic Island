--==== 音乐逻辑 ====
local function syncPlayBtn()
	if isMusicLoading then
		playPauseBtn.Text = "加载"
	elseif sound.IsPlaying then
		playPauseBtn.Text = "暂停"
	else
		playPauseBtn.Text = "播放"
	end
end

local function playMusic(rawId)
	local id = tostring(rawId or ""):match("%d+")
	if not id then
		notify("无法播放", "请输入有效的音频 ID", "warn")
		return
	end
	isMusicLoading = true
	updateCollapsedText()
	syncPlayBtn()
	sound:Stop()
	sound.SoundId = "rbxassetid://" .. id
	musicTitle.Text = "加载中 #" .. id

	local t0 = os.clock()
	while not sound.IsLoaded and os.clock() - t0 < 10 do
		task.wait(0.05)
	end
	isMusicLoading = false

	if not sound.IsLoaded then
		hasMusic = false
		musicTitle.Text = "加载失败"
		notify("加载失败", "音频 " .. id .. " 无法播放", "danger")
		syncPlayBtn()
		updateCollapsedText()
		return
	end

	hasMusic = true
	sound.TimePosition = 0
	sound:Play()
	musicTitle.Text = "音频 #" .. id
	totTime.Text = fmtTime(sound.TimeLength)
	notify("正在播放", "音频 #" .. id, "good")
	syncPlayBtn()
	updateCollapsedText()
	if not isExpanded then
		TweenService:Create(root, TweenInfo.new(0.25), {
			Size = UDim2.fromOffset(collapsedWidth(), 38),
		}):Play()
	end
end

