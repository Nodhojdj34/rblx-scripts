RunService.RenderStepped:Connect(function()
	local rp = root.Position
	local rs = root.Size
	local x, y = rp.X.Offset, rp.Y.Offset
	local w, h = rs.X.Offset, rs.Y.Offset

	shFar.Position = UDim2.fromOffset(x, y + 14)
	shFar.Size = UDim2.fromOffset(w + 28, h + 26)
	shMid.Position = UDim2.fromOffset(x, y + 8)
	shMid.Size = UDim2.fromOffset(w + 16, h + 14)
	shNear.Position = UDim2.fromOffset(x, y + 4)
	shNear.Size = UDim2.fromOffset(w + 8, h + 6)

	local now = os.clock()
	table.insert(fpsSamples, now)
	while fpsSamples[1] and now - fpsSamples[1] > 1 do
		table.remove(fpsSamples, 1)
	end

	local breath = (math.sin(now * 3) + 1) * 0.5
	local alpha = 0.15 + breath * 0.55
	dot.BackgroundTransparency = alpha
	statusDot.BackgroundTransparency = alpha

	if stopwatchRunning then renderStopwatch() end
	if countdownRunning then
		local left = countdownEnd - os.clock()
		if left <= 0 then
			countdownRunning = false
			cdVal.Text = "00:00"
			cdVal.TextColor3 = COL.text
			notify("倒计时结束", "时间到", "warn")
		else
			cdVal.Text = string.format("%02d:%02d", math.floor(left / 60), math.floor(left % 60))
			cdVal.TextColor3 = left <= 5 and COL.danger or COL.text
		end
	end
end)

--==== 数据刷新 ====
task.spawn(function()
	while true do
		task.wait(0.5)
		local f = #fpsSamples
		fpsValue.Text = tostring(f)
		if f >= 50 then
			fpsState.Text = "流畅"
			fpsState.TextColor3 = COL.good
		elseif f >= 30 then
			fpsState.Text = "一般"
			fpsState.TextColor3 = COL.warn
		else
			fpsState.Text = "卡顿"
			fpsState.TextColor3 = COL.danger
		end

		local okPing, ping = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if okPing and type(ping) == "number" then
			ping = math.floor(ping)
			pingVal.Text = ping .. "ms"
			pingVal.TextColor3 = ping < 80 and COL.good or (ping < 160 and COL.warn or COL.danger)
		else
			pingVal.Text = "--"
			pingVal.TextColor3 = COL.faint
		end

		playersVal.Text = tostring(#Players:GetPlayers())
		local okMem, mem = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
		memVal.Text = okMem and string.format("%.0fM", mem) or "--"

		local t = os.date("*t")
		clockLabel.Text = os.date("%H:%M:%S")
		dateLabel.Text = os.date("%Y/%m/%d") .. "  周" .. WEEK[t.wday]

		if not isExpanded then updateCollapsedText() end
		if pagesMap.server.Visible and refreshServer then refreshServer() end
	end
end)

