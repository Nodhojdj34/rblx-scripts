		pad(f, 10, 0, 10, 0)
		local isMe = (pl == LP)
		new("Frame", {
			Size = UDim2.fromOffset(6, 6), AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = isMe and accent or COL.good,
