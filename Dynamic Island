-- ===================== 工具 =====================

local function clamp(v, a, b) return math.min(math.max(v, a), b) end

local function fmt(s)
	s = math.floor(math.max(0, s or 0))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function corner(p, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = p; return c
end

local function stroke(p, col, tr, th)
	local s = Instance.new("UIStroke")
	s.Color = col; s.Transparency = tr; s.Thickness = th
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p; return s
end

local function grad(p, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2) })
	g.Transparency = NumberSequence.new(0); g.Rotation = rot or 0; g.Parent = p; return g
end

local function pad(p, l, t, r, b)
	local x = Instance.new("UIPadding")
	x.Left = UDim.new(0, l or 0); x.Top = UDim.new(0, t or 0)
	x.Right = UDim.new(0, r or 0); x.Bottom = UDim.new(0, b or 0); x.Parent = p; return x
end

local function layout(p, dir, pd, ha, va)
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Horizontal
	l.HorizontalAlignment = ha or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = va or Enum.VerticalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = pd or UDim.new(0, 0); l.Parent = p; return l
end

local function vpSize()
	local cam = workspace.CurrentCamera
	if cam and cam.ViewportSize then return cam.ViewportSize.X, cam.ViewportSize.Y end
	return 1000, 600
end

local function expW()
	local w = vpSize()
	return clamp(math.floor(w * C.expRatio), C.expMinW, C.expMaxW)
end

local function inside(obj, x, y)
	if not obj or not obj.Visible then return false end
	local p = obj.AbsolutePosition; local s = obj.AbsoluteSize
	return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

