local function mkBtn(od, txt, sz, prim)
	local b = Instance.new("TextButton")
	b.LayoutOrder = od; b.Size = UDim2.new(0, sz, 0, sz)
	b.Text = txt; b.Font = Enum.Font.GothamBold
	b.TextSize = math.max(12, math.floor(sz * 0.42))
