		btn.TextColor3 = active and TAB_ACTIVE_TEXT or TAB_IDLE_TEXT
		btn.BackgroundTransparency = active and 0 or 0.4
	end

	if name == "notif" then
		unreadNotifications = 0
		notifBadge.Visible = false
		renderNotifications()
	elseif name == "server" and refreshServerTab then
		refreshServerTab()
	elseif name == "home" then
		refreshHomeStats()
	end
end

