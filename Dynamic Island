switchTab = function(key, silent)
	activeTab = key
	for _, t in ipairs(TABS) do
		local active = (t.key == key)
		t.page.Visible = active
		if active then
			t.page.CanvasPosition = Vector2.zero
			headerTitle.Text = t.label
		end
		t.btn.BackgroundColor3 = active and currentTheme.accent or COL.card
		t.btn.BackgroundTransparency = active and 0.82 or 0.55
		t.btn.TextColor3 = active and Color3.new(1, 1, 1) or COL.textDim
		t.btn.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
	end
	if key == "server" and updateServerTab then updateServerTab() end
	if key == "notification" and not silent then
		unreadCount = 0
		updateBadge()
	end
end

