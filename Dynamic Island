local function getPing()
	local ok, val = pcall(function()
		local net = StatsService:FindFirstChild("Network")
		if not net then return nil end
		local item = net:FindFirstChild("ServerStatsItem")
		if not item then return nil end
		local data = item:FindFirstChild("Data Ping")
		if not data then return nil end
		local v = data:GetValue()
		if type(v) == "number" and v > 0 then return v end
		local s = data:GetValueString()
		return tonumber(string.match(s or "", "%d+"))
	end)
	if ok and type(val) == "number" and val > 0 then return math.floor(val + 0.5) end
	return nil
end
