local function new(class, props, parent)
	local i = Instance.new(class)
	if props then for k,v in pairs(props) do i[k] = v end end
	if parent then i.Parent = parent end
	return i
end
local function tw(inst, dur, props, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(dur, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play(); return t
end
local function fmtClock(sec)
	sec = math.max(0, math.floor(sec or 0))
	local h = math.floor(sec/3600); local m = math.floor((sec%3600)/60); local s = sec%60
	if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
	return string.format("%02d:%02d", m, s)
end
local function fmtStopwatch(sec)
	sec = math.max(0, sec or 0)
	local m = math.floor(sec/60); local s = math.floor(sec%60); local cs = math.floor((sec*100)%100)
	return string.format("%02d:%02d.%02d", m, s, cs)
end
local function fmtCountdown(sec)
	sec = math.max(0, math.ceil(sec or 0))
	return string.format("%02d:%02d", math.floor(sec/60), sec%60)
end
local function parseId(text)
	if not text then return nil end
	local s = string.gsub(string.gsub(tostring(text), "rbxassetid://", ""), "%s", "")
	local n = tonumber(s)
	if n and n > 0 then return math.floor(n) end
	return nil
end
local function pingColor(p)
	if not p then return COL.textDim end
	if p < 80 then return COL.good end
	if p < 160 then return COL.warn end
	return COL.danger
end
local function label(parent, props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	return new("TextLabel", props, parent)
end
local function addPressEffect(btn)
	local scale = new("UIScale", { Scale = 1 }, btn)
	btn.MouseButton1Down:Connect(function() tw(scale, 0.08, { Scale = 0.94 }) end)
	local function reset() tw(scale, 0.12, { Scale = 1 }) end
	btn.MouseButton1Up:Connect(reset); btn.MouseLeave:Connect(reset)
end
local accentBindings = {}
local function bindAccent(inst, prop)
	table.insert(accentBindings, { inst = inst, prop = prop })
	inst[prop] = accent
end

