		setMusicStatus("还没有音乐，先输入 ID 并加载", COL.warn)
		return
	end
	if musicSound.Playing then
		musicSound:Pause()
	elseif musicSound.IsPaused then
		musicSound:Resume()
	else
		if musicSound.TimeLength > 0 and musicSound.TimePosition >= musicSound.TimeLength - 0.2 then
			musicSound.TimePosition = 0
		end
		if musicSound.IsLoaded then
			musicSound:Play()
			local targetVol = isMuted and 0 or lastVolume
			musicSound.Volume = targetVol
		else
			loadAndPlay(tostring(currentMusicId))
		end
	end
	if updateMusicUI then updateMusicUI() end
end

