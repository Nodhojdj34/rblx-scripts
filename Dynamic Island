--==== 尺寸计算 ====
function collapsedWidth()
	return hasMusic and 190 or 146
end

local function expandedSize()
	local v = vp()
	local w = math.clamp(math.floor(v.X * 0.8), 288, 360)
	w = math.min(w, v.X - 32)
	local h = math.clamp(math.floor(v.Y - 70), 280, 420)
	h = math.min(h, v.Y - 40)
	return UDim2.fromOffset(w, h)
end

local function insideRoot(p)
	local ap = root.AbsolutePosition
	local as = root.AbsoluteSize
	return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
end

