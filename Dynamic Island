		return
	end

	for i, id in ipairs(recentIds) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 20)
		btn.LayoutOrder = i
		btn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
		btn.BorderSizePixel = 0
		btn.Text = "▶  ID " .. id
		btn.TextColor3 = Color3.fromRGB(220, 220, 220)
		btn.TextSize = 11
		btn.Font = Enum.Font.Gotham
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.AutoButtonColor = false
		btn.ZIndex = 6
		btn.Parent = recentScroll

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = btn

		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 8)
		padding.Parent = btn

		btn.MouseButton1Click:Connect(function()
			loadAndPlay(id)
		end)
	end
end

local function addRecent(id)
	id = tostring(id)
	for i, v in ipairs(recentIds) do
		if v == id then
			table.remove(recentIds, i)
			break
		end
	end
	table.insert(recentIds, 1, id)
	while #recentIds > 5 do
		table.remove(recentIds)
	end
	renderRecent()
end

