local pagesMap = {}
local function makePage(name)
	local f = new("ScrollingFrame", {
		Name = name,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = COL.cardSoft,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = pages,
	})
	pad(f, 4, 2, 4, 12)
	vlist(f, 8)
	pagesMap[name] = f
	local n = 0
	return f, function(o) n = n + 1; o.LayoutOrder = n; o.Parent = f; return o end
end

local function makeCard(parent, h)
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = COL.card, BorderSizePixel = 0 })
	corner(f, 12)
	parent(f)
	return f
end

