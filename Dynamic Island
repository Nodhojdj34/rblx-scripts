--================================================================
local function expandedHeight()
	local h = math.floor(camera.ViewportSize.Y - 70)
	return math.clamp(h, 280, 420)
end

local function expandedWidth()
	local w = math.floor(camera.ViewportSize.X * 0.8)
	return math.clamp(w, 288, 360)
end

local function clampPosition(w, h)
	local vp = camera.ViewportSize
	islandCenterX = math.clamp(islandCenterX, w / 2 + 4, math.max(w / 2 + 4, vp.X - w / 2 - 4))
	islandTopY = math.clamp(islandTopY, guiInset.Y + 2, math.max(guiInset.Y + 2, vp.Y - h - 6))
end

expandIsland = function()
	if isExpanded then return end
	isExpanded = true
	expandToken = expandToken + 1
	local token = expandToken

	local w = expandedWidth()
	local h = expandedHeight()
	clampPosition(w, h)

	collapsedGroup.Visible = true
	expandedGroup.Visible = true
	expandedGroup.GroupTransparency = 1
	if switchTab then switchTab(activeTab) end

	rootScale.Scale = 0.96
	tw(rootScale, 0.3, { Scale = 1 })
	tw(root, 0.36, {
		Size = UDim2.fromOffset(w, h),
		Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY)),
	})
	tw(rootCorner, 0.36, { CornerRadius = UDim.new(0, 26) })
	tw(expandedGroup, 0.26, { GroupTransparency = 0 })
	tw(collapsedGroup, 0.12, { GroupTransparency = 1 })

	task.delay(0.42, function()
		if token ~= expandToken or not isExpanded then return end
		collapsedGroup.Visible = false
	end)
end

collapseIsland = function()
	if not isExpanded then return end
	isExpanded = false
	expandToken = expandToken + 1
	local token = expandToken

	local w = collapsedWidth()
	clampPosition(w, 38)

	collapsedGroup.Visible = true
	tw(expandedGroup, 0.16, { GroupTransparency = 1 })
	tw(collapsedGroup, 0.22, { GroupTransparency = 0 })
	tw(root, 0.3, {
		Size = UDim2.fromOffset(w, 38),
		Position = UDim2.fromOffset(math.floor(islandCenterX), math.floor(islandTopY)),
	})
	tw(rootCorner, 0.3, { CornerRadius = UDim.new(0, 19) })

	task.delay(0.34, function()
		if token ~= expandToken or isExpanded then return end
		expandedGroup.Visible = false
	end)
end

