	end

	playBtn.Text = musicSound.Playing and "⏸ 暂停" or "▶ 播放"

	if not perfMode then
		local loud = musicSound.PlaybackLoudness or 0
		local playing = musicSound.Playing
		for i, bar in ipairs(visBars) do
			local noise = (math.noise(i * 0.45, musicTick * 1.8) + 1) * 0.5
			local h = playing and math.clamp(6 + (loud / 700) * noise * 24, 6, 30) or 6
			bar.Size = UDim2.new(0, 4, 0, math.floor(h))
		end
	end
end

