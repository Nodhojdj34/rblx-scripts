-- 倒计时/秒表更新函数
updateStopwatchDisplay = function()
	if swRunning then
		swValue = swAccum + (os.clock() - swStartClock)
	else
		swValue = swAccum
	end
	swLabel.Text = fmtStopwatch(swValue)
end

updateCountdownDisplay = function()
	if cdActive then
		cdValue = math.max(0, cdEndClock - os.clock())
		cdLabel.Text = fmtCountdown(cdValue)
		cdLabel.TextColor3 = (cdValue <= 5) and COL.danger or COL.text
	else
		cdValue = 0
		cdLabel.Text = (cdLabel.Text == "00:00") and "00:00" or "--:--"
		cdLabel.TextColor3 = COL.text
	end
end

swStartBtn.MouseButton1Click:Connect(function()
	if swRunning then return end
	swRunning = true
	swStartClock = os.clock()
end)

swPauseBtn.MouseButton1Click:Connect(function()
	if not swRunning then return end
	swAccum = swAccum + (os.clock() - swStartClock)
	swRunning = false
	updateStopwatchDisplay()
end)

swResetBtn.MouseButton1Click:Connect(function()
	swRunning = false
	swAccum = 0
	swValue = 0
	swLabel.Text = "00:00.00"
end)

local function startCountdown(seconds)
	if cdActive then
		cdActive = false
	end
	cdActive = true
	cdEndClock = os.clock() + seconds
	cdLabel.Text = fmtCountdown(seconds)
	cdLabel.TextColor3 = COL.text
end

cd1Btn.MouseButton1Click:Connect(function() startCountdown(60) end)
cd5Btn.MouseButton1Click:Connect(function() startCountdown(300) end)
cd10Btn.MouseButton1Click:Connect(function() startCountdown(600) end)

cdStopBtn.MouseButton1Click:Connect(function()
	cdActive = false
	cdLabel.Text = "--:--"
	cdLabel.TextColor3 = COL.text
end)

