applyTheme = function(key)
	local theme = currentTheme
	for _, t in ipairs(THEMES) do
		if t.key == key then theme = t end
	end
	currentTheme = theme
	for _, item in ipairs(accentTargets) do
		pcall(function() item.obj[item.prop] = theme.accent end)
	end
	for _, d in ipairs(themeDots) do
		d.sel.Transparency = (d.key == theme.key) and 0 or 1
	end
	if statusActive and not notificationActive then
		clockLabel.TextColor3 = theme.accent
	end
	if switchTab and activeTab then switchTab(activeTab, true) end
	if updateLoopBtn then updateLoopBtn() end
end

