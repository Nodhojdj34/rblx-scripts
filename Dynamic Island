function addRecent(id)
	for i = #recentPlaylist, 1, -1 do if recentPlaylist[i] == id then table.remove(recentPlaylist, i) end end
	table.insert(recentPlaylist, 1, id)
	while #recentPlaylist > RECENT_MAX do table.remove(recentPlaylist) end
	renderRecent()
end
