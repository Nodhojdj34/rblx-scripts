local function flashCollapsed(title, duration)
	notifFlashToken = notifFlashToken + 1
	local token = notifFlashToken
	notificationActive = true
	clockLabel.Text = title
	clockLabel.TextColor3 = currentTheme.accent
	if not isExpanded then
		tw(root, 0.24, { Size = UDim2.fromOffset(220, 38) })
	end
	task.delay(math.max(duration or 2.5, 1), function()
		if token ~= notifFlashToken then return end
		notificationActive = false
		if statusActive then
			clockLabel.Text = currentStatusText
			clockLabel.TextColor3 = currentTheme.accent
		else
			clockLabel.TextColor3 = COL.text
			if updateClock then updateClock() end
		end
		if not isExpanded then
			tw(root, 0.28, { Size = UDim2.fromOffset(currentMusicId and 190 or 146, 38) })
		end
	end)
end

showNotification = function(title, subtitle, duration)
	table.insert(notifData, 1, {
		title = title or "通知",
		sub = subtitle or "",
		time = os.date("%H:%M"),
	})
	while #notifData > 20 do
		table.remove(notifData)
	end
	unreadCount = unreadCount + 1
	if renderNotifications then renderNotifications() end
	if not isExpanded then
		flashCollapsed(title or "通知", duration)
	end
end

