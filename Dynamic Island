--==== 展开 / 收起 ====
function expandIsland()
	if isExpanded then return end
	isExpanded = true
	expandToken = expandToken + 1
	local tk = expandToken

	collapsed.Visible = false
	sheen.Visible = false
	topLine.Visible = false
	expanded.Visible = true
	expanded.GroupTransparency = 1

	local dur = animOn and 0.3 or 0.01
	TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = expandedSize(),
	}):Play()
	TweenService:Create(rootCorner, TweenInfo.new(dur), { CornerRadius = UDim.new(0, 26) }):Play()
	TweenService:Create(expanded, TweenInfo.new(dur * 0.8), { GroupTransparency = 0 }):Play()

	if refreshServer then refreshServer() end
	if refreshNotifications then refreshNotifications() end
	updateCollapsedText()
end

function collapseIsland()
	if not isExpanded then return end
	isExpanded = false
	expandToken = expandToken + 1
	local tk = expandToken

	local dur = animOn and 0.26 or 0.01
	TweenService:Create(expanded, TweenInfo.new(dur * 0.7), { GroupTransparency = 1 }):Play()
	TweenService:Create(rootCorner, TweenInfo.new(dur), { CornerRadius = UDim.new(0, 19) }):Play()

	local tw = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(collapsedWidth(), 38),
	})
	tw.Completed:Connect(function()
		if tk ~= expandToken then return end
		expanded.Visible = false
		collapsed.Visible = true
		sheen.Visible = true
		topLine.Visible = true
		updateCollapsedText()
	end)
	tw:Play()
end

