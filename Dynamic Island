loadAndPlay = function(text, skipClearQueue)
	local id = (type(text) == "number") and text or parseId(text)
	if not id then
		setMusicStatus("ID 无效，请输入纯数字", COL.danger)
		if showNotification then showNotification("播放失败", "音频 ID 无效", 2) end
		return
	end
	if isMusicLoading then return end

	if not skipClearQueue then
		musicQueue = {}
		if renderQueue then renderQueue() end
	end

	setLoadingState(true)
	currentMusicId = id
	musicSound:Stop()
	musicSound.TimePosition = 0
	musicSound.SoundId = "rbxassetid://" .. tostring(id)

	task.spawn(function()
		local t = 0
		while not musicSound.IsLoaded and t < 10 do
			task.wait(0.1)
			t = t + 0.1
			if currentMusicId ~= id then
				setLoadingState(false)
				return
			end
		end
		if currentMusicId ~= id then
			setLoadingState(false)
			return
		end
		setLoadingState(false)
		if musicSound.IsLoaded then
			musicSound:Play()
			local targetVol = isMuted and 0 or lastVolume
			if fadeEnabled then
				musicSound.Volume = 0
				TweenService:Create(musicSound, TweenInfo.new(0.6), { Volume = targetVol }):Play()
			else
				musicSound.Volume = targetVol
			end
			setMusicStatus("正在播放 · ID " .. tostring(id), COL.textDim)
			addRecent(id)
			if showNotification then showNotification("正在播放", "ID " .. tostring(id), 2) end
			if not isExpanded then
				tw(root, 0.25, { Size = UDim2.fromOffset(190, 38) })
			end
		else
			currentMusicId = nil
			setMusicStatus("加载失败：音频未公开 / 已下架", COL.danger)
			if showNotification then showNotification("播放失败", "音频无法加载", 2.5) end
			if not isExpanded then
				tw(root, 0.25, { Size = UDim2.fromOffset(146, 38) })
			end
		end
		if updateMusicUI then updateMusicUI() end
	end)
end

