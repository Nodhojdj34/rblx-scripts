local function makeCard(parent, order, height, autoHeight)
	local props = { BackgroundColor3=COL.card, BorderSizePixel=0, Size=UDim2.new(1,0,0,height), LayoutOrder=order, ZIndex=43 }
	if autoHeight then props.AutomaticSize = Enum.AutomaticSize.Y end
	local f = new("Frame", props, parent)
	new("UICorner", { CornerRadius = UDim.new(0, 14) }, f)
	return f
end
local function makeButtonRow(parent, defs, y, height)
	local row = new("Frame", { BackgroundTransparency=1, Position=UDim2.fromOffset(12,y), Size=UDim2.new(1,-24,0,height), ZIndex=44 }, parent)
	local count = #defs
	for i, def in ipairs(defs) do
		local btn = new("TextButton", { BackgroundColor3=def.color or COL.cardSoft, BorderSizePixel=0, Position=UDim2.new((i-1)/count,0,0,0), Size=UDim2.new(1/count,-4,1,0), Font=Enum.Font.GothamMedium, TextSize=12, TextColor3=COL.text, Text=def.text, AutoButtonColor=false, ZIndex=45 }, row)
		new("UICorner", { CornerRadius = UDim.new(0, 9) }, btn)
		addPressEffect(btn)
		if def.onClick then btn.MouseButton1Click:Connect(def.onClick) end
		def.button = btn
	end
	return row
end

