	{key="pink",   name="蜜桃", accent=Color3.fromRGB(255, 89, 176)},
}
local themeMap = {}
for _, t in ipairs(THEMES) do themeMap[t.key] = t end
local currentTheme = "green"

local accentTargets = {}
local function registerAccent(obj, prop)
	table.insert(accentTargets, {obj=obj, prop=prop})
end

local function applyTheme(key)
	local t = themeMap[key]
	if not t then return end
	currentTheme = key
	for _, target in ipairs(accentTargets) do
		target.obj[target.prop] = t.accent
	end
end

