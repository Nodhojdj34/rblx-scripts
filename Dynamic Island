updateMusicUI = function()
	local len = musicSound.TimeLength or 0
	local pos = musicSound.TimePosition or 0
	local ratio = (len > 0) and math.clamp(pos / len, 0, 1) or 0

	seekFill.Size = UDim2.fromScale(ratio, 1)
	seekKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
	timeLabel.Text = fmtTime(pos) .. " / " .. (len > 0 and fmtTime(len) or "0:00")

	local hasMusic = (currentMusicId ~= nil)
	musicBadge.Visible = hasMusic
	collapsedBar.Visible = hasMusic and not isExpanded
	if hasMusic then
		musicBadge.Text = "♪ " .. fmtTime(pos)
		collapsedBarFill.Size = UDim2.fromScale(ratio, 1)
	end

	playBtn.Text = musicSound.Playing and "⏸ 暂停" or "▶ 播放"

	local loud = musicSound.PlaybackLoudness or 0
	local playing = musicSound.Playing
	for i, bar in ipairs(visBars) do
		local noise = (math.noise(i * 0.45, musicTick * 1.8) + 1) * 0.5
		local h = playing and math.clamp(6 + (loud / 700) * noise * 24, 6, 30) or 6
		bar.Size = UDim2.new(0, 4, 0, math.floor(h))
	end
end

