-- ================= 交互绑定 =================
local lastTapTime = 0

clickButton.Activated:Connect(function()
	local now = os.clock()
	if now - lastTapTime < 0.35 and currentMusicId then
		if not isExpanded then expandIsland(true) end
		switchTab("music")
		lastTapTime = 0
		return
	end
	lastTapTime = now

	if not isExpanded then
		autoCollapseToken = autoCollapseToken + 1
		expandIsland(true)
	end
end)

closeBtn.Activated:Connect(function()
	autoCollapseToken = autoCollapseToken + 1
	notificationActive = false
	collapseIsland(true)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not isExpanded then return end
	if gameProcessed then return end

	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1
		and t ~= Enum.UserInputType.Touch then
		return
	end

	local pos = input.Position
	local abs = root.AbsolutePosition
	local size = root.AbsoluteSize

	local insideX = pos.X >= abs.X and pos.X <= abs.X + size.X
	local insideY = pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y

	if not (insideX and insideY) then
		autoCollapseToken = autoCollapseToken + 1
		notificationActive = false
		collapseIsland(true)
	end
end)

