--  淡入淡出控制
--==============================================================
local compactParts = { dot }
local musicParts   = { cover, coverIcon, musicTitle, musicSubtitle, track, musicFill }
local notifParts   = { notifIcon, notifGlyph, notifTitle, notifBody }

local function setAlpha(parts, alpha, duration)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, obj in ipairs(parts) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			TweenService:Create(obj, info, { TextTransparency = alpha }):Play()
		elseif obj:IsA("ImageLabel") then
			TweenService:Create(obj, info, { ImageTransparency = alpha }):Play()
		elseif obj:IsA("Frame") then
			TweenService:Create(obj, info, { BackgroundTransparency = alpha }):Play()
		end
	end
end

-- 初始全部隐藏
setAlpha(compactParts, 0, 0)
setAlpha(musicParts, 1, 0)
setAlpha(notifParts, 1, 0)

--==============================================================
--  尺寸动画（自定义 Tween，可同时补间圆角半径并支持打断）
--==============================================================
local animToken = 0

local function animateSize(targetSize, targetRadius, duration)
	animToken += 1
	local token = animToken

	local startSize   = island.Size
	local startRadius = corner.CornerRadius.Offset

	if duration <= 0 then
		island.Size = targetSize
		corner.CornerRadius = UDim.new(0, targetRadius)
		return
	end

	local elapsed = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if token ~= animToken then
			conn:Disconnect()
			return
		end

		elapsed = math.min(elapsed + dt, duration)
		local a = elapsed / duration
		local e = 1 - (1 - a) ^ 5   -- easeOutQuint

		island.Size = UDim2.new(
			startSize.X.Scale  + (targetSize.X.Scale  - startSize.X.Scale)  * e,
			startSize.X.Offset + (targetSize.X.Offset - startSize.X.Offset) * e,
			startSize.Y.Scale  + (targetSize.Y.Scale  - startSize.Y.Scale)  * e,
			startSize.Y.Offset + (targetSize.Y.Offset - startSize.Y.Offset) * e
		)
		corner.CornerRadius = UDim.new(0, startRadius + (targetRadius - startRadius) * e)

		if a >= 1 then
			conn:Disconnect()
		end
	end)
end

--==============================================================
--  状态机
--==============================================================
local STATE = {
	Idle         = "Idle",
	Music        = "Music",
	Notification = "Notification",
}

local currentState  = STATE.Idle
local collapseToken = 0

local setState   -- 前置声明
local scheduleCollapse

scheduleCollapse = function(delay)
	collapseToken += 1
	local token = collapseToken
	task.delay(delay, function()
		if token == collapseToken and currentState ~= STATE.Idle then
			setState(STATE.Idle)
		end
	end)
end

setState = function(state)
	if state == currentState then return end
	currentState = state
	collapseToken += 1   -- 取消旧的自动收起计时

	local targetSize, targetRadius

	if state == STATE.Music then
		targetSize   = dim(BASE.Music.X, BASE.Music.Y)
		targetRadius = num(math.min(BASE.Music.Y / 2, 30))
	elseif state == STATE.Notification then
		targetSize   = dim(BASE.Notif.X, BASE.Notif.Y)
		targetRadius = num(math.min(BASE.Notif.Y / 2, 30))
	else
		targetSize   = dim(BASE.Idle.X, BASE.Idle.Y)
		targetRadius = num(BASE.Idle.Y / 2)
	end

	animateSize(targetSize, targetRadius, ANIM_TIME)

	-- 先全部淡出，再淡入目标内容
	setAlpha(compactParts, 1, 0.10)
	setAlpha(musicParts,   1, 0.10)
	setAlpha(notifParts,   1, 0.10)

	local myState = state
	task.delay(0.10, function()
		if currentState ~= myState then return end
		setAlpha(compactParts, myState == STATE.Idle   and 0 or 1, 0.22)
		setAlpha(musicParts,   myState == STATE.Music  and 0 or 1, 0.22)
		setAlpha(notifParts,   myState == STATE.Notification and 0 or 1, 0.22)
	end)
end

