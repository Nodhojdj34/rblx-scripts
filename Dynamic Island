-- ===================== 逻辑 =====================

local function getDur()
	local s = songs[cur]
	return math.max(s and s.dur or 0, 1)
end

local function updProg()
	local d = getDur()
	local r = clamp(prog / d, 0, 1)
	progFill.Size = UDim2.new(r, 0, 1, 0)

	local bP = progBg.AbsolutePosition
	local bS = progBg.AbsoluteSize
	local rP = progressRow.AbsolutePosition
	local rS = progressRow.AbsoluteSize
	local iP = island.AbsolutePosition

	if bS.X > 1 and rS.Y > 1 then
		local hx = 6
		local tx
		if bS.X > 12 then
			tx = clamp(bP.X + bS.X * r - iP.X, bP.X + hx - iP.X, bP.X + bS.X - hx - iP.X)
		else
			tx = bP.X + bS.X / 2 - iP.X
		end
		progKnob.Position = UDim2.fromOffset(tx, rP.Y + rS.Y / 2 - iP.Y)
	end

	curTime.Text = fmt(prog)
	totTime.Text = fmt(d)
end

local function updNext()
	local ni
	if shuf then
		ni = math.random(1, #songs)
	else
		ni = cur % #songs + 1
	end
	local s = songs[ni]
	nextUp.Text = "Next: " .. (s and s.title or "?") .. " - " .. (s and s.artist or "?")
end

local function updShufRep()
	if shuf then
		shuffleBtn.TextColor3 = C.accent; shuffleBtn.BackgroundTransparency = 0.72; shuffleBtn.Text = "S*"
	else
		shuffleBtn.TextColor3 = C.mut; shuffleBtn.BackgroundTransparency = 0.88; shuffleBtn.Text = "S"
	end
	if rep == 1 then
		repeatBtn.TextColor3 = C.accent; repeatBtn.BackgroundTransparency = 0.72; repeatBtn.Text = "R"
	elseif rep == 2 then
		repeatBtn.TextColor3 = C.accent; repeatBtn.BackgroundTransparency = 0.72; repeatBtn.Text = "R1"
	else
		repeatBtn.TextColor3 = C.mut; repeatBtn.BackgroundTransparency = 0.88; repeatBtn.Text = "R"
	end
end

local function applySong()
	local s = songs[cur]
	trackTitle.Text = s.title; trackArtist.Text = s.artist
	collapsedTitle.Text = s.title; collapsedArtist.Text = s.artist
	playBtn.Text = playing and "||" or ">"
	collapsedStatus.Text = playing and "||" or ">"
	volBtn.Text = vol .. "%"
	updProg(); updNext()
end

local function nextSong()
	if shuf then cur = math.random(1, #songs)
	else cur = cur % #songs + 1 end
	prog = 0; applySong()
end

local function prevSong()
	if shuf then cur = math.random(1, #songs)
	else cur = ((cur - 2) % #songs) + 1 end
	prog = 0; applySong()
end

local function togPlay()
	playing = not playing
	playBtn.Text = playing and "||" or ">"
	collapsedStatus.Text = playing and "||" or ">"
end

local function togShuf() shuf = not shuf; updShufRep(); updNext() end
local function togRep() rep = (rep + 1) % 3; updShufRep() end

local function setVol(v)
	vol = clamp(math.floor(v), 0, 100)
	volBtn.Text = vol .. "%"
end

local function setRad(r)
	islandCorner.CornerRadius = UDim.new(0, r)
	highlightCorner.CornerRadius = UDim.new(0, math.max(12, r * 0.72))
end

local function interacting() return mouseOn or touchOn end

local function isOur(o)
	if o == island then return true end
	if o and o:IsDescendantOf and o:IsDescendantOf(island) then return true end
	return false
end

-- ---- 自动收起 ----

local function cancelAC()
	if acThread then task.cancel(acThread); acThread = nil end
end

local function schedAC()
	cancelAC()
	acTok += 1
	local t = acTok
	acThread = task.delay(C.autoCollapse, function()
		acThread = nil
		if t == acTok and mode == "expanded" and not interacting() then
			setMode("collapsed")
		end
	end)
end

-- ---- 模式切换（唯一入口）----

setMode = function(m)
	mode = m
	seeking = false; progKnob.Visible = false

	local w, h, r
	if m == "expanded" then
		w = expW(); h = C.expH; r = C.expR
	elseif m == "notification" then
		w = C.collW; h = C.collH; r = C.collR
	else
		w = C.collW; h = C.collH; r = C.collR
	end

	TweenService:Create(island, TweenInfo.new(C.anim, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = UDim2.new(0, w, 0, h) }):Play()
	setRad(r)

	if m == "expanded" then
		TweenService:Create(highlight, TweenInfo.new(C.anim, Enum.EasingStyle.Quad),
			{ Size = UDim2.new(1, 0, 0.32, 0) }):Play()
		schedAC()
	else
		TweenService:Create(highlight, TweenInfo.new(C.anim, Enum.EasingStyle.Quad),
			{ Size = UDim2.new(1, 0, 0.42, 0) }):Play()
		cancelAC()
	end

	task.delay(0.14, function()
		-- 如果模式已变，不执行
		if mode ~= m then return end

		collapsedRow.Visible = (m == "collapsed")
		expandedRow.Visible = (m == "expanded")
		notifRow.Visible = false
		updProg()
	end)
end

-- ---- 通知 ----

local function cancelNotif()
	nfTok += 1
	if nfThread then task.cancel(nfThread); nfThread = nil end
	notifRow.Visible = false

	if nfPrevExp then
		setMode("expanded")
	else
		setMode("collapsed")
	end
	nfPrevExp = false
end

local function showNotif(title, sub, icon, dur)
	if dur == nil then dur = C.notifSec end
	dur = math.max(dur, 0.3)

	nfTok += 1
	local myT = nfTok

	if nfThread then task.cancel(nfThread); nfThread = nil end

	nfPrevExp = (mode == "expanded")
	mode = "notification"
	cancelAC()

	collapsedRow.Visible = false
	expandedRow.Visible = false

	TweenService:Create(island, TweenInfo.new(0.2, Enum.EasingStyle.Quad),
		{ Size = UDim2.new(0, C.collW, 0, C.collH) }):Play()
	setRad(C.collR)
	TweenService:Create(highlight, TweenInfo.new(0.2, Enum.EasingStyle.Quad),
		{ Size = UDim2.new(1, 0, 0.42, 0) }):Play()

	task.delay(0.2, function()
		if myT ~= nfTok then return end

		notifRow.Visible = true
		notifTitle.Text = title or "Notice"
		notifSub.Text = sub or ""
		notifSub.Visible = (sub ~= nil and sub ~= "")
		notifIcon.Text = icon or "!"

		nfThread = task.delay(dur, function()
			nfThread = nil
			if myT ~= nfTok then return end
			cancelNotif()
		end)
	end)
end

-- ---- Seek ----

local function seekX(x)
	if mode ~= "expanded" then return end
	local p = progBg.AbsolutePosition; local s = progBg.AbsoluteSize
	if s.X <= 1 then return end
	prog = clamp((x - p.X) / s.X, 0, 1) * getDur()
	updProg()
end

-- ===================== 按钮事件 =====================

local function btnAct(fn)
	fn()
	if mode == "expanded" then schedAC() end
end

prevBtn.MouseButton1:Connect(function() btnAct(prevSong) end)
playBtn.MouseButton1:Connect(function() btnAct(togPlay) end)
nextBtn.MouseButton1:Connect(function() btnAct(nextSong) end)
closeBtn.MouseButton1:Connect(function() setMode("collapsed") end)

shuffleBtn.MouseButton1:Connect(function()
	togShuf()
	if mode == "expanded" then schedAC() end
end)

repeatBtn.MouseButton1:Connect(function()
	togRep()
	if mode == "expanded" then schedAC() end
end)

volBtn.MouseButton1:Connect(function()
	if vol >= 100 then setVol(50)
	elseif vol >= 50 then setVol(0)
	else setVol(100) end
end)

-- ===================== 键盘 =====================

UserInputService.InputBegan:Connect(function(inp)
	if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if UserInputService:GetFocusedTextBox() then return end

	if inp.KeyCode == Enum.KeyCode.Space then togPlay()
	elseif inp.KeyCode == Enum.KeyCode.Left then prevSong()
	elseif inp.KeyCode == Enum.KeyCode.Right then nextSong()
	elseif inp.KeyCode == Enum.KeyCode.F12 then
		setMode(mode == "expanded" and "collapsed" or "expanded")
	end
end)

-- ===================== 输入 =====================

island.MouseEnter:Connect(function()
	mouseOn = true
	if mode == "expanded" then schedAC() end
end)

island.MouseLeave:Connect(function() mouseOn = false end)

UserInputService.InputBegan:Connect(function(inp, gp)
	local t = inp.UserInputType

	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		local x = inp.Position.X; local y = inp.Position.Y
		if not inside(island, x, y) then return end

		if gp then
			local ok, g = pcall(function()
				return UserInputService:GetGuiObjectAtPosition(x, y, Enum.GuiType.All)
			end)
			if ok and g and not isOur(g) then return end
		end

		if t == Enum.UserInputType.Touch then
			touchOn = true
			lpStart = os.clock() * 1000
			lpTri = false
		end

		if mode == "notification" then
			cancelNotif()
			return
		end

		if mode == "expanded" then
			if inside(progressRow, x, y) then
				seeking = true; progKnob.Visible = true
				seekX(x); return
			end
			if inside(prevBtn,x,y) or inside(playBtn,x,y) or inside(nextBtn,x,y)
				or inside(closeBtn,x,y) or inside(shuffleBtn,x,y)
				or inside(repeatBtn,x,y) or inside(volBtn,x,y) then return end
			setMode("collapsed"); return
		end

		setMode("expanded")
		return
	end

	if t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
		local x = inp.Position.X; local y = inp.Position.Y
		if not inside(island, x, y) then return end
		drag = true; dragSX = x; dragSY = y
		local iA = island.AbsolutePosition; local iS = island.AbsoluteSize
		local vW, vH = vpSize()
		dragIX = (iA.X + iS.X / 2 - vW / 2) / vW
		dragIY = iA.Y / vH
	end
end)

UserInputService.InputChanged:Connect(function(inp)
	local t = inp.UserInputType
	if t == Enum.UserInputType.MouseMove then
		mouseOn = inside(island, inp.Position.X, inp.Position.Y)
	end
	if seeking then
		if t == Enum.UserInputType.MouseMove or t == Enum.UserInputType.Touch then
			seekX(inp.Position.X)
		end
	end
	if drag then
		if t == Enum.UserInputType.MouseMove or t == Enum.UserInputType.Touch then
			local vW, vH = vpSize()
			local nx = clamp(dragIX + (inp.Position.X - dragSX) / vW, -0.3, 1.3)
			local ny = clamp(dragIY + (inp.Position.Y - dragSY) / vH, 0, 0.95)
			island.Position = UDim2.new(nx, 0, ny, 0)
		end
	end
end)

UserInputService.InputEnded:Connect(function(inp)
	local t = inp.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if seeking then seeking = false; progKnob.Visible = false end
		if t == Enum.UserInputType.Touch then touchOn = false end
	end
	if (t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3
		or t == Enum.UserInputType.Touch) and drag then
		drag = false; island.BackgroundTransparency = 0; lpTri = false
	end
end)

-- ===================== Heartbeat =====================

RunService.Heartbeat:Connect(function(dt)
	-- 长按检测
	if touchOn and not lpTri and not drag and not seeking
		and os.clock() * 1000 - lpStart >= C.dragMs then
		local iA = island.AbsolutePosition; local iS = island.AbsoluteSize
		local vW, vH = vpSize()
		dragIX = (iA.X + iS.X / 2 - vW / 2) / vW
		dragIY = iA.Y / vH
		dragSX = iA.X + iS.X / 2
		dragSY = iA.Y + iS.Y / 2
		drag = true; lpTri = true
		island.BackgroundTransparency = 0.3
	end

	-- 播放
	if playing and not seeking and mode ~= "notification" then
		prog += dt
		if prog >= getDur() then
			if rep == 2 then
				prog = 0; applySong()
			elseif shuf or rep == 1 then
				nextSong()
			elseif cur < #songs then
				nextSong()
			else
				-- 最后一首且无循环 → 停止
				prog = getDur()
				playing = false
				playBtn.Text = ">"
				collapsedStatus.Text = ">"
			end
		else
			updProg()
		end
	end
end)

-- ===================== 初始化 =====================

applySong()
updShufRep()
setMode("collapsed")

-- ===================== API =====================

_G.DynamicIslandAPI = {
	play = function()
		playing = true
		playBtn.Text = "||"; collapsedStatus.Text = "||"
	end,
	pause = function()
		playing = false
		playBtn.Text = ">"; collapsedStatus.Text = ">"
	end,
	toggle = togPlay,
	next = nextSong,
	prev = prevSong,
	expand = function() setMode("expanded") end,
	collapse = function() setMode("collapsed") end,
	toggleIsland = function() setMode(mode == "expanded" and "collapsed" or "expanded") end,

	setMedia = function(title, artist, cover, dur)
		local s = songs[cur]
		if title then s.title = title end
		if artist then s.artist = artist end
		if dur then s.dur = math.max(1, dur) end
		prog = math.min(prog, getDur())
		applySong()
	end,

	setProgress = function(sec)
		if sec == nil then return end
		prog = clamp(sec, 0, getDur()); updProg()
	end,

	setQueue = function(q)
		if type(q) ~= "table" or #q == 0 then return end
		for i, v in ipairs(q) do
			songs[i] = {
				title = v.title or ("Track " .. i),
				artist = v.artist or "Unknown",
				dur = math.max(1, v.duration or 180),
			}
		end
		local oldLen = #songs
		for i = #q + 1, oldLen do songs[i] = nil end
		if cur > #q then cur = 1 end
		prog = 0; applySong()
	end,

	toggleShuffle = togShuf,
	toggleRepeat = togRep,
	setShuffle = function(on)
		shuf = on and true or false
		updShufRep(); updNext()
	end,
	setRepeat = function(m)
		rep = clamp(math.floor(m or 0), 0, 2)
		updShufRep()
	end,
	setVolume = setVol,
	showNotification = showNotif,
	clearNotification = cancelNotif,
	resetPosition = function()
		island.Position = UDim2.new(0.5, 0, 0, C.marginTop)
	end,
	getState = function()
		return {
			mode = mode, playing = playing, index = cur,
			progress = prog, duration = getDur(),
			current = songs[cur],
			shuffle = shuf, repeatMode = rep, volume = vol,
		}
	end,
}
