					TextColor3 = isMe and Color3.new(1, 1, 1) or COL.textDim,
					Text = p.Name .. (isMe and "  (你)" or ""),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.fromOffset(20, 0),
					Size = UDim2.new(1, -28, 1, 0),
				}, row)
			end
		end
		playersTitle.Text = (filterLower == "") and "在线玩家" or string.format("在线玩家（%d/%d）", shown, count)
	end
end

-- [17] Clock ------------------------------------------------------
local lastClockMinute = -1

updateClock = function()
	if notificationActive or statusActive then return end
	local now = os.date("*t")
	if now.min == lastClockMinute and clockLabel.Text ~= "--:--" then return end
	lastClockMinute = now.min
	clockLabel.Text = os.date("%H:%M")
end

setStatusText = function(text)
	currentStatusText = text or ""
	if currentStatusText ~= "" then
		statusActive = true
		if not notificationActive then
			clockLabel.Text = currentStatusText
			clockLabel.TextColor3 = currentTheme.accent
		end
	else
		statusActive = false
		if not notificationActive then
			clockLabel.TextColor3 = COL.text
			updateClock()
		end
	end
end

