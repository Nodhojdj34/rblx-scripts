-- 9. 音乐与逻辑控制
-- ============================================================
local musicSound = Instance.new("Sound")
musicSound.Volume = 0.5
musicSound.Parent = SoundService

local function updatePlayIcon()
    playBtn.Text = isPlaying and "⏸" or "▶"
end

local function playCurrentTrack()
    local track = playlist[currentIndex]
    if musicSound.SoundId ~= track.id then
        musicSound.SoundId = track.id
    end
    musicSound:Play()
    isPlaying = true
    titleLabel.Text = track.title
    artistLabel.Text = track.artist
    updatePlayIcon()
end

local function togglePlay()
    if isPlaying then
        musicSound:Pause()
        isPlaying = false
    else
        if musicSound.SoundId == "" then playCurrentTrack()
        else musicSound:Resume() isPlaying = true end
    end
    updatePlayIcon()
end

local function nextTrack()
    currentIndex = currentIndex % #playlist + 1
    playCurrentTrack()
end

musicSound.Ended:Connect(nextTrack)

-- 进度条跳转
local function seek(input)
    local ratio = math.clamp((input.Position.X - progressBg.AbsolutePosition.X) / progressBg.AbsoluteSize.X, 0, 1)
    if musicSound.TimeLength > 0 then
        musicSound.TimePosition = ratio * musicSound.TimeLength
    end
end
progressBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then seek(i) end end)
progressBg.InputChanged:Connect(function(i) if (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) and i.UserInputState == Enum.UserInputState.Change then seek(i) end end)

