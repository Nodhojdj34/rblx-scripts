    if RepeatMode == 1 or CurrentIndex < #Playlist or IsShuffle then
        nextTrack()
    else
        IsPlaying = false
        PlayButton.Text = "PLAY"
    end
end)

-- Progress bar click / drag
local draggingProgress = false

ProgressBack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingProgress = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingProgress = false
    end
end)

local function setProgressFromInput(input)
    if not draggingProgress then return end
    local length = Sound.TimeLength
    if length <= 0 then return end

    local x = math.clamp(
        (input.Position.X - ProgressBack.AbsolutePosition.X)
            / ProgressBack.AbsoluteSize.X, 0, 1
    )
    Sound.TimePosition = x * length
end

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        setProgressFromInput(input)
    end
end)

