local function responsive()
    local camera = workspace.CurrentCamera
    if not camera then return end

    if camera.ViewportSize.X < 500 then
        Sidebar.Size = UDim2.new(0, 105, 1, -65)
        Content.Position = UDim2.fromOffset(120, 55)
        Content.Size = UDim2.new(1, -130, 1, -65)

        for _, b in pairs(NavButtons) do
            b.TextSize = 10
        end
    else
        Sidebar.Size = UDim2.new(0, 130, 1, -65)
        Content.Position = UDim2.fromOffset(150, 55)
        Content.Size = UDim2.new(1, -160, 1, -65)
    end

    updateScale()
end

