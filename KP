-- 8. 音乐播放逻辑
-- ============================================================
local musicSound = Instance.new("Sound")
musicSound.Volume = 0.5
musicSound.Parent = SoundService

local function formatTime(sec)
    sec = math.floor(sec or 0)
    return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function updatePlayIcon()
    playBtn.Text = isPlaying and "⏸" or "▶"
end

local function playCurrentTrack()
    local track = playlist[currentIndex]
    if musicSound.SoundId ~= track.id then
        musicSound.SoundId = track.id
    end
    musicSound:Play()
    isPlaying = true
    titleLabel.Text = track.title
    artistLabel.Text = track.artist
    updatePlayIcon()
end

local function togglePlay()
    if isPlaying then
        musicSound:Pause()
        isPlaying = false
    else
        if musicSound.SoundId == "" then
            playCurrentTrack()
        else
            musicSound:Resume()
            isPlaying = true
        end
    end
    updatePlayIcon()
end

local function nextTrack()
    currentIndex = currentIndex % #playlist + 1
    playCurrentTrack()
end

musicSound.Ended:Connect(nextTrack)

-- ============================================================
-- 9. 进度条点击跳转
-- ============================================================
local function seek(input)
    local ratio = math.clamp((input.Position.X - progressBg.AbsolutePosition.X) / progressBg.AbsoluteSize.X, 0, 1)
    if musicSound.TimeLength > 0 then
        musicSound.TimePosition = ratio * musicSound.TimeLength
    end
end

progressBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        seek(input)
    end
end)
progressBg.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if input.UserInputState == Enum.UserInputState.Change then seek(input) end
    end
end)

-- ============================================================
-- 10. 动画与事件 (修复重叠Bug)
-- ============================================================
local autoCollapse = nil

local function resetAutoCollapse()
    if autoCollapse then task.cancel(autoCollapse) end
    autoCollapse = task.delay(5, function()
        if isExpanded then collapseIsland() end
    end)
end

function expandIsland()
    if isExpanded then return end
    isExpanded = true
    
    -- 1. 先让内容可见
    idleIcon.Visible = false
    expandedContent.Visible = true
    
    -- 2. 尺寸动画
    TweenService:Create(island, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = EXPANDED_SIZE,
        BackgroundColor3 = SPOTIFY_CARD
    }):Play()
    
    TweenService:Create(islandCorner, TweenInfo.new(0.4), { CornerRadius = CORNER_EXPAND }):Play()
    
    -- 3. 内容淡入
    TweenService:Create(expandedContent, TweenInfo.new(0.3), { GroupTransparency = 0 }):Play()
    
    resetAutoCollapse()
end

function collapseIsland()
    if not isExpanded then return end
    isExpanded = false
    
    -- 1. 内容淡出
    local fadeOut = TweenService:Create(expandedContent, TweenInfo.new(0.2), { GroupTransparency = 1 })
    fadeOut:Play()
    
    -- 2. 尺寸缩小
    TweenService:Create(island, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = IDLE_SIZE,
        BackgroundColor3 = SPOTIFY_BG
    }):Play()
    
    TweenService:Create(islandCorner, TweenInfo.new(0.35), { CornerRadius = CORNER_IDLE }):Play()
    
    -- 3. 动画结束后彻底隐藏内容 (解决重叠的关键)
    fadeOut.Completed:Connect(function()
        if not isExpanded then
            expandedContent.Visible = false
            idleIcon.Visible = true
        end
    end)
end

