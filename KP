local function RefreshDevice()
    local viewport = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize
        or Vector2.new(0, 0)

    local camera = workspace.CurrentCamera
    local resolution = camera
        and (tostring(math.floor(viewport.X)) .. " x " .. tostring(math.floor(viewport.Y)))
        or "Unavailable"

    local deviceType = UserInputService.TouchEnabled
        and "Touch Device"
        or "Keyboard / Mouse"

    if UserInputService.GamepadEnabled then
        deviceType = deviceType .. " + Gamepad"
    end

    local platform = "Unknown"

    if UserInputService:GetPlatform() == Enum.Platform.Windows then
        platform = "Windows"
    elseif UserInputService:GetPlatform() == Enum.Platform.OSX then
        platform = "macOS"
    elseif UserInputService:GetPlatform() == Enum.Platform.IOS then
        platform = "iOS"
    elseif UserInputService:GetPlatform() == Enum.Platform.Android then
        platform = "Android"
    elseif UserInputService:GetPlatform() == Enum.Platform.XBoxOne then
        platform = "Xbox"
    end

    DeviceInfo.Text =
        "PLAYER\n" ..
        "Name: " .. Player.Name .. "\n" ..
        "Display Name: " .. Player.DisplayName .. "\n" ..
        "User ID: " .. Player.UserId .. "\n\n" ..
        "DEVICE\n" ..
        "Platform: " .. platform .. "\n" ..
        "Input: " .. deviceType .. "\n" ..
        "Resolution: " .. resolution .. "\n" ..
        "Touch Enabled: " .. tostring(UserInputService.TouchEnabled) .. "\n" ..
        "Keyboard Enabled: " .. tostring(UserInputService.KeyboardEnabled) .. "\n" ..
