            Repeat = not Repeat
            CreatePage("Music")
        end)

    local volumeCard = Card(PageScroll, "VOLUME", 76)

    local volumeText = Label(volumeCard,
        "Volume: " .. math.floor(MusicVolume * 100) .. "%",
        UDim2.new(1, -24, 0, 20),
        UDim2.fromOffset(12, 34), 12)

    local volumeDown = Button(volumeCard, "−",
        UDim2.fromOffset(40, 26), UDim2.new(1, -96, 0, 32), function()
            MusicVolume = math.max(0, MusicVolume - 0.05)
            Music.Volume = MusicVolume
            volumeText.Text = "Volume: " .. math.floor(MusicVolume * 100) .. "%"
        end)

    Button(volumeCard, "+", UDim2.fromOffset(40, 26),
        UDim2.new(1, -48, 0, 32), function()
            MusicVolume = math.min(1, MusicVolume + 0.05)
            Music.Volume = MusicVolume
            volumeText.Text = "Volume: " .. math.floor(MusicVolume * 100) .. "%"
        end)

    local progressCard = Card(PageScroll, "PLAYBACK PROGRESS", 70)
    local progressText = Label(progressCard, "00:00 / 00:00",
        UDim2.new(1, -24, 0, 25), UDim2.fromOffset(12, 34), 12)

    local queueCard = Card(PageScroll, "PLAYLIST", math.max(75, #Playlist * 36 + 42))

    for i, track in ipairs(Playlist) do
        local row = New("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(10, 35 + (i - 1) * 35),
            Size = UDim2.new(1, -20, 0, 30)
        }, queueCard)

        Button(row, (i == CurrentTrack and "▶ " or "") .. track.Id,
            UDim2.new(1, -48, 1, 0), nil, function()
                PlayTrack(i)
            end)

        Button(row, "×", UDim2.fromOffset(38, 30),
            UDim2.new(1, -38, 0, 0), function()
                table.remove(Playlist, i)

                if #Playlist == 0 then
                    Music:Stop()
                    CurrentTrack = 1
                else
                    if i == CurrentTrack then
                        CurrentTrack = math.min(CurrentTrack, #Playlist)
                        PlayTrack(CurrentTrack)
                    elseif i < CurrentTrack then
                        CurrentTrack -= 1
                    end
                end

                CreatePage("Music")
            end)
    end

    Button(PageScroll, "CLEAR PLAYLIST",
        UDim2.new(1, 0, 0, 34), nil, function()
            table.clear(Playlist)
            CurrentTrack = 1
            Music:Stop()
            CreatePage("Music")
        end)

    task.spawn(function()
        while CurrentPage == "Music" and Gui.Parent do
            local length = Music.TimeLength
            local position = Music.TimePosition

            progressText.Text = FormatTime(position) .. " / " .. FormatTime(length)
            task.wait(0.5)
        end
    end)
end

