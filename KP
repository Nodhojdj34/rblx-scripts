-- 9. 音乐播放逻辑
-- ============================================================
local musicSound = Instance.new("Sound")
musicSound.Name = "DynamicIslandMusic"
musicSound.Volume = 0.5
musicSound.Looped = false
musicSound.Parent = SoundService

local function formatTime(seconds)
    seconds = math.floor(seconds or 0)
    return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function updateTrackInfo()
    local track = playlist[currentIndex]
    titleLabel.Text  = track.title
    artistLabel.Text = track.artist
end

local function updatePlayIcon()
    playIcon.Text = isPlaying and "⏸" or "▶"
end

local function playCurrentTrack()
    local track = playlist[currentIndex]
    if musicSound.SoundId ~= track.id then
        musicSound.SoundId = track.id
    end
    musicSound:Play()
    isPlaying = true
    updatePlayIcon()
    updateTrackInfo()
end

local function togglePlay()
    if isPlaying then
        musicSound:Pause()
        isPlaying = false
    else
        if musicSound.SoundId == "" then
            playCurrentTrack()
        else
            musicSound:Resume()
            isPlaying = true
        end
    end
    updatePlayIcon()
end

local function nextTrack()
    currentIndex = currentIndex % #playlist + 1
    playCurrentTrack()
end

musicSound.Ended:Connect(nextTrack)

