local function GetPing()
    local success, result = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    return success and math.floor(result) or 0
end

local function GetMemory()
    local success, result = pcall(function()
        return Stats:GetTotalMemoryUsageMb()
    end)

    return success and math.floor(result) or 0
end

--==================================================
-- ANTI-FLING
--==================================================

local CharacterConnection
local CurrentRoot
local LastFlingCheck = 0

local function SetupCharacter(character)
    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end

    CurrentRoot = nil

    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not root then return end

    CurrentRoot = root
end

Player.CharacterAdded:Connect(SetupCharacter)

Player.CharacterRemoving:Connect(function()
    CurrentRoot = nil

    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end
end)

if Player.Character then
    task.spawn(SetupCharacter, Player.Character)
end

-- Conservative client-side check.
-- This cannot guarantee protection from server-authoritative physics.
RunService.Heartbeat:Connect(function()
    if not Config.AntiFling or not CurrentRoot then
        return
    end

    if os.clock() - LastFlingCheck < 0.15 then
        return
    end

    LastFlingCheck = os.clock()

    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart then
        return
    end

    local velocity = CurrentRoot.AssemblyLinearVelocity
    local angular = CurrentRoot.AssemblyAngularVelocity

    local speed = velocity.Magnitude
    local spin = angular.Magnitude

    -- High thresholds reduce false positives.
    if speed > 180 or spin > 100 then
        AntiFlingCount += 1
        AntiFlingCountLabel.Text = "Detections: " .. AntiFlingCount

        Notify("Anti-Fling", "Abnormal movement detected")

        pcall(function()
            CurrentRoot.AssemblyLinearVelocity = Vector3.zero
            CurrentRoot.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end)

--==================================================
-- MAIN UPDATE LOOP
--==================================================

local lastRefresh = 0

RunService.Heartbeat:Connect(function(dt)
    if StopwatchRunning then
        StopwatchTime += dt
        StopwatchLabel.Text = FormatTime(StopwatchTime)
    end

    if CountdownRunning then
        CountdownTime -= dt

        if CountdownTime <= 0 then
            CountdownTime = 0
            CountdownRunning = false
            CountdownStart.Text = "Start"
            Notify("Timer", "Countdown completed")
        end

        CountdownLabel.Text = FormatTime(CountdownTime)
    end

    local now = os.clock()

    if now - lastRefresh >= 1 then
        lastRefresh = now

        ClockText.Text = os.date("%H:%M:%S")
        DateText.Text = os.date("%A, %B %d, %Y")

        SessionLabel.Text = "SESSION: " .. FormatTime(now - GameStartTime)

        Ping = GetPing()
        Memory = GetMemory()

        PerformanceText.Text =
            "FPS:       " .. FPS .. "\n\n" ..
            "PING:      " .. Ping .. " ms\n\n" ..
            "MEMORY:    " .. Memory .. " MB\n\n" ..
            "SESSION:   " .. FormatTime(now - GameStartTime)

        if FPS > 0 and FPS < 25 then
            PerformanceWarningText.Text = "Low FPS detected"
        elseif Ping > 250 then
            PerformanceWarningText.Text = "High network latency"
        else
            PerformanceWarningText.Text = "Performance monitoring active"
        end

        if Music.IsPlaying then
            PlayButton.Text = "Ⅱ Pause"

            local trackId = Playlist[CurrentTrack]
            TrackTitle.Text = trackId and ("Audio ID: " .. trackId) or "Playing"
            TrackStatus.Text = "Playing  •  " ..
                FormatTime(Music.TimePosition)
        else
            if Music.SoundId == "" then
                TrackStatus.Text = "Ready to play"
            else
                TrackStatus.Text = "Paused / Stopped"
            end
        end

        local tracks = {}

        for i, id in ipairs(Playlist) do
            table.insert(tracks, i .. ". " .. id)
        end

        PlaylistTitle.Text = "PLAYLIST  (" .. #Playlist .. ")"

        PlaylistText.Text = #tracks > 0
            and table.concat(tracks, "\n")
            or "No tracks added"

        RefreshNotifications()
        RefreshDevice()
    end
end)

