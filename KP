local function ApplyAccent(color)
    CONFIG.Accent = color
    COLORS.Accent = color

    for _, object in ipairs(Gui:GetDescendants()) do
        if object:IsA("UIStroke") then
            object.Color = color
        elseif object:IsA("TextLabel") and object.TextColor3 == COLORS.Accent then
            object.TextColor3 = color
        end
    end

    Stroke(Main, color, 0.3)
end

