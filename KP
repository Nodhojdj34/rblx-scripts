local function protectCharacter(character)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not root then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local lastDetection = 0

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not root.Parent then
            connection:Disconnect()
            return
        end

        if not CONFIG.AntiFling then return end

        -- Avoid checks during death or seated vehicle movement.
        if humanoid and (
            humanoid.Health <= 0 or humanoid.SeatPart ~= nil
        ) then
            return
        end

        if os.clock() - lastDetection < 1 then return end

        local linear = root.AssemblyLinearVelocity.Magnitude
        local angular = root.AssemblyAngularVelocity.Magnitude

        if linear > CONFIG.FlingThreshold or angular > CONFIG.FlingThreshold then
            lastDetection = os.clock()
            DetectionCount += 1
            DetectionLabel.Text = "Detections: " .. DetectionCount

            notify("Abnormal movement detected")

            -- Client-side stabilization attempt only.
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
end

