local function updateResponsiveLayout()
    updateScale()

    if expanded then
        main.Size = UDim2.fromOffset(
            CONFIG.Width,
            CONFIG.Height + 48
        )

        panel.Size = UDim2.fromOffset(
            CONFIG.Width,
            CONFIG.Height
        )

        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize

        if viewport and viewport.X < 520 then
            sidebar.Size = UDim2.new(0, 104, 1, -48)
            content.Position = UDim2.fromOffset(104, 48)
            content.Size = UDim2.new(1, -104, 1, -48)

            for name, button in pairs(sideButtons) do
                for _, child in ipairs(button:GetChildren()) do
                    if child:IsA("TextLabel") then
                        if child.Text == name then
                            child.Visible = false
                        end
                    end
                end
            end
        else
            sidebar.Size = UDim2.new(0, 132, 1, -48)
            content.Position = UDim2.fromOffset(132, 48)
            content.Size = UDim2.new(1, -132, 1, -48)

            for name, button in pairs(sideButtons) do
                for _, child in ipairs(button:GetChildren()) do
                    if child:IsA("TextLabel") and child.Text == name then
                        child.Visible = true
                    end
                end
            end
        end
    end
end

local function connectCamera(camera)
    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(
            updateResponsiveLayout
        )
    end
end

connectCamera(workspace.CurrentCamera)

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    connectCamera(workspace.CurrentCamera)
    updateResponsiveLayout()
end)

--=========================================================
-- 24. CLOCK / FPS / UPDATE LOOP
--=========================================================

local updateAccumulator = 0
local destroyed = false

local heartbeatConnection

heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if destroyed or not gui.Parent then
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
        end
        return
    end

    -- FPS measurement
    fpsCounter += 1
    fpsElapsed += deltaTime

    if fpsElapsed >= 1 then
        currentFPS = math.floor(fpsCounter / fpsElapsed + 0.5)
        fpsCounter = 0
        fpsElapsed = 0
    end

    -- Music progress
    if musicSound.IsPlaying then
        local length = musicSound.TimeLength
        local position = musicSound.TimePosition

        if length > 0 then
            progressFill.Size = UDim2.new(
                math.clamp(position / length, 0, 1),
                0,
                1,
                0
            )

            currentTimeLabel.Text = formatTime(position)
            totalTimeLabel.Text = formatTime(length)
        end

        playButton.Text = "Ⅱ"
        songStatus.Text = "PLAYING"
    else
        playButton.Text = "▶"
    end

    -- Compact island status
    if musicSound.IsPlaying then
        compactText.Text = "♫   " .. (getCurrentSong().Name or "Playing")
        compactDot.BackgroundColor3 = theme.Green
    else
        compactText.Text = "♪   Dynamic Island"
        compactDot.BackgroundColor3 = Color3.fromRGB(130, 130, 140)
    end

    -- One-second updates
    updateAccumulator += deltaTime

    if updateAccumulator >= 1 then
        updateAccumulator = 0

        local now = os.date("*t")

        local clockText = string.format(
            "%02d:%02d",
            now.hour,
            now.min
        )

        topClock.Text = clockText

        bigClock.Text = string.format(
            "%02d:%02d:%02d",
            now.hour,
            now.min,
            now.sec
        )

        dateLabel.Text = os.date("%A, %B %d, %Y")

        updateBattery()
        updatePing()
        updateDeviceInfo()
    end
end)

