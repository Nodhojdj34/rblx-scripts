    end

    RepeatButton.TextColor3 = repeatMode ~= "off"
        and C.Green
        or C.Gray

end)

--==================== SONG ENDED ====================

Music.Ended:Connect(function()

    if repeatMode == "one" then

        Music.TimePosition = 0
        Music:Play()
        isPlaying = true
        return

    end

    if repeatMode == "off" then

        if currentIndex < #PLAYLIST then
            currentIndex += 1
            loadSong(true)
        else
            isPlaying = false
            PlayButton.Text = "▶"
        end

        return

    end

    nextSong()

end)

--==================== PROGRESS SEEK ====================

local function seekTo(screenX)

    local duration = Music.TimeLength
    if duration <= 0 then
        return
    end

    local startX = ProgressBackground.AbsolutePosition.X
    local width = ProgressBackground.AbsoluteSize.X

    local alpha = math.clamp(
        (screenX - startX) / width,
        0,
        1
    )

    Music.TimePosition = alpha * duration

end

--==================== VOLUME CONTROL ====================

local function setVolume(screenX)

    local startX = VolumeBackground.AbsolutePosition.X
    local width = VolumeBackground.AbsoluteSize.X

    local alpha = math.clamp(
        (screenX - startX) / width,
        0,
        1
    )

    volume = alpha
    Music.Volume = volume

    VolumeFill.Size = UDim2.new(volume, 0, 1, 0)
    VolumePercent.Text = math.floor(volume * 100) .. "%"

end

ProgressButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingProgress = true
        seekTo(input.Position.X)

    end

end)

VolumeButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingVolume = true
        setVolume(input.Position.X)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        if draggingProgress then
            seekTo(input.Position.X)
        elseif draggingVolume then
            setVolume(input.Position.X)
        end

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingProgress = false
        draggingVolume = false

    end

end)

