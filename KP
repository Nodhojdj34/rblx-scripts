-- 6. 音乐播放逻辑
-- ============================================
local musicSound = Instance.new("Sound")
musicSound.Name = "DynamicIslandMusic"
musicSound.Volume = 0.5
musicSound.Looped = false
musicSound.Parent = SoundService

local function updatePlayButtonText()
    playButton.Text = isPlaying and "⏸" or "▶"
end

local function updateTrackInfo()
    local track = playlist[currentIndex]
    titleLabel.Text = track.title
    artistLabel.Text = track.artist
end

local function playCurrentTrack()
    local track = playlist[currentIndex]
    if musicSound.SoundId ~= track.id then
        musicSound.SoundId = track.id
    end
    musicSound:Play()
    isPlaying = true
    updatePlayButtonText()
    updateTrackInfo()
end

local function togglePlay()
    if isPlaying then
        musicSound:Pause()
        isPlaying = false
    else
        playCurrentTrack()
    end
    updatePlayButtonText()
end

local function nextTrack()
    currentIndex = currentIndex % #playlist + 1
    playCurrentTrack()
end

musicSound.Ended:Connect(function()
    nextTrack()
end)

-- ============================================
-- 7. 展开/收起动画 + 状态管理
-- ============================================
local isExpanded = false
local autoCollapseThread = nil

local function expandIsland()
    if isExpanded then return end
    isExpanded = true
    idleIcon.Visible = false
    expandedContent.Visible = true
    
    local tween = TweenService:Create(island,
        TweenInfo.new(0.4, Enum.EasingStyle.Spring, Enum.EasingDirection.Out),
        { Size = EXPANDED_SIZE, BackgroundColor3 = Color3.fromRGB(25, 25, 25) }
    )
    tween:Play()
    
    -- 自动收起（5秒无操作）
    if autoCollapseThread then task.cancel(autoCollapseThread) end
    autoCollapseThread = task.delay(5, function()
        if isExpanded then collapseIsland() end
    end)
end

function collapseIsland()
    if not isExpanded then return end
    isExpanded = false
    
    local tween = TweenService:Create(island,
        TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Size = IDLE_SIZE, BackgroundColor3 = Color3.fromRGB(15, 15, 15) }
    )
    tween.Completed:Connect(function()
        idleIcon.Visible = true
        expandedContent.Visible = false
    end)
    tween:Play()
end

