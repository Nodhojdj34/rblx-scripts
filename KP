local function updateScale()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize

    local widthScale = (viewport.X - 20) / CONFIG.Width
    local heightScale = (viewport.Y - 35) / (CONFIG.Height + 48)

    uiScale.Scale = math.clamp(
        math.min(widthScale, heightScale, 1),
        0.42,
        1
    )
end

local function expandIsland()
    if expanded then return end

    expanded = true

    compactButton.Visible = false
    panel.Visible = true

    local width = CONFIG.Width
    local height = CONFIG.Height

    main.Size = UDim2.fromOffset(190, 48)

    panel.Size = UDim2.fromOffset(width, height)
    panel.Position = UDim2.fromOffset(0, 48)

    animate(main, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(width, height + 48),
    })

    selectPage(selectedPage)
end

local function collapseIsland()
    if not expanded then return end

    expanded = false

    local animation = animate(main, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(190, 48),
    })

    animation.Completed:Connect(function()
        if not expanded and main.Parent then
            panel.Visible = false
            compactButton.Visible = true
        end
    end)
end

compactButton.Activated:Connect(expandIsland)
closeButton.Activated:Connect(collapseIsland)

