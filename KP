--// MAIN UPDATE LOOP
local updateTimer = 0

local connection
connection = RunService.Heartbeat:Connect(function(dt)
    if not Gui.Parent then
        connection:Disconnect()
        return
    end

    updateTimer += dt

    if updateTimer >= 0.25 then
        updateTimer = 0

        local length = Sound.TimeLength
        local position = Sound.TimePosition

        if length > 0 then
            ProgressFill.Size = UDim2.new(
                math.clamp(position / length, 0, 1), 0, 1, 0
            )
            TimeNow.Text = formatTime(position)
            TimeEnd.Text = formatTime(length)
        else
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
            TimeNow.Text = "00:00"
            TimeEnd.Text = "00:00"
        end

        if Sound.IsLoaded and Sound.SoundId ~= "" then
            TrackSub.Text = IsPlaying and "Playing" or "Paused"
        end

        local now = os.date("*t")
        ClockText.Text = string.format("%02d:%02d:%02d",
            now.hour, now.min, now.sec)
        DateText.Text = string.format("%04d-%02d-%02d",
            now.year, now.month, now.day)

        PillTitle.Text = IsPlaying and "♫  NOW PLAYING" or "DYNAMIC ISLAND"
    end
end)

