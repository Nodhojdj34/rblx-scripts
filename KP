local function MakeSlider(parent, title, minimum, maximum, value, callback)
    local card = Card(parent, title .. ": " .. tostring(value), 65)

    local bar = New("Frame", {
        Position = UDim2.fromOffset(12, 39),
        Size = UDim2.new(1, -24, 0, 8),
        BackgroundColor3 = Color3.fromRGB(50, 54, 65)
    }, card)
    Corner(bar, 8)

    local fill = New("Frame", {
        Size = UDim2.new(
            math.clamp((value - minimum) / (maximum - minimum), 0, 1),
            0, 1, 0
        ),
        BackgroundColor3 = Config.Accent
    }, bar)
    Corner(fill, 8)

    local knob = New("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Text = ""
    }, bar)
    Corner(knob, 20)

    local dragging = false

    local function SetFromX(x)
        local relative = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0, 1
        )

        local newValue = minimum + (maximum - minimum) * relative
        newValue = math.floor(newValue + 0.5)

        fill.Size = UDim2.new(relative, 0, 1, 0)
        knob.Position = UDim2.new(relative, 0, 0.5, 0)
        card:FindFirstChildOfClass("TextLabel").Text =
            title .. ": " .. tostring(newValue)

        callback(newValue)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            SetFromX(input.Position.X)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    local moveConnection = UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            SetFromX(input.Position.X)
        end
    end)

    local endConnection = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    table.insert(Connections, moveConnection)
    table.insert(Connections, endConnection)

    return card
end

