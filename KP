local function SeekTo(position)
    if not Music.IsLoaded or Music.TimeLength <= 0 then return end

    local percent = math.clamp(
        (position.X - ProgressBack.AbsolutePosition.X)
        / math.max(1, ProgressBack.AbsoluteSize.X),
        0,
        1
    )

    Music.TimePosition = Music.TimeLength * percent
end

ProgressBack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        SeekTo(input.Position)
    end
end)

local SeekMove
local SeekEnd

ProgressBack.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    SeekMove = UserInputService.InputChanged:Connect(function(changed)
        if changed.UserInputType == Enum.UserInputType.MouseMovement
            or changed.UserInputType == Enum.UserInputType.Touch then
            SeekTo(changed.Position)
        end
    end)

    SeekEnd = UserInputService.InputEnded:Connect(function(ended)
        if ended.UserInputType == Enum.UserInputType.MouseButton1
            or ended.UserInputType == Enum.UserInputType.Touch then

            if SeekMove then SeekMove:Disconnect() end
            if SeekEnd then SeekEnd:Disconnect() end
        end
    end)
end)

