    Panel.Visible = state

    local targetSize

    if state then
        local camera = Workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(900, 700)

        local width = math.min(CONFIG.Width, viewport.X - 20)
        local height = math.min(CONFIG.Height, viewport.Y - 85)

        targetSize = UDim2.fromOffset(
            math.max(320, width),
            math.max(300, height)
        )
    else
        targetSize = UDim2.fromOffset(210, 48)
