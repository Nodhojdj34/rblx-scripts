--// LIVE STATUS
local fpsFrames = 0
local fpsElapsed = 0
local currentFPS = 0
local updateElapsed = 0

RunService.RenderStepped:Connect(function(dt)
    fpsFrames += 1
    fpsElapsed += dt
    updateElapsed += dt

    if fpsElapsed >= 1 then
        currentFPS = math.floor(fpsFrames / fpsElapsed + 0.5)
        fpsFrames = 0
        fpsElapsed = 0
    end

    if updateElapsed >= 0.12 then
        updateElapsed = 0

        if Sound.TimeLength > 0 then
            local percent = math.clamp(Sound.TimePosition / Sound.TimeLength, 0, 1)
            ProgressFill.Size = UDim2.new(percent, 0, 1, 0)
            TimeLabel.Text = formatTime(Sound.TimePosition)
                .. " / " .. formatTime(Sound.TimeLength)
        else
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
            TimeLabel.Text = "0:00 / 0:00"
        end

        if Sound.IsPlaying then
            PillDot.BackgroundColor3 = Config.Accent
            for _, bar in ipairs(WaveBars) do
                local loudness = math.clamp(Sound.PlaybackLoudness / 500, 0.05, 1)
                local height = math.random(5, math.max(6, math.floor(25 * loudness)))
                tween(bar, {Size = UDim2.new(0, 3, 0, height)}, 0.12)
            end
        else
            for _, bar in ipairs(WaveBars) do
                tween(bar, {Size = UDim2.new(0, 3, 0, 5)}, 0.15)
            end
        end

        ClockLabel.Text = os.date("%H:%M:%S")
        DateLabel.Text = os.date("%A, %B %d, %Y")

        local elapsed = math.floor(os.clock() - SessionStart)
        SessionLabel.Text = string.format(
            "Session: %02d:%02d:%02d",
            math.floor(elapsed / 3600),
            math.floor(elapsed / 60) % 60,
            elapsed % 60
        )

        FPSValue.Text = tostring(currentFPS) .. " FPS"
        MemoryValue.Text = safeGet(function()
            return string.format("%.1f MB", Stats:GetTotalMemoryUsageMb())
        end)

        PingValue.Text = safeGet(function()
            local item = Stats.Network.ServerStatsItem["Data Ping"]
            return item:GetValueString()
        end)

        updateScreenInfo()
    end
end)

