local function selectPage(name)
    if switchingPage or not pages[name] then
        return
    end

    switchingPage = true
    selectedPage = name

    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
        page.Position = UDim2.fromOffset(12, 0)
    end

    for pageName, button in pairs(sideButtons) do
        local active = pageName == name

        animate(button, 0.16, {
            BackgroundColor3 = active and theme.Button or theme.Sidebar,
        })

        local mark = button:FindFirstChild("ActiveMark")
        if mark then
            mark.BackgroundTransparency = active and 0 or 1
        end
    end

    local activePage = pages[name]
    activePage.Visible = true

    animate(activePage, 0.2, {
        Position = UDim2.fromOffset(0, 0),
    })

    task.delay(0.22, function()
        switchingPage = false
    end)
end

