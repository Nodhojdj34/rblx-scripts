local function RefreshNotifications()
    local unread = 0
    local lines = {}

    for _, item in ipairs(Notifications) do
        if not item.Read then
            unread += 1
        end
    end

    for i = #Notifications, 1, -1 do
        local item = Notifications[i]

        if NotificationFilter == "All"
            or item.Category == NotificationFilter then

            table.insert(lines,
                "[" .. item.Time .. "] " ..
                "[" .. item.Category .. "] " ..
                item.Title .. ": " .. item.Message
            )
        end

        if #lines >= 9 then
            break
        end
    end

    NotificationCount.Text = #Notifications .. " Notifications"
    UnreadCount.Text = "Unread: " .. unread

    NotificationListText.Text = #lines > 0
        and table.concat(lines, "\n\n")
        or "No notifications"
end

local function RefreshMusic()
    PlaylistTitle.Text = "PLAYLIST (" .. #Playlist .. ")"

    local lines = {}

    for i, id in ipairs(Playlist) do
        local marker = i == CurrentTrack and " ▶ " or "   "
        table.insert(lines, marker .. i .. ". " .. id)
    end

    PlaylistText.Text = #lines > 0
        and table.concat(lines, "\n")
        or "No tracks added"

    local recentLines = {}

    for i = 1, math.min(5, #RecentTracks) do
        table.insert(recentLines, i .. ". " .. RecentTracks[i])
    end

    RecentText.Text = #recentLines > 0
        and table.concat(recentLines, "\n")
        or "Nothing played yet"

    if Music.IsPlaying then
        PlayButton.Text = "Ⅱ Pause"

        local id = Playlist[CurrentTrack]
        TrackTitle.Text = id and ("Audio ID: " .. id) or "Playing"
        TrackStatus.Text = "Playing • " .. FormatTime(Music.TimePosition)
    else
        PlayButton.Text = "▶ Play"

        if Music.SoundId == "" then
            TrackTitle.Text = "No Track"
            TrackStatus.Text = "Ready to play"
        else
            TrackStatus.Text = "Paused / Stopped"
        end
    end
end

local function RefreshTimers()
    local lines = {}

    for _, timer in ipairs(Timers) do
        table.insert(lines,
            "#" .. timer.Id .. "  " ..
            FormatTime(timer.Remaining) ..
            (timer.Running and "  • RUNNING" or "  • PAUSED")
        )
    end

    TimerListText.Text = #lines > 0
        and table.concat(lines, "\n\n")
        or "No active timers"
end

local function RefreshPerformance()
    PerformanceText.Text =
        "FPS:       " .. FPS .. "\n\n" ..
        "PING:      " .. Ping .. " ms\n\n" ..
        "MEMORY:    " .. Memory .. " MB\n\n" ..
        "SESSION:   " .. FormatTime(os.clock() - SessionStart)

    local historyLines = {}

    for i = #PerformanceHistory, math.max(1, #PerformanceHistory - 5), -1 do
        local item = PerformanceHistory[i]

        table.insert(historyLines,
            "FPS " .. item.FPS ..
            "  |  Ping " .. item.Ping .. " ms"
        )
    end

    HistoryText.Text = #historyLines > 0
        and table.concat(historyLines, "\n")
        or "No history yet"

    if FPS > 0 and FPS < 25 then
        WarningText.Text = "Warning: Low FPS"
    elseif Ping > 250 then
        WarningText.Text = "Warning: High network latency"
    else
        WarningText.Text = "Performance monitoring active"
    end
end

--==================================================
-- 22. MAIN UPDATE LOOP
--==================================================

local updateAccumulator = 0

trackConnection(RunService.Heartbeat:Connect(function(dt)
    if Destroyed then return end

    if StopwatchRunning then
        StopwatchTime += dt
        StopwatchLabel.Text = FormatTime(StopwatchTime)
        LapLabel.Text = "Laps: " .. #StopwatchLaps
    end

    for i = #Timers, 1, -1 do
        local timer = Timers[i]

        if timer.Running then
            timer.Remaining -= dt

            if timer.Remaining <= 0 then
                timer.Remaining = 0
                timer.Running = false

                Notify("Countdown", "Timer #" .. timer.Id .. " completed", "System")
            end
        end
    end

    updateAccumulator += dt

    if updateAccumulator >= 1 then
        updateAccumulator = 0

        ClockLabel.Text = os.date("%H:%M:%S")
        DateLabel.Text = os.date("%A, %B %d, %Y")

        SessionLabel.Text = "SESSION: " .. FormatTime(os.clock() - SessionStart)

        Ping = ReadPing()
        Memory = ReadMemory()

        table.insert(PerformanceHistory, {
            FPS = FPS,
            Ping = Ping,
        })

        while #PerformanceHistory > 20 do
            table.remove(PerformanceHistory, 1)
        end

        RefreshMusic()
        RefreshNotifications()
        RefreshTimers()
        RefreshPerformance()
    end
end))

