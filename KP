-- PERFORMANCE + TIMER UPDATE
local frames = 0
local elapsed = 0
local updateElapsed = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt
    updateElapsed += dt

    if TimerRunning then
        TimerSeconds += CountdownMode and -dt or dt

        if CountdownMode and TimerSeconds <= 0 then
            TimerSeconds = 0
            TimerRunning = false
            notify("Countdown finished")
        end
    end

    if updateElapsed >= 1 then
        local fps = math.floor(frames / math.max(elapsed, 0.001))

        FPSLabel.Text = "FPS: " .. fps

        if fps < 25 then
            FPSWarning.Text = "Low FPS detected"
            FPSWarning.TextColor3 = COLORS.Red
        else
            FPSWarning.Text = "Performance normal"
            FPSWarning.TextColor3 = COLORS.Green
        end

        PingLabel.Text = "Ping: " .. safeGet(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        end)

        MemoryLabel.Text = "Memory: " .. safeGet(function()
            return string.format(
                "%.1f MB",
                Stats:GetTotalMemoryUsageMb()
            )
        end)

        local seconds = math.floor(TimerSeconds)
        local hours = math.floor(seconds / 3600)
        local minutes = math.floor(seconds / 60) % 60
        local remaining = seconds % 60

        TimerLabel.Text = string.format(
            "%02d:%02d:%02d",
            hours,
            minutes,
            remaining
        )

        frames = 0
        elapsed = 0
        updateElapsed = 0
    end
end)

