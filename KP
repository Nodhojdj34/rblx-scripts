local uiScale = Instance.new("UIScale")
uiScale.Parent = island

local function updateScale()
    local viewport = camera.ViewportSize
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    -- 针对手机端放大约束，PC端保持原样
    local base = isMobile and 450 or 600 
    local minScale = isMobile and 0.85 or 0.65 -- 提高手机端最小缩放比例
    local maxScale = isMobile and 1.3 or 1.05
    uiScale.Scale = math.clamp(viewport.X / base, minScale, maxScale)
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
updateScale()

