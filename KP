-- 3. 弹簧动画工具（比普通 Tween 更真实）
-- ============================================================
local function springTo(instance, properties, speed, damping)
    -- 用 SmoothDamp 实现弹簧效果（Roblox 原生支持）
    local success, err = pcall(function()
        for prop, target in pairs(properties) do
            local current = instance[prop]
            -- SmoothDamp 需要数值类型，UDim2/Color3 手动插值
            if typeof(target) == "UDim2" then
                local startX, startY = current.X.Offset, current.Y.Offset
                local targetX, targetY = target.X.Offset, target.Y.Offset
                local startScaleX, startScaleY = current.X.Scale, current.Y.Scale
                local targetScaleX, targetScaleY = target.X.Scale, target.Y.Scale
                local t = 0
                local conn
                conn = RunService.Heartbeat:Connect(function(dt)
                    t = t + dt * (speed or 12)
                    local alpha = 1 - math.exp(-t) * math.cos(t * (damping or 6))
                    if alpha >= 0.99 then
                        instance[prop] = target
                        conn:Disconnect()
                        return
                    end
                    instance[prop] = UDim2.new(
                        startScaleX + (targetScaleX - startScaleX) * alpha,
                        startX + (targetX - startX) * alpha,
                        startScaleY + (targetScaleY - startScaleY) * alpha,
                        startY + (targetY - startY) * alpha
                    )
                end)
            elseif typeof(target) == "Color3" then
                local startColor = current
                local t = 0
                local conn
                conn = RunService.Heartbeat:Connect(function(dt)
                    t = t + dt * (speed or 12)
                    local alpha = math.clamp(1 - math.exp(-t), 0, 1)
                    if alpha >= 0.99 then
                        instance[prop] = target
                        conn:Disconnect()
                        return
                    end
                    instance[prop] = startColor:Lerp(target, alpha)
                end)
            end
        end
    end)
end

-- 简化的弹簧 tween（用于 UDim2 尺寸动画，带过冲感）
local function springTween(instance, prop, target, duration, overshoot)
    duration = duration or 0.45
    overshoot = overshoot or 0.08
    local start = instance[prop]
    local info = TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, overshoot)
    return TweenService:Create(instance, info, { [prop] = target })
end

