local function New(className, props, parent)
    local object = Instance.new(className)

    for key, value in pairs(props or {}) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function Round(object, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0, radius or 12)
    }, object)
end

local function Stroke(object, color, transparency, thickness)
    return New("UIStroke", {
        Color = color or Config.Accent,
        Transparency = transparency or 0.6,
        Thickness = thickness or 1,
    }, object)
end

local function Tween(object, properties, duration)
    if Config.ReducedMotion then
        for key, value in pairs(properties) do
            object[key] = value
        end
        return
    end

    local animation = TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.2,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        properties
    )

    animation:Play()
    return animation
end

local function Text(parent, value, size, color, bold)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(value or ""),
        TextSize = size or 12,
        TextColor3 = color or Color3.fromRGB(235, 240, 250),
        Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function MakeButton(parent, value, callback, width, height)
    local button = New("TextButton", {
        Size = UDim2.fromOffset(width or 100, height or 34),
        BackgroundColor3 = Color3.fromRGB(35, 43, 59),
        Text = value,
        TextColor3 = Color3.fromRGB(240, 244, 255),
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, parent)

    Round(button, 9)

    button.MouseEnter:Connect(function()
        Tween(button, {
            BackgroundColor3 = Color3.fromRGB(54, 66, 87)
        }, 0.12)
    end)

    button.MouseLeave:Connect(function()
        Tween(button, {
            BackgroundColor3 = Color3.fromRGB(35, 43, 59)
        }, 0.12)
    end)

    button.MouseButton1Click:Connect(function()
        if callback then
            local success, err = pcall(callback)
            if not success then
                warn("[Island] Button:", err)
            end
        end
    end)

    return button
end

