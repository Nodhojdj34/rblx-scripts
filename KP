function ApplyAppearance()
    Config.Width = math.clamp(Config.Width, 320, 900)
    Config.Height = math.clamp(Config.Height, 300, 800)
    Config.Radius = math.clamp(Config.Radius, 8, 40)
    Config.Scale = math.clamp(Config.Scale, 0.7, 1.3)
    Config.Transparency = math.clamp(Config.Transparency, 0, 0.8)

    UIScale.Scale = Config.Scale

    Main.BackgroundColor3 = Config.HighContrast
        and Color3.fromRGB(0, 0, 0)
        or Color3.fromRGB(12, 14, 20)

    Corner(Main, Config.Radius)
    Stroke(Main, Config.Accent, 0.35)

    IslandDot.BackgroundColor3 = Config.Accent
    HeaderStatus.TextColor3 = Config.Accent
    PageScroll.ScrollBarImageColor3 = Config.Accent

    if Expanded then
        local height = Config.Compact and Config.CompactHeight or Config.Height
        Main.Size = UDim2.fromOffset(Config.Width, height)
    end

    for _, item in ipairs(Gui:GetDescendants()) do
        if item:IsA("UIStroke") then
            item.Color = Config.Accent
        elseif item:IsA("Frame") then
            if item ~= Main and item.BackgroundColor3 == Config.PanelColor then
                item.BackgroundTransparency = Config.Transparency
            end
        end
    end
end

