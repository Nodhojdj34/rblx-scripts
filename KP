    if Sound.IsPlaying then
        Sound:Pause()
    elseif Sound.SoundId ~= "" and Sound.TimePosition > 0 then
        Sound:Resume()
    elseif Playlist[CurrentIndex] then
        playCurrent()
    end
    updatePlayButton()
end)

