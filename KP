}, SoundService)

local currentIndex = 1
local isPlaying = false
local shuffleEnabled = false
local repeatEnabled = false
local draggingProgress = false

local function getCurrentSong()
    return PLAYLIST[currentIndex]
end

local function updateSongDisplay()
    local song = getCurrentSong()
    if not song then
        return
    end

    songName.Text = song.Name or "Unknown"
    artistName.Text = song.Artist or "Unknown Artist"
    cover.Image = song.ImageId or ""
    totalTimeLabel.Text = formatTime(musicSound.TimeLength)
end

local function loadSong(index, shouldPlay)
    if #PLAYLIST == 0 then
        return
    end

    currentIndex = ((index - 1) % #PLAYLIST) + 1

    local song = getCurrentSong()
    musicSound:Stop()
    musicSound.SoundId = song.SoundId or ""
    musicSound.TimePosition = 0

    updateSongDisplay()
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    currentTimeLabel.Text = "0:00"

    if shouldPlay then
        local ok = pcall(function()
            musicSound:Play()
        end)

        isPlaying = ok
        songStatus.Text = ok and "PLAYING" or "UNABLE TO PLAY"
    else
        isPlaying = false
        songStatus.Text = "READY TO PLAY"
    end
end

local function playPause()
    if #PLAYLIST == 0 then
        return
    end

    if musicSound.SoundId == "" or musicSound.SoundId == "rbxassetid://0" then
        loadSong(currentIndex, false)
        songStatus.Text = "SET A VALID SOUND ID"
        return
    end

    if musicSound.IsPlaying then
        musicSound:Pause()
        isPlaying = false
        songStatus.Text = "PAUSED"
    else
        if musicSound.TimeLength > 0 and musicSound.TimePosition >= musicSound.TimeLength then
            musicSound.TimePosition = 0
        end

        local ok = pcall(function()
            musicSound:Play()
        end)

        isPlaying = ok
        songStatus.Text = ok and "PLAYING" or "UNABLE TO PLAY"
    end
end

local function nextSong()
    if #PLAYLIST == 0 then
        return
    end

    local nextIndex = currentIndex + 1

    if shuffleEnabled and #PLAYLIST > 1 then
        repeat
            nextIndex = math.random(1, #PLAYLIST)
        until nextIndex ~= currentIndex
    end

    loadSong(nextIndex, true)
end

local function previousSong()
    if musicSound.TimePosition > 3 then
        musicSound.TimePosition = 0
        return
    end

    loadSong(currentIndex - 1, true)
end

