local function seekFromInput(input)
    local relativeX = input.Position.X - progressBg.AbsolutePosition.X
    local ratio = math.clamp(relativeX / progressBg.AbsoluteSize.X, 0, 1)
    if musicSound.TimeLength > 0 then
        musicSound.TimePosition = ratio * musicSound.TimeLength
    end
end

progressBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        seekFromInput(input)
    end
end)

progressBg.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        if input.UserInputState == Enum.UserInputState.Change then
            seekFromInput(input)
        end
    end
end)

-- ============================================================
-- 12. 展开/收起动画（弹簧感）
-- ============================================================
local autoCollapseThread = nil

local function resetAutoCollapse()
    if autoCollapseThread then task.cancel(autoCollapseThread) end
    autoCollapseThread = task.delay(6, function()
        if isExpanded then collapseIsland() end
    end)
end

function expandIsland()
    if isExpanded then return end
    isExpanded = true
    idleIcon.Visible = false
    expandedContent.Visible = true

    -- 弹簧尺寸动画
    local tweenSize = springTween(island, "Size", EXPANDED_SIZE, 0.5, 0.1)
    tweenSize:Play()

    -- 圆角平滑变化
    TweenService:Create(islandCorner, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CornerRadius = CORNER_EXPAND
    }):Play()

    -- 背景色微调
    TweenService:Create(island, TweenInfo.new(0.4), { BackgroundColor3 = SPOTIFY_CARD }):Play()

    resetAutoCollapse()
end

function collapseIsland()
    if not isExpanded then return end
    isExpanded = false

    local tweenSize = springTween(island, "Size", IDLE_SIZE, 0.4, 0.06)
    tweenSize:Play()

    TweenService:Create(islandCorner, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        CornerRadius = CORNER_IDLE
    }):Play()

    TweenService:Create(island, TweenInfo.new(0.3), { BackgroundColor3 = SPOTIFY_BG }):Play()

    local hideTween = TweenService:Create(expandedContent, TweenInfo.new(0.2), { BackgroundTransparency = 1 })
    -- 用 task.delay 确保尺寸动画结束后再隐藏内容
    task.delay(0.35, function()
        if not isExpanded then
            idleIcon.Visible = true
            expandedContent.Visible = false
        end
    end)
end

