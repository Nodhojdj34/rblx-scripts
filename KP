-- 11. 悬浮窗与面板控制逻辑
-- ============================================================
local function hidePanels()
    idPanel.Visible = false
    infoPanel.Visible = false
    dimmer.Visible = false
end

dimmer.MouseButton1Click:Connect(hidePanels)

addBtn.MouseButton1Click:Connect(function()
    infoPanel.Visible = false
    if not idPanel.Visible then
        dimmer.Visible = true
        idPanel.Visible = true
        idBox:CaptureFocus()
    else
        hidePanels()
    end
end)

infoBtn.MouseButton1Click:Connect(function()
    idPanel.Visible = false
    if not infoPanel.Visible then
        dimmer.Visible = true
        infoPanel.Visible = true
        local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
        local platform = isMobile and "移动端 (手机/平板)" or "PC端 (键鼠)"
        
        infoText.Text = string.format(
            " 平台: %s\n 屏幕: %d x %d\n 帧率: %d FPS\n 网络延迟: %d ms",
            platform,
            camera.ViewportSize.X, camera.ViewportSize.Y,
            currentFPS,
            math.floor(player:GetNetworkPing() * 1000)
        )
    else
        hidePanels()
    end
end)

idBox.FocusLost:Connect(function(enterPressed)
    if enterPressed and idBox.Text ~= "" then
        local pureId = string.match(idBox.Text, "(%d+)")
        if pureId then
            musicSound.SoundId = "rbxassetid://" .. pureId
            musicSound:Play()
            isPlaying = true
            titleLabel.Text = "自定义音频"
            artistLabel.Text = "ID: " .. pureId
            updatePlayIcon()
        end
    end
    idBox.Text = ""
    hidePanels()
end)

-- ============================================================
-- 12. 展开/收起动画
-- ============================================================
local autoCollapse = nil

local function resetAutoCollapse()
    if autoCollapse then task.cancel(autoCollapse) end
    autoCollapse = task.delay(6, function()
        if isExpanded and not dimmer.Visible then 
            if not idBox:IsFocused() then
                local collapse = _G.__collapseIsland
                if collapse then collapse() end
            end
        end
    end)
end

local function expandIsland()
    if isExpanded then return end
    isExpanded = true
    idleIcon.Visible = false
    expandedContent.Visible = true
    
    TweenService:Create(island, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = EXPANDED_SIZE, BackgroundColor3 = SPOTIFY_CARD
    }):Play()
    TweenService:Create(islandCorner, TweenInfo.new(0.4), { CornerRadius = CORNER_EXPAND }):Play()
    TweenService:Create(expandedContent, TweenInfo.new(0.3), { GroupTransparency = 0 }):Play()
    resetAutoCollapse()
end

local function collapseIsland()
    if not isExpanded then return end
    isExpanded = false
    hidePanels()
    
    local fadeOut = TweenService:Create(expandedContent, TweenInfo.new(0.2), { GroupTransparency = 1 })
    fadeOut:Play()
    
    TweenService:Create(island, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = IDLE_SIZE, BackgroundColor3 = SPOTIFY_BG
    }):Play()
    TweenService:Create(islandCorner, TweenInfo.new(0.35), { CornerRadius = CORNER_IDLE }):Play()
    
    fadeOut.Completed:Connect(function()
        if not isExpanded then
            expandedContent.Visible = false
            idleIcon.Visible = true
        end
    end)
end
_G.__collapseIsland = collapseIsland

