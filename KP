local function Notify(title, message)
    table.insert(Notifications, {
        Title = title,
        Message = message,
        Time = os.date("%H:%M:%S"),
        Read = false,
    })

    if #Notifications > 50 then
        table.remove(Notifications, 1)
    end

    if _G.DynamicIslandRefreshNotifications then
        _G.DynamicIslandRefreshNotifications()
    end
end

local function PlayTrack(index)
    if #Playlist == 0 then
        Notify("Music", "Playlist is empty")
        return
    end

    CurrentTrack = math.clamp(index, 1, #Playlist)

    local id = tostring(Playlist[CurrentTrack])

    Music:Stop()
    Music.SoundId = "rbxassetid://" .. id
    Music.TimePosition = 0
    Music.Volume = Config.Volume
    Music:Play()

    Notify("Music", "Loading track " .. id)
end

local function NextTrack()
    if #Playlist == 0 then return end
    CurrentTrack = CurrentTrack + 1

    if CurrentTrack > #Playlist then
        CurrentTrack = 1
    end

    PlayTrack(CurrentTrack)
end

local function PreviousTrack()
    if #Playlist == 0 then return end

    if Music.TimePosition > 3 then
        Music.TimePosition = 0
        return
    end

    CurrentTrack = CurrentTrack - 1

    if CurrentTrack < 1 then
        CurrentTrack = #Playlist
    end

    PlayTrack(CurrentTrack)
end

local RandomMode = false
local RepeatMode = false

Music.Ended:Connect(function()
    if RepeatMode then
        Music.TimePosition = 0
        Music:Play()
    elseif RandomMode and #Playlist > 0 then
        PlayTrack(math.random(1, #Playlist))
    elseif #Playlist > 0 then
        NextTrack()
    end
end)

