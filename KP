local function sliderCard(title, initial, minValue, maxValue, callback, suffix)
    local c = card(SettingsPage, 65)
    label(c, title, 10, UDim2.fromOffset(13, 4),
        UDim2.new(0.7, 0, 0, 20), Colors.Muted, Enum.Font.GothamBold)
    local valueLabel = label(c, tostring(initial) .. (suffix or ""), 10,
        UDim2.new(1, -75, 0, 4), UDim2.fromOffset(60, 20), Colors.Text)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local back = create("TextButton", {
        Position = UDim2.fromOffset(13, 37),
        Size = UDim2.new(1, -26, 0, 7),
        BackgroundColor3 = Color3.fromRGB(65, 70, 82),
        Text = "",
        AutoButtonColor = false,
    }, c)
    round(back, 5)

    local fill = create("Frame", {
        Size = UDim2.new((initial - minValue) / (maxValue - minValue), 0, 1, 0),
        BackgroundColor3 = Config.Accent,
    }, back)
    round(fill, 5)

    local function setValue(x)
        local percent = math.clamp(
            (x - back.AbsolutePosition.X) / back.AbsoluteSize.X, 0, 1
        )
        local value = math.floor(minValue + percent * (maxValue - minValue))
        fill.Size = UDim2.new(percent, 0, 1, 0)
        valueLabel.Text = tostring(value) .. (suffix or "")
        callback(value)
    end

    back.Activated:Connect(function()
        setValue(UserInputService:GetMouseLocation().X)
    end)

    return c
end

