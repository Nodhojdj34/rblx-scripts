local expanded = CONFIG.StartExpanded

local function togglePanel()
    expanded = not expanded
    Panel.Visible = true

    if expanded then
        Panel.Size = UDim2.fromOffset(650, 10)
        TweenService:Create(Panel,
            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(650, 440)}
        ):Play()
    else
        local tween = TweenService:Create(Panel,
            TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Size = UDim2.fromOffset(650, 10)}
        )
        tween:Play()
        tween.Completed:Once(function()
            if not expanded then
                Panel.Visible = false
                Panel.Size = UDim2.fromOffset(650, 440)
            end
        end)
    end
end

Pill.Activated:Connect(togglePanel)

