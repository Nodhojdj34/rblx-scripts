local MusicSound = SoundService:FindFirstChild("DynamicIslandMusic")

if not MusicSound then
    MusicSound = Instance.new("Sound")
    MusicSound.Name = "DynamicIslandMusic"
    MusicSound.Volume = 0.5
    MusicSound.Parent = SoundService
end

local Playlist = {}
local CurrentTrack = 1
local Shuffle = false
local RepeatMode = false

local function PlayTrack(index)
    if #Playlist == 0 then
        return false
    end

    index = math.clamp(index, 1, #Playlist)
    CurrentTrack = index

    local id = Playlist[index]
    MusicSound:Stop()
    MusicSound.SoundId = "rbxassetid://" .. id
    MusicSound.TimePosition = 0

    local success = pcall(function()
        MusicSound:Play()
    end)

    return success
end

local function AddTrack(id)
    id = tostring(id):gsub("%s+", "")

    if id:match("^rbxassetid://") then
        id = id:gsub("rbxassetid://", "")
    end

    if not id:match("^%d+$") then
        return false, "Invalid Audio ID"
    end

    table.insert(Playlist, id)

    if #Playlist == 1 then
        PlayTrack(1)
    end

    return true
end

local function NextTrack()
    if #Playlist == 0 then return end

    if Shuffle and #Playlist > 1 then
        local nextIndex = CurrentTrack
        while nextIndex == CurrentTrack do
            nextIndex = math.random(1, #Playlist)
        end
        PlayTrack(nextIndex)
    else
        local nextIndex = CurrentTrack + 1
        if nextIndex > #Playlist then
            nextIndex = RepeatMode and 1 or #Playlist
        end
        PlayTrack(nextIndex)
    end
end

local function PreviousTrack()
    if #Playlist == 0 then return end

    if MusicSound.TimePosition > 3 then
        MusicSound.TimePosition = 0
        return
    end

    local index = CurrentTrack - 1
    if index < 1 then
        index = #Playlist
    end

    PlayTrack(index)
end

MusicSound.Ended:Connect(function()
    if RepeatMode then
        PlayTrack(CurrentTrack)
    elseif CurrentTrack < #Playlist then
        NextTrack()
    end
end)

