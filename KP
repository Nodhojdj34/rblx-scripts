local function addNotification(title, message)
    title = tostring(title or "Notification")
    message = tostring(message or "")

    local record = {
        Title = title,
        Message = message,
        Time = os.date("%H:%M"),
    }

    table.insert(notificationRecords, 1, record)

    while #notificationRecords > CONFIG.NotificationLimit do
        table.remove(notificationRecords)
    end

    for _, child in ipairs(notificationList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    for index, item in ipairs(notificationRecords) do
        local card = create("Frame", {
            Size = UDim2.new(1, -5, 0, 58),
            BackgroundColor3 = theme.Button,
            BorderSizePixel = 0,
