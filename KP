local sessionStart = os.clock()

local function getPlatform()
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        return "Mobile"
    elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
        return "Console"
    else
        return "PC"
    end
end

local function updateDevice()
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(0, 0)

    DeviceRows["Platform"].Text = getPlatform()
    DeviceRows["Resolution"].Text =
        math.floor(viewport.X) .. " x " .. math.floor(viewport.Y)
    DeviceRows["Orientation"].Text =
        viewport.X > viewport.Y and "Landscape" or "Portrait"

    DeviceRows["Touch"].Text = tostring(UserInputService.TouchEnabled)
    DeviceRows["Keyboard"].Text = tostring(UserInputService.KeyboardEnabled)
    DeviceRows["Mouse"].Text = tostring(UserInputService.MouseEnabled)
    DeviceRows["Gamepad"].Text = tostring(UserInputService.GamepadEnabled)

    DeviceRows["Preferred Input"].Text =
        safeRead(function() return UserInputService.PreferredInput.Name end)

    DeviceRows["FPS"].Text = tostring(math.floor(1 / math.max(RunService.Heartbeat:Wait(), 0.001)))

    DeviceRows["Memory"].Text = safeRead(function()
        return string.format("%.1f MB", Stats:GetTotalMemoryUsageMb())
    end)

    DeviceRows["Ping"].Text = safeRead(function()
        local item = Stats.Network.ServerStatsItem["Data Ping"]
        return item:GetValueString()
    end)

    DeviceRows["Username"].Text = Player.Name
    DeviceRows["Display Name"].Text = Player.DisplayName
    DeviceRows["User ID"].Text = tostring(Player.UserId)
    DeviceRows["Account Age"].Text = tostring(Player.AccountAge) .. " days"
    DeviceRows["Place ID"].Text = tostring(game.PlaceId)
    DeviceRows["Place Version"].Text = tostring(game.PlaceVersion)
    DeviceRows["Session Time"].Text = formatTime(os.clock() - sessionStart)

    DeviceRows["Battery"].Text = safeRead(function()
        local level = UserInputService:GetDeviceBatteryLevel()
        return math.floor(level * 100) .. "%"
    end)
end

