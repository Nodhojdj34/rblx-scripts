local function setTheme(name)
    C = Themes[name]
    CONFIG.Theme = name

    Panel.BackgroundColor3 = C.Background
    stroke(Panel, C.Stroke, 0.25)

    for _, obj in ipairs(Gui:GetDescendants()) do
        if obj:IsA("TextLabel") then
            if obj.TextColor3 ~= C.Muted then
                obj.TextColor3 = C.Text
            end
        elseif obj:IsA("TextButton") then
            if obj ~= Pill then
                obj.BackgroundColor3 = C.Button
                obj.TextColor3 = C.Text
            end
        elseif obj:IsA("Frame") then
            if obj ~= PillDot and obj ~= ProgressFill then
                if obj.Parent == Panel or obj.Parent == Content
                    or obj.Parent == Sidebar then
                    obj.BackgroundColor3 = C.Card
                end
            end
        end
    end

    ProgressFill.BackgroundColor3 = C.Accent
    PillDot.BackgroundColor3 = C.Accent
    InputHint.TextColor3 = C.Muted
end

