-- ANTI-FLING SYSTEM
--==================================================

local AntiFling = {
    Enabled = true,
    Level = "High",
    Activations = 0,
    LastEvent = "None",
    LastRecovery = 0,
    Consecutive = 0,
    LastVelocity = Vector3.zero,
    SafeCFrame = nil,
    SafePosition = nil,
    SafeTime = 0,
    Character = nil,
    Root = nil,
    Humanoid = nil,
}

local function ApplyProtectionLevel()
    if AntiFling.Level == "Low" then
        CONFIG.SpeedThreshold = 230
        CONFIG.AngularThreshold = 140
        CONFIG.VerticalThreshold = 210
    elseif AntiFling.Level == "Medium" then
        CONFIG.SpeedThreshold = 190
        CONFIG.AngularThreshold = 115
        CONFIG.VerticalThreshold = 175
    else
        CONFIG.SpeedThreshold = 155
        CONFIG.AngularThreshold = 85
        CONFIG.VerticalThreshold = 140
    end
end

local function BindCharacter(character)
    AntiFling.Character = character
    AntiFling.Root = character:WaitForChild("HumanoidRootPart", 10)
    AntiFling.Humanoid = character:WaitForChild("Humanoid", 10)

    AntiFling.SafeCFrame = nil
    AntiFling.SafePosition = nil
    AntiFling.Consecutive = 0
end

if Player.Character then
    task.spawn(BindCharacter, Player.Character)
end

Player.CharacterAdded:Connect(BindCharacter)

local function IsSafeMovement()
    local humanoid = AntiFling.Humanoid
    local root = AntiFling.Root

    if not humanoid or not root then
        return false
    end

    if humanoid.Health <= 0 then
        return false
    end

    if humanoid.SeatPart then
        return false
    end

    if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
        return false
    end

    return true
end

local function RecordSafePosition()
    local root = AntiFling.Root
    local humanoid = AntiFling.Humanoid

    if not root or not humanoid then
        return
    end

    if humanoid.FloorMaterial ~= Enum.Material.Air then
        AntiFling.SafeCFrame = root.CFrame
        AntiFling.SafePosition = root.Position
        AntiFling.SafeTime = os.clock()
    end
end

local function RecoverFromFling(reason)
    local root = AntiFling.Root
    local humanoid = AntiFling.Humanoid

    if not root or not humanoid then
        return
    end

    local now = os.clock()

    if now - AntiFling.LastRecovery < CONFIG.RecoveryCooldown then
        return
    end

    AntiFling.LastRecovery = now
    AntiFling.Activations += 1
    AntiFling.LastEvent = reason

    -- Best-effort local velocity reduction.
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    -- Attempt to recover an excessively tilted character.
    pcall(function()
        local position = root.Position
        local look = root.CFrame.LookVector

        local flatLook = Vector3.new(look.X, 0, look.Z)

        if flatLook.Magnitude < 0.01 then
            flatLook = Vector3.new(0, 0, -1)
        else
            flatLook = flatLook.Unit
        end

        root.CFrame = CFrame.lookAt(position, position + flatLook)
    end)

    -- Only attempt position recovery if the character is
    -- far from a recently recorded safe position.
    if AntiFling.SafeCFrame and AntiFling.SafePosition then
        local distance = (root.Position - AntiFling.SafePosition).Magnitude

        if distance > 100 and
            now - AntiFling.SafeTime < 8 then

            pcall(function()
                root.CFrame = AntiFling.SafeCFrame
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    pcall(function()
        humanoid.PlatformStand = false
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)

    Notify(
        "Anti-Fling",
        "Abnormal movement detected: " .. reason,
        "Protection"
    )
end

local function CheckAntiFling()
    if not AntiFling.Enabled then
        return
    end

    if not IsSafeMovement() then
        AntiFling.Consecutive = 0
        return
    end

    local root = AntiFling.Root
    local humanoid = AntiFling.Humanoid

    if not root or not humanoid then
        return
    end

    local velocity = root.AssemblyLinearVelocity
    local angular = root.AssemblyAngularVelocity

    local speed = velocity.Magnitude
    local angularSpeed = angular.Magnitude
    local verticalSpeed = math.abs(velocity.Y)

    local velocityChange =
        (velocity - AntiFling.LastVelocity).Magnitude

    AntiFling.LastVelocity = velocity

    local suspicious = false
    local reason = ""

    if speed > CONFIG.SpeedThreshold then
        suspicious = true
        reason = "High velocity"
    end

    if angularSpeed > CONFIG.AngularThreshold then
        suspicious = true
        reason = "Abnormal rotation"
    end

    if verticalSpeed > CONFIG.VerticalThreshold then
        suspicious = true
        reason = "Abnormal vertical movement"
    end

    if velocityChange > 115 and speed > 90 then
        suspicious = true
        reason = "Sudden physical impact"
    end

    if suspicious then
        AntiFling.Consecutive += 1
    else
        AntiFling.Consecutive = math.max(
            0,
            AntiFling.Consecutive - 1
        )
    end

    -- Multiple consecutive suspicious samples reduce false positives.
    if AntiFling.Consecutive >= 2 then
        RecoverFromFling(reason)
        AntiFling.Consecutive = 0
    end

    -- Record grounded positions for possible recovery.
    if humanoid.FloorMaterial ~= Enum.Material.Air
        and speed < 80
        and angularSpeed < 45 then
        RecordSafePosition()
    end
end

ApplyProtectionLevel()

