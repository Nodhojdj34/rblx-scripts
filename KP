    if CONFIG.ReducedMotion then
        Main.Size = targetSize
    else
        TweenService:Create(
            Main,
            TweenInfo.new(0.25, Enum.EasingStyle.Quint),
            {Size = targetSize}
        ):Play()
    end

    if state then
        Panel.Visible = true
    end
end

