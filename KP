--==================== HELPERS ====================

local function create(className, properties, parent)
    local obj = Instance.new(className)

    for key, value in pairs(properties) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, parent)
end

local function stroke(parent, color, transparency, thickness)
    return create("UIStroke", {
        Color = color,
        Transparency = transparency,
        Thickness = thickness,
    }, parent)
end

local function tween(object, duration, properties)
    local t = TweenService:Create(
        object,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        properties
    )

    t:Play()
    return t
end

local function makeLabel(parent, name, text, position, size, textSize, color, font)
    return create("TextLabel", {
        Name = name,
        Position = position,
        Size = size,

        BackgroundTransparency = 1,

        Text = text,
        TextColor3 = color or C.White,
        TextSize = textSize,

        Font = font or Enum.Font.GothamMedium,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,

        TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
end

local function makeButton(parent, name, text, position, size, color)
    return create("TextButton", {
        Name = name,
        Position = position,
        Size = size,

        BackgroundColor3 = color or C.Card,
        BorderSizePixel = 0,

        Text = text,
        TextColor3 = C.White,
        TextSize = 16,

        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, parent)
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds or 0))

    return string.format(
        "%d:%02d",
        math.floor(seconds / 60),
        seconds % 60
    )
end

local function getSong()
    return PLAYLIST[currentIndex]
end

local function validAsset(id)
    return typeof(id) == "string"
        and id ~= ""
        and id ~= "rbxassetid://0"
end

