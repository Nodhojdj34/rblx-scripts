local function refreshPlaylist()
    for _, child in ipairs(PlaylistScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for i, id in ipairs(Playlist) do
        local b = makeButton(PlaylistScroll, (i == CurrentIndex and "▶  " or "") .. id,
            UDim2.new(1, -5, 0, 27), UDim2.new(), function()
                CurrentIndex = i
                local newId = Playlist[CurrentIndex]
                Sound.SoundId = "rbxassetid://" .. newId
                TrackTitle.Text = "Audio " .. newId
                TrackSub.Text = "Loading..."
                Sound:Play()
                IsPlaying = true
                PlayButton.Text = "PAUSE"
                refreshPlaylist()
            end)
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.TextSize = 11
        b.LayoutOrder = i
    end
end

local function validId(text)
    text = tostring(text or ""):gsub("%s+", "")
    if text:match("^%d+$") and #text > 0 and #text <= 20 then
        return text
    end
    return nil
end

local function addTrack(id, playNow)
    id = validId(id)
    if not id then
        InputHint.Text = "Invalid audio ID"
        return false
    end

    if #Playlist >= CONFIG.MaxPlaylist then
        InputHint.Text = "Playlist is full"
        return false
    end

    table.insert(Playlist, id)
    CurrentIndex = #Playlist
    refreshPlaylist()
    InputHint.Text = "Added: " .. id

    if playNow then
        Sound:Stop()
        Sound.SoundId = "rbxassetid://" .. id
        TrackTitle.Text = "Audio " .. id
        TrackSub.Text = "Loading..."
        Sound:Play()
        IsPlaying = true
        PlayButton.Text = "PAUSE"
    end
    return true
end

local function playCurrent()
    local typed = validId(IdBox.Text)

    if typed then
        addTrack(typed, true)
        IdBox.Text = ""
        return
    end

    if #Playlist == 0 then
        InputHint.Text = "Enter an audio ID first"
        return
    end

    local id = Playlist[CurrentIndex]
    if not id then return end

    Sound.SoundId = "rbxassetid://" .. id
    TrackTitle.Text = "Audio " .. id
    TrackSub.Text = "Loading..."
    Sound:Play()
    IsPlaying = true
    PlayButton.Text = "PAUSE"
    refreshPlaylist()
end

local function pauseCurrent()
    if IsPlaying then
        Sound:Pause()
        IsPlaying = false
        PlayButton.Text = "PLAY"
    else
        if Sound.SoundId == "" or Sound.SoundId == "rbxassetid://0" then
            playCurrent()
        else
            Sound:Resume()
            IsPlaying = true
            PlayButton.Text = "PAUSE"
        end
    end
end

local function nextTrack()
    if #Playlist == 0 then return end

    if IsShuffle and #Playlist > 1 then
        local nextIndex = CurrentIndex
        while nextIndex == CurrentIndex do
            nextIndex = math.random(1, #Playlist)
        end
        CurrentIndex = nextIndex
    else
        CurrentIndex += 1
        if CurrentIndex > #Playlist then
            if RepeatMode == 1 then
                CurrentIndex = 1
            else
                CurrentIndex = #Playlist
                Sound:Stop()
                IsPlaying = false
                PlayButton.Text = "PLAY"
                return
            end
        end
    end

    local id = Playlist[CurrentIndex]
    Sound:Stop()
    Sound.SoundId = "rbxassetid://" .. id
    TrackTitle.Text = "Audio " .. id
    TrackSub.Text = "Loading..."
    Sound:Play()
    IsPlaying = true
    PlayButton.Text = "PAUSE"
    refreshPlaylist()
end

local function previousTrack()
    if #Playlist == 0 then return end

    if Sound.TimePosition > 3 then
        Sound.TimePosition = 0
        return
    end

    CurrentIndex -= 1
    if CurrentIndex < 1 then
        CurrentIndex = RepeatMode == 1 and #Playlist or 1
    end

    local id = Playlist[CurrentIndex]
    Sound:Stop()
    Sound.SoundId = "rbxassetid://" .. id
    TrackTitle.Text = "Audio " .. id
    TrackSub.Text = "Loading..."
    Sound:Play()
    IsPlaying = true
    PlayButton.Text = "PAUSE"
    refreshPlaylist()
end

