local function expand()

    if isExpanded or isAnimating then
        return
    end

    isAnimating = true
    isExpanded = true

    Expanded.Visible = true

    tween(MainCorner, CONFIG.AnimationTime, {
        CornerRadius = UDim.new(0, 25)
    })

    tween(Shadow, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(
            CONFIG.ExpandedWidth + 18,
            CONFIG.ExpandedHeight + 18
        )
    })

    tween(MainStroke, CONFIG.AnimationTime, {
        Transparency = 0.2,
        Color = C.Green
    })

    local t = tween(Main, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(
            CONFIG.ExpandedWidth,
            CONFIG.ExpandedHeight
        )
    })

    t.Completed:Connect(function()
        isAnimating = false
    end)

end

--==================== COLLAPSE ====================

local function collapse()

    if not isExpanded or isAnimating then
        return
    end

    isAnimating = true

    tween(MainCorner, CONFIG.AnimationTime, {
        CornerRadius = UDim.new(1, 0)
    })

    tween(Shadow, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(
            CONFIG.CompactWidth + 14,
            CONFIG.CompactHeight + 14
        )
    })

    tween(MainStroke, CONFIG.AnimationTime, {
        Transparency = 0.45,
        Color = C.Gray
    })

    local t = tween(Main, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(
            CONFIG.CompactWidth,
            CONFIG.CompactHeight
        )
    })

    t.Completed:Connect(function()

        Expanded.Visible = false
        isExpanded = false
        isAnimating = false

    end)

end

CompactButton.Activated:Connect(expand)
CloseButton.Activated:Connect(collapse)

--==================== NOTIFICATIONS ====================

local function notify(title, message)

    notificationToken += 1
    local token = notificationToken

    NotificationText.Text = tostring(title or "NOTIFICATION")
        .. "  •  "
        .. tostring(message or "")

    NotificationText.Visible = true

    Header.Text = "NOTIFICATION"

    expand()

    task.delay(CONFIG.NotificationDuration, function()

        if token ~= notificationToken then
            return
        end

        NotificationText.Visible = false
        Header.Text = "NOW PLAYING"

        collapse()

    end)

end

