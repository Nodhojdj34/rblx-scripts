local Music = SoundService:FindFirstChild("DynamicIslandV72Music")

if not Music then
    Music = New("Sound", {
        Name = "DynamicIslandV72Music",
        Volume = MusicVolume,
        Looped = false
    }, SoundService)
end

Music.Volume = MusicVolume

local function PlayTrack(index)
    if #Playlist == 0 then
        Notify("Music", T("EmptyPlaylist"), "Music")
        return
    end

    CurrentTrack = math.clamp(index, 1, #Playlist)

    local track = Playlist[CurrentTrack]

    Music:Stop()
    Music.SoundId = "rbxassetid://" .. track.Id
    Music.TimePosition = 0
    Music.Volume = MusicVolume
    Music:Play()

    Notify(T("Playing"), "Audio ID: " .. track.Id, "Music")
end

local function NextTrack()
    if #Playlist == 0 then
        return
    end

    local nextIndex

    if Shuffle and #Playlist > 1 then
        nextIndex = math.random(1, #Playlist)
        if nextIndex == CurrentTrack then
            nextIndex = nextIndex % #Playlist + 1
        end
    else
        nextIndex = CurrentTrack + 1
    end

    if nextIndex > #Playlist then
        if Repeat then
            nextIndex = 1
        else
            return
        end
    end

    PlayTrack(nextIndex)
end

local function PreviousTrack()
    if #Playlist == 0 then
        return
    end

    if Music.TimePosition > 3 then
        Music.TimePosition = 0
        return
    end

    local index = CurrentTrack - 1
    if index < 1 then
        index = #Playlist
    end

    PlayTrack(index)
end

Music.Ended:Connect(function()
    if Repeat and #Playlist > 0 then
        PlayTrack(CurrentTrack)
    else
        NextTrack()
    end
end)

