local function updateSongDisplay()
    local song = getCurrentSong()
    if not song then return end

    songName.Text = song.Name or "Unknown"
    artistName.Text = song.Artist or "Unknown Artist"
    cover.Image = song.ImageId or ""
end

local function loadSong(index, shouldPlay)
    if #PLAYLIST == 0 or isChangingSong then
        return
    end

    isChangingSong = true

    currentIndex = ((index - 1) % #PLAYLIST) + 1

    local song = getCurrentSong()

    musicSound:Stop()
    musicSound.SoundId = song.SoundId or ""
    musicSound.TimePosition = 0

    progressFill.Size = UDim2.new(0, 0, 1, 0)
    currentTimeLabel.Text = "0:00"

    updateSongDisplay()

    if shouldPlay and song.SoundId ~= "rbxassetid://0" and song.SoundId ~= "" then
        local success = pcall(function()
            musicSound:Play()
        end)

        songStatus.Text = success and "PLAYING" or "UNABLE TO PLAY"
    else
        songStatus.Text = "READY TO PLAY"
    end

    isChangingSong = false
end

local function nextSong()
    if #PLAYLIST == 0 then return end

    local nextIndex = currentIndex + 1

    if shuffleEnabled and #PLAYLIST > 1 then
        repeat
            nextIndex = math.random(1, #PLAYLIST)
        until nextIndex ~= currentIndex
    end

    loadSong(nextIndex, true)
end

local function previousSong()
    if musicSound.TimePosition > 3 then
        musicSound.TimePosition = 0
    else
        loadSong(currentIndex - 1, true)
    end
end

local function togglePlay()
    if not musicSound.SoundId or musicSound.SoundId == ""
        or musicSound.SoundId == "rbxassetid://0" then
        songStatus.Text = "SET A VALID SOUND ID"
        return
    end

    if musicSound.IsPlaying then
        musicSound:Pause()
        songStatus.Text = "PAUSED"
    else
        if musicSound.TimeLength > 0
            and musicSound.TimePosition >= musicSound.TimeLength then
            musicSound.TimePosition = 0
        end

        local success = pcall(function()
            musicSound:Play()
        end)

        songStatus.Text = success and "PLAYING" or "UNABLE TO PLAY"
    end
end

