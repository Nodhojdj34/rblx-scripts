--========================================================
-- UPDATE LOOP
--========================================================

local accumulator = 0
local timerRefresh = 0

Connect(RunService.Heartbeat:Connect(function(dt)
    if Destroyed then return end

    if StopwatchRunning then
        StopwatchTime += dt
        StopwatchText.Text = FormatTime(StopwatchTime)
        LapText.Text = "Laps: " .. #Laps
    end

    for _, timer in ipairs(Timers) do
        if timer.Running then
            timer.Remaining -= dt

            if timer.Remaining <= 0 then
                timer.Remaining = 0
                timer.Running = false

                Notify("Countdown", "Timer #" .. timer.Id .. " completed", "System")
            end
        end
    end

    accumulator += dt
    timerRefresh += dt

    if accumulator >= 1 then
        accumulator = 0

        ClockText.Text = os.date("%H:%M:%S")
        DateText.Text = os.date("%A, %B %d, %Y")

        SessionText.Text = "SESSION: " ..
            FormatTime(os.clock() - SessionStart)

        Ping = ReadPing()
        Memory = ReadMemory()

        table.insert(PerformanceHistory, {
            FPS = FPS,
            Ping = Ping,
        })

        while #PerformanceHistory > 30 do
            table.remove(PerformanceHistory, 1)
        end

        RefreshPerformance()
        RefreshNotifications()
        RefreshMusic()
    end

    if timerRefresh >= 0.25 then
        timerRefresh = 0
        RefreshTimers()
    end
end))

