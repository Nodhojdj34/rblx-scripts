-- Progress and volume touch/mouse handling

local function setProgressFromX(x)
    local width = progressBackground.AbsoluteSize.X
    if width <= 0 or musicSound.TimeLength <= 0 then
        return
    end

    local fraction = math.clamp(
        (x - progressBackground.AbsolutePosition.X) / width,
        0,
        1
    )

    musicSound.TimePosition = fraction * musicSound.TimeLength
end

local function setVolumeFromX(x)
    local width = volumeBackground.AbsoluteSize.X
    if width <= 0 then
        return
    end

    local fraction = math.clamp(
        (x - volumeBackground.AbsolutePosition.X) / width,
        0,
        1
    )

    musicSound.Volume = fraction
    volumeFill.Size = UDim2.new(fraction, 0, 1, 0)
end

progressHit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingProgress = true
        setProgressFromX(input.Position.X)
    end
end)

volumeHit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        setVolumeFromX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingProgress and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        setProgressFromX(input.Position.X)
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement then
        -- Volume is changed by clicking or dragging on its bar.
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingProgress = false
    end
end)

