        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, PageHolder)

    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    Pages[name] = page
    return page
end

local function card(parent, height)
    local f = create("Frame", {
        Size = UDim2.new(1, -8, 0, height),
        BackgroundColor3 = Colors.Card,
        BackgroundTransparency = 0.12,
    }, parent)
    round(f, 15)
    return f
end

local function switchPage(name)
    if not Pages[name] then return end
    CurrentPage = name
    Header.Text = name
    SubHeader.Text = ({
        Music = "Your personal music player",
        Notifications = "Recent alerts and messages",
        Device = "Device and Roblox information",
        Time = "Clock and session information",
        Network = "Connection and performance",
        Settings = "Personalize your island",
    })[name] or ""

    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
        if page.Visible then
            page.Position = UDim2.new(0, 12, 0, 0)
            tween(page, {Position = UDim2.new(0, 0, 0, 0)}, 0.2)
        end
    end

    for pageName, navButton in pairs(NavButtons) do
        local active = pageName == name
        tween(navButton, {
            BackgroundColor3 = active and Config.Accent or Colors.Sidebar,
        }, 0.16)
        navButton.TextColor3 = active and Color3.new(1, 1, 1) or Colors.Muted
    end
end

