local PlaylistRows = {}

local function updateSongUI()

    local song = getSong()
    if not song then
        return
    end

    SongTitle.Text = song.Name
    SongArtist.Text = song.Artist

    if validAsset(song.ImageId) then
        AlbumImage.Image = song.ImageId
        AlbumFallback.Visible = false
    else
        AlbumImage.Image = ""
        AlbumFallback.Visible = true
    end

    for index, row in ipairs(PlaylistRows) do

        local active = index == currentIndex

        row.Title.TextColor3 = active and C.Green or C.White
        row.Number.TextColor3 = active and C.Green or C.Gray
        row.Playing.Visible = active

    end

end

--==================== LOAD SONG ====================

local function loadSong(autoplay)

    local song = getSong()
    if not song then
        return
    end

    songToken += 1
    local token = songToken

    isPlaying = false

    Music:Stop()
    Music.TimePosition = 0
    Music.SoundId = song.SoundId

    PlayButton.Text = "▶"
    CompactText.Text = "SPOTIFY"

    CurrentTime.Text = "0:00"
    TotalTime.Text = "0:00"
    ProgressFill.Size = UDim2.new(0, 0, 1, 0)

    updateSongUI()

    if autoplay then

        if not validAsset(song.SoundId) then
            Footer.Text = "● PLEASE SET A VALID MUSIC ID"
            return
        end

        Music:Play()
        isPlaying = true
        PlayButton.Text = "Ⅱ"
        CompactText.Text = "PLAYING"

    end

    task.spawn(function()

        local start = os.clock()

        while GUI.Parent
            and token == songToken
            and Music.TimeLength <= 0
            and os.clock() - start < 20 do

            task.wait(0.2)

        end

        if token ~= songToken then
            return
        end

        if Music.TimeLength > 0 then
            TotalTime.Text = formatTime(Music.TimeLength)
        end

    end)

end

