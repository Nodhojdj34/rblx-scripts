local function updateLayout()
    updateResponsiveScale()

    if expanded then
        local width, height = getPanelSize()
        main.Size = UDim2.fromOffset(width, height + 48)
        panel.Size = UDim2.fromOffset(width, height)
        panel.Position = UDim2.fromOffset(0, 48)

        local mobile = width < 420
        local sidebarWidth = mobile and 104 or 132

        sidebar.Size = UDim2.new(0, sidebarWidth, 1, -48)
        content.Position = UDim2.fromOffset(sidebarWidth, 48)
        content.Size = UDim2.new(1, -sidebarWidth, 1, -48)

        for _, button in pairs(sideButtons) do
            for _, child in ipairs(button:GetChildren()) do
                if child:IsA("TextLabel") then
                    if child.Text ~= "" and child.Text ~= "♫"
                        and child.Text ~= "♧" and child.Text ~= "▣"
                        and child.Text ~= "◷" and child.Text ~= "⌁"
                        and child.Text ~= "⚙" then
                        child.Visible = not mobile
                    end
                end
            end
        end
    end
end

local camera = workspace.CurrentCamera
if camera then
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLayout)
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    local newCamera = workspace.CurrentCamera
    if newCamera then
        newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLayout)
        updateLayout()
    end
end)

--==================================================
-- MAIN UPDATE LOOP
--==================================================

local updateAccumulator = 0

local updateConnection
updateConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if not gui.Parent then
        if updateConnection then
            updateConnection:Disconnect()
        end
        return
    end

    updateAccumulator += deltaTime

    -- Music progress
    if musicSound.IsPlaying then
        local length = musicSound.TimeLength
        local position = musicSound.TimePosition

        if length > 0 then
            progressFill.Size = UDim2.new(
                math.clamp(position / length, 0, 1),
                0,
                1,
                0
            )

            currentTimeLabel.Text = formatTime(position)
            totalTimeLabel.Text = formatTime(length)
        end

        playButton.Text = "Ⅱ"
    else
        playButton.Text = "▶"
    end

    -- Auto next track
    if musicSound.Ended and not repeatEnabled then
        nextSong()
    end

    if updateAccumulator >= 1 then
        updateAccumulator = 0

        local now = os.date("*t")
        local clockText = string.format("%02d:%02d", now.hour, now.min)

        topClock.Text = clockText
        bigClock.Text = string.format(
            "%02d:%02d:%02d",
            now.hour,
            now.min,
            now.sec
        )

        dateLabel.Text = os.date("%A, %B %d, %Y")

        updateBattery()
        updatePing()
        updateCompact()
    end
end)

