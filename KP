-- NOTIFICATION
--==================================================

local NotificationId = 0

local function Notify(title, message)

    NotificationId += 1
    local currentId = NotificationId

    Title.Text = tostring(title or "Notification")
    Artist.Text = tostring(message or "")
    NotificationLabel.Text = tostring(message or "")

    Expand()

    task.delay(CONFIG.AutoCloseTime, function()

        if NotificationId == currentId then
            Collapse()
        end

    end)

end

-- Local notification event

local NotifyEvent = Instance.new("BindableEvent")
NotifyEvent.Name = "DynamicIslandNotify"
NotifyEvent.Parent = GUI

NotifyEvent.Event:Connect(function(title, message)
    Notify(title, message)
end)

-- Server notification event

local Remote = ReplicatedStorage:FindFirstChild(
    "DynamicIslandRemote"
)

if Remote and Remote:IsA("RemoteEvent") then

    Remote.OnClientEvent:Connect(function(title, message)
        Notify(title, message)
    end)

end

