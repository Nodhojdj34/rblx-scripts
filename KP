--// ANTI-FLING LOCAL MONITOR
local function BindCharacter(character)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not root then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end

    local connection

    connection = RunService.Heartbeat:Connect(function()
        if not Gui.Parent or not root.Parent then
            if connection then
                connection:Disconnect()
            end
            return
        end

        if not Config.AntiFling then
            return
        end

        if humanoid.SeatPart then
            return
        end

        local speed = root.AssemblyLinearVelocity.Magnitude
        local angular = root.AssemblyAngularVelocity.Magnitude

        if (speed > 180 or angular > 100)
            and os.clock() - LastFlingWarning > 3 then

            LastFlingWarning = os.clock()
            AntiFlingCount += 1

            Notify(
                "Anti-Fling Alert",
                "Abnormal movement detected. Local stabilization attempted.",
                "System"
            )

            pcall(function()
                if speed > 180 then
                    root.AssemblyLinearVelocity =
                        root.AssemblyLinearVelocity.Unit * 80
                end

                if angular > 100 then
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end
    end)

    table.insert(CharacterConnections, connection)
end

Player.CharacterAdded:Connect(BindCharacter)

if Player.Character then
    task.spawn(BindCharacter, Player.Character)
end

