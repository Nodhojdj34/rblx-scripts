-- 10. 实时进度条 + 可视化更新
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not isExpanded then return end

    -- 进度条
    if musicSound.TimeLength > 0 then
        local ratio = musicSound.TimePosition / musicSound.TimeLength
        progressFill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
        timeCurrent.Text = formatTime(musicSound.TimePosition)
        timeTotal.Text = formatTime(musicSound.TimeLength)
    end

    -- 音波可视化（仅在播放时跳动）
    if isPlaying then
        local loudness = musicSound.PlaybackLoudness / 1000
        for i, bar in ipairs(bars) do
            local wave = math.sin(os.clock() * (4 + i * 2)) * 0.5 + 0.5
            local height = 3 + loudness * 10 * wave
            bar.Size = UDim2.new(0, 3, 0, math.clamp(height, 3, 14))
        end
    else
        for _, bar in ipairs(bars) do
            bar.Size = UDim2.new(0, 3, 0, 4)
        end
    end
end)

