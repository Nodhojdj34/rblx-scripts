local function Create(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Corner(object, radius)
    Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 12),
    }, object)
end

local function Outline(object, color, transparency)
    return Create("UIStroke", {
        Color = color or Config.Accent,
        Transparency = transparency or 0.6,
        Thickness = 1,
    }, object)
end

local function Animate(object, properties, duration)
    if Config.ReducedMotion then
        for key, value in pairs(properties) do
            object[key] = value
        end
        return nil
    end

    local tween = TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.22,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        properties
    )

    tween:Play()
    return tween
end

local function Label(parent, text, size, color, bold)
    return Create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextSize = size or 12,
        TextColor3 = color or Color3.fromRGB(235, 240, 250),
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function Button(parent, text, callback, width)
    local button = Create("TextButton", {
        Size = UDim2.fromOffset(width or 110, 34),
        BackgroundColor3 = Color3.fromRGB(36, 43, 57),
        Text = text,
        TextColor3 = Color3.fromRGB(245, 247, 255),
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
    }, parent)

    Corner(button, 9)

    button.MouseEnter:Connect(function()
        Animate(button, {
            BackgroundColor3 = Color3.fromRGB(52, 63, 82),
        }, 0.12)
    end)

    button.MouseLeave:Connect(function()
        Animate(button, {
            BackgroundColor3 = Color3.fromRGB(36, 43, 57),
        }, 0.12)
    end)

    button.MouseButton1Click:Connect(function()
        if callback then
            local ok, err = pcall(callback)
            if not ok then
                warn("[Dynamic Island] Button error:", err)
            end
        end
    end)

    return button
end

