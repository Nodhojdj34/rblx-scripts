        return math.floor(size.X) .. " x " .. math.floor(size.Y)
    end
    return "Unavailable"
end

--==================================================
-- PERFORMANCE MONITOR
--==================================================

local FPS = 0
local Ping = "Unavailable"
local Memory = "Unavailable"
local frameCounter = 0
local fpsElapsed = 0

local PerformanceHistory = {}

local function UpdatePerformance(dt)
    frameCounter += 1
    fpsElapsed += dt

    if fpsElapsed >= 1 then
        FPS = math.floor(frameCounter / fpsElapsed)
        frameCounter = 0
        fpsElapsed = 0

        local pingSuccess, pingValue = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)

        if pingSuccess then
            Ping = math.floor(pingValue) .. " ms"
        else
            Ping = "Unavailable"
        end

        local memorySuccess, memoryValue = pcall(function()
            return Stats:GetTotalMemoryUsageMb()
        end)

        if memorySuccess then
            Memory = math.floor(memoryValue) .. " MB"
        else
            Memory = "Unavailable"
        end

        table.insert(PerformanceHistory, {
            FPS = FPS,
            Time = os.date("%H:%M:%S")
        })

        if #PerformanceHistory > 60 then
            table.remove(PerformanceHistory, 1)
        end
    end
end

