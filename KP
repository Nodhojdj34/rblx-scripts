--========================================================
-- ANTI-FLING
--========================================================

local CurrentRoot
local CharacterGeneration = 0
local LastDetection = 0

local function SetupCharacter(character)
    CharacterGeneration += 1
    local generation = CharacterGeneration
    CurrentRoot = nil

    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)

        if Destroyed or generation ~= CharacterGeneration then
            return
        end

        if root and root:IsA("BasePart") then
            CurrentRoot = root
        end
    end)
end

Connect(Player.CharacterAdded:Connect(SetupCharacter))

Connect(Player.CharacterRemoving:Connect(function()
    CharacterGeneration += 1
    CurrentRoot = nil
end))

if Player.Character then
    SetupCharacter(Player.Character)
end

Connect(RunService.Heartbeat:Connect(function()
    if not Config.AntiFling or not CurrentRoot then return end
    if os.clock() - LastDetection < 0.2 then return end

    LastDetection = os.clock()

    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart then
        return
    end

    local root = CurrentRoot

    if not root.Parent then
        CurrentRoot = nil
        return
    end

    local speed = root.AssemblyLinearVelocity.Magnitude
    local angular = root.AssemblyAngularVelocity.Magnitude

    if speed > 180 or angular > 100 then
        AntiFlingCount += 1
        AntiFlingCountText.Text = "Detections: " .. AntiFlingCount

        Notify("Anti-Fling", "Abnormal movement detected", "System")

        -- Local best-effort stabilization only.
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end))

