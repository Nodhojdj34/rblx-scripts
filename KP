--==================================================
-- NETWORK PING
--==================================================

task.spawn(function()

    while GUI.Parent do

        if CONFIG.ShowPing then

            local success, result = pcall(function()

                return Stats.Network.ServerStatsItem[
                    "Data Ping"
                ]:GetValueString()

            end)

            if success then

                PingLabel.Text = "Ping: " .. tostring(result)
                NetworkLabel.Text = "Network: Connected"
                NetworkLabel.TextColor3 = GREEN

            else

                PingLabel.Text = "Ping: N/A"
                NetworkLabel.Text = "Network: Unavailable"
                NetworkLabel.TextColor3 = GRAY

            end

        end

        task.wait(2)

    end

end)

--==================================================
-- BATTERY / CHARGING
--==================================================

task.spawn(function()

    while GUI.Parent do

        if CONFIG.ShowBattery then

            local batterySuccess, battery = pcall(function()
                return UserInputService:GetDeviceBatteryLevel()
            end)

            local chargeSuccess, charging = pcall(function()
                return UserInputService:GetDeviceChargingState()
            end)

            if batterySuccess and typeof(battery) == "number" then

                local percent = math.floor(battery * 100)

                if chargeSuccess and
                    tostring(charging):lower():find("charging") then

                    BatteryLabel.Text =
                        "⚡ Charging: " .. percent .. "%"

                    BatteryLabel.TextColor3 = GREEN
                    MiniStatus.TextColor3 = GREEN

                else

                    BatteryLabel.Text =
                        "Battery: " .. percent .. "%"

                    BatteryLabel.TextColor3 = WHITE

                end

            else

                BatteryLabel.Text = "Battery: N/A"

            end

        end

        task.wait(5)

    end

end)

--==================================================
-- RESPONSIVE SCALE
--==================================================

local function UpdateScale()

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local width = camera.ViewportSize.X

    if width < 400 then
        UIScale.Scale = 0.82
    elseif width < 600 then
        UIScale.Scale = 0.90
    elseif width < 900 then
        UIScale.Scale = 0.95
    else
        UIScale.Scale = 1
    end

end

local function BindCamera(camera)

    if not camera then
        return
    end

    camera:GetPropertyChangedSignal(
        "ViewportSize"
    ):Connect(UpdateScale)

    UpdateScale()

end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    BindCamera(workspace.CurrentCamera)
end)

BindCamera(workspace.CurrentCamera)

