        Visible = false,
    }, Content)

    Create("UIPadding", {
        PaddingRight = UDim.new(0, 7),
        PaddingBottom = UDim.new(0, 12),
    }, page)

    Create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    Pages[name] = page
    return page
end

local function OpenPage(name)
    if not Pages[name] then return end

    CurrentPage = name

    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for pageName, button in pairs(Navigation) do
        local selected = pageName == name

        button.BackgroundColor3 = selected
            and Color3.fromRGB(43, 58, 80)
            or Color3.fromRGB(25, 30, 41)

        button.TextColor3 = selected
            and Config.Accent
            or Color3.fromRGB(195, 202, 215)
    end

    TopTitle.Text = Expanded
        and ("◉  DYNAMIC ISLAND  •  " .. name:upper())
        or "◉  DYNAMIC ISLAND"
end

