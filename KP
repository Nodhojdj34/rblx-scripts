local function updateScale()
    local viewport = camera.ViewportSize
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local base     = isMobile and 460 or 580
    local minScale = isMobile and 0.75 or 0.65
    local maxScale = isMobile and 1.15 or 1.00
    uiScale.Scale = math.clamp(viewport.X / base, minScale, maxScale)
end
