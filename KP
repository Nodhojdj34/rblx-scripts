--==================================================
-- EXPAND / COLLAPSE
--==================================================

local ExpandedState = false
local Animating = false

local function Expand()

    if ExpandedState or Animating then
        return
    end

    Animating = true
    ExpandedState = true

    Expanded.Visible = true

    local tween = TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.AnimationTime,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromOffset(
                CONFIG.ExpandedWidth,
                CONFIG.ExpandedHeight
            )
        }
    )

    tween:Play()
    tween.Completed:Wait()

    Animating = false
end

local function Collapse()

    if not ExpandedState or Animating then
        return
    end

    Animating = true

    local tween = TweenService:Create(
        Main,
        TweenInfo.new(
            CONFIG.AnimationTime,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        ),
        {
            Size = UDim2.fromOffset(
                CONFIG.CompactWidth,
                CONFIG.CompactHeight
            )
        }
    )

    tween:Play()
    tween.Completed:Wait()

    Expanded.Visible = false
    ExpandedState = false
    Animating = false
end

local function Toggle()

    if ExpandedState then
        Collapse()
    else
        Expand()
    end

end

ClickArea.Activated:Connect(Toggle)

