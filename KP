local StopwatchRunning = false
local StopwatchStart = 0
local StopwatchElapsed = 0
local Laps = {}
local CountdownRunning = false
local CountdownEnd = 0

local function BuildTime()
    local page = NewPage()

    Section(page, T("Time"))

    local clockLabel = InfoRow(
        page,
        "Local Time",
        os.date("%H:%M:%S")
    )

    local dateLabel = InfoRow(
        page,
        "Date",
        os.date("%Y-%m-%d")
    )

    task.spawn(function()
        while clockLabel.Parent and dateLabel.Parent do
            clockLabel.Text = os.date("%H:%M:%S")
            dateLabel.Text = os.date("%Y-%m-%d")
            task.wait(1)
        end
    end)

    Section(page, T("Stopwatch"))

    local stopwatchLabel = InfoRow(page, "Elapsed", "0.00 s")

    MakeButton(page, T("Start"), UDim2.new(),
        UDim2.new(1, 0, 0, 35), function()
            if not StopwatchRunning then
                StopwatchRunning = true
                StopwatchStart = os.clock() - StopwatchElapsed
            else
                StopwatchRunning = false
                StopwatchElapsed = os.clock() - StopwatchStart
            end
        end)

    MakeButton(page, T("Lap"), UDim2.new(),
        UDim2.new(1, 0, 0, 35), function()
            if StopwatchRunning then
                local lap = os.clock() - StopwatchStart
                table.insert(Laps, lap)
                Notify("Stopwatch", "Lap " .. #Laps .. ": " ..
                    string.format("%.2f", lap) .. "s", "System")
            end
        end)

    MakeButton(page, T("Reset"), UDim2.new(),
        UDim2.new(1, 0, 0, 35), function()
            StopwatchRunning = false
            StopwatchElapsed = 0
            table.clear(Laps)
            stopwatchLabel.Text = "0.00 s"
        end)

    task.spawn(function()
        while stopwatchLabel.Parent do
            if StopwatchRunning then
                StopwatchElapsed = os.clock() - StopwatchStart
                stopwatchLabel.Text = string.format(
                    "%.2f s",
                    StopwatchElapsed
                )
            end
            task.wait(0.1)
        end
    end)

    for index, lap in ipairs(Laps) do
        InfoRow(page, "Lap " .. index, string.format("%.2f s", lap))
    end

    Section(page, T("Countdown"))

    local countdownInput = InputBox(page, "Enter seconds")

    local countdownLabel = InfoRow(page, "Remaining", "Not running")

    MakeButton(page, T("StartTimer"), UDim2.new(),
        UDim2.new(1, 0, 0, 36), function()
            local seconds = tonumber(countdownInput.Text)

            if seconds and seconds > 0 then
                CountdownEnd = os.clock() + math.clamp(seconds, 1, 86400)
                CountdownRunning = true

                task.spawn(function()
                    while CountdownRunning do
                        local remaining = math.max(
                            0,
                            CountdownEnd - os.clock()
                        )

                        countdownLabel.Text =
                            string.format("%.1f s", remaining)

                        if remaining <= 0 then
                            CountdownRunning = false
                            Notify("Timer", "Countdown finished", "System")
                            break
                        end

                        task.wait(0.1)
                    end
                end)
            end
        end)
end

