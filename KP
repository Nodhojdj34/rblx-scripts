local function updatePlayButton()
    if playButton then
        playButton.Text = Sound.IsPlaying and "Ⅱ" or "▶"
    end
end

local function playCurrent()
    if not Playlist[CurrentIndex] then return end
    local item = Playlist[CurrentIndex]
    LoadingTrack = true
    TrackTitle.Text = item.Name
    TrackSub.Text = "Loading audio..."
    Sound:Stop()
    Sound.SoundId = "rbxassetid://" .. item.Id
    Sound.Volume = Config.Volume
    Sound.TimePosition = 0

    task.spawn(function()
        local loaded = Sound.IsLoaded
        if not loaded then
            local ok = pcall(function()
                Sound.Loaded:Wait()
            end)
            loaded = ok and Sound.IsLoaded
        end

        if not loaded then
            LoadingTrack = false
            TrackSub.Text = "Audio unavailable or permission denied"
            return
        end

        local ok = pcall(function()
            Sound:Play()
        end)

        LoadingTrack = false
        if ok then
            TrackSub.Text = "Now playing"
            updatePlayButton()
        else
            TrackSub.Text = "Unable to play this audio"
        end
    end)
end

local function nextTrack()
    if #Playlist == 0 then return end

    if Shuffle and #Playlist > 1 then
        local nextIndex = CurrentIndex
        while nextIndex == CurrentIndex do
            nextIndex = math.random(1, #Playlist)
        end
        CurrentIndex = nextIndex
    else
        CurrentIndex += 1
        if CurrentIndex > #Playlist then
            if RepeatMode == 1 then
                CurrentIndex = 1
            else
                CurrentIndex = #Playlist
                Sound:Stop()
                updatePlayButton()
                return
            end
        end
    end
    playCurrent()
end

local function previousTrack()
    if #Playlist == 0 then return end
    if Sound.TimePosition > 3 then
        Sound.TimePosition = 0
        return
    end
    CurrentIndex -= 1
    if CurrentIndex < 1 then
        CurrentIndex = #Playlist
    end
    playCurrent()
end

