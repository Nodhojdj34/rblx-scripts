local function Notify(title, message, category)
    table.insert(Notifications, {
        Title = tostring(title or "Notification"),
        Message = tostring(message or ""),
        Category = tostring(category or "General"),
        Time = os.date("%H:%M:%S"),
        Read = false,
    })

    while #Notifications > 60 do
        table.remove(Notifications, 1)
    end

    if Config.NotificationSound then
        -- Sound is intentionally optional.
        -- No external sound asset is forced.
    end
end

