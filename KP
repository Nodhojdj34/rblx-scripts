local function getPanelSize()
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

    local isMobile = UserInputService.TouchEnabled and viewport.X < 800

    local width = math.min(CONFIG.ExpandedWidth, viewport.X - 20)
    local height = math.min(CONFIG.ExpandedHeight, viewport.Y * 0.78)

    if isMobile then
        width = math.max(280, viewport.X * CONFIG.MobileWidthScale)
        height = math.max(320, math.min(CONFIG.ExpandedHeight, viewport.Y * CONFIG.MobileHeightScale))
    end

    return math.floor(width), math.floor(height)
end

local function updateResponsiveScale()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local widthScale = viewport.X / CONFIG.ExpandedWidth
    local heightScale = viewport.Y / (CONFIG.ExpandedHeight + 40)

    scale.Scale = math.clamp(math.min(widthScale, heightScale, 1), 0.55, 1)
end

local function expandIsland()
    if expanded then
        return
    end

    expanded = true
    local width, height = getPanelSize()

    compactButton.Visible = false
    panel.Visible = true
    panel.Size = UDim2.fromOffset(width, height)
    panel.BackgroundTransparency = 0

    main.ClipsDescendants = true

    tween(main, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(width, height + 48),
        Position = UDim2.new(0.5, 0, 0, 8),
    })

    panel.Size = UDim2.fromOffset(width, height)
    panel.Position = UDim2.fromOffset(0, 48)

    selectPage(selectedPage)
end

local function collapseIsland()
    if not expanded then
        return
    end

    expanded = false

    local animation = tween(main, CONFIG.AnimationTime, {
        Size = UDim2.fromOffset(190, 48),
        Position = UDim2.new(0.5, 0, 0, 8),
    })

    animation.Completed:Connect(function()
        if not expanded and main.Parent then
            panel.Visible = false
            compactButton.Visible = true
        end
    end)
end

compactButton.Activated:Connect(function()
    expandIsland()
end)

closeButton.Activated:Connect(function()
    collapseIsland()
end)

