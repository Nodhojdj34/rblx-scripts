--// PANEL OPEN / CLOSE
local Expanded = false

local function setExpanded(state)
    Expanded = state
    if state then
        Panel.Visible = true
        tween(Pill, {
            Size = UDim2.fromOffset(math.min(Config.PillWidth + 35, 420), Config.PillHeight),
        }, 0.22)
        tween(Panel, {
            Size = UDim2.fromOffset(Config.PanelWidth, Config.PanelHeight),
        }, 0.3)
    else
        tween(Panel, {
            Size = UDim2.fromOffset(Config.PanelWidth, 0),
        }, 0.23)
        tween(Pill, {
            Size = UDim2.fromOffset(Config.PillWidth, Config.PillHeight),
        }, 0.23)
        task.delay(0.25, function()
            if not Expanded then Panel.Visible = true end
        end)
    end
end

Pill.Activated:Connect(function()
    setExpanded(not Expanded)
