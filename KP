--==================== PLAY / PAUSE ====================

local function playPause()

    if not validAsset(getSong().SoundId) then
        Footer.Text = "● SET YOUR MUSIC ID FIRST"
        return
    end

    if isPlaying then

        Music:Pause()
        isPlaying = false

        PlayButton.Text = "▶"
        CompactText.Text = "PAUSED"

    else

        if Music.TimePosition > 0 then
            Music:Resume()
        else
            Music:Play()
        end

        isPlaying = true

        PlayButton.Text = "Ⅱ"
        CompactText.Text = "PLAYING"

    end

end

--==================== NEXT / PREVIOUS ====================

local function nextSong()

    if #PLAYLIST == 0 then
        return
    end

    if shuffleEnabled and #PLAYLIST > 1 then

        local nextIndex = currentIndex

        while nextIndex == currentIndex do
            nextIndex = math.random(1, #PLAYLIST)
        end

        currentIndex = nextIndex

    else

        currentIndex += 1

        if currentIndex > #PLAYLIST then

            if repeatMode == "all" then
                currentIndex = 1
            else
                currentIndex = #PLAYLIST
                Music:Stop()
                isPlaying = false
                PlayButton.Text = "▶"
                return
            end

        end

    end

    loadSong(true)

end

local function previousSong()

    if Music.TimePosition > 3 then
        Music.TimePosition = 0
        return
    end

    currentIndex -= 1

    if currentIndex < 1 then
        currentIndex = #PLAYLIST
    end

    loadSong(true)

end

