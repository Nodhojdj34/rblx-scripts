--// Anti-Fling V2.0 best-effort local monitor
local anti = {
    LastPosition = nil,
    LastVelocity = Vector3.zero,
    SafeCFrame = nil,
    LastSafeAt = 0,
    LastTriggerAt = 0,
    Suspicion = 0,
    LastSampleAt = 0,
}
local function getCharacterParts()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if humanoid and root then return character, humanoid, root end
end

local function safeState(humanoid, root)
    if humanoid.Health <= 0 or humanoid.SeatPart then return false end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Swimming
        or state == Enum.HumanoidStateType.Climbing
        or state == Enum.HumanoidStateType.Seated
        or state == Enum.HumanoidStateType.Dead then
        return false
    end
    if humanoid.FloorMaterial == Enum.Material.Air then return false end
    if math.abs(root.AssemblyLinearVelocity.Y) > 8 then return false end
    return true
end

local function antiFlingStep(dt)
    if not State.AntiFlingEnabled then return end
    local character, humanoid, root = getCharacterParts()
    if not character then return end
    local now = os.clock()
    local velocity = root.AssemblyLinearVelocity
    local angular = root.AssemblyAngularVelocity
    local position = root.Position
    if safeState(humanoid, root) then
        if now - anti.LastSafeAt > 0.25 then
            anti.SafeCFrame = root.CFrame
            anti.LastSafeAt = now
        end
    end
    if not anti.LastPosition then
        anti.LastPosition = position
        anti.LastVelocity = velocity
        anti.LastSampleAt = now
        return
    end
    local elapsed = math.max(0.016, now - anti.LastSampleAt)
    local acceleration = (velocity - anti.LastVelocity).Magnitude / elapsed
    local displacementSpeed = (position - anti.LastPosition).Magnitude / elapsed

    local thresholds = {
        Low = {speed=155, angular=42, accel=850, displacement=190},
        Medium = {speed=115, angular=32, accel=620, displacement=150},
        High = {speed=82, angular=23, accel=430, displacement=115},
    }
    local t = thresholds[State.AntiFlingSensitivity] or thresholds.Medium
    local suspicious = velocity.Magnitude > t.speed
        or angular.Magnitude > t.angular
        or acceleration > t.accel
        or displacementSpeed > t.displacement

    -- Avoid flagging normal airborne motion, seats, and special movement states.
    local state = humanoid:GetState()
    local airborneExpected = state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.FallingDown
    if humanoid.SeatPart or state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Climbing then
        suspicious = false
    elseif airborneExpected and velocity.Magnitude < t.speed * 1.35 and angular.Magnitude < t.angular * 1.5 then
        suspicious = false
    end

    if suspicious then
        anti.Suspicion += 1
    else
        anti.Suspicion = math.max(0, anti.Suspicion - 1)
    end

    local required = State.AntiFlingSensitivity == "High" and 1 or 2
    if anti.Suspicion >= required and now - anti.LastTriggerAt > 1.5 then
        anti.LastTriggerAt = now
        anti.Suspicion = 0
        State.AntiFlingStats.Triggers += 1
        State.AntiFlingStats.LastEvent = os.date("%H:%M:%S") .. " · 异常物理运动"
        notify("Anti-Fling 检测到异常", "正在尝试本地稳定角色。服务器控制的物理行为可能无法拦截。", "Protection")

        -- Best effort only: never anchor, teleport continuously, or alter WalkSpeed/JumpPower.
        local canControl = false
        pcall(function() canControl = root:CanSetNetworkOwnership() end)
        if canControl then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.new(
                    math.clamp(velocity.X, -34, 34),
                    math.clamp(velocity.Y, -48, 48),
                    math.clamp(velocity.Z, -34, 34)
                )
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end

        if State.AntiFlingRecover and anti.SafeCFrame and not humanoid.SeatPart
            and (position - anti.SafeCFrame.Position).Magnitude > 55
            and humanoid.Health > 0 then
            -- One-time local recovery to the last grounded position; may be rejected by server.
            pcall(function()
                root.CFrame = anti.SafeCFrame + Vector3.new(0, 3, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    anti.LastPosition = position
    anti.LastVelocity = velocity
    anti.LastSampleAt = now
end

--// Runtime monitoring
local frameCount = 0
local fpsElapsed = 0
local sampleElapsed = 0
local updateElapsed = 0
local connections = {}

table.insert(connections, RunService.RenderStepped:Connect(function(dt)
    frameCount += 1
    fpsElapsed += dt
    sampleElapsed += dt
    updateElapsed += dt
    if fpsElapsed >= 1 then
        State.FPS = math.floor(frameCount / fpsElapsed + 0.5)
        frameCount = 0
        fpsElapsed = 0
    end
    if sampleElapsed >= 2 then
        sampleElapsed = 0
        local ping = 0
        local memory = 0
        pcall(function()
            local item = Stats.Network.ServerStatsItem["Data Ping"]
            ping = math.floor(item:GetValue())
        end)
        pcall(function()
            memory = math.floor(Stats:GetTotalMemoryUsageMb())
        end)
        State.Ping = ping
        State.Memory = memory
        table.insert(State.PerformanceHistory, {
            Time = os.date("%H:%M:%S"),
            FPS = State.FPS,
            Ping = State.Ping,
            Memory = State.Memory,
        })
        while #State.PerformanceHistory > 60 do table.remove(State.PerformanceHistory, 1) end
    end
    if updateElapsed >= 0.5 then
        updateElapsed = 0
        if State.CurrentPage == "Home" then
            -- Keep the compact top-line status current without rebuilding the page.
            IslandSub.Text = MusicSound.IsPlaying and ("MUSIC  " .. (currentTrack() and currentTrack().Name or "Playing")) or ("FPS " .. State.FPS .. " · Ping " .. State.Ping .. " ms")
        end
        if State.CurrentPage == "Time" then
            -- Re-rendering the page is intentionally avoided every frame to prevent UI churn.
        end
    end
    antiFlingStep(dt)
end))

