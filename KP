--==================================================
-- 20. ANTI-FLING CHARACTER HANDLING
--==================================================

local CurrentRoot = nil
local CharacterGeneration = 0
local LastFlingCheck = 0

local function SetupCharacter(character)
    CharacterGeneration += 1
    local generation = CharacterGeneration

    CurrentRoot = nil

    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)

        if Destroyed or generation ~= CharacterGeneration then
            return
        end

        if root and root:IsA("BasePart") then
            CurrentRoot = root
        end
    end)
end

trackConnection(Player.CharacterAdded:Connect(SetupCharacter))

trackConnection(Player.CharacterRemoving:Connect(function()
    CharacterGeneration += 1
    CurrentRoot = nil
end))

if Player.Character then
    SetupCharacter(Player.Character)
end

-- Client-side best-effort detection only.
-- Does not bypass server physics or anti-cheat systems.
trackConnection(RunService.Heartbeat:Connect(function()
    if not Config.AntiFling or not CurrentRoot then
        return
    end

    if os.clock() - LastFlingCheck < 0.2 then
        return
    end

    LastFlingCheck = os.clock()

    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart then
        return
    end

    local root = CurrentRoot

    if not root.Parent then
        CurrentRoot = nil
        return
    end

    local speed = root.AssemblyLinearVelocity.Magnitude
    local spin = root.AssemblyAngularVelocity.Magnitude

    -- Conservative thresholds to reduce false positives.
    if speed > 180 or spin > 100 then
        AntiFlingCount += 1
        AntiFlingCountLabel.Text = "Detections: " .. AntiFlingCount

        Notify("Anti-Fling", "Abnormal movement detected", "System")

        -- Attempt local stabilization. Server may override this.
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end))

