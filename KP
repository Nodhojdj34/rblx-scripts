local function refreshPlaylist()
    for _, child in ipairs(PlaylistList:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end

    for i, item in ipairs(Playlist) do
        local row = create("Frame", {
            Size = UDim2.new(1, -5, 0, 31),
            BackgroundColor3 = i == CurrentIndex and Config.Accent or Colors.Background,
            BackgroundTransparency = i == CurrentIndex and 0.45 or 0.2,
            LayoutOrder = i,
        }, PlaylistList)
        round(row, 8)

        local selectButton = create("TextButton", {
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.new(1, -42, 1, 0),
            BackgroundTransparency = 1,
            Text = item.Name,
            TextColor3 = Colors.Text,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)

        selectButton.Activated:Connect(function()
            CurrentIndex = i
            refreshPlaylist()
            playCurrent()
        end)

        local remove = button(row, "×", UDim2.new(1, -32, 0, 2),
            UDim2.fromOffset(27, 27), function()
                table.remove(Playlist, i)
                if CurrentIndex > #Playlist then
                    CurrentIndex = #Playlist
                elseif i < CurrentIndex then
                    CurrentIndex -= 1
                elseif i == CurrentIndex then
                    Sound:Stop()
                    if #Playlist > 0 then
                        CurrentIndex = math.min(i, #Playlist)
                        playCurrent()
                    else
                        CurrentIndex = 0
                    end
                end
                refreshPlaylist()
            end, Colors.Card)
    end
end

