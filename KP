local function RefreshQueue()
    for _, row in ipairs(QueueRows) do
        row:Destroy()
    end

    table.clear(QueueRows)

    for index, id in ipairs(Playlist) do
        local row = New("Frame", {
            Size = UDim2.new(1, -5, 0, 32),
            BackgroundColor3 = index == CurrentTrack
                and Color3.fromRGB(42, 57, 79)
                or Color3.fromRGB(19, 25, 36),
            BorderSizePixel = 0,
        }, QueueList)

        Round(row, 8)

        local play = New("TextButton", {
            Position = UDim2.new(0, 7, 0, 0),
            Size = UDim2.new(1, -65, 1, 0),
            BackgroundTransparency = 1,
            Text = (index == CurrentTrack and "> " or "") .. "Track " .. index .. "  |  " .. id,
            TextColor3 = Color3.fromRGB(230, 237, 248),
            TextSize = 10,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)

        play.MouseButton1Click:Connect(function()
            PlayTrack(index)
        end)

        local remove = New("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -5, 0.5, 0),
            Size = UDim2.fromOffset(42, 25),
            BackgroundColor3 = Color3.fromRGB(100, 47, 55),
            Text = "DEL",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 9,
            Font = Enum.Font.GothamBold,
            BorderSizePixel = 0,
        }, row)

        Round(remove, 7)

        remove.MouseButton1Click:Connect(function()
            table.remove(Playlist, index)

            if #Playlist == 0 then
                CurrentTrack = 1
                Music:Stop()
            elseif index < CurrentTrack then
                CurrentTrack -= 1
            elseif index == CurrentTrack then
                CurrentTrack = math.min(CurrentTrack, #Playlist)
                PlayTrack(CurrentTrack)
            end

            RefreshQueue()
        end)

        table.insert(QueueRows, row)
    end

    if #Playlist == 0 then
        local empty = Text(QueueList, "Queue is empty. Add an Audio ID above.", 10,
            Color3.fromRGB(150, 165, 185))
        empty.Size = UDim2.new(1, -8, 0, 32)
        table.insert(QueueRows, empty)
    end
end

