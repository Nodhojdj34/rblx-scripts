--// HELPERS
local function corner(parent, radius)
    local v = Instance.new("UICorner")
    v.CornerRadius = UDim.new(0, radius or 12)
    v.Parent = parent
    return v
end

local function stroke(parent, color, transparency)
    local v = Instance.new("UIStroke")
    v.Color = color or C.Stroke
    v.Transparency = transparency or 0.5
    v.Thickness = 1
    v.Parent = parent
    return v
end

local function new(class, parent, properties)
    local v = Instance.new(class)
    for k, value in pairs(properties or {}) do
        v[k] = value
    end
    v.Parent = parent
    return v
end

local function makeLabel(parent, text, size, position, fontSize, color)
    return new("TextLabel", parent, {
        BackgroundTransparency = 1,
        Text = text,
        Size = size,
        Position = position,
        Font = Enum.Font.Gotham,
        TextSize = fontSize or 14,
        TextColor3 = color or C.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    })
end

local function makeButton(parent, text, size, position, callback)
    local b = new("TextButton", parent, {
        Size = size,
        Position = position,
        BackgroundColor3 = C.Button,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        AutoButtonColor = true,
    })
    corner(b, 10)
    if callback then b.Activated:Connect(callback) end
    return b
end

local function makeCard(parent, size, position)
    local f = new("Frame", parent, {
        Size = size,
        Position = position,
        BackgroundColor3 = C.Card,
        BorderSizePixel = 0,
    })
    corner(f, 13)
    return f
end

local function safeRead(callback, fallback)
    local ok, result = pcall(callback)
    if ok and result ~= nil then
        return tostring(result)
    end
    return fallback or "Unavailable"
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds or 0))
    return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

