if not Music then
    Music = Instance.new("Sound")
    Music.Name = "DynamicIslandV61Music"
    Music.Volume = Config.Volume
    Music.Parent = SoundService
end

Music.Volume = Config.Volume

local function AddRecent(id)
    for i = #RecentTracks, 1, -1 do
        if RecentTracks[i] == id then
            table.remove(RecentTracks, i)
        end
    end

    table.insert(RecentTracks, 1, id)

    while #RecentTracks > 10 do
        table.remove(RecentTracks)
    end
end

local function PlayTrack(index)
    if #Playlist == 0 then
        return
    end

    CurrentTrack = math.clamp(index, 1, #Playlist)

    local id = Playlist[CurrentTrack]

    Music:Stop()
    Music.SoundId = "rbxassetid://" .. id
    Music.TimePosition = 0
    Music.Volume = Config.Volume
    Music:Play()

    AddRecent(id)
end

local function NextTrack()
    if #Playlist == 0 then return end

    if Shuffle and #Playlist > 1 then
        local nextIndex = CurrentTrack

        repeat
            nextIndex = math.random(1, #Playlist)
        until nextIndex ~= CurrentTrack

        PlayTrack(nextIndex)
    elseif CurrentTrack < #Playlist then
        PlayTrack(CurrentTrack + 1)
    elseif RepeatMode == 1 then
        PlayTrack(1)
    end
end

local function PreviousTrack()
    if #Playlist == 0 then return end

    if Music.TimePosition > 3 then
        Music.TimePosition = 0
        return
    end

    if CurrentTrack > 1 then
        PlayTrack(CurrentTrack - 1)
    elseif RepeatMode == 1 then
        PlayTrack(#Playlist)
    else
        Music.TimePosition = 0
    end
end

Connect(Music.Ended:Connect(function()
    if Destroyed then return end

    if RepeatMode == 2 then
        Music.TimePosition = 0
        Music:Play()
    else
        NextTrack()
    end
end))

