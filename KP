local function updateBattery()
    local level = safeRead(function()
        return UserInputService:GetDeviceBatteryLevel()
    end)

    local charging = safeRead(function()
        return UserInputService:GetDeviceChargingState()
    end)

    if type(level) == "number" then
        local percent = math.clamp(level, 0, 1)

        batteryValue.Text = string.format(
            "%d%%",
            math.floor(percent * 100 + 0.5)
        )

        batteryFill.Size = UDim2.new(percent, 0, 1, 0)

        if percent <= 0.2 then
            batteryFill.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        else
            batteryFill.BackgroundColor3 = theme.Green
        end
    else
        batteryValue.Text = "Unavailable"
        batteryFill.Size = UDim2.new(0, 0, 1, 0)
    end

    if type(charging) == "boolean" then
        batteryStatus.Text = charging and "⚡ Charging" or "Not charging"
    else
        batteryStatus.Text = "Charging status unavailable"
    end
end

local function getNetworkStat(name)
    return safeRead(function()
        local network = Stats:FindFirstChild("Network")
        if not network then return nil end

        local item = network:FindFirstChild(name, true)
        if not item then return nil end

        if item.GetValueString then
            return item:GetValueString()
        end

        return nil
    end)
end

local function updateDeviceInfo()
    local camera = workspace.CurrentCamera

    -- Device type
    local deviceType = "Unknown"

    if UserInputService.TouchEnabled and UserInputService.KeyboardEnabled then
        deviceType = "Touch + Keyboard"
    elseif UserInputService.TouchEnabled then
        deviceType = "Mobile / Tablet"
    elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
        deviceType = "Console / Gamepad"
    elseif UserInputService.KeyboardEnabled then
        deviceType = "PC / Computer"
    end

    setDeviceInfo("设备类型", deviceType)

    -- Screen information
    if camera then
        local viewport = camera.ViewportSize

        setDeviceInfo(
            "屏幕分辨率",
            string.format("%d × %d", viewport.X, viewport.Y)
        )

        setDeviceInfo(
            "屏幕方向",
            viewport.X >= viewport.Y and "Landscape" or "Portrait"
        )
    end

    -- Input capabilities
    setDeviceInfo(
        "触摸支持",
        UserInputService.TouchEnabled and "Supported" or "No"
    )

    setDeviceInfo(
        "键盘支持",
        UserInputService.KeyboardEnabled and "Supported" or "No"
    )

    setDeviceInfo(
        "鼠标支持",
        UserInputService.MouseEnabled and "Supported" or "No"
    )

    setDeviceInfo(
        "手柄支持",
        UserInputService.GamepadEnabled and "Supported" or "No"
    )

    local preferredInput = safeRead(function()
        return UserInputService.PreferredInput.Name
    end)

    setDeviceInfo("主要输入", preferredInput or "Unavailable")

    -- FPS from local frame updates
    setDeviceInfo("当前FPS", tostring(currentFPS) .. " FPS")

    -- Client memory
    local memory = safeRead(function()
        return Stats:GetTotalMemoryUsageMb()
    end)

    if type(memory) == "number" then
        setDeviceInfo(
            "客户端内存",
            string.format("%.1f MB", memory)
        )
    else
        setDeviceInfo("客户端内存", "Unavailable")
    end

    -- Render timing may not be exposed on every client
    setDeviceInfo("CPU渲染耗时", "API unavailable")
    setDeviceInfo("GPU渲染耗时", "API unavailable")

    -- Network
    local ping = safeRead(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    if type(ping) == "number" then
        setDeviceInfo(
            "网络Ping",
            tostring(math.floor(ping + 0.5)) .. " ms"
        )
    else
        setDeviceInfo("网络Ping", "Unavailable")
    end

    local receive = getNetworkStat("Data Receive Kbps")
        or getNetworkStat("Data Receive")

    local send = getNetworkStat("Data Send Kbps")
        or getNetworkStat("Data Send")

    setDeviceInfo("数据接收", receive or "Unavailable")
    setDeviceInfo("数据发送", send or "Unavailable")

    -- Game information
    setDeviceInfo("游戏PlaceId", tostring(game.PlaceId))
    setDeviceInfo("游戏版本", tostring(game.PlaceVersion))

    -- Player information
    setDeviceInfo("玩家名称", player.Name)
    setDeviceInfo("显示名称", player.DisplayName)
    setDeviceInfo("玩家UserId", tostring(player.UserId))
    setDeviceInfo("账号年龄", tostring(player.AccountAge) .. " 天")

    -- Session time
    local elapsed = math.floor(os.clock() - sessionStart)

    local hours = math.floor(elapsed / 3600)
    local minutes = math.floor((elapsed % 3600) / 60)
    local seconds = elapsed % 60

    setDeviceInfo(
        "游戏运行时间",
        string.format("%02d:%02d:%02d", hours, minutes, seconds)
    )
end

