local DeviceScreenValue = DevicePage:GetChildren()[1]
local function updateScreenInfo()
    local camera = workspace.CurrentCamera
    if camera then
        local screen = camera.ViewportSize
        local rows = DevicePage:GetChildren()
        for _, row in ipairs(rows) do
            if row:IsA("Frame") then
                local titleLabel = row:FindFirstChildWhichIsA("TextLabel")
                if titleLabel and titleLabel.Text == "Screen" then
                    local labels = {}
                    for _, child in ipairs(row:GetChildren()) do
                        if child:IsA("TextLabel") then
                            table.insert(labels, child)
                        end
                    end
                    if #labels >= 2 then
                        labels[2].Text = math.floor(screen.X) .. " × " .. math.floor(screen.Y)
                    end
                end
            end
        end
    end
end

