local function applyTheme(name)
    if not THEMES[name] then return end

    currentThemeName = name
    theme = THEMES[name]

    panel.BackgroundColor3 = theme.Background
    sidebar.BackgroundColor3 = theme.Sidebar
    panelStroke.Color = theme.Border

    for pageName, button in pairs(sideButtons) do
        button.BackgroundColor3 =
            pageName == selectedPage and theme.Button or theme.Sidebar

        for _, child in ipairs(button:GetChildren()) do
            if child:IsA("TextLabel") then
                child.TextColor3 = theme.Text
            elseif child.Name == "ActiveMark" then
                child.BackgroundColor3 = theme.Accent
            end
        end
    end

    for _, page in pairs(pages) do
        for _, item in ipairs(page:GetDescendants()) do
            if item:IsA("TextLabel") then
                item.TextColor3 = theme.Text
            elseif item:IsA("TextButton") then
                item.TextColor3 = theme.Text
                item.BackgroundColor3 = theme.Button
            elseif item:IsA("ScrollingFrame") then
                item.BackgroundColor3 = theme.Card
            elseif item:IsA("Frame") then
                if item.Name ~= "ActiveMark"
                    and item ~= progressFill
                    and item ~= volumeFill
                    and item ~= batteryFill then
                    item.BackgroundColor3 = theme.Card
                end
            end
        end
    end

    for id, button in pairs(themeButtons) do
        button.BackgroundColor3 =
            id == name and theme.Green or theme.Button
    end

    compactText.TextColor3 = Color3.fromRGB(245, 245, 250)
    brand.TextColor3 = theme.Text
    topClock.TextColor3 = theme.SubText

    progressFill.BackgroundColor3 = theme.Accent
    volumeFill.BackgroundColor3 = theme.Accent
    batteryFill.BackgroundColor3 = theme.Green
