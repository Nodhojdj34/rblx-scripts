local IDInput = create("TextBox", {
    Size = UDim2.new(1, -8, 0, 40),
    BackgroundColor3 = COLORS.Card,
    Text = "",
    PlaceholderText = "Roblox Audio ID",
    PlaceholderColor3 = COLORS.Muted,
    TextColor3 = COLORS.Text,
    Font = Enum.Font.Gotham,
    TextSize = 13,
    ClearTextOnFocus = false,
}, MusicPage)
corner(IDInput)

local function playTrack(index)
    local id = Playlist[index]
    if not id then return end

    CurrentIndex = index
    Music:Stop()
    Music.SoundId = "rbxassetid://" .. id
    Music.TimePosition = 0
    Music.Volume = CONFIG.Volume
    TrackLabel.Text = "Loading Audio " .. id

    task.spawn(function()
        local loaded = Music.IsLoaded

        if not loaded then
            local success = pcall(function()
                Music.Loaded:Wait()
            end)
            loaded = success and Music.IsLoaded
        end

        if loaded then
            local ok = pcall(function()
                Music:Play()
            end)

            if ok then
                TrackLabel.Text = "Now Playing: " .. id
            else
                TrackLabel.Text = "Playback failed"
            end
        else
            TrackLabel.Text = "Audio unavailable or not permitted"
        end
    end)
end

button(
    MusicPage,
    "ADD AUDIO ID",
    UDim2.new(),
    UDim2.new(1, -8, 0, 38),
    function()
        local id = IDInput.Text:match("%d+")
        if not id then
            TrackLabel.Text = "Invalid Audio ID"
            return
        end

        table.insert(Playlist, id)
        IDInput.Text = ""
        playTrack(#Playlist)
    end
)

