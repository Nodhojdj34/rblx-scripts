local function applyShader(mode)
	for _, v in pairs(Lighting:GetChildren()) do
		if v.Name == "IslandShader" then v:Destroy() end
	end
	if mode == "None" then return end
	local cc = Instance.new("ColorCorrectionEffect", Lighting); cc.Name = "IslandShader"
	local bloom = Instance.new("BloomEffect", Lighting); bloom.Name = "IslandShader"; bloom.Intensity = 0.7
	if mode == "Cyber" then
		cc.Contrast = 0.25; cc.Saturation = 0.45; cc.TintColor = Color3.fromRGB(210, 230, 255); Lighting.ClockTime = 0
	elseif mode == "Sunset" then
		cc.Contrast = 0.15; cc.Saturation = 0.3; cc.TintColor = Color3.fromRGB(255, 210, 175); Lighting.ClockTime = 17.6
	elseif mode == "Dream" then
		cc.Contrast = 0.1; cc.Saturation = 0.35; cc.TintColor = Color3.fromRGB(245, 200, 255); Lighting.ClockTime = 18.5
	elseif mode == "Retro" then
		cc.Contrast = 0.3; cc.Saturation = -0.35; cc.TintColor = Color3.fromRGB(255, 240, 210)
	end
end

