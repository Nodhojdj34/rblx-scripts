local function switchPage(targetId)
	for id, page in pairs(UI.Pages) do page.Visible = (id == targetId) end
	for id, btn in pairs(UI.NavBtns) do
		local active = (id == targetId)
		TweenService:Create(btn, Anim.Fast, {
			BackgroundColor3 = active and Cfg.accentColor or Color3.fromRGB(28, 28, 38),
			TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(165, 165, 180)
		}):Play()
	end
end

