statusDot.Position = UDim2.new(0, 14, 0.5, 0)
statusDot.AnchorPoint = Vector2.new(0, 0.5)
statusDot.BackgroundColor3 = Color3.fromRGB(48, 209, 88) -- 苹果绿
statusDot.Parent = compactFrame
local dotCorner = Instance.new("UICorner")
dotCorner.CornerRadius = UDim.new(1, 0)
dotCorner.Parent = statusDot

-- 顶部时间显示
local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(0, 60, 1, 0)
timeLabel.Position = UDim2.new(1, -12, 0, 0)
timeLabel.AnchorPoint = Vector2.new(1, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Text = "12:00"
timeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
timeLabel.Font = Enum.Font.GothamMedium
timeLabel.TextSize = 12
timeLabel.TextXAlignment = Enum.TextXAlignment.Right
timeLabel.Parent = compactFrame

-- 4. 创建展开状态的内容 (Expanded View)
local expandedFrame = Instance.new("Frame")
expandedFrame.Name = "ExpandedContent"
expandedFrame.Size = UDim2.new(1, 0, 1, 0)
expandedFrame.BackgroundTransparency = 1
expandedFrame.Visible = false
expandedFrame.Parent = island

-- 玩家头像
local avatar = Instance.new("ImageLabel")
avatar.Size = UDim2.new(0, 50, 0, 50)
avatar.Position = UDim2.new(0, 20, 0, 20)
avatar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
avatar.Parent = expandedFrame
local avatarCorner = Instance.new("UICorner")
avatarCorner.CornerRadius = UDim.new(1, 0)
avatarCorner.Parent = avatar

-- 异步获取玩家头像
task.spawn(function()
	local content, isReady = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
	if isReady then avatar.Image = content end
end)

-- 玩家名称
local nameLabel = Instance.new("TextLabel")
nameLabel.Size = UDim2.new(0, 150, 0, 25)
nameLabel.Position = UDim2.new(0, 82, 0, 22)
nameLabel.BackgroundTransparency = 1
nameLabel.Text = player.DisplayName
nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
nameLabel.Font = Enum.Font.GothamBold
nameLabel.TextSize = 16
nameLabel.TextXAlignment = Enum.TextXAlignment.Left
nameLabel.Parent = expandedFrame

-- FPS 显示
local fpsLabel = Instance.new("TextLabel")
fpsLabel.Size = UDim2.new(0, 150, 0, 20)
