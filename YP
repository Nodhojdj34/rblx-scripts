local function applyCharacterTrail(char, enabled)
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart
	for _, v in pairs(root:GetChildren()) do
		if v.Name == "IslandTrail" or v.Name == "TrailAtt0" or v.Name == "TrailAtt1" then v:Destroy() end
	end
	if enabled then
		local a0 = Instance.new("Attachment", root); a0.Name = "TrailAtt0"; a0.Position = Vector3.new(0, 1.5, 0)
		local a1 = Instance.new("Attachment", root); a1.Name = "TrailAtt1"; a1.Position = Vector3.new(0, -1.5, 0)
		local tr = Instance.new("Trail", root); tr.Name = "IslandTrail"
		tr.Attachment0 = a0; tr.Attachment1 = a1
		tr.Lifetime = 0.6; tr.FaceCamera = true
		tr.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C_BLUE),
			ColorSequenceKeypoint.new(0.5, C_PINK),
			ColorSequenceKeypoint.new(1, C_GREEN)
		})
		tr.Transparency = NumberSequence.new(0.1, 1)
	end
end

