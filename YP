local playBtn
local function loadTrack(idx, customId)
	if customId then
		musicSound.SoundId = "rbxassetid://" .. tostring(customId)
		songTitle.Text = "自定义音乐 ID: " .. tostring(customId)
		songArtist.Text = "Custom Radio"
	else
		curTrack = idx
		if curTrack > #playlist then curTrack = 1 elseif curTrack < 1 then curTrack = #playlist end
		musicSound.SoundId = playlist[curTrack].id
		songTitle.Text = playlist[curTrack].name
		songArtist.Text = playlist[curTrack].artist
	end
	musicSound:Play()
	isPlaying = true
	playBtn.Text = "⏸️"
	playBtn.BackgroundColor3 = COLOR_PINK
end

createMusicBtn("⏮️", UDim2.new(1, -135, 0, 82), UDim2.new(0, 36, 0, 30), function() loadTrack(curTrack - 1) end)
playBtn = createMusicBtn("▶️", UDim2.new(1, -93, 0, 82), UDim2.new(0, 42, 0, 30), function()
	if isPlaying then
		musicSound:Pause()
		isPlaying = false
		playBtn.Text = "▶️"
		playBtn.BackgroundColor3 = COLOR_CARD_ACTIVE
	else
		if musicSound.SoundId == "" then loadTrack(1) else musicSound:Resume(); isPlaying = true; playBtn.Text = "⏸️"; playBtn.BackgroundColor3 = COLOR_PINK end
	end
end)
