local playBtn
local function playTrack(idx, customId)
	if customId then
		musicSound.SoundId = "rbxassetid://" .. tostring(customId)
		songTitle.Text = "自定义电台 ID: " .. tostring(customId)
		songArtist.Text = "Custom Audio Stream"
	else
		curTrack = idx
		if curTrack > #playlist then curTrack = 1 elseif curTrack < 1 then curTrack = #playlist end
		musicSound.SoundId = "rbxassetid://" .. playlist[curTrack].id
		songTitle.Text = playlist[curTrack].name
		songArtist.Text = playlist[curTrack].artist
	end
	musicSound:Play()
	isPlaying = true
	playBtn.Text = "⏸ 暂停"
	playBtn.BackgroundColor3 = C_PINK
end

makeCtrlBtn("⏮", 32, function() playTrack(curTrack - 1) end)
