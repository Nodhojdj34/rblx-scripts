-- 点击空白处自动收起 (兼容手机触摸与电脑点击)
UserInputService.InputBegan:Connect(function(input)
	if isExpanded and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		local pos = input.Position
		local iPos = island.AbsolutePosition
		local iSize = island.AbsoluteSize
		if pos.X < iPos.X or pos.X > iPos.X + iSize.X or pos.Y < iPos.Y or pos.Y > iPos.Y + iSize.Y then
			toggleIsland(false)
		end
	end
end)

-- ================= 5. 数据实时监控引擎 =================
local lastUpdate = os.clock()
local frames = 0
local showTimeInCompact = false

RunService.RenderStepped:Connect(function()
	frames += 1
	local now = os.clock()
	if now - lastUpdate >= 1 then
		local currentFps = frames
		frames = 0
		lastUpdate = now
		
		-- 获取真实 Ping (毫秒) 和 内存
		local ping = math.round(player:GetNetworkPing() * 1000)
		local mem = math.round(Stats:GetTotalMemoryUsageMb())
		
		-- 顶部小胶囊文字交替显示 (FPS / 时间)
		showTimeInCompact = not showTimeInCompact
		if showTimeInCompact then
			compactText.Text = os.date("%H:%M") .. " • " .. ping .. "ms"
		else
			compactText.Text = currentFps .. " FPS • " .. ping .. "ms"
		end
		
		-- 如果展开了服务器页面，更新全部详细信息
		if isExpanded and pageServer.Visible then
			local upTime = math.floor(workspace.DistributedGameTime)
			local hours = math.floor(upTime / 3600)
			local mins = math.floor((upTime % 3600) / 60)
			local secs = upTime % 60
			
			infoFPS.Text = string.format("🟢 实时帧率: <font color='#30D158'><b>%d FPS</b></font>", currentFps)
			infoPing.Text = string.format("📶 网络延迟: <font color='#0A84FF'><b>%d ms</b></font>", ping)
			infoMem.Text = string.format("💾 内存占用: <b>%d MB</b>", mem)
			infoPlayers.Text = string.format("👥 房间人数: <b>%d / %d 人</b>", #Players:GetPlayers(), Players.MaxPlayers)
			infoTime.Text = string.format("⏱️ 服运行时长: <b>%02d时 %02d分 %02d秒</b>", hours, mins, secs)
		end
	end
end)

-- ================= 6. 智能通知系统 =================
local function sendNotification(title, msg, color)
	if isNotifying then return end
	if isExpanded then toggleIsland(false) task.wait(0.3) end
	isNotifying = true
	compactFrame.Visible = false
	
	local notifyBox = Instance.new("Frame")
	notifyBox.Size = UDim2.new(1, 0, 1, 0)
	notifyBox.BackgroundTransparency = 1
	notifyBox.Parent = island
	
	createLabel(notifyBox, "🔔 " .. title, UDim2.new(1, -30, 0, 20), UDim2.new(0, 18, 0, 12), Enum.Font.GothamBold, 14, color or COLOR_IOS_GREEN)
	createLabel(notifyBox, msg, UDim2.new(1, -30, 0, 20), UDim2.new(0, 18, 0, 34), Enum.Font.Gotham, 13, COLOR_TEXT)
	
	TweenService:Create(island, TWEEN_EXPAND, {Size = SIZE_NOTIFY}):Play()
	TweenService:Create(mainCorner, TWEEN_EXPAND, {CornerRadius = UDim.new(0, 24)}):Play()
	
	task.wait(3.5)
	
	notifyBox:Destroy()
	compactFrame.Visible = true
	TweenService:Create(island, TWEEN_SHRINK, {Size = SIZE_CLOSED}):Play()
	TweenService:Create(mainCorner, TWEEN_SHRINK, {CornerRadius = UDim.new(0, 17)}):Play()
	task.wait(0.3)
	isNotifying = false
end

