-- ================= 同步开关状态管理器 (让控制中心与列表页开关实时同步) =================
local toggleSync = {}
local function registerSync(key, fn)
	if not toggleSync[key] then toggleSync[key] = {} end
	table.insert(toggleSync[key], fn)
end
local function triggerSync(key, val)
	cfg[key] = val
	if toggleSync[key] then
		for _, fn in ipairs(toggleSync[key]) do fn(val) end
	end
end

-- ================= 核心功能：⚡ 闪现冲刺 (Flash Dash) =================
local function performFlashDash()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	
	-- 镜头动态广角冲击感
	local origFov = camera.FieldOfView
	TweenService:Create(camera, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {FieldOfView = origFov + 22}):Play()
	task.delay(0.12, function()
		TweenService:Create(camera, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {FieldOfView = cfg.fovOn and cfg.fovVal or 70}):Play()
	end)
	
	-- 残影特效球
	localfx = Instance.new("Part", workspace)
	localfx.Size = Vector3.new(3, 3, 3); localfx.Shape = Enum.PartType.Ball
	localfx.Material = Enum.Material.Neon; localfx.Color = ACCENT
	localfx.Anchored = true; localfx.CanCollide = false; localfx.CFrame = root.CFrame
	TweenService:Create(localfx, TweenInfo.new(0.35), {Size = Vector3.new(0.2, 0.2, 12), Transparency = 1}):Play()
	game:GetService("Debris"):AddItem(localfx, 0.36)
	
	-- 向前瞬移冲刺 28 格 (带射线防卡墙检测)
	local dir = camera.CFrame.LookVector * 28
	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {char}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local hit = workspace:Raycast(root.Position, dir, rayParams)
	if hit then
		root.CFrame = CFrame.new(hit.Position - dir.Unit * 2.5) * root.CFrame.Rotation
	else
		root.CFrame = root.CFrame + dir
	end
end

