local function toggleIsland(expand)
	if expand == isExpanded then return end
	isExpanded = expand
	if isExpanded then
		compactView.Visible = false
		expandedView.Visible = true
		TweenService:Create(island, TWEEN_OPEN, { Size = SIZE_EXPANDED }):Play()
		TweenService:Create(islandCorner, TWEEN_OPEN, { CornerRadius = UDim.new(0, 26) }):Play()
	else
		expandedView.Visible = false
		compactView.Visible = true
		TweenService:Create(island, TWEEN_CLOSE, {
			Size = isHovered and SIZE_HOVER or SIZE_CLOSED,
			Position = DEFAULT_POS
		}):Play()
		TweenService:Create(islandCorner, TWEEN_CLOSE, { CornerRadius = UDim.new(0, 20) }):Play()
	end
end

