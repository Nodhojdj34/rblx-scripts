local function createToggle(title, icon, callback)
	local btn = Instance.new("TextButton")
	btn.BackgroundColor3 = COLOR_CARD
	btn.Text = "  " .. icon .. "  " .. title
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 13
	btn.TextColor3 = COLOR_TEXT
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.AutoButtonColor = false
	btn.Parent = pageControls
	addCorner(btn, 10)
	
	local active = false
	btn.Activated:Connect(function()
		active = not active
		TweenService:Create(btn, TWEEN_FAST, {
			BackgroundColor3 = active and COLOR_IOS_BLUE or COLOR_CARD
		}):Play()
		callback(active)
	end)
end

