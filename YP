local function sendToast(title, msg, col)
	local card = Instance.new("Frame", toastContainer)
	card.Size = UDim2.new(0, 0, 0, 54) -- 从0宽度滑入
	card.BackgroundColor3 = C_BG
	card.BackgroundTransparency = 0.08
	card.ClipsDescendants = true
	addCorner(card, 14)
	addStroke(card, col or ACCENT, 1.2, 0.25)
	
	local bar = Instance.new("Frame", card)
	bar.Size = UDim2.new(0, 4, 1, -16); bar.Position = UDim2.new(0, 8, 0, 8)
	bar.BackgroundColor3 = col or ACCENT; addCorner(bar, 2)
	
	createText(card, title, UDim2.new(1, -28, 0, 18), UDim2.new(0, 20, 0, 8), Enum.Font.GothamBold, 12, col or C_GREEN)
	createText(card, msg, UDim2.new(1, -28, 0, 16), UDim2.new(0, 20, 0, 27), Enum.Font.Gotham, 11, C_TEXT)
	
	TweenService:Create(card, TWEEN_BOUNCE, {Size = UDim2.new(0, 265, 0, 54)}):Play()
	task.delay(3.2, function()
		if card and card.Parent then
			local out = TweenService:Create(card, TWEEN_FAST, {Size = UDim2.new(0, 0, 0, 54), BackgroundTransparency = 1})
			out:Play()
			out.Completed:Wait()
			card:Destroy()
		end
	end)
end

