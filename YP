local accentObjs = {}
local function bindAccent(inst, prop)
	table.insert(accentObjs, {inst = inst, prop = prop})
	inst[prop] = ACCENT
end

local function setTheme(col)
	ACCENT = col
	for _, item in ipairs(accentObjs) do
		if item.inst and item.inst.Parent then
			TweenService:Create(item.inst, TWEEN_FAST, {[item.prop] = col}):Play()
		end
	end
end

-- ================= UI 基础组件库 =================
local function addCorner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = UDim.new(0, r)
	return c
end

local function addStroke(p, col, thick, trans)
	local s = Instance.new("UIStroke", p)
	s.Color = col or Color3.fromRGB(55, 55, 70)
	s.Thickness = thick or 1
	s.Transparency = trans or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function createText(p, txt, size, pos, font, tSize, col, align)
	local l = Instance.new("TextLabel", p)
	l.Size = size; l.Position = pos; l.BackgroundTransparency = 1
	l.Text = txt; l.Font = font or Enum.Font.GothamMedium
	l.TextSize = tSize or 12; l.TextColor3 = col or C_TEXT
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.TextTruncate = Enum.TextTruncate.AtEnd
	return l
end

