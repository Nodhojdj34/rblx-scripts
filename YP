	local valLbl = createText(card, tostring(defV) .. " " .. unit, UDim2.new(0.22, 0, 0, 18), UDim2.new(0.58, 0, 0, 7), Enum.Font.GothamBold, 11, C_SUB, Enum.TextXAlignment.Right)
	
	local swBg = Instance.new("TextButton", card)
	swBg.Size = UDim2.new(0, 42, 0, 22); swBg.Position = UDim2.new(1, -54, 0, 6)
	swBg.BackgroundColor3 = C_CARD_HOVER; swBg.Text = ""; swBg.AutoButtonColor = false; addCorner(swBg, 11)
	
	local knob = Instance.new("Frame", swBg)
	knob.Size = UDim2.new(0, 18, 0, 18); knob.Position = UDim2.new(0, 2, 0.5, -9); knob.BackgroundColor3 = C_TEXT; addCorner(knob, 9)
	
	registerSync(syncKey, function(val)
		TweenService:Create(swBg, TWEEN_FAST, {BackgroundColor3 = val and C_GREEN or C_CARD_HOVER}):Play()
		TweenService:Create(knob, TWEEN_FAST, {Position = val and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)}):Play()
		if onToggle then onToggle(val) end
	end)
	swBg.Activated:Connect(function() triggerSync(syncKey, not cfg[syncKey]) end)
	
	local sHit = Instance.new("TextButton", card)
	sHit.Size = UDim2.new(1, -24, 0, 20); sHit.Position = UDim2.new(0, 12, 0, 32); sHit.BackgroundTransparency = 1; sHit.Text = ""
	local sBg = Instance.new("Frame", sHit)
	sBg.Size = UDim2.new(1, 0, 0, 5); sBg.Position = UDim2.new(0, 0, 0.5, -2.5); sBg.BackgroundColor3 = Color3.fromRGB(45, 45, 58); addCorner(sBg, 3)
	
	local initR = math.clamp((defV - minV) / (maxV - minV), 0, 1)
	local sFill = Instance.new("Frame", sBg)
	sFill.Size = UDim2.new(initR, 0, 1, 0); addCorner(sFill, 3); bindAccent(sFill, "BackgroundColor3")
	local thumb = Instance.new("Frame", sBg)
	thumb.Size = UDim2.new(0, 13, 0, 13); thumb.Position = UDim2.new(initR, -6.5, 0.5, -6.5); thumb.BackgroundColor3 = C_TEXT; addCorner(thumb, 7)
	
	local function updateVal(x)
		local r = math.clamp((x - sBg.AbsolutePosition.X) / sBg.AbsoluteSize.X, 0, 1)
		local v = math.round(minV + r * (maxV - minV))
		sFill.Size = UDim2.new(r, 0, 1, 0); thumb.Position = UDim2.new(r, -6.5, 0.5, -6.5)
		valLbl.Text = tostring(v) .. " " .. unit
		onSlide(v)
	end
	sHit.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			activeSlider = sHit; updateVal(inp.Position.X)
			inp.Changed:Connect(function() if inp.UserInputState == Enum.UserInputState.End and activeSlider == sHit then activeSlider = nil end end)
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if activeSlider == sHit and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateVal(inp.Position.X)
		end
	end)
end

