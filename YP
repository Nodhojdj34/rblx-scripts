-- ================= 4. 动画与交互逻辑 =================
local function toggleIsland(expand)
	if isNotifying then return end
	isExpanded = expand
	
	if isExpanded then
		compactFrame.Visible = false
		expandedFrame.Visible = true
		TweenService:Create(island, TWEEN_EXPAND, {Size = SIZE_EXPANDED}):Play()
		TweenService:Create(mainCorner, TWEEN_EXPAND, {CornerRadius = UDim.new(0, 28)}):Play()
	else
		expandedFrame.Visible = false
		compactFrame.Visible = true
		local targetSize = isHovering and SIZE_HOVER or SIZE_CLOSED
		TweenService:Create(island, TWEEN_SHRINK, {Size = targetSize}):Play()
		TweenService:Create(mainCorner, TWEEN_SHRINK, {CornerRadius = UDim.new(0, 17)}):Play()
	end
end

openBtn.Activated:Connect(function() toggleIsland(true) end)
closeBtn.Activated:Connect(function() toggleIsland(false) end)

