	b.BackgroundTransparency = (page == pageMusic) and 0 or 1
	b.Text = txt; b.Font = Enum.Font.GothamBold; b.TextSize = 11; b.TextColor3 = COLOR_TEXT
	b.Parent = dock; addCorner(b, 8)
	table.insert(navItems, {btn = b, page = page})
	
	b.Activated:Connect(function()
		for _, item in pairs(navItems) do
			item.page.Visible = (item.page == page)
			TweenService:Create(item.btn, TWEEN_FAST, {
				BackgroundTransparency = (item.page == page) and 0 or 1,
				BackgroundColor3 = (item.page == page) and COLOR_BLUE or COLOR_CARD
			}):Play()
		end
		if page == pagePlayers then refreshPlayers() end
	end)
end

