local function onAccentChange(fn)
	table.insert(State.accentCallbacks, fn)
end

local function registerSync(key, fn)
	if not State.syncCallbacks[key] then State.syncCallbacks[key] = {} end
	table.insert(State.syncCallbacks[key], fn)
end

local function triggerSync(key, val)
	if State.syncCallbacks[key] then
		for _, fn in ipairs(State.syncCallbacks[key]) do fn(val) end
	end
end

local function setIslandMode(mode)
	State.islandMode = mode
	State.isAlertMorphing = false
	UI.AlertView.Visible = false

	if mode == "Closed" then
		UI.ExpandedView.Visible = false
		UI.MusicPillView.Visible = false
		UI.CompactView.Visible = true
		TweenService:Create(UI.Island, Anim.Smooth, {
			Size = State.isHovered and Anim.SizeHover or Anim.SizeClosed,
			Position = Anim.DefaultPos
		}):Play()
		TweenService:Create(UI.IslandCorner, Anim.Smooth, { CornerRadius = UDim.new(0, 20) }):Play()
	elseif mode == "MusicPill" then
		UI.ExpandedView.Visible = false
		UI.CompactView.Visible = false
		UI.MusicPillView.Visible = true
		TweenService:Create(UI.Island, Anim.Spring, {
			Size = Anim.SizeMusicPill,
			Position = Anim.DefaultPos
		}):Play()
		TweenService:Create(UI.IslandCorner, Anim.Spring, { CornerRadius = UDim.new(0, 28) }):Play()
	elseif mode == "Expanded" then
		UI.CompactView.Visible = false
		UI.MusicPillView.Visible = false
		UI.ExpandedView.Visible = true
		TweenService:Create(UI.Island, Anim.Spring, { Size = Anim.SizeExpanded }):Play()
		TweenService:Create(UI.IslandCorner, Anim.Spring, { CornerRadius = UDim.new(0, 28) }):Play()
	end
end

local function sendToast(title, subtitle, iconText, badgeColor, forceBottomRight)
	-- 当灵动岛处于收起胶囊态且非强制右下角时，触发真机灵动岛流体膨胀通知
	if State.islandMode == "Closed" and not forceBottomRight and UI.AlertView then
		State.alertToken += 1
		local myToken = State.alertToken
		State.isAlertMorphing = true

		UI.CompactView.Visible = false
		UI.MusicPillView.Visible = false
		UI.AlertView.Visible = true

		UI.AlertIconBox.BackgroundColor3 = badgeColor or Cfg.accentColor
		UI.AlertIconLbl.Text = iconText or "🔔"
		UI.AlertTitleLbl.Text = title
		UI.AlertSubLbl.Text = subtitle

		TweenService:Create(UI.Island, Anim.Spring, { Size = Anim.SizeAlertPill }):Play()
		TweenService:Create(UI.IslandCorner, Anim.Spring, { CornerRadius = UDim.new(0, 26) }):Play()

		task.delay(2.2, function()
			if State.alertToken == myToken and State.islandMode == "Closed" then
				UI.AlertView.Visible = false
				UI.CompactView.Visible = true
				State.isAlertMorphing = false
				TweenService:Create(UI.Island, Anim.Smooth, {
					Size = State.isHovered and Anim.SizeHover or Anim.SizeClosed
				}):Play()
				TweenService:Create(UI.IslandCorner, Anim.Smooth, { CornerRadius = UDim.new(0, 20) }):Play()
