UserInputService.InputBegan:Connect(function(inp, gp)
	if gp then return end
	if inp.KeyCode == Enum.KeyCode.RightShift then
		setIslandMode(State.islandMode == "Expanded" and "Closed" or "Expanded")
	elseif inp.KeyCode == Enum.KeyCode.Q then
		performFlashDash()
	elseif inp.KeyCode == Enum.KeyCode.R then
		performTimeRewind()
	end
end)

Players.PlayerAdded:Connect(function(p)
	if refreshPlayerRadar then refreshPlayerRadar() end
	if not Cfg.mutePlayerJoin then
		sendToast("新玩家加入房间", p.DisplayName .. " (@" .. p.Name .. ")", "👋", Color3.fromRGB(48, 209, 88), true)
	end
end)

Players.PlayerRemoving:Connect(function(p)
	if Cfg.followTarget == p then Cfg.followTarget = nil end
	if Cfg.orbitTarget == p then Cfg.orbitTarget = nil end
	task.defer(function() if refreshPlayerRadar then refreshPlayerRadar() end end)
	if not Cfg.mutePlayerJoin then
		sendToast("玩家离开房间", p.DisplayName .. " 退出了服务器", "🚪", Color3.fromRGB(255, 149, 0), true)
	end
end)

