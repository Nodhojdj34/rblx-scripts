-- 8. 核心物理与状态安全还原函数 (解决一切残留与飞行 Bug)
--==============================================================================
local origCollideCache = {}
local bvFly, bgFly = nil, nil

local function setNoclipState(enabled)
	cfg.noclip = enabled
	local char = player.Character
	if not char then return end
	if enabled then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				if origCollideCache[part] == nil then
					origCollideCache[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	else
		for part, wasCol in pairs(origCollideCache) do
			if part and part.Parent then part.CanCollide = wasCol end
		end
		table.clear(origCollideCache)
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then root.CanCollide = true end
	end
end

local function setAntiKillBrickState(enabled)
	cfg.antiKillBrick = enabled
	local char = player.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then part.CanTouch = not enabled end
	end
end

-- 完美清理飞行物理组件并扶正角色
local function stopFlyCleanly()
	cfg.flyVerticalInput = 0
	if bvFly then bvFly:Destroy(); bvFly = nil end
	if bgFly then bgFly:Destroy(); bgFly = nil end
	local char = player.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local airFloatForce = nil
local function setAirSwimState(enabled)
	cfg.airSwim = enabled
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if enabled then
		if hum then
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			hum:ChangeState(Enum.HumanoidStateType.Swimming)
		end
		if root and not airFloatForce then
			airFloatForce = Instance.new("BodyVelocity")
			airFloatForce.MaxForce = Vector3.new(0, 40000, 0)
			airFloatForce.Velocity = Vector3.zero
			airFloatForce.Parent = root
		end
	else
		if airFloatForce then airFloatForce:Destroy(); airFloatForce = nil end
		if hum then
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

-- 闪现冲刺
local function performFlashDash()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local look = camera.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = (flatLook.Magnitude > 0.01) and flatLook.Unit or root.CFrame.LookVector
	root.CFrame = root.CFrame + flatLook * 28
	sendToast("闪现冲刺", "已向准星方向瞬移 28 Studs", "⚡", Color3.fromRGB(255, 159, 10))
end

-- 3秒时光倒流回溯
local isRewinding = false
local function performTimeRewind()
	if isRewinding then return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or #rewindHistory < 5 then
		sendToast("时光倒流未就绪", "历史轨迹不足，请移动几秒后再试", "⏪", Color3.fromRGB(255, 69, 58))
		return
	end
	isRewinding = true
	sendToast("时光倒流启动", "正在沿着时间轨迹回溯至 3 秒前...", "⏪", Color3.fromRGB(175, 82, 222))
	task.spawn(function()
		for i = #rewindHistory, 1, -2 do
			if not root or not root.Parent then break end
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = rewindHistory[i]
			RunService.RenderStepped:Wait()
		end
		table.clear(rewindHistory)
		isRewinding = false
	end)
end

-- 原地刷新角色
local function refreshCharacterInPlace()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local savedCF = root.CFrame
	sendToast("原地刷新中", "正在重置角色并保留当前坐标...", "🔄", cfg.accentColor)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then hum.Health = 0 else char:BreakJoints() end
	task.spawn(function()
		local newChar = player.CharacterAdded:Wait()
		local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.15)
		if newRoot then
			newRoot.CFrame = savedCF
			sendToast("刷新完成", "已精准回到原位置", "✅", Color3.fromRGB(48, 209, 88))
		end
	end)
end

