-- 5. 智能双模通知系统 (收起时灵动岛本体膨胀，展开时右下角吐司不打扰)
--==============================================================================
local toastContainer = Instance.new("Frame", screenGui)
toastContainer.Name = "IndependentToastStack"
toastContainer.AnchorPoint = Vector2.new(1, 1)
toastContainer.Position = UDim2.new(1, -18, 1, -18)
toastContainer.Size = UDim2.new(0, 270, 0, 240)
toastContainer.BackgroundTransparency = 1

local toastLayout = Instance.new("UIListLayout", toastContainer)
toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
toastLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
toastLayout.Padding = UDim.new(0, 8)

local toastCounter = 0
local alertToken = 0

local function sendToast(title, subtitle, badgeText, badgeColor, forceBottomRight)
	-- 如果灵动岛处于静默胶囊状态且不是强制右下角，则使用真机灵动岛本体流体膨胀动画！
	if islandMode == "Closed" and not forceBottomRight then
		alertToken += 1
		local myToken = alertToken
		isAlertMorphing = true

		compactView.Visible = false
		musicPillView.Visible = false
		islandAlertView.Visible = true

		alertIconBox.BackgroundColor3 = badgeColor or cfg.accentColor
		alertIconLbl.Text = badgeText or "🔔"
		alertTitleLbl.Text = title
		alertSubLbl.Text = subtitle

		TweenService:Create(island, TWEEN_SPRING, { Size = SIZE_ALERT_PILL }):Play()
		TweenService:Create(islandCorner, TWEEN_SPRING, { CornerRadius = UDim.new(0, 26) }):Play()

		task.delay(2.2, function()
			if alertToken == myToken and islandMode == "Closed" then
				islandAlertView.Visible = false
				compactView.Visible = true
				isAlertMorphing = false
				TweenService:Create(island, TWEEN_SMOOTH, { Size = isHovered and SIZE_HOVER or SIZE_CLOSED }):Play()
				TweenService:Create(islandCorner, TWEEN_SMOOTH, { CornerRadius = UDim.new(0, 20) }):Play()
			end
		end)
		return
	end

	-- 当用户正在展开操作灵动岛或处于音乐小岛时，走右下角独立吐司，绝不打断操作
	toastCounter += 1
	local card = Instance.new("Frame", toastContainer)
	card.Size = UDim2.new(0, 270, 0, 52)
	card.BackgroundColor3 = Color3.fromRGB(18, 18, 25)
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.LayoutOrder = toastCounter
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 14)

	local st = Instance.new("UIStroke", card)
	st.Color = badgeColor or cfg.accentColor
	st.Thickness = 1.2
	st.Transparency = 0.35

	local iconBox = Instance.new("Frame", card)
	iconBox.Size = UDim2.new(0, 34, 0, 34)
	iconBox.AnchorPoint = Vector2.new(0, 0.5)
	iconBox.Position = UDim2.new(0, 10, 0.5, 0)
	iconBox.BackgroundColor3 = badgeColor or cfg.accentColor
	iconBox.BackgroundTransparency = 0.15
	Instance.new("UICorner", iconBox).CornerRadius = UDim.new(1, 0)

	local iconLbl = Instance.new("TextLabel", iconBox)
	iconLbl.Size = UDim2.new(1, 0, 1, 0)
	iconLbl.BackgroundTransparency = 1
	iconLbl.Text = badgeText or "🔔"
	iconLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	iconLbl.Font = Enum.Font.GothamBold
	iconLbl.TextSize = 14

	local tLbl = Instance.new("TextLabel", card)
	tLbl.Size = UDim2.new(1, -56, 0, 18)
	tLbl.Position = UDim2.new(0, 52, 0, 8)
	tLbl.BackgroundTransparency = 1
	tLbl.Text = title
	tLbl.TextColor3 = Color3.fromRGB(245, 245, 250)
	tLbl.Font = Enum.Font.GothamBold
