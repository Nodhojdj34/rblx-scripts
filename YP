			tpBtn.Parent = card; addCorner(tpBtn, 6)
			tpBtn.Activated:Connect(function()
				if player.Character and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					player.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
				end
			end)
		end
		
		-- 观战按钮
		local specBtn = Instance.new("TextButton")
		specBtn.Size = UDim2.new(0, 62, 0, 26); specBtn.Position = UDim2.new(1, -70, 0.5, -13)
		specBtn.BackgroundColor3 = (p == player) and COLOR_CARD_ACTIVE or COLOR_BLUE
