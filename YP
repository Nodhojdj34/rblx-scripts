-- 1. 创建带【自定义滑块 + iOS开关】的组合卡片
local function addCustomSliderToggle(parent, title, minVal, maxVal, defaultVal, unit, onToggle, onSlide)
	local card = Instance.new("Frame", parent)
	card.Size = UDim2.new(1, 0, 0, 58)
	card.BackgroundColor3 = C_CARD
	addCorner(card, 12)
	
	local titleLbl = createText(card, title, UDim2.new(0.55, 0, 0, 18), UDim2.new(0, 12, 0, 7), Enum.Font.GothamBold, 12, C_TEXT)
	local valLbl = createText(card, tostring(defaultVal) .. " " .. unit, UDim2.new(0.25, 0, 0, 18), UDim2.new(0.55, 0, 0, 7), Enum.Font.GothamBold, 11, C_SUB, Enum.TextXAlignment.Right)
	
	-- iOS 胶囊开关 (右上角)
	local swBg = Instance.new("TextButton", card)
	swBg.Size = UDim2.new(0, 42, 0, 22); swBg.Position = UDim2.new(1, -54, 0, 6)
	swBg.BackgroundColor3 = C_CARD_LIGHT; swBg.Text = ""; swBg.AutoButtonColor = false
	addCorner(swBg, 11)
	
	local swKnob = Instance.new("Frame", swBg)
	swKnob.Size = UDim2.new(0, 18, 0, 18); swKnob.Position = UDim2.new(0, 2, 0.5, -9)
	swKnob.BackgroundColor3 = C_TEXT; addCorner(swKnob, 9)
	
	local stateOn = false
	swBg.Activated:Connect(function()
		stateOn = not stateOn
		TweenService:Create(swBg, TWEEN_FAST, {BackgroundColor3 = stateOn and C_GREEN or C_CARD_LIGHT}):Play()
		TweenService:Create(swKnob, TWEEN_FAST, {Position = stateOn and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)}):Play()
		onToggle(stateOn)
	end)
	
	-- 底部可拖拽数值滑块条
	local sliderHit = Instance.new("TextButton", card)
	sliderHit.Size = UDim2.new(1, -24, 0, 20); sliderHit.Position = UDim2.new(0, 12, 0, 32)
	sliderHit.BackgroundTransparency = 1; sliderHit.Text = ""
	
	local trackBg = Instance.new("Frame", sliderHit)
	trackBg.Size = UDim2.new(1, 0, 0, 5); trackBg.Position = UDim2.new(0, 0, 0.5, -2.5)
	trackBg.BackgroundColor3 = Color3.fromRGB(45, 45, 55); addCorner(trackBg, 3)
	
	local initRatio = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
	local trackFill = Instance.new("Frame", trackBg)
	trackFill.Size = UDim2.new(initRatio, 0, 1, 0); addCorner(trackFill, 3)
	bindAccent(trackFill, "BackgroundColor3")
	
	local thumb = Instance.new("Frame", trackBg)
	thumb.Size = UDim2.new(0, 13, 0, 13); thumb.Position = UDim2.new(initRatio, -6.5, 0.5, -6.5)
	thumb.BackgroundColor3 = C_TEXT; addCorner(thumb, 7)
	
	local function updateSlider(inputX)
		local ratio = math.clamp((inputX - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
		local val = math.round(minVal + ratio * (maxVal - minVal))
		trackFill.Size = UDim2.new(ratio, 0, 1, 0)
		thumb.Position = UDim2.new(ratio, -6.5, 0.5, -6.5)
		valLbl.Text = tostring(val) .. " " .. unit
		onSlide(val)
	end
	
	sliderHit.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			activeSlider = sliderHit
			updateSlider(inp.Position.X)
			inp.Changed:Connect(function()
				if inp.UserInputState == Enum.UserInputState.End and activeSlider == sliderHit then activeSlider = nil end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if activeSlider == sliderHit and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(inp.Position.X)
		end
	end)
end

-- 2. 创建双列紧凑型 iOS 胶囊开关行 (一行放两个开关，节省空间容纳更多功能)
local function addDualSwitchRow(parent, t1, d1, cb1, t2, d2, cb2)
	local row = Instance.new("Frame", parent)
	row.Size = UDim2.new(1, 0, 0, 44); row.BackgroundTransparency = 1
	
	local function makeHalf(posScale, title, desc, cb)
		local box = Instance.new("Frame", row)
		box.Size = UDim2.new(0.49, 0, 1, 0); box.Position = UDim2.new(posScale, 0, 0, 0)
		box.BackgroundColor3 = C_CARD; addCorner(box, 10)
		
		createText(box, title, UDim2.new(1, -56, 0, 16), UDim2.new(0, 10, 0, 6), Enum.Font.GothamBold, 11, C_TEXT)
		createText(box, desc, UDim2.new(1, -56, 0, 14), UDim2.new(0, 10, 0, 22), Enum.Font.Gotham, 9, C_SUB)
		
		local swBg = Instance.new("TextButton", box)
		swBg.Size = UDim2.new(0, 38, 0, 20); swBg.Position = UDim2.new(1, -46, 0.5, -10)
		swBg.BackgroundColor3 = C_CARD_LIGHT; swBg.Text = ""; swBg.AutoButtonColor = false; addCorner(swBg, 10)
		
		local knob = Instance.new("Frame", swBg)
		knob.Size = UDim2.new(0, 16, 0, 16); knob.Position = UDim2.new(0, 2, 0.5, -8)
		knob.BackgroundColor3 = C_TEXT; addCorner(knob, 8)
		
		local on = false
		swBg.Activated:Connect(function()
			on = not on
			TweenService:Create(swBg, TWEEN_FAST, {BackgroundColor3 = on and C_GREEN or C_CARD_LIGHT}):Play()
			TweenService:Create(knob, TWEEN_FAST, {Position = on and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
			cb(on)
		end)
	end
	makeHalf(0, t1, d1, cb1)
	if t2 then makeHalf(0.51, t2, d2, cb2) end
end

