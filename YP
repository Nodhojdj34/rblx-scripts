local function addFeatureBtn(page, title, sub, icon, callback)
	local btn = Instance.new("TextButton")
	btn.BackgroundColor3 = COLOR_CARD
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = page
	addCorner(btn, 12)
	
	local ic = createText(btn, icon, UDim2.new(0, 30, 1, 0), UDim2.new(0, 8, 0, 0), Enum.Font.GothamBold, 18, COLOR_TEXT, Enum.TextXAlignment.Center)
	local t1 = createText(btn, title, UDim2.new(1, -42, 0, 18), UDim2.new(0, 38, 0, 9), Enum.Font.GothamBold, 12, COLOR_TEXT)
	local t2 = createText(btn, sub, UDim2.new(1, -42, 0, 14), UDim2.new(0, 38, 0, 27), Enum.Font.Gotham, 10, COLOR_SUB)
	
	local active = false
	btn.Activated:Connect(function()
		active = not active
		TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = active and COLOR_BLUE or COLOR_CARD}):Play()
		t2.Text = active and "已开启" or sub
		t2.TextColor3 = active and COLOR_TEXT or COLOR_SUB
		callback(active)
	end)
end

