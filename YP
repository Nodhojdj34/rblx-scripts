local function registerSync(key, fn)
	if not syncCallbacks[key] then syncCallbacks[key] = {} end
	table.insert(syncCallbacks[key], fn)
end

local function triggerSync(key, val)
	if syncCallbacks[key] then
		for _, fn in ipairs(syncCallbacks[key]) do fn(val) end
	end
end

