local trackRowBtns = {}
local function loadAndPlayTrack(idx)
	curTrackIdx = idx
	local tr = playlist[idx]
	mTitle.Text = tr.title
	mArtist.Text = tr.artist
	mpTitle.Text = tr.title
	mpSub.Text = tr.artist
	vinylCenter.BackgroundColor3 = tr.color
	albumAmbient.BackgroundColor3 = tr.color

	soundObj:Stop()
	soundObj.SoundId = tr.id
	soundObj.PlaybackSpeed = soundPitch
	soundObj:Play()
	isPlayingMusic = true
	playBtn.Text = "⏸"
	mpPlayBtn.Text = "⏸"
	TweenService:Create(tonearmPivot, TWEEN_FAST, { Rotation = 8 }):Play()

	for i, b in ipairs(trackRowBtns) do
		b.BackgroundColor3 = (i == idx) and cfg.accentColor or Color3.fromRGB(30, 30, 44)
	end
end

for idx, tr in ipairs(playlist) do
	local b = Instance.new("TextButton", trackScroll)
	b.Size = UDim2.new(1, -4, 0, 32)
	b.BackgroundColor3 = (idx == 1) and cfg.accentColor or Color3.fromRGB(30, 30, 44)
	b.Text = string.format("  %d. %s", idx, tr.title)
	b.TextColor3 = Color3.fromRGB(240, 240, 248)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextTruncate = Enum.TextTruncate.AtEnd
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	trackRowBtns[idx] = b
	b.MouseButton1Click:Connect(function() loadAndPlayTrack(idx) end)
end

local function togglePlayPause()
	if isPlayingMusic then
		soundObj:Pause()
		isPlayingMusic = false
		playBtn.Text = "▶"
		mpPlayBtn.Text = "▶"
		TweenService:Create(tonearmPivot, TWEEN_FAST, { Rotation = -25 }):Play()
	else
		if soundObj.SoundId == "" then
			loadAndPlayTrack(curTrackIdx)
		else
			soundObj:Resume()
			isPlayingMusic = true
			playBtn.Text = "⏸"
			mpPlayBtn.Text = "⏸"
			TweenService:Create(tonearmPivot, TWEEN_FAST, { Rotation = 8 }):Play()
		end
	end
end

local function playPrevTrack()
	local n = curTrackIdx - 1
	if n < 1 then n = #playlist end
	loadAndPlayTrack(n)
end

local function playNextTrack()
	local n = curTrackIdx + 1
	if n > #playlist then n = 1 end
	loadAndPlayTrack(n)
end

playBtn.MouseButton1Click:Connect(togglePlayPause)
mpPlayBtn.MouseButton1Click:Connect(togglePlayPause)
prevBtn.MouseButton1Click:Connect(playPrevTrack)
mpPrevBtn.MouseButton1Click:Connect(playPrevTrack)
nextBtn.MouseButton1Click:Connect(playNextTrack)
mpNextBtn.MouseButton1Click:Connect(playNextTrack)

