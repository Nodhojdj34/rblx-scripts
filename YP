local airPart = nil
local orbitAngle = 0

RunService.Stepped:Connect(function(_, dt)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and root and hum) then return end
	
	-- 1. 穿墙模式 (Noclip)
	if state.noclip then
		for _, p in pairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
		end
	end
	
	-- 2. 踏空行走 (Air Walk)
	if state.airWalk then
		if not airPart then
			airPart = Instance.new("Part", workspace)
			airPart.Size = Vector3.new(7, 0.4, 7); airPart.Anchored = true; airPart.Transparency = 0.5
			airPart.Material = Enum.Material.Neon; airPart.Color = C_BLUE
		end
		airPart.CFrame = root.CFrame * CFrame.new(0, -3.2, 0)
	elseif airPart then
		airPart:Destroy(); airPart = nil
	end
	
	-- 3. 3D 自由飞行 (自适应手机摇杆与PC键盘)
	if state.fly then
		local bv = root:FindFirstChild("IslandFlyBV") or Instance.new("BodyVelocity", root)
		bv.Name = "IslandFlyBV"; bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		local bg = root:FindFirstChild("IslandFlyBG") or Instance.new("BodyGyro", root)
		bg.Name = "IslandFlyBG"; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bg.P = 9e4
		
		hum.PlatformStand = true
		bg.CFrame = camera.CFrame
		
		local moveDir = hum.MoveDirection
		if moveDir.Magnitude > 0 then
			local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
			local forwardDot = moveDir:Dot(flatLook)
			local vertVel = camera.CFrame.LookVector.Y * forwardDot
			bv.Velocity = (moveDir + Vector3.new(0, vertVel, 0)).Unit * state.flySpeed
		else
			bv.Velocity = Vector3.zero
		end
	end
	
	-- 4. 蜘蛛爬墙
	if state.spider then
		local ray = workspace:Raycast(root.Position, root.CFrame.LookVector * 2.5)
		if ray then root.Velocity = Vector3.new(root.Velocity.X, 30, root.Velocity.Z) end
	end
	
	-- 5. 炫酷陀螺旋转
	if state.spin then
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(25), 0)
	end
	
	-- 6. 环绕玩家飞行
	if state.orbitTarget and state.orbitTarget.Character and state.orbitTarget.Character:FindFirstChild("HumanoidRootPart") then
		orbitAngle = orbitAngle + dt * 4
		local tPos = state.orbitTarget.Character.HumanoidRootPart.Position
		root.CFrame = CFrame.new(tPos + Vector3.new(math.cos(orbitAngle)*6, 1, math.sin(orbitAngle)*6), tPos)
	end
end)

-- ================= 6. 音乐律动与服务器监控循环 =================
local lastClock = os.clock()
local frameCount = 0

RunService.RenderStepped:Connect(function(dt)
	frameCount += 1
	
	-- 唱片旋转与真实音波律动
	if isPlaying and musicSound.IsPlaying then
		vinylDisc.Rotation = (vinylDisc.Rotation + dt * 95 * curSpeed) % 360
		local loud = math.clamp(musicSound.PlaybackLoudness / 220, 0.15, 1)
		for i, bar in ipairs(waveBars) do
			local h = math.clamp(loud * 16 * math.abs(math.sin(os.clock()*10 + i*1.3)), 4, 16)
			bar.Size = bar.Size:Lerp(UDim2.new(0, 3, 0, h), 0.35)
		end
		if musicSound.TimeLength > 0 then
			progFill.Size = UDim2.new(musicSound.TimePosition / musicSound.TimeLength, 0, 1, 0)
			local cM, cS = math.floor(musicSound.TimePosition/60), math.floor(musicSound.TimePosition%60)
			local tM, tS = math.floor(musicSound.TimeLength/60), math.floor(musicSound.TimeLength%60)
			timeLabel.Text = string.format("%02d:%02d / %02d:%02d", cM, cS, tM, tS)
		end
	else
		for _, bar in ipairs(waveBars) do bar.Size = bar.Size:Lerp(UDim2.new(0, 3, 0, 4), 0.2) end
	end
	
	-- 每秒更新系统状态
	local now = os.clock()
	if now - lastClock >= 1 then
		local fps = frameCount; frameCount = 0; lastClock = now
		local ping = math.round(player:GetNetworkPing() * 1000)
		local mem = math.round(Stats:GetTotalMemoryUsageMb())
		
		compactText.Text = isPlaying and ("🎵 " .. string.sub(songTitle.Text, 1, 14) .. "..") or (fps .. " FPS • " .. ping .. "ms")
		pingPill.Text = fps .. " FPS"
		if state.esp then refreshESP() end
		
		if isExpanded and pageServer.Visible then
			local up = math.floor(workspace.DistributedGameTime)
			sFPS.Text = string.format("🟢 实时画面帧率: <font color='#30D158'><b>%d FPS</b></font>", fps)
			sPing.Text = string.format("📶 网络通信延迟: <font color='#0A84FF'><b>%d ms</b></font>", ping)
			sMem.Text = string.format("💾 客户端内存占用: <b>%d MB</b>", mem)
			sPlrs.Text = string.format("👥 服务器在线人数: <b>%d / %d 人</b>", #Players:GetPlayers(), Players.MaxPlayers)
			sTime.Text = string.format("⏱️ 服务器运行时长: <b>%02d时 %02d分 %02d秒</b>", math.floor(up/3600), math.floor((up%3600)/60), up%60)
		end
	end
end)

