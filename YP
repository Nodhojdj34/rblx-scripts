local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 动画配置 (模仿苹果的丝滑弹性动画)
local expandTweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local shrinkTweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local fadeTweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- 状态变量
local isExpanded = false
local isHovering = false
local isNotifying = false

-- 尺寸定义 (使用Offset保证在手机和电脑上大小一致)
local SIZE_CLOSED = UDim2.new(0, 120, 0, 32)
local SIZE_HOVER = UDim2.new(0, 135, 0, 34)
local SIZE_EXPANDED = UDim2.new(0, 320, 0, 110)

local CORNER_CLOSED = UDim.new(0, 16)
local CORNER_EXPANDED = UDim.new(0, 30)

-- 1. 创建基础 ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DynamicIslandGui"
screenGui.IgnoreGuiInset = true -- 忽略顶部栏，真正置顶
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

-- 2. 创建灵动岛主体 (黑色胶囊)
local island = Instance.new("Frame")
island.Name = "Island"
island.AnchorPoint = Vector2.new(0.5, 0)
island.Position = UDim2.new(0.5, 0, 0, 10) -- 距离屏幕最上方 10 像素
island.Size = SIZE_CLOSED
island.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
island.ClipsDescendants = true -- 裁剪超出部分
island.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = CORNER_CLOSED
uiCorner.Parent = island

local uiStroke = Instance.new("UIStroke")
uiStroke.Color = Color3.fromRGB(45, 45, 45)
uiStroke.Thickness = 1
uiStroke.Parent = island

-- 3. 创建缩小状态的内容 (Compact View)
local compactFrame = Instance.new("Frame")
compactFrame.Name = "CompactContent"
compactFrame.Size = UDim2.new(1, 0, 1, 0)
compactFrame.BackgroundTransparency = 1
compactFrame.Parent = island

-- 小绿点 (模仿iOS隐私指示器/后台活动)
local statusDot = Instance.new("Frame")
