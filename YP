local function toggleIsland(expand)
	if isNotifying then return end
	isExpanded = expand
	if isExpanded then
		compactFrame.Visible = false; expandedFrame.Visible = true
		TweenService:Create(island, TWEEN_BOUNCE, {Size = SIZE_EXPANDED}):Play()
		TweenService:Create(mainCorner, TWEEN_BOUNCE, {CornerRadius = UDim.new(0, 30)}):Play()
	else
		expandedFrame.Visible = false; compactFrame.Visible = true
		activeSlider = nil
		local tSize = isHovering and SIZE_HOVER or SIZE_CLOSED
		TweenService:Create(island, TWEEN_SMOOTH, {Size = tSize, Position = DEFAULT_POS}):Play()
		TweenService:Create(mainCorner, TWEEN_SMOOTH, {CornerRadius = UDim.new(0, 18)}):Play()
	end
end

