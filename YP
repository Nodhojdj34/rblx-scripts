RunService.Stepped:Connect(function()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if Cfg.noclip then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				if Backup.OrigCollide[p] == nil then Backup.OrigCollide[p] = true end
				p.CanCollide = false
			end
		end
	end

	if Cfg.antiFling then
		for _, op in ipairs(Players:GetPlayers()) do
			if op ~= player and op.Character then
				for _, p in ipairs(op.Character:GetDescendants()) do
					if p:IsA("BasePart") then
						p.CanCollide = false
						p.AssemblyLinearVelocity = Vector3.zero
						p.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end
		end
	end

	if hum then
		if Cfg.speedOn then hum.WalkSpeed = Cfg.speedVal end
		if Cfg.jumpOn then hum.UseJumpPower = true; hum.JumpPower = Cfg.jumpVal end
		if Cfg.autoJump and hum.FloorMaterial ~= Enum.Material.Air then hum.Jump = true end
	end

	if Cfg.magnetLoot and root then
		for _, item in ipairs(Workspace:GetChildren()) do
			if item:IsA("Tool") and item:FindFirstChild("Handle") then
				local h = item.Handle
				if (h.Position - root.Position).Magnitude <= 35 then h.CFrame = root.CFrame end
			end
		end
	end
end)

-- RenderStepped 渲染帧
RunService.RenderStepped:Connect(function(dt)
	State.frameCount += 1
	local now = os.clock()
	local cam = getCam()

	if Cfg.rainbowBorder then
		UI.StrokeGrad.Rotation = (UI.StrokeGrad.Rotation + 90 * dt) % 360
		UI.AmbientGrad.Rotation = (UI.AmbientGrad.Rotation + 35 * dt) % 360
	end

	-- 音乐黑胶旋转与频谱律动
	local snd = UI.Sound
	if State.isPlayingMusic and snd and snd.IsPlaying then
		UI.VinylDisc.Rotation = (UI.VinylDisc.Rotation + 80 * dt * State.soundPitch) % 360
		UI.MpDisc.Rotation = UI.VinylDisc.Rotation
		local loud = math.clamp(snd.PlaybackLoudness / 400, 0.06, 1)
		local gSz = 130 + loud * 55
		UI.AlbumAmbient.Size = UDim2.new(0, gSz, 0, gSz)

		for i, bar in ipairs(UI.EqBars) do
			local w = math.abs(math.sin(now * 11 + i * 0.55))
			bar.Size = UDim2.new(0, 5, 0, math.clamp(4 + (loud * 28 * w), 4, 32))
		end
		for i, mbar in ipairs(UI.MiniBars) do
			local h = math.clamp(4 + loud * 12 * math.abs(math.cos(now * 12 + i)), 4, 15)
			mbar.Size = UDim2.new(0, 3, 0, h)
		end

		if snd.TimeLength > 0 then
			local pct = math.clamp(snd.TimePosition / math.max(0.01, snd.TimeLength), 0, 1)
			UI.SeekFill.Size = UDim2.new(pct, 0, 1, 0)
			UI.MpProgFill.Size = UDim2.new(pct, 0, 1, 0)
			UI.TimeCur.Text = string.format("%02d:%02d", math.floor(snd.TimePosition / 60), math.floor(snd.TimePosition % 60))
			UI.TimeTot.Text = string.format("%02d:%02d", math.floor(snd.TimeLength / 60), math.floor(snd.TimeLength % 60))
		end
	else
		for i, mbar in ipairs(UI.MiniBars) do
			mbar.Size = UDim2.new(0, 3, 0, 4 + math.sin(now * 4 + i) * 2.5)
		end
	end

	if cam and Cfg.fovOn then cam.FieldOfView = Cfg.fovVal end
	if Cfg.timeLockOn then Lighting.ClockTime = Cfg.timeLockVal end
	if Cfg.fullbright then
		Lighting.Brightness = 2.5
		if not Cfg.timeLockOn then Lighting.ClockTime = 14 end
		Lighting.FogEnd = 100000; Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
	end

	-- 无人机自由视角
	if Cfg.freecam and cam then
		cam.CameraType = Enum.CameraType.Scriptable
		local mv = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv += cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv -= cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv -= cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv += cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0, 1, 0) end
		if mv.Magnitude > 0 then State.freecamCF = State.freecamCF + mv.Unit * (Cfg.flySpeed * dt) end
		cam.CFrame = CFrame.new(State.freecamCF.Position) * cam.CFrame.Rotation
	end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if root and hum then
		-- 记录 3秒时光倒流轨迹
		if not State.isRewinding and (now - State.lastRewindTime >= 0.03) then
			State.lastRewindTime = now
			table.insert(Backup.RewindFrames, root.CFrame)
			if #Backup.RewindFrames > 100 then table.remove(Backup.RewindFrames, 1) end
		end

		if Cfg.cframeSpeedOn and not Cfg.freecam and not Cfg.flyOn and hum.MoveDirection.Magnitude > 0 then
			root.CFrame = root.CFrame + hum.MoveDirection * (Cfg.cframeSpeedVal * dt)
		end

		if Cfg.slopeSurf and not Cfg.flyOn and hum.MoveDirection.Magnitude > 0 then
			local tv = hum.MoveDirection * math.max(Cfg.speedVal, 48)
			root.AssemblyLinearVelocity = Vector3.new(tv.X, root.AssemblyLinearVelocity.Y, tv.Z)
		end

		if hum.FloorMaterial ~= Enum.Material.Air then State.lastSafeCF = root.CFrame end
		if Cfg.antiVoid and root.Position.Y < (Workspace.FallenPartsDestroyHeight + 35) and State.lastSafeCF then
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = State.lastSafeCF + Vector3.new(0, 4, 0)
			sendToast("防虚空保护触发", "已将你拉回坠落前的安全地面", "🛡️", Color3.fromRGB(48, 209, 88))
		end

		if Cfg.airWalk then
			airWalkPad.CanCollide = true; airWalkPad.Transparency = 0.45; airWalkPad.Color = Cfg.accentColor
			airWalkPad.CFrame = CFrame.new(root.Position.X, Cfg.airWalkY, root.Position.Z)
		else
			airWalkPad.CanCollide = false; airWalkPad.Transparency = 1
		end

		if Cfg.spider and hum.MoveDirection.Magnitude > 0 then
			local rp = RaycastParams.new()
			rp.FilterDescendantsInstances = { char, airWalkPad }; rp.FilterType = Enum.RaycastFilterType.Exclude
			if Workspace:Raycast(root.Position, root.CFrame.LookVector * 3.2, rp) then
				root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 28, root.AssemblyLinearVelocity.Z)
			end
		end

		if Cfg.headlight then
			local l = root:FindFirstChild("IslandHeadlight")
			if not l then
				l = Instance.new("PointLight", root); l.Name = "IslandHeadlight"; l.Brightness = 3.5; l.Shadows = false
			end
			l.Range = Cfg.headlightRange; l.Color = Color3.fromRGB(255, 250, 240)
		end

		if Cfg.autoActivate then
			local tool = char:FindFirstChildOfClass("Tool")
			if tool then tool:Activate() end
		end

		if Cfg.carBoostOn and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
			local st = hum.SeatPart
			if st.Throttle == 1 then st.AssemblyLinearVelocity = st.CFrame.LookVector * Cfg.carBoostVal
			elseif st.Throttle == -1 then st.AssemblyLinearVelocity = -st.CFrame.LookVector * (Cfg.carBoostVal * 0.6) end
		end

		if Cfg.followTarget and Cfg.followTarget.Character then
			local tr = Cfg.followTarget.Character:FindFirstChild("HumanoidRootPart")
			if tr and (tr.Position - root.Position).Magnitude > 5 then hum:MoveTo(tr.Position) end
		elseif Cfg.orbitTarget and Cfg.orbitTarget.Character then
			local tr = Cfg.orbitTarget.Character:FindFirstChild("HumanoidRootPart")
			if tr then
				State.orbitAngle = (State.orbitAngle + 3.5 * dt) % (math.pi * 2)
				local off = Vector3.new(math.cos(State.orbitAngle) * 7, 0, math.sin(State.orbitAngle) * 7)
				root.CFrame = CFrame.new(tr.Position + off, tr.Position)
			end
		end

		-- ✈️ 3D 全向稳定飞行引擎 v2.0
		if Cfg.flyOn and not Cfg.freecam and cam then
			if not State.bvFly or State.bvFly.Parent ~= root then
				if State.bvFly then State.bvFly:Destroy() end
				local bv = Instance.new("BodyVelocity")
				bv.Name = "IslandFlyBV"; bv.MaxForce = Vector3.new(1e7, 1e7, 1e7); bv.P = 10000
				bv.Velocity = Vector3.zero; bv.Parent = root
				State.bvFly = bv
			end
			if not State.bgFly or State.bgFly.Parent ~= root then
				if State.bgFly then State.bgFly:Destroy() end
				local bg = Instance.new("BodyGyro")
				bg.Name = "IslandFlyBG"; bg.MaxTorque = Vector3.new(1e7, 1e7, 1e7); bg.P = 15000; bg.D = 500
				bg.CFrame = cam.CFrame; bg.Parent = root
				State.bgFly = bg
			end

			hum.PlatformStand = true
			State.bgFly.CFrame = cam.CFrame

			local camCF = cam.CFrame
			local fDir = Vector3.zero
			local typing = UserInputService:GetFocusedTextBox() ~= nil

			if not typing then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then fDir += camCF.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then fDir -= camCF.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then fDir += camCF.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then fDir -= camCF.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
					fDir += Vector3.new(0, 1, 0)
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
					fDir -= Vector3.new(0, 1, 0)
				end
			end

			-- 手机摇杆三维映射
			if fDir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
				local flatL = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
				local flatR = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
				if flatL.Magnitude > 0.01 and flatR.Magnitude > 0.01 then
					flatL = flatL.Unit; flatR = flatR.Unit
					local fwd = hum.MoveDirection:Dot(flatL)
					local rgt = hum.MoveDirection:Dot(flatR)
					fDir = (camCF.LookVector * fwd) + (camCF.RightVector * rgt)
				else
					fDir = hum.MoveDirection
				end
			end

			if Cfg.flyVertical ~= 0 then fDir += Vector3.new(0, Cfg.flyVertical, 0) end
			State.bvFly.Velocity = (fDir.Magnitude > 0.01) and (fDir.Unit * Cfg.flySpeed) or Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	-- 每 0.4 秒刷新遥测与 ESP
	if now - State.lastStatTime >= 0.4 then
		local fps = math.clamp(math.floor(State.frameCount / (now - State.lastStatTime)), 1, 999)
		State.frameCount = 0; State.lastStatTime = now

		local ping = 0
		pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		local mem = math.floor(Stats:GetTotalMemoryUsageMb())
		local pCnt = #Players:GetPlayers()
		local upSec = math.floor(now - State.startTime)
		local curSpd = root and math.floor(Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude) or 0

		UI.TopPill.Text = string.format("%d FPS | %d ms", fps, ping)
		UI.BentoFps.Text = fps .. " FPS"
		UI.BentoPing.Text = ping .. " ms"
		UI.BentoMem.Text = string.format("移速: %d Stud/s  |  在线: %d/%d", curSpd, pCnt, Players.MaxPlayers)

		if Cfg.showSpeedOnIsland then
			if State.isPlayingMusic and snd and snd.IsPlaying then
				UI.CompactText.Text = string.format("🎵 %d Stud/s • %s", curSpd, UI.MusicTitle.Text)
			else
				UI.CompactText.Text = string.format("iOS 18 • %d Stud/s", curSpd)
			end
		end

		UI.ServerDetailText.Text = string.format(
			"PlaceId: %d  |  在线人数: %d / %d  |  回溯缓存: %d 帧\n客户端内存: %d MB  |  运行时长: %02d分%02d秒",
			game.PlaceId, pCnt, Players.MaxPlayers, #Backup.RewindFrames, mem, math.floor(upSec / 60), upSec % 60
		)

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local hl = p.Character:FindFirstChild("IslandESP")
				local bg = p.Character:FindFirstChild("IslandTag")
				if Cfg.esp then
					if not hl then
						hl = Instance.new("Highlight", p.Character); hl.Name = "IslandESP"
						hl.FillColor = Cfg.accentColor; hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.FillTransparency = 0.5
					end
					local head = p.Character:FindFirstChild("Head")
					local thum = p.Character:FindFirstChildOfClass("Humanoid")
					if head and thum then
						if not bg then
							bg = Instance.new("BillboardGui", p.Character); bg.Name = "IslandTag"; bg.Adornee = head
							bg.Size = UDim2.new(0, 140, 0, 32); bg.StudsOffset = Vector3.new(0, 2.5, 0); bg.AlwaysOnTop = true
							local tl = Instance.new("TextLabel", bg); tl.Name = "Lbl"; tl.Size = UDim2.new(1, 0, 1, 0)
							tl.BackgroundTransparency = 1; tl.TextColor3 = Color3.fromRGB(255, 255, 255)
							tl.TextStrokeTransparency = 0.2; tl.Font = Enum.Font.GothamBold; tl.TextSize = 11
						end
						local dist = root and math.floor((head.Position - root.Position).Magnitude) or 0
						bg.Lbl.Text = string.format("%s [%d HP | %dm]", p.DisplayName, math.floor(thum.Health), dist)
					end
				else
					if hl then hl:Destroy() end
					if bg then bg:Destroy() end
				end
			end
		end
	end
end)

