				airPart.Size = Vector3.new(7, 0.5, 7); airPart.Anchored = true; airPart.Transparency = 0.6
				airPart.Material = Enum.Material.Neon; airPart.Color = COLOR_BLUE
			end
			airPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, -3.3, 0)
