local function sendNotify(title, msg, col)
	if isNotifying then return end
	if isExpanded then toggleIsland(false); task.wait(0.35) end
	isNotifying = true; compactFrame.Visible = false
	
	local box = Instance.new("Frame", island)
	box.Size = UDim2.new(1,0,1,0); box.BackgroundTransparency = 1
	createText(box, "🔔 " .. title, UDim2.new(1,-32,0,20), UDim2.new(0,18,0,14), Enum.Font.GothamBold, 13, col or C_GREEN)
	createText(box, msg, UDim2.new(1,-32,0,20), UDim2.new(0,18,0,36), Enum.Font.Gotham, 12, C_TEXT)
	
	TweenService:Create(island, TWEEN_EXPAND, {Size = SIZE_NOTIFY}):Play()
	TweenService:Create(mainCorner, TWEEN_EXPAND, {CornerRadius = UDim.new(0, 26)}):Play()
	task.wait(3)
	box:Destroy(); compactFrame.Visible = true
	TweenService:Create(island, TWEEN_SHRINK, {Size = SIZE_CLOSED}):Play()
	TweenService:Create(mainCorner, TWEEN_SHRINK, {CornerRadius = UDim.new(0, 18)}):Play()
	task.wait(0.3); isNotifying = false
end

