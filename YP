	local function updateX(px)
		local r = math.clamp((px - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		local v = math.floor(minV + (maxV - minV) * r + 0.5)
		fill.Size = UDim2.new(r, 0, 1, 0)
		sk.Position = UDim2.new(r, 0, 0.5, 0)
		badge.Text = tostring(v) .. " " .. unit
		onSlide(v)
	end
	hit.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			if parent:IsA("ScrollingFrame") then
				parent.ScrollingEnabled = false
				State.activeScroll = parent
			end
			State.activeDragFn = updateX
			updateX(inp.Position.X)
		end
	end)
end

