		center.BackgroundColor3 = tr.color; amb.BackgroundColor3 = tr.color
		snd:Stop(); snd.SoundId = tr.id; snd.PlaybackSpeed = State.soundPitch; snd:Play()
		State.isPlayingMusic = true
		playB.Text = "⏸"; UI.MpPlayBtn.Text = "⏸"
		TweenService:Create(arm, Anim.Fast, { Rotation = 8 }):Play()
		for i, b in ipairs(UI.TrackBtns) do
			b.BackgroundColor3 = (i == idx) and Cfg.accentColor or Color3.fromRGB(30, 30, 44)
		end
	end

