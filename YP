-- ================= 状态同步与通用控件工厂 =================
local toggleSync = {}
local function registerSync(key, fn)
	if not toggleSync[key] then toggleSync[key] = {} end
	table.insert(toggleSync[key], fn)
end
local function triggerSync(key, val)
	cfg[key] = val
	if toggleSync[key] then
		for _, fn in ipairs(toggleSync[key]) do fn(val) end
	end
end

