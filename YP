-- ================= 5. 全服通用底层物理与实战引擎 =================
local airPart = nil
local orbitAngle = 0

RunService.Stepped:Connect(function(_, dt)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and root and hum) then return end
	
	-- 1. 常规速度 & CFrame 强行位移加速 (无视服务器限速!)
	if cfg.speedOn then hum.WalkSpeed = cfg.speedVal end
	if cfg.cframeSpeedOn and hum.MoveDirection.Magnitude > 0 then
		root.CFrame = root.CFrame + hum.MoveDirection * (cfg.cframeSpeedVal * dt)
	end
	if cfg.jumpOn then hum.UseJumpPower = true; hum.JumpPower = cfg.jumpVal end
	if cfg.fovOn then camera.FieldOfView = cfg.fovVal end
	
	-- 2. 跑酷免疫岩浆/激光秒杀 (关闭角色 CanTouch 触碰伤害)
	if cfg.antiKillBrick then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.CanTouch then p.CanTouch = false end
		end
	end
	
	-- 3. 手持武器/工具自动高频挥砍 (连点器)
	if cfg.autoActivate then
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then tool:Activate() end
	end
	
	-- 4. 随身强光探照灯 (无视恐怖服黑夜锁)
	if cfg.headlight then
		local light = root:FindFirstChild("IslandHeadlight") or Instance.new("PointLight", root)
		light.Name = "IslandHeadlight"; light.Brightness = 3.5; light.Range = cfg.lightRange; light.Shadows = false
	end
	
	-- 5. 放大其他玩家碰撞箱 (Hitbox Expander)
	if cfg.hitboxExpand then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = p.Character.HumanoidRootPart
				hrp.Size = Vector3.new(cfg.hitboxSize, cfg.hitboxSize, cfg.hitboxSize)
				hrp.Transparency = 0.7; hrp.Color = ACCENT; hrp.CanCollide = false
			end
		end
	end
	
	-- 6. 视角智能索敌锁定
	if cfg.camLock then
		local nearest, minDist = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local humP = p.Character:FindFirstChildOfClass("Humanoid")
				if humP and humP.Health > 0 then
					local d = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
					if d < minDist then minDist = d; nearest = p.Character.HumanoidRootPart end
				end
			end
		end
		if nearest then camera.CFrame = CFrame.new(camera.CFrame.Position, nearest.Position) end
	end
	
	-- 防掉虚空保护
	if hum.FloorMaterial ~= Enum.Material.Air then cfg.lastSafeCF = root.CFrame end
	if cfg.antiVoid and root.Position.Y < (workspace.FallenPartsDestroyHeight + 35) and cfg.lastSafeCF then
		root.Velocity = Vector3.zero; root.CFrame = cfg.lastSafeCF + Vector3.new(0, 4, 0)
	end
	
	-- 穿墙与踏空行走
	if cfg.noclip then
		for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end end
	end
	if cfg.airWalk then
		if not airPart then
			airPart = Instance.new("Part", workspace); airPart.Size = Vector3.new(8, 0.4, 8); airPart.Anchored = true
			airPart.Transparency = 0.45; airPart.Material = Enum.Material.Neon; airPart.Color = ACCENT
		end
		airPart.CFrame = CFrame.new(root.Position.X, cfg.airY, root.Position.Z)
	elseif airPart then airPart:Destroy(); airPart = nil end
	
	-- 空中游泳 & 3D飞行 & 灵魂出窍
	if cfg.airSwim then
		hum:ChangeState(Enum.HumanoidStateType.Swimming)
		if hum.MoveDirection.Magnitude > 0 then
			local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
			local vert = camera.CFrame.LookVector.Y * hum.MoveDirection:Dot(flatLook)
			root.Velocity = (hum.MoveDirection + Vector3.new(0, vert, 0)).Unit * (cfg.speedOn and cfg.speedVal or 38)
		else root.Velocity = Vector3.zero end
	end
	if cfg.flyOn and not cfg.freecam then
		local bv = root:FindFirstChild("IslandFlyBV") or Instance.new("BodyVelocity", root)
		bv.Name = "IslandFlyBV"; bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		local bg = root:FindFirstChild("IslandFlyBG") or Instance.new("BodyGyro", root)
		bg.Name = "IslandFlyBG"; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9); bg.P = 9e4
		hum.PlatformStand = true; bg.CFrame = camera.CFrame
		if hum.MoveDirection.Magnitude > 0 then
			local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
			local vert = camera.CFrame.LookVector.Y * hum.MoveDirection:Dot(flatLook)
			bv.Velocity = (hum.MoveDirection + Vector3.new(0, vert, 0)).Unit * cfg.flyVal
		else bv.Velocity = Vector3.zero end
	end
	if cfg.freecam then
		camera.CameraType = Enum.CameraType.Scriptable
		local move = hum.MoveDirection
		if move.Magnitude > 0 then
			local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
			local vert = camera.CFrame.LookVector.Y * move:Dot(flatLook)
			cfg.freecamCF = cfg.freecamCF + (move + Vector3.new(0, vert, 0)).Unit * (cfg.flyVal * dt * 1.5)
		end
		camera.CFrame = CFrame.new(cfg.freecamCF.Position) * camera.CFrame.Rotation
	end
	
	if cfg.carBoostOn and hum.SeatPart and hum.MoveDirection.Magnitude > 0 then
		hum.SeatPart.Velocity = hum.SeatPart.CFrame.LookVector * cfg.carBoostVal + Vector3.new(0, hum.SeatPart.Velocity.Y, 0)
	end
	if cfg.spider then
		local ray = workspace:Raycast(root.Position, root.CFrame.LookVector * 2.6)
		if ray then root.Velocity = Vector3.new(root.Velocity.X, 32, root.Velocity.Z) end
	end
	if cfg.autoJump and hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	if cfg.spin then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(cfg.spinVal), 0) end
	if cfg.followTarget and cfg.followTarget.Character and cfg.followTarget.Character:FindFirstChild("HumanoidRootPart") then
		hum:MoveTo(cfg.followTarget.Character.HumanoidRootPart.Position)
	end
	if cfg.orbitTarget and cfg.orbitTarget.Character and cfg.orbitTarget.Character:FindFirstChild("HumanoidRootPart") then
		orbitAngle = orbitAngle + dt * 4.5
		local tPos = cfg.orbitTarget.Character.HumanoidRootPart.Position
		root.CFrame = CFrame.new(tPos + Vector3.new(math.cos(orbitAngle)*6, 1, math.sin(orbitAngle)*6), tPos)
	end
end)

-- ================= 6. 流光边框、音乐频谱与监控实时渲染 =================
local lastClock = os.clock()
local frameCnt = 0

RunService.RenderStepped:Connect(function(dt)
	frameCnt += 1
	if cfg.rainbowBorder then strokeGrad.Rotation = (strokeGrad.Rotation + dt * 65) % 360 end
	
	if isPlaying and musicSound.IsPlaying then
		vinylDisc.Rotation = (vinylDisc.Rotation + dt * 100 * curPitch) % 360
		local loud = math.clamp(musicSound.PlaybackLoudness / 200, 0.12, 1)
		local glowSz = 92 + loud * 22
		vinylGlow.Size = vinylGlow.Size:Lerp(UDim2.new(0, glowSz, 0, glowSz), 0.3)
		for i, b in ipairs(miniWaves) do
			local h = math.clamp(loud * 16 * math.abs(math.sin(os.clock()*11 + i*1.2)), 4, 16)
			b.Size = b.Size:Lerp(UDim2.new(0, 3, 0, h), 0.35)
		end
		for i, b in ipairs(eqBars) do
			local h = math.clamp(loud * 28 * math.abs(math.cos(os.clock()*15 + i*0.7)), 3, 28)
			b.Size = b.Size:Lerp(UDim2.new(0, 4, 0, h), 0.4)
		end
		if musicSound.TimeLength > 0 then
			local r = musicSound.TimePosition / musicSound.TimeLength
			seekFill.Size = UDim2.new(r, 0, 1, 0); seekKnob.Position = UDim2.new(r, -5.5, 0.5, -5.5)
			timeText.Text = string.format("%02d:%02d / %02d:%02d", math.floor(musicSound.TimePosition/60), math.floor(musicSound.TimePosition%60), math.floor(musicSound.TimeLength/60), math.floor(musicSound.TimeLength%60))
		end
	else
		vinylGlow.Size = vinylGlow.Size:Lerp(UDim2.new(0, 92, 0, 92), 0.2)
		for _, b in ipairs(miniWaves) do b.Size = b.Size:Lerp(UDim2.new(0, 3, 0, 4), 0.2) end
		for _, b in ipairs(eqBars) do b.Size = b.Size:Lerp(UDim2.new(0, 4, 0, 3), 0.2) end
	end
	
	local now = os.clock()
	if now - lastClock >= 1 then
		local fps = frameCnt; frameCnt = 0; lastClock = now
		local ping = math.round(player:GetNetworkPing() * 1000)
		local mem = math.round(Stats:GetTotalMemoryUsageMb())
		
		compactText.Text = isPlaying and ("🎵 " .. string.sub(songTitle.Text, 1, 14) .. "..") or (fps .. " FPS • " .. ping .. "ms")
		fpsPill.Text = fps .. " FPS | " .. ping .. "ms"
		dashFps.Text = fps .. " FPS"; dashPing.Text = "📶 延迟: " .. ping .. " ms"
		dashMem.Text = "💾 内存: " .. mem .. " MB"; dashPlr.Text = string.format("👥 在线: %d / %d 人", #Players:GetPlayers(), Players.MaxPlayers)
		
		if cfg.esp then refreshESP() end
		if isExpanded and pageSettings.Visible then
			local up = math.floor(workspace.DistributedGameTime)
			sLine1.Text = string.format("🟢 实时画面帧率: <font color='#30D158'><b>%d FPS</b></font>   |   📶 网络延迟: <font color='#0A84FF'><b>%d ms</b></font>", fps, ping)
			sLine2.Text = string.format("💾 客户端内存占用: <b>%d MB</b>   |   👥 房间人数: <b>%d / %d 人</b>", mem, #Players:GetPlayers(), Players.MaxPlayers)
			sLine3.Text = string.format("⏱️ 服务器已运行: <b>%02d时 %02d分 %02d秒</b>   |   🌐 ID: <b>%d</b>", math.floor(up/3600), math.floor((up%3600)/60), up%60, game.PlaceId)
		end
	end
end)

