barFill.Parent = barBg
Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

-- 5. 创建触发按钮 (兼容 PC 点击 和 手机触摸)
local triggerBtn = Instance.new("TextButton")
triggerBtn.Size = UDim2.new(1, 0, 1, 0)
triggerBtn.BackgroundTransparency = 1
triggerBtn.Text = ""
triggerBtn.Parent = island

-- 动画控制函数
local function toggleIsland(expand)
	if isNotifying then return end -- 如果正在通知，禁止手动切换
	isExpanded = expand
	
	if isExpanded then
		compactFrame.Visible = false
		expandedFrame.Visible = true
		
		TweenService:Create(island, expandTweenInfo, {Size = SIZE_EXPANDED}):Play()
		TweenService:Create(uiCorner, expandTweenInfo, {CornerRadius = CORNER_EXPANDED}):Play()
	else
		expandedFrame.Visible = false
		compactFrame.Visible = true
		
		local targetSize = isHovering and SIZE_HOVER or SIZE_CLOSED
		TweenService:Create(island, shrinkTweenInfo, {Size = targetSize}):Play()
		TweenService:Create(uiCorner, shrinkTweenInfo, {CornerRadius = CORNER_CLOSED}):Play()
	end
end

-- 交互事件绑定 (PC + 移动端通用)
triggerBtn.Activated:Connect(function()
	toggleIsland(not isExpanded)
end)

-- PC端特有的鼠标悬停效果
triggerBtn.MouseEnter:Connect(function()
	isHovering = true
	if not isExpanded and not isNotifying then
		TweenService:Create(island, fadeTweenInfo, {Size = SIZE_HOVER}):Play()
	end
end)

triggerBtn.MouseLeave:Connect(function()
	isHovering = false
	if not isExpanded and not isNotifying then
		TweenService:Create(island, fadeTweenInfo, {Size = SIZE_CLOSED}):Play()
	end
end)

-- 点击灵动岛外部自动收起 (提升移动端和PC体验)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isExpanded and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		local pos = input.Position
		local islandPos = island.AbsolutePosition
		local islandSize = island.AbsoluteSize
		
		-- 检查点击位置是否在灵动岛外部
		if pos.X < islandPos.X or pos.X > islandPos.X + islandSize.X or
		   pos.Y < islandPos.Y or pos.Y > islandPos.Y + islandSize.Y then
			toggleIsland(false)
		end
	end
end)

-- 实时更新时间和 FPS
local lastUpdate = os.clock()
local frames = 0

RunService.RenderStepped:Connect(function()
	frames += 1
	local now = os.clock()
	if now - lastUpdate >= 1 then
		fpsLabel.Text = "正在运行 - FPS: " .. tostring(frames)
		frames = 0
		lastUpdate = now
		
		-- 更新时间
		timeLabel.Text = os.date("%H:%M")
	end
end)

-- ==========================================
-- 附加功能：发送灵动岛通知 (你可以在其他地方调用)
-- ==========================================
local function sendNotification(title, text, duration)
	if isExpanded then toggleIsland(false) task.wait(0.3) end
	isNotifying = true
	compactFrame.Visible = false
	
	-- 创建临时通知UI
	local notifyFrame = Instance.new("Frame")
	notifyFrame.Size = UDim2.new(1, 0, 1, 0)
	notifyFrame.BackgroundTransparency = 1
	notifyFrame.Parent = island
	
	local nTitle = Instance.new("TextLabel")
	nTitle.Size = UDim2.new(1, -40, 0, 20)
	nTitle.Position = UDim2.new(0, 20, 0, 12)
	nTitle.BackgroundTransparency = 1
	nTitle.Text = title
	nTitle.Font = Enum.Font.GothamBold
	nTitle.TextColor3 = Color3.fromRGB(48, 209, 88)
	nTitle.TextSize = 14
	nTitle.TextXAlignment = Enum.TextXAlignment.Left
	nTitle.Parent = notifyFrame
	
	local nText = Instance.new("TextLabel")
	nText.Size = UDim2.new(1, -40, 0, 20)
	nText.Position = UDim2.new(0, 20, 0, 32)
	nText.BackgroundTransparency = 1
	nText.Text = text
	nText.Font = Enum.Font.Gotham
	nText.TextColor3 = Color3.fromRGB(255, 255, 255)
	nText.TextSize = 13
	nText.TextXAlignment = Enum.TextXAlignment.Left
	nText.Parent = notifyFrame
	
	-- 展开到通知大小
	TweenService:Create(island, expandTweenInfo, {Size = UDim2.new(0, 280, 0, 65)}):Play()
	TweenService:Create(uiCorner, expandTweenInfo, {CornerRadius = UDim.new(0, 25)}):Play()
	
	task.wait(duration or 3)
	
	-- 恢复原状
	notifyFrame:Destroy()
	compactFrame.Visible = true
	TweenService:Create(island, shrinkTweenInfo, {Size = SIZE_CLOSED}):Play()
	TweenService:Create(uiCorner, shrinkTweenInfo, {CornerRadius = CORNER_CLOSED}):Play()
	
	task.wait(0.3)
	isNotifying = false
end

-- 游戏启动3秒后测试一次弹窗通知
task.delay(3, function()
	sendNotification("灵动岛已激活", "欢迎来到游戏，" .. player.DisplayName .. "！", 4)
end)
