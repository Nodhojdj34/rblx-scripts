-- 通用按钮构造函数 (isAction=true 代表点击触发一次，false 代表开关切换)
local function addGridBtn(parentScroll, title, sub, icon, isAction, callback)
	local btn = Instance.new("TextButton")
	btn.BackgroundColor3 = C_CARD
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = parentScroll
	addCorner(btn, 10)
	
	createText(btn, icon, UDim2.new(0, 26, 1, 0), UDim2.new(0, 6, 0, 0), Enum.Font.GothamBold, 16, C_TEXT, Enum.TextXAlignment.Center)
	local t1 = createText(btn, title, UDim2.new(1, -36, 0, 16), UDim2.new(0, 34, 0, 8), Enum.Font.GothamBold, 11, C_TEXT)
	local t2 = createText(btn, sub, UDim2.new(1, -36, 0, 14), UDim2.new(0, 34, 0, 24), Enum.Font.Gotham, 9, C_SUB)
	
	local active = false
	btn.Activated:Connect(function()
		if isAction then
			TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = C_ORANGE}):Play()
			callback(true)
			task.delay(0.25, function()
				TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = C_CARD}):Play()
			end)
		else
			active = not active
			TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = active and C_BLUE or C_CARD}):Play()
			t2.Text = active and "● 已开启" or sub
			t2.TextColor3 = active and C_TEXT or C_SUB
