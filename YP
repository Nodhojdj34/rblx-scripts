local xrayPartsCache = {}
local function applyXray(on, alpha)
	if on then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj:IsDescendantOf(player.Character or Instance.new("Folder")) then
				local model = obj:FindFirstAncestorOfClass("Model")
				local isPlr = model and Players:GetPlayerFromCharacter(model)
				if not isPlr and obj.Transparency < 0.8 then
					xrayPartsCache[obj] = true
					obj.LocalTransparencyModifier = alpha
				end
			end
		end
	else
		for obj, _ in pairs(xrayPartsCache) do
			if obj and obj.Parent then obj.LocalTransparencyModifier = 0 end
		end
		table.clear(xrayPartsCache)
	end
end

