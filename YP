			playB.Text = "▶"; UI.MpPlayBtn.Text = "▶"
			TweenService:Create(arm, Anim.Fast, { Rotation = -25 }):Play()
		else
			if snd.SoundId == "" then playTrack(State.curTrackIdx)
			else
				snd:Resume(); State.isPlayingMusic = true
				playB.Text = "⏸"; UI.MpPlayBtn.Text = "⏸"
				TweenService:Create(arm, Anim.Fast, { Rotation = 8 }):Play()
			end
		end
	end
	local function prevTrack()
		local n = State.curTrackIdx - 1; if n < 1 then n = #Playlist end; playTrack(n)
	end
	local function nextTrack()
		local n = State.curTrackIdx + 1; if n > #Playlist then n = 1 end; playTrack(n)
	end

	playB.MouseButton1Click:Connect(togglePlay); UI.MpPlayBtn.MouseButton1Click:Connect(togglePlay)
	prevB.MouseButton1Click:Connect(prevTrack);  UI.MpPrevBtn.MouseButton1Click:Connect(prevTrack)
	nextB.MouseButton1Click:Connect(nextTrack);  UI.MpNextBtn.MouseButton1Click:Connect(nextTrack)

