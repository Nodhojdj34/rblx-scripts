local function applyShader(mode)
	cfg.activeShader = mode
	local cc = Lighting:FindFirstChild("IslandCC") or Instance.new("ColorCorrectionEffect", Lighting)
	cc.Name = "IslandCC"
	local bl = Lighting:FindFirstChild("IslandBloom") or Instance.new("BloomEffect", Lighting)
	bl.Name = "IslandBloom"

	if mode == "None" then
		cc.Enabled = false; bl.Enabled = false
	elseif mode == "Cyber" then
		cc.Enabled = true; cc.Contrast = 0.25; cc.Saturation = 0.45; cc.TintColor = Color3.fromRGB(215, 235, 255)
		bl.Enabled = true; bl.Intensity = 1.2; bl.Size = 24; bl.Threshold = 0.85
	elseif mode == "Sunset" then
		cc.Enabled = true; cc.Contrast = 0.15; cc.Saturation = 0.3; cc.TintColor = Color3.fromRGB(255, 215, 185)
		bl.Enabled = true; bl.Intensity = 0.9; bl.Size = 28; bl.Threshold = 0.9
	elseif mode == "Dream" then
		cc.Enabled = true; cc.Contrast = 0.08; cc.Saturation = 0.2; cc.TintColor = Color3.fromRGB(245, 225, 255)
		bl.Enabled = true; bl.Intensity = 1.5; bl.Size = 36; bl.Threshold = 0.8
	elseif mode == "Retro" then
		cc.Enabled = true; cc.Contrast = 0.3; cc.Saturation = -0.65; cc.TintColor = Color3.fromRGB(240, 230, 205)
		bl.Enabled = false
	end

	for id, b in pairs(shaderBtns) do
		b.BackgroundColor3 = (id == mode) and cfg.accentColor or Color3.fromRGB(34, 34, 48)
	end
end

