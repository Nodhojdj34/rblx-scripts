		local r = math.clamp((x - sBg.AbsolutePosition.X) / sBg.AbsoluteSize.X, 0, 1)
		local v = math.round(minV + r * (maxV - minV))
		sFill.Size = UDim2.new(r, 0, 1, 0); thumb.Position = UDim2.new(r, -6.5, 0.5, -6.5)
		valLbl.Text = tostring(v) .. " " .. unit
		onSlide(v)
	end
	sHit.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			activeSlider = sHit; updateVal(inp.Position.X)
			inp.Changed:Connect(function() if inp.UserInputState == Enum.UserInputState.End and activeSlider == sHit then activeSlider = nil end end)
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if activeSlider == sHit and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateVal(inp.Position.X)
		end
	end)
end

