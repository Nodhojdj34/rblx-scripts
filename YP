		isPlaying = false
		playBtn.Text = "▶ 播放"
		playBtn.BackgroundColor3 = C_CARD_HOVER
	else
		if musicSound.SoundId == "" then playTrack(1) else musicSound:Resume(); isPlaying = true; playBtn.Text = "⏸ 暂停"; playBtn.BackgroundColor3 = C_PINK end
	end
end)
