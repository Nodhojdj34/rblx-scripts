-- ================= 4. 展开与收起动画控制 =================
local function toggleIsland(expand)
	if isNotifying then return end
	isExpanded = expand
	if isExpanded then
		compactFrame.Visible = false; expandedFrame.Visible = true
		TweenService:Create(island, TWEEN_EXPAND, {Size = SIZE_EXPANDED}):Play()
		TweenService:Create(shadow, TWEEN_EXPAND, {Size = SIZE_EXPANDED + UDim2.new(0, 14, 0, 14)}):Play()
		TweenService:Create(mainCorner, TWEEN_EXPAND, {CornerRadius = UDim.new(0, 32)}):Play()
	else
		expandedFrame.Visible = false; compactFrame.Visible = true
		local tSize = isHovering and SIZE_HOVER or SIZE_CLOSED
		TweenService:Create(island, TWEEN_SHRINK, {Size = tSize}):Play()
		TweenService:Create(shadow, TWEEN_SHRINK, {Size = tSize + UDim2.new(0, 10, 0, 10)}):Play()
		TweenService:Create(mainCorner, TWEEN_SHRINK, {CornerRadius = UDim.new(0, 18)}):Play()
	end
end

openBtn.Activated:Connect(function() toggleIsland(true) end)
closeBtn.Activated:Connect(function() toggleIsland(false) end)

openBtn.MouseEnter:Connect(function()
	isHovering = true
	if not isExpanded and not isNotifying then TweenService:Create(island, TWEEN_FAST, {Size = SIZE_HOVER}):Play() end
end)
openBtn.MouseLeave:Connect(function()
	isHovering = false
	if not isExpanded and not isNotifying then TweenService:Create(island, TWEEN_FAST, {Size = SIZE_CLOSED}):Play() end
end)

UserInputService.InputBegan:Connect(function(input)
	if isExpanded and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		local pos = input.Position; local iPos = island.AbsolutePosition; local iSize = island.AbsoluteSize
		if pos.X < iPos.X or pos.X > iPos.X + iSize.X or pos.Y < iPos.Y or pos.Y > iPos.Y + iSize.Y then
			toggleIsland(false)
		end
	end
end)

