local function setNoclip(on)
	Cfg.noclip = on
	local char = player.Character
	if not char then return end
	if on then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				if Backup.OrigCollide[p] == nil then Backup.OrigCollide[p] = p.CanCollide end
				p.CanCollide = false
			end
		end
	else
		for p, canCol in pairs(Backup.OrigCollide) do
			if p and p.Parent then p.CanCollide = canCol end
		end
		table.clear(Backup.OrigCollide)
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then root.CanCollide = true end
	end
end

local function setAntiKillBrick(on)
	Cfg.antiKillBrick = on
	local char = player.Character
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CanTouch = not on end
	end
end

local function stopFlightCleanly()
	Cfg.flyVertical = 0
	if State.bvFly then State.bvFly:Destroy(); State.bvFly = nil end
	if State.bgFly then State.bgFly:Destroy(); State.bgFly = nil end
	local char = player.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local function setAirSwim(on)
	Cfg.airSwim = on
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if on then
		if hum then
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			hum:ChangeState(Enum.HumanoidStateType.Swimming)
		end
		if root and not State.airFloat then
			State.airFloat = Instance.new("BodyVelocity")
			State.airFloat.MaxForce = Vector3.new(0, 40000, 0)
			State.airFloat.Velocity = Vector3.zero
			State.airFloat.Parent = root
		end
	else
		if State.airFloat then State.airFloat:Destroy(); State.airFloat = nil end
		if hum then
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local function updateForceFieldBody(on)
	Cfg.forceFieldBody = on
	local char = player.Character
	if not char then return end
	if on then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				Backup.OrigMaterial[p] = p.Material
				p.Material = Enum.Material.ForceField
			end
		end
	else
		for p, mat in pairs(Backup.OrigMaterial) do
			if p and p.Parent then p.Material = mat end
		end
		table.clear(Backup.OrigMaterial)
	end
end

local function updateNeonTrail(on)
	Cfg.neonTrail = on
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local old = root:FindFirstChild("IslandTrail")
	if on and not old then
		local a0 = root:FindFirstChild("TrailA0") or Instance.new("Attachment", root)
		a0.Name = "TrailA0"; a0.Position = Vector3.new(0, 1.4, 0)
		local a1 = root:FindFirstChild("TrailA1") or Instance.new("Attachment", root)
		a1.Name = "TrailA1"; a1.Position = Vector3.new(0, -1.4, 0)
		local tr = Instance.new("Trail", root)
		tr.Name = "IslandTrail"
		tr.Attachment0 = a0; tr.Attachment1 = a1
		tr.Lifetime = 0.65
		tr.Color = UI.StrokeGrad.Color
		tr.Transparency = NumberSequence.new(0.15, 1)
	elseif not on and old then
		old:Destroy()
	end
end

local function performFlashDash()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local cam = getCam()
	if not root or not cam then return end
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = (flat.Magnitude > 0.01) and flat.Unit or root.CFrame.LookVector
	root.CFrame = root.CFrame + flat * 28
	sendToast("闪现冲刺", "已向准星方向瞬移 28 Studs", "⚡", Color3.fromRGB(255, 159, 10))
end

local function performTimeRewind()
	if State.isRewinding then return end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or #Backup.RewindFrames < 5 then
		sendToast("时光倒流未就绪", "历史轨迹不足，请移动几秒后再试", "⏪", Color3.fromRGB(255, 69, 58))
		return
	end
	State.isRewinding = true
	sendToast("时光倒流启动", "正在回溯至 3 秒前的位置...", "⏪", Color3.fromRGB(175, 82, 222))
	task.spawn(function()
		for i = #Backup.RewindFrames, 1, -2 do
			if not root or not root.Parent then break end
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = Backup.RewindFrames[i]
			RunService.RenderStepped:Wait()
		end
		table.clear(Backup.RewindFrames)
		State.isRewinding = false
	end)
end

local function refreshCharacterInPlace()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local savedCF = root.CFrame
	sendToast("原地刷新中", "正在重置角色并保留当前坐标...", "🔄", Cfg.accentColor)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then hum.Health = 0 else char:BreakJoints() end
	task.spawn(function()
		local newChar = player.CharacterAdded:Wait()
		local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.15)
		if newRoot then
			newRoot.CFrame = savedCF
			sendToast("刷新完成", "已精准回到原坐标", "✅", Color3.fromRGB(48, 209, 88))
		end
	end)
end

