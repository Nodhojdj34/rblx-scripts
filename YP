-- 底部装饰条 (模拟音乐进度条或系统状态)
local barBg = Instance.new("Frame")
barBg.Size = UDim2.new(1, -40, 0, 6)
barBg.Position = UDim2.new(0, 20, 1, -20)
barBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
