	local function updateFromX(posX)
		local rel = math.clamp((posX - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		local v = math.floor(minVal + (maxVal - minVal) * rel + 0.5)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		sKnob.Position = UDim2.new(rel, 0, 0.5, 0)
		valBadge.Text = tostring(v) .. " " .. unit
		onSlide(v)
	end

	sliderHit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if parentScroll:IsA("ScrollingFrame") then
				parentScroll.ScrollingEnabled = false
				activeScrollFrame = parentScroll
			end
			activeDragUpdate = updateFromX
			updateFromX(input.Position.X)
		end
	end)
end

