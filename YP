-- Stepped 物理帧：处理穿墙、防甩飞护盾、锁速覆盖
RunService.Stepped:Connect(function()
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")

		-- 穿墙开启时持续保持穿透
		if cfg.noclip then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					if origCollideCache[part] == nil then
						origCollideCache[part] = true
					end
					part.CanCollide = false
				end
			end
		end

		-- 防甩飞护盾：本地禁用其他玩家角色的物理碰撞体积与旋转冲击
		if cfg.antiFling then
			for _, otherPlr in ipairs(Players:GetPlayers()) do
				if otherPlr ~= player and otherPlr.Character then
					for _, p in ipairs(otherPlr.Character:GetDescendants()) do
						if p:IsA("BasePart") then
							p.CanCollide = false
							p.AssemblyLinearVelocity = Vector3.zero
							p.AssemblyAngularVelocity = Vector3.zero
						end
					end
				end
			end
		end

		if hum then
			if cfg.speedOn then hum.WalkSpeed = cfg.speedVal end
			if cfg.jumpOn then
				hum.UseJumpPower = true
				hum.JumpPower = cfg.jumpVal
			end
			if cfg.autoJump and hum.FloorMaterial ~= Enum.Material.Air then
				hum.Jump = true
			end
		end

		-- 磁吸拾取周围掉落的 Tool
		if cfg.magnetLoot and root then
			for _, item in ipairs(Workspace:GetChildren()) do
				if item:IsA("Tool") and item:FindFirstChild("Handle") then
					local handle = item.Handle
					if (handle.Position - root.Position).Magnitude <= 35 then
						handle.CFrame = root.CFrame
					end
				end
			end
		end
	end
end)

-- RenderStepped 渲染帧：处理 UI 动画、3D 飞行、无人机视角、音乐频谱
RunService.RenderStepped:Connect(function(dt)
	frameCount += 1
	local now = os.clock()

	-- Siri 边框旋转
	if cfg.rainbowBorder then
		strokeGrad.Rotation = (strokeGrad.Rotation + 95 * dt) % 360
	end

	-- 音乐黑胶旋转与频谱律动
	if isPlayingMusic and soundObj.IsPlaying then
		vinylDisc.Rotation = (vinylDisc.Rotation + 75 * dt * soundPitch) % 360
		local loud = math.clamp(soundObj.PlaybackLoudness / 420, 0.06, 1)
		vinylGlow.Size = UDim2.new(0, 78 + loud * 18, 0, 78 + loud * 18)
		vinylGlow.Position = UDim2.new(0, 56 - (78 + loud * 18) / 2, 0, 56 - (78 + loud * 18) / 2)

		for i, bar in ipairs(eqBars) do
			local wave = math.abs(math.sin(now * 10 + i * 0.6))
			local h = math.clamp(4 + (loud * 28 * wave), 4, 32)
			bar.Size = UDim2.new(0, 5, 0, h)
		end
		for i, mbar in ipairs(miniBars) do
			local h = math.clamp(4 + loud * 11 * math.abs(math.cos(now * 12 + i)), 4, 14)
			mbar.Size = UDim2.new(0, 3, 0, h)
		end

		if soundObj.TimeLength > 0 then
			local pct = math.clamp(soundObj.TimePosition / soundObj.TimeLength, 0, 1)
			seekFill.Size = UDim2.new(pct, 0, 1, 0)
			local cM = math.floor(soundObj.TimePosition / 60)
			local cS = math.floor(soundObj.TimePosition % 60)
			local tM = math.floor(soundObj.TimeLength / 60)
			local tS = math.floor(soundObj.TimeLength % 60)
			timeCur.Text = string.format("%02d:%02d", cM, cS)
			timeTot.Text = string.format("%02d:%02d", tM, tS)
		end
	else
		for i, mbar in ipairs(miniBars) do
			local h = 4 + math.sin(now * 4 + i) * 2.5
			mbar.Size = UDim2.new(0, 3, 0, h)
		end
	end

	-- 视觉覆盖：广角视野、夜视与时间锁定
	if cfg.fovOn then camera.FieldOfView = cfg.fovVal end
	if cfg.timeLockOn then Lighting.ClockTime = cfg.timeLockVal end
	if cfg.fullbright then
		Lighting.Brightness = 2.5
		if not cfg.timeLockOn then Lighting.ClockTime = 14 end
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
	end

	-- 无人机自由视角 (支持 PC 键盘 + 手机摇杆，角色本体自动锁定不乱跑)
	if cfg.freecam then
		camera.CameraType = Enum.CameraType.Scriptable
		local moveVec = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec += camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec -= camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec -= camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec += camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVec += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVec -= Vector3.new(0, 1, 0) end
		if moveVec.Magnitude > 0 then
			freecamCF = freecamCF + moveVec.Unit * (cfg.flySpeed * dt)
		end
		camera.CFrame = CFrame.new(freecamCF.Position) * camera.CFrame.Rotation
	end

	-- 角色物理与实用功能循环
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if root and hum then
		-- CFrame 强力微瞬移加速 (仅在未开启自由视角时生效)
		if cfg.cframeSpeedOn and not cfg.freecam and hum.MoveDirection.Magnitude > 0 then
			root.CFrame = root.CFrame + hum.MoveDirection * (cfg.cframeSpeedVal * dt)
		end

		-- 防虚空保护
		if hum.FloorMaterial ~= Enum.Material.Air then
			lastSafeCF = root.CFrame
		end
		if cfg.antiVoid and root.Position.Y < (Workspace.FallenPartsDestroyHeight + 35) and lastSafeCF then
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = lastSafeCF + Vector3.new(0, 4, 0)
			sendToast("防虚空保护触发", "已将你拉回坠落前的安全地面", "🛡️", Color3.fromRGB(48, 209, 88))
		end

		-- 踏空行走平台
		if cfg.airWalk then
			airWalkPart.CanCollide = true
			airWalkPart.Transparency = 0.45
			airWalkPart.Color = cfg.accentColor
			airWalkPart.CFrame = CFrame.new(root.Position.X, cfg.airWalkY, root.Position.Z)
		else
			airWalkPart.CanCollide = false
			airWalkPart.Transparency = 1
		end

		-- 蜘蛛爬墙检测
		if cfg.spider and hum.MoveDirection.Magnitude > 0 then
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = { char, airWalkPart }
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			local hit = Workspace:Raycast(root.Position, root.CFrame.LookVector * 3.2, rayParams)
			if hit then
				root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 28, root.AssemblyLinearVelocity.Z)
			end
		end

		-- 随身强光探照灯
		if cfg.headlight then
			local light = root:FindFirstChild("IslandHeadlight")
			if not light then
				light = Instance.new("PointLight")
				light.Name = "IslandHeadlight"
				light.Brightness = 3.5
				light.Shadows = false
				light.Parent = root
			end
			light.Range = cfg.headlightRange
			light.Color = Color3.fromRGB(255, 250, 240)
		end

		-- 手持工具自动连点
		if cfg.autoActivate then
			local tool = char:FindFirstChildOfClass("Tool")
			if tool then tool:Activate() end
		end

		-- 载具推进器
		if cfg.carBoostOn and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
			local seat = hum.SeatPart
			if seat.Throttle == 1 then
				seat.AssemblyLinearVelocity = seat.CFrame.LookVector * cfg.carBoostVal
			elseif seat.Throttle == -1 then
				seat.AssemblyLinearVelocity = -seat.CFrame.LookVector * (cfg.carBoostVal * 0.6)
			end
		end

		-- 自动跟随与环绕目标
		if cfg.followTarget and cfg.followTarget.Character then
			local tRoot = cfg.followTarget.Character:FindFirstChild("HumanoidRootPart")
			if tRoot and (tRoot.Position - root.Position).Magnitude > 5 then
				hum:MoveTo(tRoot.Position)
			end
		elseif cfg.orbitTarget and cfg.orbitTarget.Character then
			local tRoot = cfg.orbitTarget.Character:FindFirstChild("HumanoidRootPart")
			if tRoot then
				orbitAngle = (orbitAngle + 3.5 * dt) % (math.pi * 2)
				local offset = Vector3.new(math.cos(orbitAngle) * 7, 0, math.sin(orbitAngle) * 7)
				root.CFrame = CFrame.new(tRoot.Position + offset, tRoot.Position)
			end
		end

		-- 3D 镜头飞行 (完美支持手机摇杆 MoveDirection + PC 键盘)
		if cfg.flyOn and not cfg.freecam then
			if not bvFly then
				bvFly = Instance.new("BodyVelocity")
				bvFly.MaxForce = Vector3.new(1e5, 1e5, 1e5)
				bvFly.Parent = root
			end
			if not bgFly then
				bgFly = Instance.new("BodyGyro")
				bgFly.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
				bgFly.P = 9000
				bgFly.Parent = root
			end
			hum.PlatformStand = true
			bgFly.CFrame = camera.CFrame

			local dir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end

			-- 手机端摇杆方向自动转换到镜头 3D 方向
			if dir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
				dir = (camera.CFrame.LookVector * -hum.MoveDirection.Z) + (camera.CFrame.RightVector * hum.MoveDirection.X)
				if dir.Magnitude == 0 then dir = hum.MoveDirection end
			end
			bvFly.Velocity = (dir.Magnitude > 0) and (dir.Unit * cfg.flySpeed) or Vector3.zero
		end
	end

	-- 每 0.5 秒更新服务器遥测数据与 ESP
	if now - lastStatTime >= 0.5 then
		local fps = math.clamp(math.floor(frameCount / (now - lastStatTime)), 1, 999)
		frameCount = 0
		lastStatTime = now

		local ping = 0
		pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		local mem = math.floor(Stats:GetTotalMemoryUsageMb())
		local pCnt = #Players:GetPlayers()
		local upSec = math.floor(now - startTime)

		topPill.Text = string.format("%d FPS | %d ms", fps, ping)
		bsFps.Text = fps .. " FPS"
		bsPing.Text = ping .. " ms"
		bsMem.Text = string.format("内存: %d MB  |  在线: %d/%d", mem, pCnt, Players.MaxPlayers)
		sdText.Text = string.format(
			"PlaceId: %d  |  在线人数: %d / %d  |  已删缓存: %d 个\n客户端内存: %d MB  |  运行时长: %02d分%02d秒",
			game.PlaceId, pCnt, Players.MaxPlayers, #deletedPartsHistory, mem, math.floor(upSec / 60), upSec % 60
		)

		-- 玩家位置高亮 ESP
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local hl = p.Character:FindFirstChild("IslandESP")
				local bg = p.Character:FindFirstChild("IslandTag")
				if cfg.esp then
					if not hl then
						hl = Instance.new("Highlight")
						hl.Name = "IslandESP"
						hl.FillColor = cfg.accentColor
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.FillTransparency = 0.5
						hl.Parent = p.Character
					end
					local head = p.Character:FindFirstChild("Head")
					local thum = p.Character:FindFirstChildOfClass("Humanoid")
					if head and thum then
						if not bg then
							bg = Instance.new("BillboardGui", p.Character)
							bg.Name = "IslandTag"
							bg.Adornee = head
							bg.Size = UDim2.new(0, 140, 0, 32)
							bg.StudsOffset = Vector3.new(0, 2.5, 0)
							bg.AlwaysOnTop = true
							local tl = Instance.new("TextLabel", bg)
							tl.Name = "Lbl"
							tl.Size = UDim2.new(1, 0, 1, 0)
							tl.BackgroundTransparency = 1
							tl.TextColor3 = Color3.fromRGB(255, 255, 255)
							tl.TextStrokeTransparency = 0.2
							tl.Font = Enum.Font.GothamBold
							tl.TextSize = 11
						end
						local dist = root and math.floor((head.Position - root.Position).Magnitude) or 0
						bg.Lbl.Text = string.format("%s [%d HP | %dm]", p.DisplayName, math.floor(thum.Health), dist)
					end
				else
					if hl then hl:Destroy() end
					if bg then bg:Destroy() end
				end
			end
		end
	end
end)

-- 无限连跳
UserInputService.JumpRequest:Connect(function()
	if cfg.infJump and player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

-- 快捷键监听: RightShift 展开/收起灵动岛，Q键 触发闪现冲刺
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		toggleIsland(not isExpanded)
	elseif input.KeyCode == Enum.KeyCode.Q then
		performFlashDash()
	end
end)

-- 玩家进出房间：仅在右下角弹出轻量通知，绝不关闭或打断正在使用的灵动岛
Players.PlayerAdded:Connect(function(p)
	refreshPlayerRadar()
	if not cfg.mutePlayerJoin then
		sendToast("新玩家加入房间", p.DisplayName .. " (@" .. p.Name .. ")", "👋", Color3.fromRGB(48, 209, 88))
	end
end)

Players.PlayerRemoving:Connect(function(p)
	if cfg.followTarget == p then cfg.followTarget = nil end
	if cfg.orbitTarget == p then cfg.orbitTarget = nil end
	task.defer(refreshPlayerRadar)
	if not cfg.mutePlayerJoin then
		sendToast("玩家离开房间", p.DisplayName .. " 退出了服务器", "🚪", Color3.fromRGB(255, 149, 0))
	end
end)
