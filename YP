		local b = Instance.new("TextButton", tScroll)
		b.Size = UDim2.new(1, -4, 0, 32)
		b.BackgroundColor3 = (idx == 1) and Cfg.accentColor or Color3.fromRGB(30, 30, 44)
		b.Text = string.format("  %d. %s", idx, tr.title)
		b.TextColor3 = Color3.fromRGB(240, 240, 248); b.Font = Enum.Font.GothamBold; b.TextSize = 11
