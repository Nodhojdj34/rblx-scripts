-- 主题色绑定表（用于一键换肤）
local accentElements = {}
local function bindAccent(inst, prop)
	table.insert(accentElements, {inst = inst, prop = prop})
	inst[prop] = ACCENT
end

local function setThemeColor(newColor)
	ACCENT = newColor
	for _, item in pairs(accentElements) do
		if item.inst and item.inst.Parent then
			TweenService:Create(item.inst, TWEEN_FAST, {[item.prop] = newColor}):Play()
		end
	end
end

-- ================= 基础 UI 辅助工具 =================
local function addCorner(parent, r)
	local c = Instance.new("UICorner", parent)
	c.CornerRadius = UDim.new(0, r)
	return c
end

local function addStroke(parent, col, thick, trans)
	local s = Instance.new("UIStroke", parent)
	s.Color = col or Color3.fromRGB(55, 55, 68)
	s.Thickness = thick or 1
	s.Transparency = trans or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function createText(parent, text, size, pos, font, tSize, col, align)
	local l = Instance.new("TextLabel", parent)
	l.Size = size; l.Position = pos; l.BackgroundTransparency = 1
	l.Text = text; l.Font = font or Enum.Font.GothamMedium
	l.TextSize = tSize or 12; l.TextColor3 = col or C_TEXT
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.TextTruncate = Enum.TextTruncate.AtEnd
	return l
end

