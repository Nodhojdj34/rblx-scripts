local origMaterials = {}
local function updateForceFieldBody(on)
	cfg.forceFieldBody = on
	local char = player.Character
	if not char then return end
	if on then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				origMaterials[p] = p.Material
				p.Material = Enum.Material.ForceField
			end
		end
	else
		for p, mat in pairs(origMaterials) do
			if p and p.Parent then p.Material = mat end
		end
		table.clear(origMaterials)
	end
end

local function updateNeonTrail(on)
	cfg.neonTrail = on
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local existing = root:FindFirstChild("IslandTrail")
	if on and not existing then
		local a0 = Instance.new("Attachment", root); a0.Name = "TrailA0"; a0.Position = Vector3.new(0, 1.4, 0)
		local a1 = Instance.new("Attachment", root); a1.Name = "TrailA1"; a1.Position = Vector3.new(0, -1.4, 0)
		local tr = Instance.new("Trail", root)
		tr.Name = "IslandTrail"
		tr.Attachment0 = a0; tr.Attachment1 = a1
		tr.Lifetime = 0.65
		tr.Color = strokeGrad.Color
		tr.Transparency = NumberSequence.new(0.15, 1)
	elseif not on and existing then
		existing:Destroy()
	end
end

