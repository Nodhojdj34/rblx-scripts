local navBtns = {}
local function createNavBtn(text, targetPage)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.32, 0, 0, 26)
	btn.BackgroundColor3 = (targetPage == pageControls) and COLOR_IOS_BLUE or COLOR_CARD
	btn.BackgroundTransparency = (targetPage == pageControls) and 0 or 1
	btn.Text = text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.TextColor3 = COLOR_TEXT
	btn.Parent = navBar
	addCorner(btn, 7)
	table.insert(navBtns, {btn = btn, page = targetPage})
	
	btn.Activated:Connect(function()
		for _, item in pairs(navBtns) do
			item.page.Visible = (item.page == targetPage)
			TweenService:Create(item.btn, TWEEN_FAST, {
				BackgroundTransparency = (item.page == targetPage) and 0 or 1,
				BackgroundColor3 = (item.page == targetPage) and COLOR_IOS_BLUE or COLOR_CARD
			}):Play()
		end
		if targetPage == pagePlayers then updatePlayerList() end
	end)
end

