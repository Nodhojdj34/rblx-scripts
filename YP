end)

-- ================= 6. 音频波纹、进度条与服务器监控循环 =================
local lastTime = os.clock()
local frames = 0

RunService.RenderStepped:Connect(function(dt)
	frames += 1
	
	-- 音乐播放时的实时动态效果 (60帧丝滑运行)
	if isPlaying and musicSound.IsPlaying then
		miniNote.Rotation = (miniNote.Rotation + dt * 120) % 360 -- 唱片旋转
		local loudness = math.clamp(musicSound.PlaybackLoudness / 250, 0.15, 1)
		for i, bar in ipairs(waveBars) do
			local h = math.clamp(loudness * 16 * math.sin(os.clock()*12 + i), 4, 16)
			bar.Size = bar.Size:Lerp(UDim2.new(0, 3, 0, math.abs(h)), 0.3)
		end
		if musicSound.TimeLength > 0 then
			progFill.Size = UDim2.new(musicSound.TimePosition / musicSound.TimeLength, 0, 1, 0)
			local cM, cS = math.floor(musicSound.TimePosition/60), math.floor(musicSound.TimePosition%60)
			local tM, tS = math.floor(musicSound.TimeLength/60), math.floor(musicSound.TimeLength%60)
			timeTxt.Text = string.format("%02d:%02d / %02d:%02d", cM, cS, tM, tS)
		end
	else
		for _, bar in ipairs(waveBars) do bar.Size = bar.Size:Lerp(UDim2.new(0, 3, 0, 4), 0.2) end
	end
	
	-- 每秒更新一次系统数据
	local now = os.clock()
	if now - lastTime >= 1 then
		local fps = frames; frames = 0; lastTime = now
		local ping = math.round(player:GetNetworkPing() * 1000)
		local mem = math.round(Stats:GetTotalMemoryUsageMb())
		
		compactText.Text = isPlaying and "正在播放..." or (fps .. " FPS • " .. ping .. "ms")
		if feat.esp then updateESP() end -- 刷新ESP防止新玩家漏掉
		
		if isExpanded and pageServer.Visible then
			local up = math.floor(workspace.DistributedGameTime)
			sFPS.Text = string.format("🟢 实时画面帧率: <font color='#30D158'><b>%d FPS</b></font>", fps)
			sPing.Text = string.format("📶 服务器网络延迟: <font color='#0A84FF'><b>%d ms</b></font>", ping)
			sMem.Text = string.format("💾 客户端内存占用: <b>%d MB</b>", mem)
			sPlrs.Text = string.format("👥 当前房间人数: <b>%d / %d 人</b>", #Players:GetPlayers(), Players.MaxPlayers)
			sTime.Text = string.format("⏱️ 服务器已运行: <b>%02d时 %02d分 %02d秒</b>", math.floor(up/3600), math.floor((up%3600)/60), up%60)
		end
	end
end)

