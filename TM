	IsPlaying = true
	PlayPauseBtn.Text = "⏸ 暂停"
	QMPlayBtn.Text = "⏸ 暂停"
	LoadTrack(n)
end)

local function NextTrack()
	PlayClickSound(1.0)
	local n = CurrentTrackIndex + 1
	if n > #Playlist then n = 1 end
	IsPlaying = true
	PlayPauseBtn.Text = "⏸ 暂停"
	QMPlayBtn.Text = "⏸ 暂停"
	LoadTrack(n)
end
