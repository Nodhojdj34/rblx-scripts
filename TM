-- ================= 核心展开与收起动画 =================
local isExpanded = false
local ExpandTween = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CollapseTween = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function expandIsland()
    if isExpanded then return end
    isExpanded = true
    OpenTrigger.Visible = false
    CompactFrame.Visible = false
    
    TweenService:Create(Island, ExpandTween, {Size = UDim2.new(0, 360, 0, 260)}):Play()
    TweenService:Create(IslandCorner, ExpandTween, {CornerRadius = UDim.new(0, 34)}):Play()
    task.wait(0.08)
    if isExpanded then ExpandedFrame.Visible = true end
end

local function collapseIsland()
    if not isExpanded then return end
    isExpanded = false
    ExpandedFrame.Visible = false
    
    TweenService:Create(Island, CollapseTween, {Size = UDim2.new(0, 165, 0, 36)}):Play()
    TweenService:Create(IslandCorner, CollapseTween, {CornerRadius = UDim.new(0, 50)}):Play()
    task.wait(0.2)
    if not isExpanded then
        CompactFrame.Visible = true
        OpenTrigger.Visible = true
    end
end

OpenTrigger.Activated:Connect(expandIsland)
CollapseTopBtn.Activated:Connect(collapseIsland)
HomeBarBtn.Activated:Connect(collapseIsland)

-- ================= 实时状态循环 (声波 / 进度条 / 流光旋转 / 性能) =================
local function formatTime(sec)
    local m = math.floor(sec / 60)
    local s = math.floor(sec % 60)
    return string.format("%02d:%02d", m, s)
end

task.spawn(function()
    while task.wait(0.12) do
        -- 1. 待机彩色声波律动
        for _, bar in ipairs(WaveBars) do
            local h = isPlaying and (math.random(25, 100) / 100) or 0.22
            TweenService:Create(bar, TweenInfo.new(0.12), {Size = UDim2.new(0, 3, h, 0)}):Play()
        end
        -- 2. 音乐时间与进度条更新
        if Sound.TimeLength > 0 then
            local ratio = math.clamp(Sound.TimePosition / Sound.TimeLength, 0, 1)
            TweenService:Create(BarFill, TweenInfo.new(0.12), {Size = UDim2.new(ratio, 0, 1, 0)}):Play()
            TimeNow.Text = formatTime(Sound.TimePosition)
            TimeTotal.Text = formatTime(Sound.TimeLength)
        end
        -- 3. 边框流光缓慢旋转
        StrokeGradient.Rotation = (StrokeGradient.Rotation + 3) % 360
    end
end)

-- 帧率与时间刷新
local lastTime = tick()
local frameCounter = 0
RunService.RenderStepped:Connect(function()
    frameCounter = frameCounter + 1
    if tick() - lastTime >= 0.5 then
        local fps = math.floor(frameCounter / (tick() - lastTime))
        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        local nowStr = os.date("%H:%M")
        CompactTime.Text = nowStr
        StatusText.Text = string.format("🕒 %s   •   🟢 %d FPS   •   📶 %d ms", nowStr, fps, ping)
        frameCounter = 0
        lastTime = tick()
    end
end)
