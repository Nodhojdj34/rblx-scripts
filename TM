local function ClampIslandPosition(pos)
	local vp = Camera.ViewportSize
	local halfW = Island.AbsoluteSize.X * 0.5
	local xOffset = startPos.X.Scale * vp.X + startPos.X.Offset + (pos.X - dragStart.X)
	local yOffset = startPos.Y.Scale * vp.Y + startPos.Y.Offset + (pos.Y - dragStart.Y)
	local clampedX = math.clamp(xOffset, halfW + 6, vp.X - halfW - 6)
	local clampedY = math.clamp(yOffset, 4, vp.Y - Island.AbsoluteSize.Y - 6)
	return UDim2.new(0, clampedX, 0, clampedY)
end

Island.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local relY = input.Position.Y - Island.AbsolutePosition.Y
		if not Config.IsExpanded or relY <= 38 then
			dragging = true
			hasMoved = false
			dragStart = input.Position
			startPos = Island.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end
end)

Island.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		if (input.Position - dragStart).Magnitude > 6 then
			hasMoved = true
			Island.Position = ClampIslandPosition(input.Position)
		end
	end
end)

CompactView.MouseButton1Click:Connect(function()
	if not hasMoved then SetIslandExpanded(true) end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
		SetIslandExpanded(not Config.IsExpanded)
	end
end)

