-- ================= 4. 核心交互逻辑 =================

-- 展开/收起灵动岛
local function toggleIsland()
    if isNotifying then return end -- 通知时禁止操作
    isExpanded = not isExpanded
    
    if isExpanded then
        CompactFrame.Visible = false
        ExpandedFrame.Visible = true
        TweenService:Create(Island, ExpandTweenInfo, {Size = UDim2.new(0, 320, 0, 180)}):Play()
        TweenService:Create(IslandCorner, ExpandTweenInfo, {CornerRadius = UDim.new(0, 30)}):Play()
    else
        ExpandedFrame.Visible = false
        CompactFrame.Visible = true
        TweenService:Create(Island, CollapseTweenInfo, {Size = UDim2.new(0, 130, 0, 32)}):Play()
        TweenService:Create(IslandCorner, CollapseTweenInfo, {CornerRadius = UDim.new(0, 20)}):Play()
    end
end

-- 透明触发按钮 (覆盖在待机界面上，兼容PC点击和手机触摸)
local TriggerButton = Instance.new("TextButton")
TriggerButton.Size = UDim2.new(1, 0, 1, 0)
TriggerButton.BackgroundTransparency = 1
TriggerButton.Text = ""
TriggerButton.Parent = CompactFrame

TriggerButton.Activated:Connect(toggleIsland)

-- 点击灵动岛外部自动收起 (提升手机和PC体验)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isExpanded and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        local mousePos = UserInputService:GetMouseLocation()
        local islandPos = Island.AbsolutePosition
        local islandSize = Island.AbsoluteSize
        
        -- 判断点击位置是否在灵动岛外部
        if mousePos.X < islandPos.X or mousePos.X > islandPos.X + islandSize.X or
           mousePos.Y < islandPos.Y or mousePos.Y > islandPos.Y + islandSize.Y then
            toggleIsland()
        end
    end
end)

-- 灵动通知函数
local function SendNotification(text)
    if isExpanded then toggleIsland() task.wait(0.3) end
    isNotifying = true
    
    CompactFrame.Visible = false
    NotifyFrame.Visible = true
    NotifyText.Text = text
    
    -- 弹出动画
    TweenService:Create(Island, ExpandTweenInfo, {Size = UDim2.new(0, 280, 0, 45)}):Play()
    task.wait(2.5)
    
    -- 收起动画
    NotifyFrame.Visible = false
    CompactFrame.Visible = true
    TweenService:Create(Island, CollapseTweenInfo, {Size = UDim2.new(0, 130, 0, 32)}):Play()
    
    isNotifying = false
end

