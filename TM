-- 更新时间和Ping
task.spawn(function()
    while task.wait(1) do
        -- 更新时间
        TimeLabel.Text = os.date("%H:%M")
        
        -- 呼吸灯闪烁效果
        TweenService:Create(StatusDot, TweenInfo.new(0.5), {BackgroundTransparency = 0.5}):Play()
        task.wait(0.5)
        TweenService:Create(StatusDot, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
    end
end)

-- 更新FPS和Ping
local lastUpdate = tick()
local frameCount = 0
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    if tick() - lastUpdate >= 0.5 then
        local fps = math.floor(frameCount / (tick() - lastUpdate))
        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        StatsLabel.Text = string.format("%s\n🟢 FPS: %d  |  📶 Ping: %dms", LocalPlayer.DisplayName, fps, ping)
        frameCount = 0
        lastUpdate = tick()
    end
end)

