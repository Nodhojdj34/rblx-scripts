-- ================= 核心动画与展开/收起逻辑 =================
local isExpanded = false
local ExpandInfo = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CollapseInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function openIsland()
    if isExpanded then return end
    isExpanded = true
    
    OpenTrigger.Visible = false -- 禁用外层按钮，确保内部按钮100%可点！
    ClickOutsideOverlay.Visible = true -- 启用外部点击检测
    CompactFrame.Visible = false
    
    TweenService:Create(Island, ExpandInfo, {Size = UDim2.new(0, 350, 0, 225)}):Play()
    TweenService:Create(IslandCorner, ExpandInfo, {CornerRadius = UDim.new(0, 36)}):Play()
    
    task.wait(0.1)
    if isExpanded then ExpandedFrame.Visible = true end
end

local function closeIsland()
    if not isExpanded then return end
    isExpanded = false
    
    ExpandedFrame.Visible = false
    ClickOutsideOverlay.Visible = false
    
    TweenService:Create(Island, CollapseInfo, {Size = UDim2.new(0, 150, 0, 35)}):Play()
    TweenService:Create(IslandCorner, CollapseInfo, {CornerRadius = UDim.new(0, 50)}):Play()
    
    task.wait(0.2)
    if not isExpanded then
        CompactFrame.Visible = true
        OpenTrigger.Visible = true
    end
end

