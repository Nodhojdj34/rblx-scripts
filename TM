local function SetIslandState(expand)
	if Config.Expanded == expand then return end
	Config.Expanded = expand
	PlayClickSound(expand and 1.15 or 0.9)

	if expand then
		CompactView.Visible = false
		ExpandedView.Visible = true
		RefreshPlayersList()
		InnerRimCorner.CornerRadius = UDim.new(0, 28)
		TweenService:Create(Island, TweenInfo.new(0.44, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = EXPANDED_SIZE
		}):Play()
		TweenService:Create(AmbientGlow, TweenInfo.new(0.44, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, EXPANDED_SIZE.X.Offset + 12, 0, EXPANDED_SIZE.Y.Offset + 12),
			BackgroundTransparency = 0.85
		}):Play()
		TweenService:Create(IslandCorner, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			CornerRadius = UDim.new(0, 30)
		}):Play()
	else
		ExpandedView.Visible = false
		InnerRimCorner.CornerRadius = UDim.new(1, 0)
		TweenService:Create(Island, TweenInfo.new(0.36, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = COMPACT_SIZE
		}):Play()
		TweenService:Create(AmbientGlow, TweenInfo.new(0.36, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, COMPACT_SIZE.X.Offset + 8, 0, COMPACT_SIZE.Y.Offset + 8),
			BackgroundTransparency = 0.78
		}):Play()
		TweenService:Create(IslandCorner, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			CornerRadius = UDim.new(1, 0)
		}):Play()
