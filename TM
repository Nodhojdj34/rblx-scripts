-- ================= 实时状态循环 (声波动画 / 进度条 / FPS) =================
task.spawn(function()
    while task.wait(0.15) do
        -- 动态音乐波形动画
        for _, bar in ipairs(WaveBars) do
            local targetHeight = isPlaying and (math.random(25, 100) / 100) or 0.2
            TweenService:Create(bar, TweenInfo.new(0.15), {Size = UDim2.new(0, 3, targetHeight, 0)}):Play()
        end
        -- 更新音乐进度条
        if Sound.TimeLength > 0 then
            local progress = math.clamp(Sound.TimePosition / Sound.TimeLength, 0, 1)
            TweenService:Create(ProgressFill, TweenInfo.new(0.15), {Size = UDim2.new(progress, 0, 1, 0)}):Play()
        end
        if espEnabled then updateESP() end
    end
end)

-- 更新顶部 时间 & FPS & Ping
local lastTick = tick()
local frames = 0
RunService.RenderStepped:Connect(function()
    frames = frames + 1
    if tick() - lastTick >= 0.5 then
        local fps = math.floor(frames / (tick() - lastTick))
        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        TopBar.Text = string.format("🕒 %s     |     🟢 %d FPS     📶 %d ms", os.date("%H:%M"), fps, ping)
        frames = 0
        lastTick = tick()
    end
end)
