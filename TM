local SpringTween = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function SetIslandExpanded(state)
	if Config.IsExpanded == state then return end
	Config.IsExpanded = state

	if state then
		CompactView.Visible = false
		ExpandedView.Visible = true
		RefreshPlayerList()
		TweenService:Create(Island, SpringTween, { Size = EXPANDED_SIZE }):Play()
		TweenService:Create(IslandCorner, SpringTween, { CornerRadius = UDim.new(0, 28) }):Play()
		TweenService:Create(InnerRimCorner, SpringTween, { CornerRadius = UDim.new(0, 26) }):Play()
	else
		ExpandedView.Visible = false
		TweenService:Create(Island, SpringTween, { Size = COMPACT_SIZE }):Play()
		TweenService:Create(IslandCorner, SpringTween, { CornerRadius = UDim.new(0, 18) }):Play()
		TweenService:Create(InnerRimCorner, SpringTween, { CornerRadius = UDim.new(0, 16) }):Play()
		task.delay(0.2, function()
			if not Config.IsExpanded then CompactView.Visible = true end
		end)
	end
end

