local function LoadTrack(idx)
	CurrentTrackIndex = idx
	local t = Playlist[idx]
	SongTitle.Text = t.Name
	SongArtist.Text = t.Artist
	QMTitle.Text = "🎵 " .. t.Name
	AlbumArt.BackgroundColor3 = t.Color
	MiniDisk.BackgroundColor3 = t.Color
	ProgressFill.BackgroundColor3 = t.Color
	for _, b in ipairs(WaveBars) do b.BackgroundColor3 = t.Color end
	AudioPlayer.SoundId = t.ID
	AudioPlayer.PlaybackSpeed = CurrentPitch
	if IsPlaying then
		AudioPlayer:Play()
		ShowToast("🎵 正在播放: " .. t.Name)
	end
end

local function TogglePlay()
	PlayClickSound(1.1)
	if IsPlaying then
		AudioPlayer:Pause()
		IsPlaying = false
		PlayPauseBtn.Text = "▶ 播放"
		QMPlayBtn.Text = "▶ 播放"
		ShowToast("⏸ 音乐已暂停")
	else
		if AudioPlayer.SoundId == "" then
			AudioPlayer.SoundId = Playlist[CurrentTrackIndex].ID
		end
		AudioPlayer:Play()
		IsPlaying = true
		PlayPauseBtn.Text = "⏸ 暂停"
		QMPlayBtn.Text = "⏸ 暂停"
		ShowToast("🎵 正在播放: " .. SongTitle.Text)
	end
end

PlayPauseBtn.MouseButton1Click:Connect(TogglePlay)
QMPlayBtn.MouseButton1Click:Connect(TogglePlay)

PrevBtn.MouseButton1Click:Connect(function()
	PlayClickSound(1.0)
	local n = CurrentTrackIndex - 1
