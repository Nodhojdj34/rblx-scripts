-- ================= 实时状态循环 (声波 / 服务器信息 / 黑胶旋转) =================
local function formatTime(sec)
    local m = math.floor(sec / 60)
    local s = math.floor(sec % 60)
    return string.format("%02d:%02d", m, s)
end

local function formatHours(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = math.floor(sec % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

task.spawn(function()
    while task.wait(0.15) do
        -- 1. 待机彩色声波律动
        for _, bar in ipairs(WaveBars) do
            local h = isPlaying and (math.random(25, 100) / 100) or 0.22
            TweenService:Create(bar, TweenInfo.new(0.15), {Size = UDim2.new(0, 3, h, 0)}):Play()
        end
        
        -- 2. 音乐时间与进度条更新
        if Sound.TimeLength > 0 then
            local ratio = math.clamp(Sound.TimePosition / Sound.TimeLength, 0, 1)
            TweenService:Create(BarFill, TweenInfo.new(0.15), {Size = UDim2.new(ratio, 0, 1, 0)}):Play()
            TimeNow.Text = formatTime(Sound.TimePosition)
            TimeTotal.Text = formatTime(Sound.TimeLength)
        end
        
        -- 3. 边框流光旋转
        StrokeGradient.Rotation = (StrokeGradient.Rotation + 3) % 360

        -- 4. 更新服务器信息面板
        local curPlrs = #Players:GetPlayers()
        local maxPlrs = Players.MaxPlayers
        PlayerCountLabel.Text = string.format("👥 在线玩家: %d / %d 人 (空余 %d 位)", curPlrs, maxPlrs, math.max(0, maxPlrs - curPlrs))
        TweenService:Create(CapBarFill, TweenInfo.new(0.2), {Size = UDim2.new(math.clamp(curPlrs / math.max(1, maxPlrs), 0, 1), 0, 1, 0)}):Play()
        
        MetricUptime.Text = "⏱️ 服运行: " .. formatHours(workspace.DistributedGameTime)
        MetricMemory.Text = string.format("🧠 内存占用: %d MB", math.floor(Stats:GetTotalMemoryUsageMb()))
        MetricPhysics.Text = string.format("⚙️ 物理帧率: %.1f Hz", workspace:GetRealPhysicsFPS())
    end
end)

-- 帧率刷新 & 黑胶唱片丝滑旋转
local lastTime = tick()
local frameCounter = 0
RunService.RenderStepped:Connect(function(dt)
    frameCounter = frameCounter + 1
    
    -- 黑胶旋转动画
    if isPlaying then
        MiniDisk.Rotation = (MiniDisk.Rotation + dt * 65) % 360
        AlbumArt.Rotation = (AlbumArt.Rotation + dt * 45) % 360
    end

    if tick() - lastTime >= 0.5 then
        local fps = math.floor(frameCounter / (tick() - lastTime))
        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        local nowStr = os.date("%H:%M")
        CompactTime.Text = nowStr
        StatusText.Text = string.format("🕒 %s   •   🟢 %d FPS   •   📶 %d ms", nowStr, fps, ping)
        frameCounter = 0
        lastTime = tick()
    end
end)
