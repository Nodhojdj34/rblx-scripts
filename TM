local function CreateiOSToggle(parent, title, subtitle, defaultOn, callback)
	local card = Instance.new("TextButton")
	card.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
	card.BackgroundTransparency = 0.15
	card.Text = ""
	card.AutoButtonColor = false
	card.ZIndex = 14
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 11)

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = Color3.fromRGB(55, 55, 70)
	cardStroke.Thickness = 1
	cardStroke.Transparency = 0.55
	cardStroke.Parent = card

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -54, 0, 18)
	titleLbl.Position = UDim2.new(0, 10, 0, 5)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = title
	titleLbl.TextColor3 = Color3.fromRGB(240, 240, 245)
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 11
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.ZIndex = 15
	titleLbl.Parent = card

	local subLbl = Instance.new("TextLabel")
	subLbl.Size = UDim2.new(1, -54, 0, 14)
	subLbl.Position = UDim2.new(0, 10, 0, 22)
	subLbl.BackgroundTransparency = 1
	subLbl.Text = subtitle
	subLbl.TextColor3 = Color3.fromRGB(145, 145, 160)
	subLbl.Font = Enum.Font.Gotham
	subLbl.TextSize = 9
	subLbl.TextXAlignment = Enum.TextXAlignment.Left
	subLbl.ZIndex = 15
	subLbl.Parent = card

	local switchBg = Instance.new("Frame")
	switchBg.Size = UDim2.new(0, 36, 0, 20)
	switchBg.AnchorPoint = Vector2.new(1, 0.5)
	switchBg.Position = UDim2.new(1, -8, 0.5, 0)
	switchBg.BackgroundColor3 = Color3.fromRGB(52, 52, 64)
	switchBg.ZIndex = 15
	switchBg.Parent = card
	Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.AnchorPoint = Vector2.new(0, 0.5)
	knob.Position = UDim2.new(0, 2, 0.5, 0)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.ZIndex = 16
	knob.Parent = switchBg
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local isOn = defaultOn and true or false
	local function UpdateStyle()
		local accent = Themes[CurrentThemeIndex].Accent
		TweenService:Create(switchBg, TweenInfo.new(0.22, Enum.EasingStyle.Quart), {
			BackgroundColor3 = isOn and accent or Color3.fromRGB(52, 52, 64)
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = isOn and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		}):Play()
		TweenService:Create(cardStroke, TweenInfo.new(0.22), {
			Color = isOn and accent or Color3.fromRGB(55, 55, 70),
			Transparency = isOn and 0.15 or 0.55
		}):Play()
	end

	UpdateStyle()
	table.insert(ActiveSwitchStylers, UpdateStyle)

	card.MouseButton1Click:Connect(function()
		isOn = not isOn
		PlayClickSound(isOn and 1.2 or 0.9)
		UpdateStyle()
		callback(isOn, subLbl)
	end)
end

