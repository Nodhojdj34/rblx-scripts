local function clock(value)
    value = math.max(0, math.floor(value))
    return string.format("%d:%02d", math.floor(value / 60), value % 60)
end

local function scheduleCollapse()
    collapseRevision += 1
    local version = collapseRevision
    if Config.AutoCollapse then
        task.delay(Config.CollapseAfter, function()
            if alive and version == collapseRevision then setExpanded(false) end
        end)
    end
end

setExpanded = function(value)
    isExpanded = value
    compact.Visible = not value
    expanded.Visible = value
    if sizeTween then sizeTween:Cancel() end
    local duration = Config.Animation == "snappy" and 0.2 or 0.45
    local easing = Config.Animation == "spring" and Enum.EasingStyle.Back or Enum.EasingStyle.Quint
    sizeTween = TweenService:Create(pill, TweenInfo.new(duration, easing, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(value and 320 or 192, value and 152 or 40),
    })
    sizeTween:Play()
    if value then scheduleCollapse() else collapseRevision += 1 end
end

