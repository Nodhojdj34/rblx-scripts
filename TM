local function ShowToast(msg)
	ToastText.Text = msg
	ToastStroke.Color = Themes[CurrentThemeIndex].Accent
	TweenService:Create(ToastBanner, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 7)
	}):Play()
	task.delay(1.85, function()
		if ToastText.Text == msg then
			TweenService:Create(ToastBanner, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(0.5, 0, 0, -42)
			}):Play()
		end
	end)
end

