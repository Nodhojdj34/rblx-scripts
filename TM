local function FormatSec(s)
	return string.format("%02d:%02d", math.floor(s / 60), math.floor(s % 60))
end

local frameCount, lastTime, currentFPS = 0, os.clock(), 60
local rotAngle = 0

RunService.RenderStepped:Connect(function(dt)
	frameCount = frameCount + 1
	local now = os.clock()
	if now - lastTime >= 0.5 then
		currentFPS = math.clamp(math.floor(frameCount / (now - lastTime)), 1, 999)
		frameCount = 0
		lastTime = now

		StatusInfoLabel.Text = "5G " .. os.date("%H:%M") .. " 🔋100%"

		local ping = 0
		pcall(function()
			ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		NetDetail.Text = string.format("延迟: %d ms\n帧率: %d FPS | 运行稳定", ping, currentFPS)

		if not Config.StopwatchRunning then
			if IsPlaying then
				CompactTitle.Text = "🎵 " .. string.sub(SongTitle.Text, 1, 11)
			else
				CompactTitle.Text = currentFPS .. " FPS · " .. os.date("%H:%M")
			end
		end

		local pCount = #Players:GetPlayers()
		local maxP = Players.MaxPlayers
		CapBarFill.Size = UDim2.new(math.clamp(pCount / math.max(maxP, 1), 0, 1), 0, 1, 0)
		CapLabel.Text = string.format("人数负载: %d / %d 人 | Ping: %d ms", pCount, maxP, ping)

		local up = math.floor(workspace.DistributedGameTime)
		StatUptime.Text = string.format("⏱️ 运行时长: %02d:%02d:%02d", math.floor(up/3600), math.floor((up%3600)/60), up%60)
		pcall(function()
			StatMemory.Text = string.format("💾 内存占用: %d MB", math.floor(Stats:GetTotalMemoryUsageMb()))
			StatPhysics.Text = string.format("⚙️ 物理帧率: %d Hz", math.floor(workspace:GetRealPhysicsFPS()))
		end)
	end

	if Config.StopwatchRunning then
		Config.StopwatchTime = Config.StopwatchTime + dt
		local m = math.floor(Config.StopwatchTime / 60)
		local s = Config.StopwatchTime % 60
		local str = string.format("%02d:%04.1f", m, s)
		TimerLabel.Text = "⏱️ 灵动秒表: " .. str
		CompactTitle.Text = "⏱️ " .. str
	end

	StrokeGradient.Rotation = (StrokeGradient.Rotation + dt * 42) % 360

	if IsPlaying and AudioPlayer.IsPlaying then
		rotAngle = (rotAngle + dt * 115) % 360
		AlbumArt.Rotation = rotAngle
		MiniDisk.Rotation = rotAngle

		local tPos = AudioPlayer.TimePosition
		local tLen = AudioPlayer.TimeLength
		if tLen > 0 then
			ProgressFill.Size = UDim2.new(math.clamp(tPos / tLen, 0, 1), 0, 1, 0)
			TimeLabel.Text = FormatSec(tPos) .. " / " .. FormatSec(tLen)
		end

		local loud = math.clamp(AudioPlayer.PlaybackLoudness / 380, 0.18, 1)
		for i, bar in ipairs(WaveBars) do
			local h = math.clamp(( math.sin(now * 13 + i * 1.4) * 0.5 + 0.5 ) * loud * 24, 4, 24)
			bar.Size = UDim2.new(0, 4, 0, h)
		end
		for i, mb in ipairs(MiniBars) do
			local mh = math.clamp(( math.cos(now * 14 + i * 1.6) * 0.5 + 0.5 ) * loud * 15, 4, 15)
			mb.Size = UDim2.new(0, 3, 0, mh)
		end
	end

	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hum and hrp then
			if Config.SpeedLock then hum.WalkSpeed = Config.TargetSpeed end
			if Config.JumpLock then
				hum.UseJumpPower = true
				hum.JumpPower = Config.TargetJump
			end
			StatPos.Text = string.format("📍 坐标: %d, %d, %d", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
			CharDashText.Text = string.format("👤 玩家: %s\n❤️ 生命值: %d/%d | ⚡ 移速: %d | 🚀 弹跳: %d", LocalPlayer.DisplayName, math.floor(hum.Health), math.floor(hum.MaxHealth), math.floor(hum.WalkSpeed), math.floor(hum.JumpPower))

			-- 🦅 摇杆与键盘通用丝滑自由飞行
			if Config.Fly then
				local moveDir = hum.MoveDirection
				local camCF = Camera.CFrame
				local flyVel = Vector3.zero
				if moveDir.Magnitude > 0 then
					local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
					local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
					local forwardDot = flatLook:Dot(moveDir)
					local rightDot = flatRight:Dot(moveDir)
					flyVel = (camCF.LookVector * forwardDot + camCF.RightVector * rightDot) * Config.FlySpeed
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					flyVel = flyVel + Vector3.new(0, Config.FlySpeed * 0.8, 0)
				elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					flyVel = flyVel - Vector3.new(0, Config.FlySpeed * 0.8, 0)
				end
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.CFrame = hrp.CFrame + flyVel * dt
			end

			-- 🕷️ 蜘蛛自动爬墙
			if Config.SpiderClimb and hum.MoveDirection.Magnitude > 0 then
				local rayParams = RaycastParams.new()
				rayParams.FilterDescendantsInstances = {char}
				rayParams.FilterType = Enum.RaycastFilterType.Exclude
				local res = workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 2.6, rayParams)
				if res then
					hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 42, hrp.AssemblyLinearVelocity.Z)
				end
			end

			-- 🌀 炫酷陀螺旋转
			if Config.SpinBot then
				hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(22), 0)
			end

			-- 🛰️ 360° 环绕目标玩家
			if Config.OrbitTarget and Config.OrbitTarget.Character then
				local tHrp = Config.OrbitTarget.Character:FindFirstChild("HumanoidRootPart")
				if tHrp then
					Config.OrbitAngle = (Config.OrbitAngle + dt * 3.5) % (math.pi * 2)
					local offset = Vector3.new(math.cos(Config.OrbitAngle) * 7, 1, math.sin(Config.OrbitAngle) * 7)
					hrp.CFrame = CFrame.new(tHrp.Position + offset, tHrp.Position)
				end
			end

			-- 👟 踏空漫步
			if Config.AirWalk then
				local airPart = workspace:FindFirstChild("IslandAirPart")
				if not airPart then
					airPart = Instance.new("Part")
					airPart.Name = "IslandAirPart"
					airPart.Size = Vector3.new(8, 0.5, 8)
					airPart.Anchored = true
					airPart.Material = Enum.Material.Neon
					airPart.Transparency = 0.45
					airPart.Parent = workspace
				end
				airPart.Color = Themes[CurrentThemeIndex].Accent
				airPart.CFrame = CFrame.new(hrp.Position.X, Config.AirWalkY, hrp.Position.Z)
			end
		end
	end

	if Config.Fullbright then
		Lighting.Brightness = 2.5
		Lighting.Ambient = Color3.fromRGB(255, 255, 255)
		Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
	end

	-- 🎯 轮廓高光透视 & 🏷️ 头顶全息血量名片
	if Config.ESP or Config.NameESP then
		local myHrp = char and char:FindFirstChild("HumanoidRootPart")
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				if Config.ESP then
					local hl = p.Character:FindFirstChild("AppleESP")
					if not hl then
						hl = Instance.new("Highlight")
						hl.Name = "AppleESP"
						hl.FillTransparency = 0.65
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.Parent = p.Character
					end
					hl.FillColor = Themes[CurrentThemeIndex].Accent
				end
				if Config.NameESP then
					local head = p.Character:FindFirstChild("Head")
					local tHum = p.Character:FindFirstChildOfClass("Humanoid")
					if head and tHum then
						local bgui = p.Character:FindFirstChild("AppleNameESP")
						if not bgui then
							bgui = Instance.new("BillboardGui")
							bgui.Name = "AppleNameESP"
							bgui.Adornee = head
							bgui.Size = UDim2.new(0, 120, 0, 32)
							bgui.StudsOffset = Vector3.new(0, 2.5, 0)
							bgui.AlwaysOnTop = true
							local tl = Instance.new("TextLabel", bgui)
							tl.Name = "TagText"
							tl.Size = UDim2.new(1, 0, 1, 0)
							tl.BackgroundTransparency = 1
							tl.Font = Enum.Font.GothamBold
							tl.TextSize = 11
							tl.TextStrokeTransparency = 0.2
							bgui.Parent = p.Character
						end
						local dist = myHrp and math.floor((myHrp.Position - head.Position).Magnitude) or 0
						bgui.TagText.TextColor3 = Themes[CurrentThemeIndex].Accent
						bgui.TagText.Text = string.format("%s [%dm]\n❤️ %d/%d", p.DisplayName, dist, math.floor(tHum.Health), math.floor(tHum.MaxHealth))
					end
				end
			end
		end
	end
end)
