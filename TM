	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local nearestPart, minDist = nil, math.huge
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("Tool") and v:FindFirstChild("Handle") then
			local d = (v.Handle.Position - hrp.Position).Magnitude
			if d < minDist then
				minDist = d
				nearestPart = v.Handle
			end
		end
	end
	if nearestPart then
		hrp.CFrame = nearestPart.CFrame + Vector3.new(0, 3, 0)
		Notify("🎁 已瞬移至道具 (" .. math.floor(minDist) .. "m)！")
	else
		Notify("全图暂未发现野生掉落工具", Color3.fromRGB(255, 159, 10))
	end
end)

