local function CreateQuickTile(colIdx, rowIdx, title, activeMode, callback)
	local btn = Instance.new("TextButton", ControlPage)
	btn.Size = UDim2.new(1/3, -5, 0, 32)
	btn.Position = UDim2.new((colIdx - 1) / 3, (colIdx - 1) * 2, 0, 56 + (rowIdx - 1) * 36)
	btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
	btn.BackgroundTransparency = 0.2
	btn.Text = title
	btn.TextColor3 = Color3.fromRGB(240, 240, 250)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 11
	btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)

	local isOn = false
	btn.MouseButton1Click:Connect(function()
		if activeMode then
			isOn = not isOn
			btn.BackgroundColor3 = isOn and Themes[Config.CurrentTheme].Accent or Color3.fromRGB(28, 28, 38)
			callback(isOn)
		else
			btn.BackgroundColor3 = Themes[Config.CurrentTheme].Accent
			task.delay(0.2, function() btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38) end)
			callback()
		end
	end)
end

