local function addFeatureCard(parent, iconTitle, desc, onToggle)
    local card = Instance.new("TextButton")
    card.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
    card.Text = ""
    card.AutoButtonColor = false
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 14)

    local tLbl = Instance.new("TextLabel")
    tLbl.Size = UDim2.new(1, -20, 0, 20)
    tLbl.Position = UDim2.new(0, 10, 0, 8)
    tLbl.BackgroundTransparency = 1
    tLbl.Text = iconTitle
    tLbl.TextColor3 = Color3.fromRGB(245, 245, 250)
    tLbl.Font = Enum.Font.GothamBold
    tLbl.TextSize = 12
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.Parent = card

    local sLbl = Instance.new("TextLabel")
    sLbl.Size = UDim2.new(1, -20, 0, 16)
    sLbl.Position = UDim2.new(0, 10, 0, 30)
    sLbl.BackgroundTransparency = 1
    sLbl.Text = "点击开启"
    sLbl.TextColor3 = Color3.fromRGB(135, 135, 148)
    sLbl.Font = Enum.Font.Gotham
    sLbl.TextSize = 10
    sLbl.TextXAlignment = Enum.TextXAlignment.Left
    sLbl.Parent = card

    local active = false
    card.Activated:Connect(function()
        active = not active
        if active then
            TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(10, 132, 255)}):Play()
            sLbl.Text = desc
            sLbl.TextColor3 = Color3.fromRGB(225, 240, 255)
        else
            TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(26, 26, 34)}):Play()
            sLbl.Text = "已关闭"
            sLbl.TextColor3 = Color3.fromRGB(135, 135, 148)
        end
        onToggle(active, card, sLbl)
    end)
end

