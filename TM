	tLbl.BackgroundTransparency = 1
	tLbl.Text = title
	tLbl.TextColor3 = Color3.fromRGB(242, 242, 248)
	tLbl.Font = Enum.Font.GothamBold
	tLbl.TextSize = 12
	tLbl.TextXAlignment = Enum.TextXAlignment.Left

	local dLbl = Instance.new("TextLabel", card)
	dLbl.Size = UDim2.new(1, -74, 0, 16)
	dLbl.Position = UDim2.new(0, 12, 0, 23)
	dLbl.BackgroundTransparency = 1
	dLbl.Text = desc
	dLbl.TextColor3 = Color3.fromRGB(145, 145, 162)
	dLbl.Font = Enum.Font.Gotham
	dLbl.TextSize = 10
	dLbl.TextXAlignment = Enum.TextXAlignment.Left

	local swBtn = Instance.new("TextButton", card)
	swBtn.Size = UDim2.new(0, 44, 0, 24)
	swBtn.Position = UDim2.new(1, -54, 0.5, -12)
	swBtn.BackgroundColor3 = defaultVal and Themes[Config.CurrentTheme].Accent or Color3.fromRGB(52, 52, 64)
	swBtn.Text = ""
	swBtn.AutoButtonColor = false
	Instance.new("UICorner", swBtn).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame", swBtn)
	knob.Size = UDim2.new(0, 20, 0, 20)
	knob.Position = defaultVal and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local state = defaultVal or false
	if state then
		Config.ActiveCount = Config.ActiveCount + 1
		ActiveTrackFills[swBtn] = true
		RefreshActivePrivacyDot()
	end

	swBtn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			Config.ActiveCount = Config.ActiveCount + 1
			ActiveTrackFills[swBtn] = true
		else
			Config.ActiveCount = math.max(0, Config.ActiveCount - 1)
			ActiveTrackFills[swBtn] = nil
		end
		RefreshActivePrivacyDot()
		TweenService:Create(swBtn, TweenInfo.new(0.2), {
			BackgroundColor3 = state and Themes[Config.CurrentTheme].Accent or Color3.fromRGB(52, 52, 64)
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
		}):Play()
		Notify(title .. (state and " 已开启" or " 已关闭"), state and Color3.fromRGB(48, 209, 88) or Color3.fromRGB(255, 159, 10))
		callback(state)
	end)
end

