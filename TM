-- ==================== 17. 主循环引擎 (60FPS 物理/渲染/音频/实用功能) ====================
local fpsCounter, lastTick, currentFPS = 0, tick(), 60
local freecamYaw, freecamPitch = 0, 0
local lastHistoryRecord = 0
local lastPanicTrigger = 0

RunService.RenderStepped:Connect(function(dt)
	fpsCounter = fpsCounter + 1
	if tick() - lastTick >= 0.5 then
		currentFPS = math.floor(fpsCounter / (tick() - lastTick))
		fpsCounter = 0
		lastTick = tick()
		MiniFPSLabel.Text = currentFPS .. "Hz"
		MiniTimeLabel.Text = os.date("%H:%M")

		local pingVal = 0
		pcall(function() pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		NetTileValue.Text = string.format("Ping: %dms | %d FPS", pingVal, currentFPS)

		if Config.IsExpanded and Pages["Server"].Visible then
			local pCount = #Players:GetPlayers()
			local maxP = Players.MaxPlayers
			SLabels["Players"].Text = pCount .. " / " .. maxP
			CapBarFill.Size = UDim2.new(math.clamp(pCount / math.max(maxP, 1), 0, 1), 0, 1, 0)
			SLabels["Ping"].Text = pingVal .. " ms"
			SLabels["FPS"].Text = currentFPS .. " FPS"
			local up = math.floor(workspace.DistributedGameTime)
			SLabels["Uptime"].Text = string.format("%02d:%02d:%02d", math.floor(up/3600), math.floor((up%3600)/60), up%60)
			SLabels["Memory"].Text = math.floor(Stats:GetTotalMemoryUsageMb()) .. " MB"
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				SLabels["Pos"].Text = string.format("%d,%d,%d", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
			end
		end
	end

	-- 秒表跳动
	if swRunning then
		swElapsed = swElapsed + dt
		SWLabel.Text = string.format("⏱️ 秒表: %02d:%04.1f", math.floor(swElapsed / 60), swElapsed % 60)
	end

	-- 灵动岛流光边框旋转
	StrokeGrad.Rotation = (StrokeGrad.Rotation + 85 * dt) % 360

	-- 音乐黑胶旋转与频谱律动
	if Config.MusicPlaying and MusicSound.IsPlaying then
		AlbumArt.Rotation = (AlbumArt.Rotation + 95 * dt) % 360
		MiniDisk.Rotation = (MiniDisk.Rotation + 95 * dt) % 360
		local loudness = math.clamp(MusicSound.PlaybackLoudness / 380, 0.15, 1)
		for i, bar in ipairs(MiniBars) do
			local h = math.clamp(4 + math.sin(tick() * 14 + i) * 10 * loudness, 3, 15)
			bar.Size = UDim2.new(0, 3, 0, h)
		end
		for i, w in ipairs(WaveBars) do
			local h = math.clamp(6 + math.cos(tick() * 16 + i * 1.4) * 24 * loudness, 4, 30)
			w.Size = UDim2.new(0, 5, 0, h)
		end
		if MusicSound.TimeLength > 0 then
			local ratio = math.clamp(MusicSound.TimePosition / MusicSound.TimeLength, 0, 1)
			ProgressFill.Size = UDim2.new(ratio, 0, 1, 0)
			local cur, tot = math.floor(MusicSound.TimePosition), math.floor(MusicSound.TimeLength)
			TimeLeftLbl.Text = string.format("%02d:%02d / %02d:%02d", math.floor(cur/60), cur%60, math.floor(tot/60), tot%60)
		end
	end

	-- 角色物理与强化逻辑
	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")

		if hum and hrp then
			-- 1. V9新增：记录 3 秒时光倒流轨迹 (每0.1秒采样一次，保留30帧即3秒)
			if tick() - lastHistoryRecord >= 0.1 then
				lastHistoryRecord = tick()
				table.insert(Config.HistoryCFrames, hrp.CFrame)
				if #Config.HistoryCFrames > 30 then
					table.remove(Config.HistoryCFrames, 1)
				end
			end

			-- 2. V9新增：手持工具自动连点
			if Config.AutoClickTool then
				local heldTool = char:FindFirstChildOfClass("Tool")
				if heldTool then
					pcall(function() heldTool:Activate() end)
				end
			end

			-- 3. V9新增：濒死自动升空逃生 (HP < 28%)
			if Config.PanicEscape and hum.Health > 0 and (hum.Health / math.max(hum.MaxHealth, 1)) < 0.28 and (tick() - lastPanicTrigger > 6) then
				lastPanicTrigger = tick()
				local safePos = hrp.Position + Vector3.new(0, 85, 0)
				local safePod = Instance.new("Part")
				safePod.Size = Vector3.new(18, 1.2, 18)
				safePod.Position = safePos - Vector3.new(0, 3.5, 0)
				safePod.Anchored = true
				safePod.Material = Enum.Material.Neon
				safePod.Color = Color3.fromRGB(48, 209, 88)
				safePod.Transparency = 0.35
				safePod.Parent = workspace
				hrp.Velocity = Vector3.zero
				hrp.CFrame = CFrame.new(safePos)
				Notify("🚑 濒死自动逃生触发！已升空保命", Color3.fromRGB(255, 55, 95))
			end

			-- 4. V9新增：踏水而行模式
			if Config.WalkOnWater then
				local pad = workspace:FindFirstChild("IslandWaterPad")
				if not pad then
					pad = Instance.new("Part")
					pad.Name = "IslandWaterPad"
					pad.Size = Vector3.new(10, 0.6, 10)
					pad.Anchored = true
					pad.Material = Enum.Material.Glass
					pad.Color = Color3.fromRGB(0, 199, 190)
					pad.Transparency = 0.55
					pad.Parent = workspace
				end
				if hum:GetState() == Enum.HumanoidStateType.Swimming then
					hrp.Velocity = Vector3.new(hrp.Velocity.X, 22, hrp.Velocity.Z)
				end
				pad.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.3, hrp.Position.Z)
			end

			-- 5. 移速与跳跃锁定
			if Config.UseCustomSpeed then hum.WalkSpeed = Config.Speed end
			if Config.UseCustomJump then
				hum.UseJumpPower = true
				hum.JumpPower = Config.Jump
			end

			-- 6. 防掉虚空自动救援
			if Config.AntiVoid then
				if hum.FloorMaterial ~= Enum.Material.Air and hrp.Position.Y > (workspace.FallenPartsDestroyHeight + 65) then
					Config.LastSafeCFrame = hrp.CFrame
				end
				if hrp.Position.Y < (workspace.FallenPartsDestroyHeight + 45) and Config.LastSafeCFrame then
					hrp.Velocity = Vector3.zero
					hrp.CFrame = Config.LastSafeCFrame + Vector3.new(0, 4, 0)
					Notify("🛟 防掉虚空已将您救回安全陆地！", Color3.fromRGB(48, 209, 88))
				end
			end

			-- 7. 防撞飞保护
			if Config.AntiFling then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						for _, part in ipairs(p.Character:GetDescendants()) do
							if part:IsA("BasePart") then part.CanCollide = false end
						end
					end
				end
				if hrp.RotVelocity.Magnitude > 50 or hrp.Velocity.Magnitude > 250 then
					hrp.RotVelocity = Vector3.zero
					hrp.Velocity = Vector3.zero
				end
			end

			-- 8. V9新增：头顶骑乘目标玩家
			if Config.PiggybackTarget and Config.PiggybackTarget.Character and Config.PiggybackTarget.Character:FindFirstChild("HumanoidRootPart") then
				local tHrp = Config.PiggybackTarget.Character.HumanoidRootPart
				hum.Sit = true
				hrp.Velocity = Vector3.zero
				hrp.CFrame = tHrp.CFrame * CFrame.new(0, 3.2, 0)
			elseif Config.PiggybackTarget then
				Config.PiggybackTarget = nil
			end

			-- 9. 环绕目标玩家
			if Config.OrbitTarget and Config.OrbitTarget.Character and Config.OrbitTarget.Character:FindFirstChild("HumanoidRootPart") then
				Config.OrbitAngle = Config.OrbitAngle + dt * 4.5
				local tPos = Config.OrbitTarget.Character.HumanoidRootPart.Position
				local offset = Vector3.new(math.cos(Config.OrbitAngle) * 7, 2, math.sin(Config.OrbitAngle) * 7)
				hrp.CFrame = CFrame.new(tPos + offset, tPos)
				hrp.Velocity = Vector3.zero
			elseif Config.OrbitTarget then
				Config.OrbitTarget = nil
			end

			-- 10. 灵魂自由视角 (Freecam)
			if Config.Freecam then
				local moveDir = hum.MoveDirection
				local camCF = Camera.CFrame
				local upVec = Vector3.new(0, Config.VerticalInput, 0)
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then upVec = Vector3.new(0, 1, 0) end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then upVec = Vector3.new(0, -1, 0) end
				local delta = UserInputService:GetMouseDelta()
				freecamYaw = freecamYaw - delta.X * 0.004
				freecamPitch = math.clamp(freecamPitch - delta.Y * 0.004, -1.4, 1.4)
				local rotCF = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
				local nextPos = camCF.Position + (moveDir + upVec) * (Config.FlySpeed * dt * 1.4)
				Camera.CFrame = CFrame.new(nextPos) * rotCF
			end

			-- 11. 摇杆/键盘全向飞行
			if Config.Fly and not Config.Freecam then
				local moveDir = hum.MoveDirection
				local camLook = Camera.CFrame.LookVector
				local vInput = Config.VerticalInput
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vInput = 1 end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vInput = -1 end
				local vel = Vector3.zero
				if moveDir.Magnitude > 0 then
					vel = (moveDir + Vector3.new(0, camLook.Y, 0)).Unit * Config.FlySpeed
				end
				vel = vel + Vector3.new(0, vInput * Config.FlySpeed, 0)
				hrp.Velocity = vel
			end

			-- 12. 虚空踏空漫步
			if Config.AirWalk then
				Config.AirWalkY = Config.AirWalkY + Config.VerticalInput * (dt * 22)
				local airPart = workspace:FindFirstChild("IslandAirPart")
				if not airPart then
					airPart = Instance.new("Part")
					airPart.Name = "IslandAirPart"
					airPart.Size = Vector3.new(9, 0.6, 9)
					airPart.Anchored = true
					airPart.Material = Enum.Material.Neon
					airPart.Transparency = 0.45
					airPart.Parent = workspace
				end
				airPart.Color = Themes[Config.CurrentTheme].Accent
				airPart.CFrame = CFrame.new(hrp.Position.X, Config.AirWalkY, hrp.Position.Z)
			end

			-- 13. 蜘蛛自动爬墙
			if Config.SpiderClimb then
				local params = RaycastParams.new()
				params.FilterDescendantsInstances = { char }
				params.FilterType = Enum.RaycastFilterType.Exclude
				local hit = workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 2.8, params)
				if hit then
					hrp.Velocity = Vector3.new(hrp.Velocity.X, 34, hrp.Velocity.Z)
				end
			end

			-- 14. 自动吸取周围掉落物
			if Config.AutoCollect and firetouchinterest then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
						if (obj.Parent.Position - hrp.Position).Magnitude <= 35 then
							pcall(function()
								firetouchinterest(hrp, obj.Parent, 0)
								firetouchinterest(hrp, obj.Parent, 1)
							end)
						end
					end
				end
			end

			-- 15. 陀螺旋转
			if Config.SpinBot then
				hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(28), 0)
			end
		end

		if Config.Noclip then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end

	-- 极昼夜视与锁定时间保持
	if Config.Fullbright then
		Lighting.Brightness = 2.5
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(255, 255, 255)
	elseif Config.LockTime then
		Lighting.ClockTime = Config.CustomClockTime
	end

	if Config.NoFog then
		Lighting.FogEnd = 100000
	end

	-- 全息视觉 ESP (轮廓 + 头顶名片 + 追踪激光)
	local myHrp = char and char:FindFirstChild("HumanoidRootPart")
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local tChar = p.Character
			local tHrp = tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar:FindFirstChildOfClass("Humanoid")

			if Config.ESP then
				local hl = tChar:FindFirstChild("IslandESP")
				if not hl then
					hl = Instance.new("Highlight", tChar)
					hl.Name = "IslandESP"
					hl.FillTransparency = 0.55
				end
				hl.FillColor = Themes[Config.CurrentTheme].Accent
			end

			if Config.NameESP and tHrp and tHum then
				local bg = tChar:FindFirstChild("IslandNameTag")
				if not bg then
					bg = Instance.new("BillboardGui", tChar)
					bg.Name = "IslandNameTag"
					bg.Size = UDim2.new(0, 150, 0, 36)
					bg.StudsOffset = Vector3.new(0, 3.4, 0)
					bg.AlwaysOnTop = true
					local txt = Instance.new("TextLabel", bg)
					txt.Name = "TagLbl"
					txt.Size = UDim2.new(1, 0, 1, 0)
					txt.BackgroundTransparency = 1
					txt.Font = Enum.Font.GothamBold
					txt.TextSize = 11
					txt.TextStrokeTransparency = 0.3
				end
				bg.Adornee = tHrp
				local dist = myHrp and math.floor((tHrp.Position - myHrp.Position).Magnitude) or 0
				local hp = math.floor((tHum.Health / math.max(tHum.MaxHealth, 1)) * 100)
				bg.TagLbl.Text = string.format("%s [%dm]\n❤️ %d%%", p.DisplayName, dist, hp)
				bg.TagLbl.TextColor3 = Themes[Config.CurrentTheme].Accent
			end

			if Config.TracerESP and myHrp and tHrp then
				local beam = tChar:FindFirstChild("IslandTracer")
				if not beam then
					beam = Instance.new("Beam", tChar)
					beam.Name = "IslandTracer"
					beam.FaceCamera = true
					beam.Width0 = 0.09
					beam.Width1 = 0.09
					local a0 = Instance.new("Attachment", myHrp)
					a0.Name = "TracerA0"
					local a1 = Instance.new("Attachment", tHrp)
					a1.Name = "TracerA1"
					beam.Attachment0 = a0
					beam.Attachment1 = a1
				end
				beam.Color = ColorSequence.new(Themes[Config.CurrentTheme].Accent)
			end
		end
	end
end)

