    sLbl.Font = Enum.Font.Gotham
    sLbl.TextSize = 10
    sLbl.TextXAlignment = Enum.TextXAlignment.Left
    sLbl.Parent = card

    -- 真实 iOS Toggle Switch 胶囊开关
    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 36, 0, 20)
    switchBg.AnchorPoint = Vector2.new(1, 0.5)
    switchBg.Position = UDim2.new(1, -10, 0.5, 0)
    switchBg.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
    switchBg.Parent = card
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = switchBg
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local active = false
    card.Activated:Connect(function()
        active = not active
        if active then
            TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(48, 209, 88)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -18, 0.5, 0)}):Play()
            sLbl.TextColor3 = Color3.fromRGB(100, 225, 140)
        else
            TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55, 55, 68)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
            sLbl.Text = defaultSub
            sLbl.TextColor3 = Color3.fromRGB(140, 140, 155)
        end
        onToggle(active, sLbl, switchBg, knob)
    end)
end

