local ActiveTabId = "Control"

local function SwitchTab(tabId)
	ActiveTabId = tabId
	PlayClickSound(1.15)
	for id, page in pairs(Pages) do
		page.Visible = (id == tabId)
	end
	for idx, tabInfo in ipairs(Tabs) do
		local btn = TabButtons[tabInfo.Id]
		local isSelected = (tabInfo.Id == tabId)
		if isSelected then
			TweenService:Create(TabIndicator, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Position = UDim2.new((idx - 1) / #Tabs, 2, 0, 3),
				BackgroundColor3 = Themes[CurrentThemeIndex].Accent
			}):Play()
		end
		TweenService:Create(btn, TweenInfo.new(0.2), {
			TextColor3 = isSelected and Color3.fromRGB(10, 10, 14) or Color3.fromRGB(185, 185, 195)
		}):Play()
	end
end

for _, tab in ipairs(Tabs) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1 / #Tabs, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = tab.Title
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 11
	btn.AutoButtonColor = false
	btn.ZIndex = 15
	btn.Parent = TabContainer
	btn.MouseButton1Click:Connect(function() SwitchTab(tab.Id) end)
	TabButtons[tab.Id] = btn

	local page = Instance.new("ScrollingFrame")
	page.Name = tab.Id .. "Page"
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = Themes[1].Accent
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.Visible = false
	page.ZIndex = 13
	page.Parent = PageContainer
	Pages[tab.Id] = page
end

