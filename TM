local function CreateFlyPadBtn(text, posY, val)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 50)
	btn.Position = UDim2.new(0, 0, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
	btn.BackgroundTransparency = 0.25
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.Parent = FlyControlPad
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 16)
	local st = Instance.new("UIStroke", btn)
	st.Color = Themes[1].Accent
	st.Thickness = 1.4
	st.Transparency = 0.3

	btn.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			Config.VerticalInput = val
			btn.BackgroundColor3 = Themes[Config.CurrentTheme].Accent
		end
	end)
	btn.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			if Config.VerticalInput == val then
				Config.VerticalInput = 0
			end
			btn.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
		end
	end)
	return btn
end
