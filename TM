local function CreateQuickTile(icon, title, isToggle, callback)
	local tile = Instance.new("TextButton")
	tile.Size = UDim2.new(0.25, -5, 1, 0)
	tile.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
	tile.Text = icon .. "\n" .. title
	tile.TextColor3 = Color3.fromRGB(225, 225, 235)
	tile.Font = Enum.Font.GothamBold
	tile.TextSize = 10
	tile.AutoButtonColor = false
	tile.ZIndex = 15
	tile.Parent = QuickGridRow
	Instance.new("UICorner", tile).CornerRadius = UDim.new(0, 11)

	local active = false
	tile.MouseButton1Click:Connect(function()
		if isToggle then
			active = not active
			PlayClickSound(active and 1.2 or 0.9)
			TweenService:Create(tile, TweenInfo.new(0.2), {
				BackgroundColor3 = active and Themes[CurrentThemeIndex].Accent or Color3.fromRGB(26, 26, 36),
				TextColor3 = active and Color3.fromRGB(10, 10, 14) or Color3.fromRGB(225, 225, 235)
			}):Play()
			callback(active, tile)
		else
			PlayClickSound(1.2)
			TweenService:Create(tile, TweenInfo.new(0.12), {BackgroundColor3 = Themes[CurrentThemeIndex].Accent, TextColor3 = Color3.fromRGB(10, 10, 14)}):Play()
			task.delay(0.2, function()
				TweenService:Create(tile, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(26, 26, 36), TextColor3 = Color3.fromRGB(225, 225, 235)}):Play()
			end)
			callback(true, tile)
		end
	end)
	return tile
end

