local dragging, dragStart, startPos = false, nil, nil
local movedDistance = 0

local function StartDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local relY = input.Position.Y - Island.AbsolutePosition.Y
		if not Config.Expanded or relY <= 38 then
			dragging = true
			movedDistance = 0
			dragStart = input.Position
			startPos = Island.Position
		end
	end
end

Island.InputBegan:Connect(StartDrag)
CompactView.InputBegan:Connect(StartDrag)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		movedDistance = delta.Magnitude
		local vp = Camera.ViewportSize
		local halfW = (Island.AbsoluteSize.X * 0.5)
		local newX = math.clamp(startPos.X.Scale * vp.X + startPos.X.Offset + delta.X, halfW + 6, vp.X - halfW - 6)
		local newY = math.clamp(startPos.Y.Scale * vp.Y + startPos.Y.Offset + delta.Y, 6, vp.Y - 46)
		local targetPos = UDim2.new(0, newX, 0, newY)
		Island.Position = targetPos
		AmbientGlow.Position = targetPos
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

CompactView.MouseButton1Click:Connect(function()
	if movedDistance < 10 then
		SetIslandState(true)
	end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if not gp and input.KeyCode == Enum.KeyCode.RightShift then
		SetIslandState(not Config.Expanded)
	end
end)

