-- 测试按钮示例
local function createBtn(name, yOffset)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.8,0,0,32)
    btn.AnchorPoint = Vector2.new(0.5,0)
    btn.Position = UDim2.new(0.5, 0, 0, yOffset)
    btn.BackgroundColor3 = Color3.fromRGB(55,55,55)
    btn.Text = name
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.CornerRadius = UDim.new(0.12,0)
    btn.Parent = MainPanel
    btn.MouseButton1Click:Connect(function()
        print("点击了："..name)
    end)
    return btn
end

createBtn("测试功能A", 46)
createBtn("测试功能B", 84)
createBtn("测试功能C", 122)
createBtn("关闭面板", 160).MouseButton1Click:Connect(function()
    MainPanel.Visible = false
end)

-- 动画变量
local isOpen = false
local TweenService = game:GetService("TweenService")
local tweenInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- 灵动岛点击事件
IslandFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isOpen = not isOpen
        if isOpen then
            -- 灵动岛放大一点 + 显示面板
            TweenService:Create(IslandFrame, tweenInfo, {Size = UDim2.new(0,110,0,30)}):Play()
            MainPanel.Visible = true
        else
            -- 还原灵动岛 + 隐藏面板
            TweenService:Create(IslandFrame, tweenInfo, {Size = UDim2.new(0,90,0,26)}):Play()
            MainPanel.Visible = false
        end
    end
end)
