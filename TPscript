local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 1. 创建灵动岛的主容器 (胶囊形状)
local islandFrame = Instance.new("Frame")
islandFrame.Name = "DynamicIsland"
islandFrame.Parent = script.Parent
islandFrame.AnchorPoint = Vector2.new(0.5, 0) -- 顶部居中
islandFrame.Position = UDim2.new(0.5, 0, 0, 10)
islandFrame.Size = UDim2.new(0, 120, 0, 36) -- 收起时的尺寸
islandFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
islandFrame.BackgroundTransparency = 0.1
islandFrame.BorderSizePixel = 0
islandFrame.ClipsDescendants = true -- 关键：裁剪子元素以实现圆角效果

-- 圆角 (胶囊形状)
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0) -- 完全圆角
corner.Parent = islandFrame

-- 2. 创建内部内容 (例如：状态指示点 + 文本)
local statusDot = Instance.new("Frame")
statusDot.Name = "StatusDot"
statusDot.Parent = islandFrame
statusDot.Size = UDim2.new(0, 8, 0, 8)
statusDot.Position = UDim2.new(0, 16, 0.5, -4)
statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- 绿色表示"活跃"
statusDot.BorderSizePixel = 0
Instance.new("UICorner", statusDot).CornerRadius = UDim.new(1, 0)

local label = Instance.new("TextLabel")
label.Name = "StatusLabel"
label.Parent = islandFrame
label.Size = UDim2.new(1, -40, 1, 0)
label.Position = UDim2.new(0, 28, 0, 0)
label.BackgroundTransparency = 1
label.Text = "就绪"
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.TextXAlignment = Enum.TextXAlignment.Left
label.Font = Enum.Font.GothamMedium
label.TextSize = 14

-- 3. 展开/收起动画逻辑
local isExpanded = false
local collapsedSize = UDim2.new(0, 120, 0, 36)
local expandedSize = UDim2.new(0, 300, 0, 90) -- 展开后的尺寸

local function toggleIsland()
    isExpanded = not isExpanded
    local targetSize = isExpanded and expandedSize or collapsedSize
    
    -- 使用 TweenService 实现平滑动画
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local tween = TweenService:Create(islandFrame, tweenInfo, {Size = targetSize})
    tween:Play()
    
    -- 更新文本内容作为演示
    if isExpanded then
        label.Text = "正在播放 · 灵动岛演示"
        statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 255) -- 展开时变为青色
    else
        label.Text = "就绪"
        statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    end
end

-- 点击切换
islandFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggleIsland()
    end
end)

-- 4. (可选) 示例：让灵动岛显示实时时间
local function updateTime()
    while true do
        local currentTime = os.date("%H:%M")
        if not isExpanded then
            -- 收起状态下，可以用时间替换“就绪”文本，更贴近真实灵动岛
            label.Text = currentTime 
        end
        task.wait(1)
    end
end

task.spawn(updateTime)

