local views = { InfoView, ListView, ActionView, ThemeView }
setActiveView = function(view)
    for _, v in ipairs(views) do v.Visible = false end
    view.Visible = true
    for _, item in ipairs(categoryButtons) do
        if item.view == view then
            item.btn.BackgroundColor3 = themes[currentThemeIndex].accent
        else
            item.btn.BackgroundColor3 = themes[currentThemeIndex].btn
        end
    end
end

applyTheme = function(index)
    currentThemeIndex = index
    local t = themes[index]
    MainWindow.BackgroundColor3 = t.main
    LeftBar.BackgroundColor3 = t.side
    RightPanel.BackgroundColor3 = t.content
    RespawnBtn.BackgroundColor3 = t.btn
    RejoinBtn.BackgroundColor3 = t.btn
    for _, item in ipairs(categoryButtons) do
        local active = false
        for _, v in ipairs(views) do
            if v.Visible and item.view == v then active = true end
        end
        item.btn.BackgroundColor3 = active and t.accent or t.btn
    end
end

