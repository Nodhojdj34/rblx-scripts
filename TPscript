-- 拖拽逻辑 + 边界限制
local dragging = false
local dragStart
local startPos
DragHandle.MouseButton1Down:Connect(function(x,y)
    dragging = true
    dragStart = Vector2.new(x,y)
    startPos = MainPanel.Position
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        local newX = startPos.X.Offset + delta.X
        local newY = startPos.Y.Offset + delta.Y
        local minX = MainPanel.Size.X.Offset / 2
        local maxX = workspace.CurrentCamera.ViewportSize.X - minX
        local minY = MainPanel.Size.Y.Offset / 2
        local maxY = workspace.CurrentCamera.ViewportSize.Y - MainPanel.Size.Y.Offset / 2
        newX = math.clamp(newX, minX, maxX)
        newY = math.clamp(newY, minY, maxY)
        MainPanel.Position = UDim2.new(0, newX, 0, newY)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

