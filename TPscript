local function createActionBtn(parent, textStr, yPos, isToggle, callback, initialState)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 38); btn.Position = UDim2.new(0, 0, 0, yPos)
	btn.BackgroundColor3 = (isToggle and initialState) and THEME.Success or (isToggle and THEME.BgPanel or THEME.Accent)
	btn.Text = textStr .. (isToggle and (initialState and " : 开启" or " : 关闭") or "")
	btn.TextColor3 = THEME.TextWhite; btn.Font = Enum.Font.GothamBold; btn.TextSize = 14
	btn.Parent = parent; btn:SetAttribute("BaseZ", 2)
	btn:SetAttribute("IsAccentBtn", not isToggle) -- 标记为强调色按钮，方便换色
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
	
	local state = initialState or false
	if isToggle then btn:SetAttribute("IsActive", state) end
	
	btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = state and THEME.Success or (isToggle and Color3.fromRGB(50,50,65) or THEME.Accent:Lerp(Color3.new(1,1,1), 0.2))}):Play() end)
	btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = state and THEME.Success or (isToggle and THEME.BgPanel or THEME.Accent)}):Play() end)
	
	btn.Activated:Connect(function()
		if isToggle then
			state = not state
			btn.BackgroundColor3 = state and THEME.Success or THEME.BgPanel
			btn.Text = textStr .. (state and " : 开启" or " : 关闭")
			btn:SetAttribute("IsActive", state)
			playSound(sndToggle)
		else
			playSound(sndClick)
		end
		callback(state, btn)
	end)
	
	btn:GetAttributeChangedSignal("IsActive"):Connect(function()
		local active = btn:GetAttribute("IsActive")
		if active ~= state and isToggle then
			state = active; btn.BackgroundColor3 = state and THEME.Success or THEME.BgPanel
			btn.Text = textStr .. (state and " : 开启" or " : 关闭")
		end
	end)
	return btn
end

local function createSlider(parent, textStr, minVal, maxVal, defaultVal, yPos, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 45); container.Position = UDim2.new(0, 0, 0, yPos)
	container.BackgroundTransparency = 1; container.Parent = parent; container:SetAttribute("BaseZ", 2)

