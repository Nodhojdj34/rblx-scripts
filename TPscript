-- 灵动岛开关（防抖，避免多事件重复触发导致来回切换）
local function toggleIsland()
    local now = os.clock()
    if now - lastToggle < 0.25 then return end
    lastToggle = now
    if isOpen then closeMainWindow() else openMainWindow() end
end

IslandBtn.Activated:Connect(toggleIsland)
IslandBtn.MouseButton1Click:Connect(toggleIsland)
IslandBtn.MouseButton1Down:Connect(toggleIsland)

-- 坐标命中兜底：原生按钮事件失效时，用触摸/鼠标位置判断是否点在岛上
local function hitIsland(pos)
    local p = IslandBtn.AbsolutePosition
    local s = IslandBtn.AbsoluteSize
    return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

-- 快捷键 + 灵动岛坐标命中兜底
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1)
        and hitIsland(input.Position) then
        toggleIsland()
        return
    end
    if input.KeyCode == Enum.KeyCode.F1 then
        if isOpen then closeMainWindow() else openMainWindow() end
    elseif input.KeyCode == Enum.KeyCode.F2 then
        flyEnabled = not flyEnabled
        FlyBtn.Text = flyEnabled and "飞行：开启" or "飞行：关闭"
        styleToggle(FlyBtn, flyEnabled)
    elseif input.KeyCode == Enum.KeyCode.F3 then
        invisible = not invisible
        InvisBtn.Text = invisible and "隐身：开启" or "隐身：关闭"
        styleToggle(InvisBtn, invisible)
        applyInvisibility()
    end
end)

