local function styleToggle(btn, on)
    if on then
        btn.BackgroundColor3 = COLOR.accent
        if btn._stroke then btn._stroke.Color = COLOR.accent2 end
    else
        btn.BackgroundColor3 = COLOR.btn
        if btn._stroke then btn._stroke.Color = COLOR.stroke end
    end
end

-- 功能按钮工厂：按钮自身为实体背景，内部不放置可拦截的子元素
local function makeFuncButton(name, y, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 230, 0, 40)
    btn.Position = UDim2.new(0.5, 0, 0, y)
    btn.AnchorPoint = Vector2.new(0.5, 0)
    btn.BackgroundColor3 = COLOR.btn
    btn.BackgroundTransparency = 0
    btn.Text = name
    btn.TextColor3 = COLOR.text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.Active = true
    btn.ZIndex = 2
    btn.Parent = FuncView
    addCorner(btn, UDim.new(0.16, 0))
    btn._stroke = addStroke(btn, COLOR.stroke, 1)
    btn.Activated:Connect(callback)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

