local currentZIndex = 50
local windowCount = 0

local function bringToFront(win)
	currentZIndex = currentZIndex + 1
	if currentZIndex > 5000 then currentZIndex = 50 end
	win.ZIndex = currentZIndex
	for _, child in ipairs(win:GetDescendants()) do
		if child:IsA("GuiObject") then
			if child:GetAttribute("BaseZ") then child.ZIndex = currentZIndex + child:GetAttribute("BaseZ") 
			else child.ZIndex = currentZIndex + 1 end
		end
	end
end

local function makeDraggable(frame, dragArea)
	local dragging, dragStart, startPos
	dragArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = frame.Position
			bringToFront(frame)
			input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

local function makeResizable(frame, resizeGrip)
	local resizing, resizeStart, startSize
	resizeGrip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true; resizeStart = input.Position; startSize = frame.AbsoluteSize
			bringToFront(frame)
			input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then resizing = false end end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - resizeStart
			local newWidth = math.max(300, startSize.X + delta.X)
			local newHeight = math.max(200, startSize.Y + delta.Y)
			frame.Size = UDim2.fromOffset(newWidth, newHeight)
		end
	end)
end

