-- 刷新玩家列表函数
local function RefreshPlayerList()
    -- 清空旧条目
    for _,v in pairs(ScrollFrame:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        local entry = Instance.new("Frame")
        entry.Size = UDim2.new(1,0,0,52)
        entry.BackgroundColor3 = Color3.fromRGB(32,32,32)
        entry.CornerRadius = UDim.new(0.06,0)
        entry.Parent = ScrollFrame

        local char = plr.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local dist = hrp and math.floor((hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude) or "N/A"
        local hp = hum and math.floor(hum.Health) or "N/A"
        local maxHp = hum and math.floor(hum.MaxHealth) or "N/A"
        local teamName = plr.Team and plr.Team.Name or "无队伍"
        local hasChar = char and "✅已加载" or "❌无角色"

        local infoText = Instance.new("TextLabel")
        infoText.Size = UDim2.new(1,-10,1,0)
        infoText.Position = UDim2.new(0,5,0,0)
        infoText.BackgroundTransparency = 1
        infoText.TextColor3 = Color3.new(1,1,1)
        infoText.Font = Enum.Font.Gotham
        infoText.TextSize = 11
        infoText.Text = string.format(
            "【%s】ID:%d\nHP:%s/%s | 距离:%s studs\n队伍:%s | %s",
            plr.Name, plr.UserId, hp, maxHp, dist, teamName, hasChar
        )
        infoText.TextXAlignment = Enum.TextXAlignment.Left
        infoText.Parent = entry
    end
    ScrollFrame.CanvasSize = UDim2.new(0,0,0, UIListLayout.AbsoluteContentSize.Y)
end

-- 自动刷新循环
task.spawn(function()
    while task.wait(1.2) do
        if PlayerListWindow.Visible then
            RefreshPlayerList()
        end
    end
end)

-- 生成按钮函数
local function createBtn(name, yOffset, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.8,0,0,32)
    btn.AnchorPoint = Vector2.new(0.5, 0)
    btn.Position = UDim2.new(0.5, 0, 0, yOffset)
    btn.BackgroundColor3 = Color3.fromRGB(55,55,55)
    btn.Text = name
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.CornerRadius = UDim.new(0.12,0)
    btn.Parent = MainPanel
    btn.MouseButton1Click:Connect(callback)
    return btn
end

