setActiveView = function(view)
    for _, v in ipairs(views) do v.Visible = false end
    view.Visible = true
    local accent = useCustomAccent and customAccent or themes[currentThemeIndex].accent
    local base = themes[currentThemeIndex].btn
    for _, item in ipairs(categoryButtons) do
        item.btn.BackgroundColor3 = (item.view == view) and accent or base
    end
end

applyTheme = function(index)
    currentThemeIndex = index
    useCustomAccent = false
    local t = themes[index]
    MainWindow.BackgroundColor3 = t.main
    LeftBar.BackgroundColor3 = t.side
    RightPanel.BackgroundColor3 = t.content
    TitleBar.BackgroundColor3 = t.side
    FlyBtn.BackgroundColor3 = t.btn
    AntiKbBtn.BackgroundColor3 = t.btn
    InvisBtn.BackgroundColor3 = t.btn
    HealBtn.BackgroundColor3 = t.btn
    TeleportBtn.BackgroundColor3 = t.btn
    ResetBtn.BackgroundColor3 = t.btn
    BrightBox.BackgroundColor3 = t.btn
    for _, item in ipairs(categoryButtons) do
        local active = item.view.Visible
        item.btn.BackgroundColor3 = active and t.accent or t.btn
    end
end

