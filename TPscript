local function RefreshPlayerList()
    local ok, err = pcall(function()
        for _, v in pairs(ScrollFrame:GetChildren()) do
            if v:IsA("Frame") then v:Destroy() end
        end

        local localRoot = nil
        if LocalPlayer.Character then
            localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        end

        local players = Players:GetPlayers()
        for _, plr in ipairs(players) do
            local char = plr.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            local dist = "N/A"
            if hrp and localRoot then
                dist = tostring(math.floor((hrp.Position - localRoot.Position).Magnitude))
            end
            local hp = hum and tostring(math.floor(hum.Health)) or "N/A"
            local maxHp = hum and tostring(math.floor(hum.MaxHealth)) or "N/A"
            local teamName = (plr.Team and plr.Team.Name) or "无队伍"
            local hasChar = char and "已加载" or "无角色"
            local tag = (plr == LocalPlayer) and "（自己）" or ""

            local entry = Instance.new("Frame")
            entry.Size = UDim2.new(1, 0, 0, 56)
            entry.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
            entry.CornerRadius = UDim.new(0.06, 0)
            entry.ZIndex = 21
            entry.Parent = ScrollFrame

            local infoText = Instance.new("TextLabel")
            infoText.Size = UDim2.new(1, -12, 1, -8)
            infoText.Position = UDim2.new(0, 6, 0, 4)
            infoText.BackgroundTransparency = 1
            infoText.TextColor3 = Color3.new(1, 1, 1)
            infoText.Font = Enum.Font.Gotham
            infoText.TextSize = 11
            infoText.TextWrapped = true
            infoText.Text = string.format(
                "【%s】%s ID:%d\nHP:%s/%s | 距离:%s studs\n队伍:%s | %s",
                plr.Name, tag, plr.UserId, hp, maxHp, dist, teamName, hasChar
            )
            infoText.TextXAlignment = Enum.TextXAlignment.Left
            infoText.TextYAlignment = Enum.TextYAlignment.Top
            infoText.ZIndex = 22
            infoText.Parent = entry
        end

        PLDrag.Text = string.format("服务器玩家列表 | 共 %d 人", #players)
    end)
    if not ok then
        warn("[玩家列表] 刷新出错：", err)
    end
end

local function setMainPanel(open)
    isOpen = open
    if open then
        MainPanel.Visible = true
        TweenService:Create(IslandFrame, tweenInfo, {Size = UDim2.new(0, 110, 0, 30)}):Play()
    else
        TweenService:Create(IslandFrame, tweenInfo, {Size = UDim2.new(0, 90, 0, 26)}):Play()
        task.delay(0.2, function()
            if not isOpen then MainPanel.Visible = false end
        end)
    end
end

local function createBtn(name, yOffset, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.8, 0, 0, 32)
    btn.AnchorPoint = Vector2.new(0.5, 0)
    btn.Position = UDim2.new(0.5, 0, 0, yOffset)
    btn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    btn.Text = name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.CornerRadius = UDim.new(0.12, 0)
    btn.ZIndex = 11
    btn.Parent = MainPanel
    btn.MouseButton1Click:Connect(callback)
    return btn
end

