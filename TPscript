addButton(MainPanel, "关闭菜单", 120, function()
    setMainPanel(false)
end)

setMainPanel = function(open)
    isOpen = open
    if open then
        MainPanel.Visible = true
        TweenService:Create(Island, tweenInfo, {Size = UDim2.new(0, 105, 0, 28)}):Play()
        IslandLabel.Text = "已点开"
    else
        MainPanel.Visible = false
        TweenService:Create(Island, tweenInfo, {Size = UDim2.new(0, 80, 0, 24)}):Play()
        IslandLabel.Text = "灵动岛"
    end
end

IslandClick.MouseButton1Click:Connect(function()
    setMainPanel(not isOpen)
end)

Players.PlayerAdded:Connect(function()
    if ListWindow.Visible then refreshPlayerList() end
end)
Players.PlayerRemoving:Connect(function()
    if ListWindow.Visible then refreshPlayerList() end
end)

task.spawn(function()
    while task.wait(1.2) do
        if InfoWindow.Visible then refreshServerInfo() end
        if ListWindow.Visible then refreshPlayerList() end
    end
end)
