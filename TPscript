-- ========== 数据刷新逻辑 ==========
local function refreshServerInfo()
    local ok, text = pcall(function()
        local playerCount = #Players:GetPlayers()
        local maxPlayers = Players.MaxPlayers or 0
        local pingMs = "N/A"
        local okPing, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
        if okPing and ping then
            pingMs = tostring(math.floor(ping * 1000)) .. " ms"
        end
        local isPrivate = (game.PrivateServerId and game.PrivateServerId ~= "")
        local serverType = isPrivate and "私人服" or "公开服"
        local privateId = (isPrivate and game.PrivateServerId) or "无"

        return string.format(
            "游戏名称：%s\nPlaceId：%d\n在线玩家：%d / %d\n服务器类型：%s\n私人服ID：%s\n本地 Ping：%s\n本地玩家：%s\n玩家 ID：%d",
            tostring(game.Name),
            game.PlaceId or 0,
            playerCount,
            maxPlayers,
            serverType,
            tostring(privateId),
            pingMs,
            LocalPlayer.Name,
            LocalPlayer.UserId
        )
    end)

    if ok then
        InfoText.Text = text
    else
        InfoText.Text = "信息读取失败：" .. tostring(text)
    end
end

local function refreshPlayerList()
    local ok, err = pcall(function()
        for _, v in pairs(ListScroll:GetChildren()) do
            if v:IsA("Frame") then v:Destroy() end
        end

        local localRoot = nil
        if LocalPlayer.Character then
            localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        end

        local list = Players:GetPlayers()
        for _, plr in ipairs(list) do
            local char = plr.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            local dist = "N/A"
            if hrp and localRoot then
                dist = tostring(math.floor((hrp.Position - localRoot.Position).Magnitude))
            end

            local hp = hum and tostring(math.floor(hum.Health)) or "N/A"
            local maxHp = hum and tostring(math.floor(hum.MaxHealth)) or "N/A"
            local teamName = (plr.Team and plr.Team.Name) or "无队伍"
            local hasChar = char and "已加载" or "无角色"
            local tag = (plr == LocalPlayer) and "（自己）" or ""

            local entry = Instance.new("Frame")
            entry.Size = UDim2.new(1, 0, 0, 56)
            entry.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
            entry.Parent = ListScroll
            addCorner(entry, UDim.new(0.06, 0))

            local info = Instance.new("TextLabel")
            info.Size = UDim2.new(1, -12, 1, -8)
            info.Position = UDim2.new(0, 6, 0, 4)
            info.BackgroundTransparency = 1
            info.TextColor3 = Color3.new(1, 1, 1)
            info.Font = Enum.Font.Gotham
            info.TextSize = 11
            info.TextWrapped = true
            info.TextXAlignment = Enum.TextXAlignment.Left
            info.TextYAlignment = Enum.TextYAlignment.Top
            info.Text = string.format(
                "【%s】%s ID:%d\nHP:%s/%s | 距离:%s studs\n队伍:%s | %s",
                plr.Name, tag, plr.UserId, hp, maxHp, dist, teamName, hasChar
            )
            info.Parent = entry
        end
    end)

    if not ok then
        warn("[玩家列表] 刷新出错：", err)
    end
end

-- ========== 关闭与灵动岛开关 ==========
local function closeMainWindow()
    isOpen = false
    MainWindow.Visible = false
    TweenService:Create(Island, tweenInfo, {Size = UDim2.new(0, 86, 0, 26)}):Play()
    IslandLabel.Text = "灵动岛"
end

local function openMainWindow()
    isOpen = true
    MainWindow.Visible = true
    TweenService:Create(Island, tweenInfo, {Size = UDim2.new(0, 110, 0, 30)}):Play()
    IslandLabel.Text = "已打开"
    refreshServerInfo()
    refreshPlayerList()
    setActiveView(InfoView)
end

CloseBtn.MouseButton1Click:Connect(closeMainWindow)

IslandClick.MouseButton1Click:Connect(function()
    if isOpen then
        closeMainWindow()
    else
        openMainWindow()
    end
end)

-- ========== 自动刷新 ==========
Players.PlayerAdded:Connect(function()
    if ListView.Visible then
        refreshPlayerList()
    end
end)

Players.PlayerRemoving:Connect(function()
    if ListView.Visible then
        refreshPlayerList()
    end
end)

task.spawn(function()
    while task.wait(1.2) do
        if MainWindow.Visible then
            refreshServerInfo()
            refreshPlayerList()
        end
    end
end)
