-- Roblox 极简灵动岛｜修复 CornerRadius 报错版本
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 删除旧UI防止重复生成
local old = PlayerGui:FindFirstChild("SimpleIsland")
if old then old:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SimpleIsland"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 999
ScreenGui.Parent = PlayerGui

local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local isOpen = false

-- 灵动岛胶囊
local Island = Instance.new("Frame")
Island.AnchorPoint = Vector2.new(0.5, 0)
Island.Position = UDim2.new(0.5,0,0,10)
Island.Size = UDim2.new(0,80,0,24)
Island.BackgroundColor3 = Color3.new(0,0,0)
Island.Parent = ScreenGui

-- ✅ 圆角单独加 UICorner（修复报错）
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1,0)
UICorner.Parent = Island

local Label = Instance.new("TextLabel")
Label.AnchorPoint = Vector2.new(0.5,0.5)
Label.Position = UDim2.new(0.5,0,0.5,0)
Label.Size = UDim2.new(0.85,0,0.7,0)
Label.BackgroundTransparency = 1
Label.Text = "灵动岛"
Label.TextColor3 = Color3.new(1,1,1)
Label.Font = Enum.Font.GothamBold
Label.TextSize = 11
Label.Parent = Island

-- 点击区域
local ClickBtn = Instance.new("TextButton")
ClickBtn.Size = UDim2.new(1,0,1,0)
ClickBtn.BackgroundTransparency = 1
ClickBtn.Text = ""
ClickBtn.Parent = Island

ClickBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    if isOpen then
        TweenService:Create(Island, tweenInfo, {Size = UDim2.new(0,105,0,28)}):Play()
        Label.Text = "已点开"
    else
        TweenService:Create(Island, tweenInfo, {Size = UDim2.new(0,80,0,24)}):Play()
        Label.Text = "灵动岛"
    end
end)
