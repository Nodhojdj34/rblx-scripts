-- ===================== 逻辑 =====================
local isOpen = false
local marqueeX, marqueePause = 0, 0
local islandTween, panelTween

local function formatTime(t)
    t = math.max(0, math.floor(t or 0))
    return string.format("%d:%02d", math.floor(t / 60), t % 60)
end

local function tweenIsland(targetSize)
    if islandTween then islandTween:Cancel() end
    islandTween = TweenService:Create(island,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Size = targetSize })
    islandTween:Play()
end

local function tweenPanel(targetSize, targetTransparency)
    if panelTween then panelTween:Cancel() end
    panelTween = TweenService:Create(panel,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Size = targetSize, BackgroundTransparency = targetTransparency })
    panelTween:Play()
    return panelTween
end

local function refreshIslandText()
    if isOpen then
        islandLabel.Text = "控制中心"
        islandLabel.Position = UDim2.new(0, 0, 0, 0)
        dot.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    elseif isPlaying then
        islandLabel.Text = "♪ " .. musicList[currentIndex].name .. "  ·  " .. musicList[currentIndex].artist
        dot.BackgroundColor3 = Color3.fromRGB(255, 120, 80)
        marqueeX = 0
        marqueePause = 1.0
        islandLabel.Position = UDim2.new(0, 0, 0, 0)
    else
        islandLabel.Text = os.date("%H:%M")
        islandLabel.Position = UDim2.new(0, 0, 0, 0)
        dot.BackgroundColor3 = Color3.fromRGB(0, 220, 120)
    end
end

local function updateMusicUI()
    local track = musicList[currentIndex]
    songNameLabel.Text = track.name
    artistLabel.Text = track.artist
    playPauseBtn.Text = isPlaying and "暂停" or "播放"
    playPauseBtn.BackgroundColor3 = isPlaying
        and Color3.fromRGB(0, 140, 220)
        or Color3.fromRGB(50, 50, 55)
    refreshIslandText()
end

local function loadTrack(index, autoplay)
    currentIndex = index
    sound:Stop()
    sound.TimePosition = 0
    sound.SoundId = musicList[index].id
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    timeText.Text = "0:00 / 0:00"
    if autoplay then
        sound:Play()
        isPlaying = true
    else
        isPlaying = false
    end
    updateMusicUI()
end

-- 按钮事件
playPauseBtn.Activated:Connect(function()
    if isPlaying then
        sound:Pause()
        isPlaying = false
    else
        sound:Play()
        isPlaying = true
    end
    updateMusicUI()
end)

prevBtn.Activated:Connect(function()
    local wasPlaying = isPlaying
    local i = currentIndex - 1
    if i < 1 then i = #musicList end
    loadTrack(i, wasPlaying)
end)

nextBtn.Activated:Connect(function()
    local wasPlaying = isPlaying
    local i = currentIndex + 1
    if i > #musicList then i = 1 end
    loadTrack(i, wasPlaying)
end)

sound.Ended:Connect(function()
    local i = currentIndex + 1
    if i > #musicList then i = 1 end
    loadTrack(i, true)
end)

-- 进度条点击跳转
progressBtn.Activated:Connect(function(input)
    local x
    if input and input.Position then
        x = input.Position.X
    else
        x = game:GetService("UserInputService"):GetMouseLocation().X
    end
    local relX = x - progressBg.AbsolutePosition.X
    local ratio = math.clamp(relX / math.max(1, progressBg.AbsoluteSize.X), 0, 1)
    if sound.TimeLength > 0 then
        sound.TimePosition = ratio * sound.TimeLength
    end
end)

-- 打开 / 关闭悬浮窗
local function openPanel()
    if isOpen then return end
    isOpen = true
    tweenIsland(UDim2.new(0, 170, 0, 36))
    panel.Visible = true
    tweenPanel(UDim2.new(0, 300, 0, 280), 0)
    refreshIslandText()
end

local function closePanel()
    if not isOpen then return end
    isOpen = false
    tweenIsland(UDim2.new(0, 150, 0, 36))
    local t = tweenPanel(UDim2.new(0, 300, 0, 0), 1)
    t.Completed:Once(function()
        if not isOpen then panel.Visible = false end
    end)
    refreshIslandText()
end

clickBtn.Activated:Connect(function()
    if isOpen then closePanel() else openPanel() end
end)

closeBtn.Activated:Connect(closePanel)

-- 进度条 & 时间刷新
task.spawn(function()
    while screenGui.Parent do
        if sound.TimeLength > 0 then
            local ratio = sound.TimePosition / sound.TimeLength
            progressFill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
            timeText.Text = formatTime(sound.TimePosition) .. " / " .. formatTime(sound.TimeLength)
        end
        task.wait(0.1)
    end
end)

-- 面板内实时时间
task.spawn(function()
    while screenGui.Parent do
        panelTime.Text = "当前时间：" .. os.date("%H:%M:%S")
        if not isOpen and not isPlaying then
            islandLabel.Text = os.date("%H:%M")
        end
        task.wait(1)
    end
end)

-- 灵动岛跑马灯（只在播放且面板关闭时）
RunService.Heartbeat:Connect(function(dt)
    if isOpen or not isPlaying then return end
    local textW = islandLabel.TextBounds.X
    local containerW = labelContainer.AbsoluteSize.X
    if textW <= containerW or containerW <= 0 then
        islandLabel.Position = UDim2.new(0, 0, 0, 0)
        return
    end
    if marqueePause > 0 then
        marqueePause = marqueePause - dt
        return
    end
    marqueeX = marqueeX - dt * 40
    if marqueeX < -textW - 20 then
        marqueeX = containerW
        marqueePause = 1.0
    end
    islandLabel.Position = UDim2.new(0, marqueeX, 0, 0)
end)

-- 初始化
updateMusicUI()
