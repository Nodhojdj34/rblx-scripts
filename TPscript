local function createWindow(title, width, height)
    local win = Instance.new("Frame")
    win.AnchorPoint = Vector2.new(0.5, 0.5)
    win.Position = UDim2.new(0.5, 0, 0.5, 0)
    win.Size = UDim2.new(0, width, 0, height)
    win.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    win.Visible = false
    win.Parent = ScreenGui
    addCorner(win, UDim.new(0.08, 0))

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, 0, 0, 34)
    bar.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    bar.Text = title
    bar.TextColor3 = Color3.new(1, 1, 1)
    bar.Font = Enum.Font.GothamBold
    bar.TextSize = 12
    bar.Parent = win
    addCorner(bar, UDim.new(0.08, 0))
    makeDraggable(win, bar)

    local close = Instance.new("TextButton")
    close.AnchorPoint = Vector2.new(1, 0)
    close.Position = UDim2.new(1, -4, 4, 0)
    close.Size = UDim2.new(0, 26, 0, 26)
    close.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    close.Text = "X"
    close.TextColor3 = Color3.new(1, 1, 1)
    close.Font = Enum.Font.GothamBold
    close.TextSize = 13
    close.Parent = win
    addCorner(close, UDim.new(0.5, 0))
    close.MouseButton1Click:Connect(function() win.Visible = false end)

    return win, bar
end

