local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    LocalPlayer = Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
end
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 清理所有旧GUI残留，防止旧界面遮挡
for _,gui in ipairs(PlayerGui:GetChildren()) do
    if gui:IsA("ScreenGui") and (gui.Name:find("Hub") or gui.Name:find("Island")) then
        gui:Destroy()
    end
end

-- 创建主GUI
local HubGui = Instance.new("ScreenGui")
HubGui.Name = "NewStableHub"
HubGui.ResetOnSpawn = false
HubGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
HubGui.DisplayOrder = 999
HubGui.IgnoreGuiInset = true
HubGui.Parent = PlayerGui

-- 状态变量
local WindowOpen = false
local Window = nil
local Fly = false
local FlySpeed = 2
local AntiKnockback = false
local Invisible = false
local AutoHeal = false
local SelectedPlayer = nil
local Debounce = 0.25
local LastClick = 0

-- 圆角工具函数
local function AddCorner(Obj, Radius)
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = Radius
    Corner.Parent = Obj
end

-- ========== 灵动岛（按钮本体就是胶囊，无遮挡层！核心修复点击失效） ==========
local IslandBtn = Instance.new("TextButton")
IslandBtn.AnchorPoint = Vector2.new(0.5, 0)
IslandBtn.Position = UDim2.new(0.5, 0, 0, 10)
IslandBtn.Size = UDim2.new(0, 120, 0, 36)
IslandBtn.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
IslandBtn.Text = ""
IslandBtn.ZIndex = 10
AddCorner(IslandBtn, UDim.new(1, 0))
IslandBtn.Parent = HubGui

-- 灵动岛文字（Active=false，不拦截触摸）
local IslandText = Instance.new("TextLabel")
IslandText.Size = UDim2.new(1, 0, 1, 0)
IslandText.BackgroundTransparency = 1
IslandText.Text = "点我打开面板"
IslandText.TextColor3 = Color3.new(1,1,1)
IslandText.Font = Enum.Font.GothamBold
IslandText.TextSize = 11
IslandText.Active = false
IslandText.Parent = IslandBtn

-- 切换窗口函数
local function ToggleWindow()
    local Now = os.clock()
    if Now - LastClick < Debounce then return end
    LastClick = Now
    WindowOpen = not WindowOpen
    if Window then
        Window.Visible = WindowOpen
    end
end

-- 绑定多个点击事件兜底
IslandBtn.Activated:Connect(ToggleWindow)
IslandBtn.MouseButton1Click:Connect(ToggleWindow)
IslandBtn.MouseButton1Down:Connect(ToggleWindow)

-- F1快捷键兜底
UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then return end
    if Input.KeyCode == Enum.KeyCode.F1 then
        ToggleWindow()
    end
end)

-- ========== 构建主窗口（高对比纯色，杜绝黑屏） ==========
local function BuildWindow()
    if Window then return end
    Window = Instance.new("Frame")
    Window.AnchorPoint = Vector2.new(0.5,0.5)
    Window.Position = UDim2.new(0.5,0,0.5,0)
    Window.Size = UDim2.new(0, 420, 0, 320)
    Window.BackgroundColor3 = Color3.fromRGB(55, 58, 66)
    Window.Visible = false
    Window.ZIndex = 11
    AddCorner(Window, UDim.new(0.07,0))
    Window.Parent = HubGui

    -- 标题栏（拖动）
    local TitleBar = Instance.new("Frame")
    TitleBar.Size = UDim2.new(1,0,0,32)
    TitleBar.BackgroundColor3 = Color3.fromRGB(70,74,84)
    TitleBar.Parent = Window
    AddCorner(TitleBar, UDim.new(0.07,0))

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1,-40,1,0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = "功能面板"
    TitleLabel.TextColor3 = Color3.new(1,1,1)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize =13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Position = UDim2.new(0,10,0,0)
    TitleLabel.Active = false
    TitleLabel.Parent = TitleBar

    -- 关闭按钮
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.AnchorPoint = Vector2.new(1,0.5)
    CloseBtn.Position = UDim2.new(1,-8,0.5,0)
    CloseBtn.Size = UDim2.new(0,24,0,24)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(180,40,40)
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.new(1,1,1)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize =11
    AddCorner(CloseBtn,UDim.new(1,0))
    CloseBtn.Parent = TitleBar
    CloseBtn.Activated:Connect(function()
        WindowOpen = false
        Window.Visible = false
    end)

    -- 窗口拖动逻辑
    local Drag = false
    local DragStart, WinStart
    TitleBar.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch then
            Drag = true
            DragStart = Input.Position
            WinStart = Window.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(Input)
        if Drag and Input.UserInputType == Enum.UserInputType.Touch then
            local Delta = Input.Position - DragStart
            Window.Position = UDim2.new(WinStart.X.Scale, WinStart.X.Offset + Delta.X, WinStart.Y.Scale, WinStart.Y.Offset + Delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch then Drag = false end
    end)

    local Padding = Instance.new("UIPadding")
    Padding.PaddingTop = UDim.new(0,40)
    Padding.PaddingLeft = UDim.new(0,12)
    Padding.PaddingRight = UDim.new(0,12)
    Padding.Parent = Window

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0,8)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Window

    -- 创建按钮工具
    local function MakeBtn(Name, Callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1,-10,0,32)
        Btn.BackgroundColor3 = Color3.fromRGB(80,84,96)
        Btn.Text = Name
        Btn.TextColor3 = Color3.new(1,1,1)
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize =12
        AddCorner(Btn,UDim.new(0.12,0))
        Btn.Parent = Window
        Btn.Activated:Connect(Callback)
        return Btn
    end

    local BtnFly = MakeBtn("飞行：关闭",function()
        Fly = not Fly
        BtnFly.Text = Fly and "飞行：开启" or "飞行：关闭"
    end)
    local BtnAntiKb = MakeBtn("防甩飞：关闭",function()
        AntiKnockback = not AntiKnockback
        BtnAntiKb.Text = AntiKnockback and "防甩飞：开启" or "防甩飞：关闭"
    end)
    local BtnInvis = MakeBtn("隐身：关闭",function()
        Invisible = not Invisible
        BtnInvis.Text = Invisible and "隐身：开启" or "隐身：关闭"
        pcall(function()
            local Char = LocalPlayer.Character
            if not Char then return end
            for _,v in ipairs(Char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Transparency = Invisible and 1 or 0
                elseif v:IsA("ParticleEmitter") then
                    v.Enabled = not Invisible
                end
            end
        end)
    end)
    local BtnHeal = MakeBtn("自动回血：关闭",function()
        AutoHeal = not AutoHeal
        BtnHeal.Text = AutoHeal and "自动回血：开启" or "自动回血：关闭"
    end)
    MakeBtn("重置角色",function()
        pcall(function() LocalPlayer:LoadCharacter() end)
    end)
end

BuildWindow()

-- ========== 主循环｜飞行、功能逻辑（低检测风险） ==========
RunService.RenderStepped:Connect(function()
    pcall(function()
        local Char = LocalPlayer.Character
        if not Char then return end
        local Hum = Char:FindFirstChildOfClass("Humanoid")
        local Hrp = Char:FindFirstChild("HumanoidRootPart")
        if not Hum or not Hrp then return end
        local Cam = workspace.CurrentCamera

        -- 飞行 CFrame位移
        if Fly then
            Hum.PlatformStand = true
            local MoveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then MoveDir += Cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then MoveDir -= Cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then MoveDir -= Cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then MoveDir += Cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then MoveDir += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then MoveDir += Vector3.new(0,-1,0) end
            if MoveDir.Magnitude > 0 then
                MoveDir = MoveDir.Unit * FlySpeed
                Hrp.CFrame = Hrp.CFrame + MoveDir
            end
        else
            Hum.PlatformStand = false
        end

        -- 防甩飞
        if AntiKnockback then
            if Hrp.Velocity.Magnitude > 70 then
                Hrp.Velocity = Hrp.Velocity.Unit * 70
            end
        end

        -- 自动回血
        if AutoHeal and Hum.Health < Hum.MaxHealth then
            Hum.Health = Hum.MaxHealth
        end

        -- 选中玩家简易逻辑
        local Plrs = Players:GetPlayers()
        if #Plrs >= 2 then
            SelectedPlayer = Plrs[2]
        end
    end)
end)

-- ========== GUI守护循环，防止界面被删除消失 ==========
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if HubGui.Parent ~= PlayerGui then
                HubGui.Parent = PlayerGui
            end
        end)
    end
end)
