local function PanicDisableCheats(reason)
	GlobalState.IsFlying = false; GlobalState.IsNoclipping = false; GlobalState.IsInfJump = false; GlobalState.IsAutoAttack = false
	GlobalState.IsAutoRun = false; GlobalState.IsAutoJump = false; GlobalState.IsLockHealth = false; GlobalState.IsMagnet = false
	GlobalState.IsAutoAim = false; GlobalState.IsNoFall = false; GlobalState.IsKillAura = false; GlobalState.IsGodMode = false; GlobalState.IsHitboxExpand = false
	
	if GlobalState.AutoAttackConn then task.cancel(GlobalState.AutoAttackConn); GlobalState.AutoAttackConn = nil end
	if GlobalState.AutoRunConn then task.cancel(GlobalState.AutoRunConn); GlobalState.AutoRunConn = nil end
	if GlobalState.AutoJumpConn then task.cancel(GlobalState.AutoJumpConn); GlobalState.AutoJumpConn = nil end
	if GlobalState.LockHealthConn then task.cancel(GlobalState.LockHealthConn); GlobalState.LockHealthConn = nil end
	if GlobalState.MagnetConn then task.cancel(GlobalState.MagnetConn); GlobalState.MagnetConn = nil end
	if GlobalState.KillAuraConn then task.cancel(GlobalState.KillAuraConn); GlobalState.KillAuraConn = nil end
	if GlobalState.GodModeConn then task.cancel(GlobalState.GodModeConn); GlobalState.GodModeConn = nil end
	
	if GlobalState.AutoAimConn then GlobalState.AutoAimConn:Disconnect(); GlobalState.AutoAimConn = nil end
	if GlobalState.NoFallConn then GlobalState.NoFallConn:Disconnect(); GlobalState.NoFallConn = nil end
	if GlobalState.HitboxConn then GlobalState.HitboxConn:Disconnect(); GlobalState.HitboxConn = nil end
	
	local char = player.Character
	if char then
		local hum = char:FindFirstChild("Humanoid"); local hrp = char:FindFirstChild("HumanoidRootPart")
		if hum then GlobalState.TargetWalkSpeed = 16; GlobalState.TargetJumpPower = 50; hum.WalkSpeed = 16; hum.UseJumpPower = true; hum.JumpPower = 50; hum.PlatformStand = false end
		if hrp then
			if GlobalState.FlyBV then GlobalState.FlyBV:Destroy() GlobalState.FlyBV = nil end
			for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = true end end
		end
		if GlobalState.FlyConn then GlobalState.FlyConn:Disconnect() GlobalState.FlyConn = nil end
		if GlobalState.NoclipConn then GlobalState.NoclipConn:Disconnect() GlobalState.NoclipConn = nil end
		if GlobalState.InfJumpConn then GlobalState.InfJumpConn:Disconnect() GlobalState.InfJumpConn = nil end
	end
	GlobalState.AntiCheatWarning:Fire(reason)
end

