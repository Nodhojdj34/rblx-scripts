local function makeActionButton(name, y, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 36)
    btn.Position = UDim2.new(0.5, 0, 0, y)
    btn.AnchorPoint = Vector2.new(0.5, 0)
    btn.BackgroundColor3 = themes[1].btn
    btn.Text = name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.ZIndex = 2
    btn.Parent = ActionView
    addCorner(btn, UDim.new(0.12, 0))
    btn.Activated:Connect(callback)
    return btn
end

