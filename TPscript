					if GlobalState.IsFlying and hum.FloorMaterial ~= Enum.Material.Air and not hrp:FindFirstChild("FlyBV") then triggered = true; reason = "飞行状态被服务器强制中断" end
					if GlobalState.IsNoclipping and (hum:GetState() == Enum.HumanoidStateType.Ragdoll or hum:GetState() == Enum.HumanoidStateType.FallingDown) then triggered = true; reason = "疑似穿墙触发物理回弹" end
					
					if triggered then
						statusLabel.Text = "⚠️ 警告: 检测到服务器反作弊干预！\n已自动关闭所有危险功能保命。"; statusLabel.TextColor3 = THEME.Danger
						addLog("[警告] 触发原因: " .. reason, THEME.Danger); addLog("[系统] 已执行断臂求生，恢复安全属性。", THEME.Success)
						playSound(sndWarn); PanicDisableCheats(reason); task.wait(3)
					end
				end
			end
		end
	end)

	local warnConn = GlobalState.AntiCheatWarning.Event:Connect(function(reason)
		if content.Parent then statusLabel.Text = "⚠️ 警告: " .. reason .. "\n已自动执行断臂求生！"; statusLabel.TextColor3 = THEME.Danger; addLog("[系统] 已强制恢复: " .. reason, THEME.Danger) end
	end)

	content.Destroying:Connect(function() if checkConn then task.cancel(checkConn) end; if warnConn then warnConn:Disconnect() end end)
end

local function openCombatWindow()
	local content = createWindow("⚔️ 战斗中心 (终极火力)", 440)
	
	createActionBtn(content, "💥 范围斩杀 (Kill Aura)", 0, true, function(state)
		GlobalState.IsKillAura = state
		if state then
			GlobalState.KillAuraConn = task.spawn(function()
				while GlobalState.IsKillAura do
					task.wait(0.5)
					local myChar = player.Character
					if myChar and myChar:FindFirstChild("HumanoidRootPart") then
						local myPos = myChar.HumanoidRootPart.Position
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
								local enemyHum = p.Character:FindFirstChild("Humanoid")
								if enemyHum and (p.Character.HumanoidRootPart.Position - myPos).Magnitude < 30 then
									enemyHum.Health = 0
								end
							end
						end
					end
				end
			end)
		elseif GlobalState.KillAuraConn then task.cancel(GlobalState.KillAuraConn) end
	end, GlobalState.IsKillAura)

	createActionBtn(content, "🛡️ 无敌模式 (God Mode)", 45, true, function(state)
		GlobalState.IsGodMode = state
		if state then
			GlobalState.GodModeConn = task.spawn(function()
				while GlobalState.IsGodMode do
					task.wait(0.1)
					local char = player.Character
					if char then
						local hum = char:FindFirstChild("Humanoid")
						if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
					end
				end
			end)
		elseif GlobalState.GodModeConn then task.cancel(GlobalState.GodModeConn) end
	end, GlobalState.IsGodMode)

	createActionBtn(content, "🥊 暴力 Hitbox (范围扩大)", 90, true, function(state)
		GlobalState.IsHitboxExpand = state
		if state then
			GlobalState.HitboxConn = RunService.Stepped:Connect(function()
				local char = player.Character
				if char then
					for _, v in pairs(char:GetDescendants()) do
						if v:IsA("BasePart") and not v:IsA("MeshPart") then v.Size = Vector3.new(10, 10, 10) end
					end
				end
			end)
		else
			if GlobalState.HitboxConn then GlobalState.HitboxConn:Disconnect() end
			local char = player.Character
			if char then
				local hum = char:FindFirstChild("Humanoid")
				if hum then hum:BuildRigFromAttachments() end
			end
		end
	end, GlobalState.IsHitboxExpand)

	createActionBtn(content, "⚔️ 自动攻击 (极速)", 135, true, function(state)
		GlobalState.IsAutoAttack = state
		if state then
			GlobalState.AutoAttackConn = task.spawn(function()
				while GlobalState.IsAutoAttack do
					task.wait(0.05)
					local char = player.Character
					if char then
						local tool = char:FindFirstChildOfClass("Tool")
						if tool then pcall(function() tool:Activate() end) end
						pcall(function()
							local vim = game:GetService("VirtualInputManager")
							vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
							task.wait(0.01)
							vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
						end)
					end
				end
			end)
		else
			if GlobalState.AutoAttackConn then task.cancel(GlobalState.AutoAttackConn); GlobalState.AutoAttackConn = nil end
		end
	end, GlobalState.IsAutoAttack)

	createActionBtn(content, "🎯 自动索敌 (Auto-Aim)", 180, true, function(state)
		GlobalState.IsAutoAim = state
		if state then
			GlobalState.AutoAimConn = RunService.RenderStepped:Connect(function()
				local closest = math.huge; local target = nil; local myChar = player.Character
				if myChar and myChar:FindFirstChild("HumanoidRootPart") then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
							local dist = (p.Character.Head.Position - myChar.HumanoidRootPart.Position).Magnitude
							if dist < closest then closest = dist; target = p.Character.Head end
						end
					end
					if target and closest < 200 then
						workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, target.Position)
					end
				end
			end)
		elseif GlobalState.AutoAimConn then GlobalState.AutoAimConn:Disconnect() end
	end, GlobalState.IsAutoAim)

	createActionBtn(content, "🏃 自动奔跑 (Auto-Run)", 225, true, function(state)
		GlobalState.IsAutoRun = state
		if state then
			GlobalState.AutoRunConn = task.spawn(function()
				while GlobalState.IsAutoRun do
					task.wait(0.1)
					local char = player.Character
					if char then
						local hum = char:FindFirstChild("Humanoid")
						if hum then hum:Move(workspace.CurrentCamera.CFrame.LookVector, false) end
					end
				end
			end)
		elseif GlobalState.AutoRunConn then task.cancel(GlobalState.AutoRunConn) end
	end, GlobalState.IsAutoRun)

	createActionBtn(content, "🦘 自动跳跃 (Auto-Jump)", 270, true, function(state)
		GlobalState.IsAutoJump = state
		if state then
			GlobalState.AutoJumpConn = RunService.Heartbeat:Connect(function()
				local char = player.Character
				if char then
					local hum = char:FindFirstChild("Humanoid")
					if hum and hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
				end
			end)
		elseif GlobalState.AutoJumpConn then GlobalState.AutoJumpConn:Disconnect(); GlobalState.AutoJumpConn = nil end
	end, GlobalState.IsAutoJump)

	createActionBtn(content, "🪶 无掉落伤害", 315, true, function(state)
		GlobalState.IsNoFall = state
		if state then
			GlobalState.NoFallConn = player.Character.Humanoid.StateChanged:Connect(function(old, new)
				if new == Enum.HumanoidStateType.Landed then player.Character.Humanoid.Health = player.Character.Humanoid.MaxHealth end
			end)
		elseif GlobalState.NoFallConn then GlobalState.NoFallConn:Disconnect() end
	end, GlobalState.IsNoFall)
	
	createActionBtn(content, "🛡️ 锁定血量 (本地)", 360, true, function(state)
		GlobalState.IsLockHealth = state
		if state then
			GlobalState.LockHealthConn = task.spawn(function()
				while GlobalState.IsLockHealth do
					task.wait(0.5)
					local char = player.Character
					if char then
						local hum = char:FindFirstChild("Humanoid")
						if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
					end
				end
			end)
		elseif GlobalState.LockHealthConn then task.cancel(GlobalState.LockHealthConn) end
	end, GlobalState.IsLockHealth)

	createSlider(content, "视野缩放 (FOV)", 50, 120, workspace.CurrentCamera.FieldOfView, 405, function(val)
		if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = val end
	end)
end

